#!/usr/bin/env bash
# gh api with bounded backoff for our own platform repo. A GitHub outage (no HTTP status,
# 5xx, 429) retries 4 times (2, 4, 8 s), then exits 75 so the caller notes and skips;
# any other failure (404, 422, 403) is real and exits 1 at once. Output: gh's stdout.
set -uo pipefail
errors=$(mktemp)
for attempt in 1 2 3 4; do
  if gh api "$@" 2>"$errors"; then
    exit 0
  fi
  status=$(grep -Eo 'HTTP [0-9]{3}' "$errors" | tail -1 | cut -d' ' -f2 || true)
  case "$status" in
    "" | 5?? | 429) ;;
    *) cat "$errors" >&2; exit 1 ;;
  esac
  [[ $attempt -lt 4 ]] && sleep $((2 ** attempt))
done
cat "$errors" >&2
exit 75
