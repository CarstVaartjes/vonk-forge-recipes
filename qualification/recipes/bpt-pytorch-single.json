{
  "id": "vonk-forge/bpt-pytorch-single",
  "recipes": {
    "interface": "mesh-job",
    "parameters": {
      "temperature": 0.5,
      "seed": 0
    },
    "inputs": [
      {
        "slot": "mesh",
        "fixture": "generic-mesh-glb"
      }
    ],
    "output_limits": {
      "max_files": 1,
      "max_file_bytes": 268435456,
      "max_total_bytes": 268435456,
      "allowed_media_types": [
        "model/gltf-binary"
      ]
    },
    "timeout_seconds": 1800,
    "assertions": [
      {
        "kind": "file-count",
        "exact": 1
      },
      {
        "kind": "file-names",
        "exact": [
          "retopo.glb"
        ]
      },
      {
        "kind": "media-type",
        "allowed": [
          "model/gltf-binary"
        ]
      },
      {
        "kind": "minimum-bytes",
        "value": 20
      },
      {
        "kind": "format",
        "format": "glb"
      },
      {
        "kind": "glb-structure",
        "profile": "triangle-mesh",
        "minimum_meshes": 1,
        "minimum_primitives": 1
      }
    ]
  }
}
