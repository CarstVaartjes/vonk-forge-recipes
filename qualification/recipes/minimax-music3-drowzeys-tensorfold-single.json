{
  "id": "vonk-forge/minimax-music3-drowzeys-tensorfold-single",
  "recipes": {
    "interface": "audio-job",
    "parameters": {},
    "inputs": [
      {
        "slot": "caption",
        "fixture": "generic-prompt-text"
      }
    ],
    "output_limits": {
      "max_files": 1,
      "max_file_bytes": 11000000,
      "max_total_bytes": 11000000,
      "allowed_media_types": [
        "audio/wav"
      ]
    },
    "timeout_seconds": 3600,
    "assertions": [
      {
        "kind": "file-count",
        "exact": 1
      },
      {
        "kind": "file-names",
        "exact": [
          "song.wav"
        ]
      },
      {
        "kind": "media-type",
        "allowed": [
          "audio/wav"
        ]
      },
      {
        "kind": "minimum-bytes",
        "value": 44
      },
      {
        "kind": "format",
        "format": "wav"
      },
      {
        "kind": "audio-metadata",
        "media_type": "audio/wav",
        "channels": 2,
        "sample_rate": 44100,
        "sample_width_bytes": 2,
        "minimum_duration_seconds": 0.01,
        "maximum_duration_seconds": 60.0
      }
    ]
  }
}
