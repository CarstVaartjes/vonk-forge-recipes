{
  "id": "vonk-forge/step1x-3d-texture-pytorch-single",
  "recipes": {
    "interface": "mesh-job",
    "parameters": {},
    "inputs": [
      {
        "slot": "image",
        "fixture": "generic-image-png"
      },
      {
        "slot": "mesh",
        "fixture": "generic-mesh-glb"
      }
    ],
    "output_limits": {
      "max_files": 1,
      "max_file_bytes": 1073741824,
      "max_total_bytes": 1073741824,
      "allowed_media_types": [
        "model/gltf-binary"
      ]
    },
    "timeout_seconds": 3600,
    "assertions": [
      {
        "kind": "file-count",
        "exact": 1
      },
      {
        "kind": "file-names",
        "exact": [
          "step1x-textured.glb"
        ]
      },
      {
        "kind": "media-type",
        "allowed": [
          "model/gltf-binary"
        ]
      },
      {
        "kind": "minimum-bytes",
        "value": 20
      },
      {
        "kind": "format",
        "format": "glb"
      },
      {
        "kind": "glb-structure",
        "profile": "textured",
        "minimum_meshes": 1,
        "minimum_primitives": 1
      }
    ]
  }
}
