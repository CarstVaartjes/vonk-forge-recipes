{
  "id": "vonk-forge/skintokens-pytorch-single",
  "recipes": {
    "interface": "mesh-job",
    "parameters": {},
    "inputs": [
      {
        "slot": "mesh",
        "fixture": "skintokens-rigged-figure"
      }
    ],
    "output_limits": {
      "max_files": 1,
      "max_file_bytes": 536870912,
      "max_total_bytes": 536870912,
      "allowed_media_types": [
        "model/gltf-binary"
      ]
    },
    "timeout_seconds": 3600,
    "assertions": [
      {
        "kind": "file-count",
        "exact": 1
      },
      {
        "kind": "file-names",
        "exact": [
          "output.glb"
        ]
      },
      {
        "kind": "media-type",
        "allowed": [
          "model/gltf-binary"
        ]
      },
      {
        "kind": "minimum-bytes",
        "value": 20
      },
      {
        "kind": "format",
        "format": "glb"
      },
      {
        "kind": "glb-structure",
        "profile": "skinned",
        "minimum_meshes": 1,
        "minimum_primitives": 1
      }
    ]
  }
}
