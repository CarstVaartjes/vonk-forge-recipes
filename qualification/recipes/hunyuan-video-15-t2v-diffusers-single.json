{
  "id": "vonk-forge/hunyuan-video-15-t2v-diffusers-single",
  "recipes": {
    "interface": "video-job",
    "parameters": {
      "num-frames": 1,
      "num-inference-steps": 2
    },
    "inputs": [
      {
        "slot": "prompt",
        "fixture": "generic-prompt-text"
      }
    ],
    "output_limits": {
      "max_files": 1,
      "max_file_bytes": 1073741824,
      "max_total_bytes": 1073741824,
      "allowed_media_types": [
        "video/mp4"
      ]
    },
    "timeout_seconds": 3600,
    "assertions": [
      {
        "kind": "file-count",
        "exact": 1
      },
      {
        "kind": "file-names",
        "exact": [
          "output.mp4"
        ]
      },
      {
        "kind": "media-type",
        "allowed": [
          "video/mp4"
        ]
      },
      {
        "kind": "minimum-bytes",
        "value": 12
      },
      {
        "kind": "format",
        "format": "mp4"
      },
      {
        "kind": "video-metadata",
        "media_type": "video/mp4",
        "fps": 24,
        "fps_tolerance": 0.01,
        "frame_count": 1,
        "codec": "h264",
        "stream_count": 1,
        "audio_streams": 0,
        "minimum_duration_seconds": 0.04,
        "maximum_duration_seconds": 0.08333333333333333,
        "native_dimensions": {
          "kind": "hunyuan-video-15",
          "target_size": 960,
          "aspect_ratio": [
            16,
            9
          ]
        }
      }
    ]
  }
}
