{
  "id": "vonk-forge/stable-audio-3-small-sfx-pytorch-single",
  "recipes": {
    "interface": "audio-job",
    "parameters": {
      "duration-seconds": 2
    },
    "inputs": [
      {
        "slot": "prompt",
        "fixture": "sfx-prompt-text"
      }
    ],
    "output_limits": {
      "max_files": 1,
      "max_file_bytes": 21200000,
      "max_total_bytes": 21200000,
      "allowed_media_types": [
        "audio/wav"
      ]
    },
    "timeout_seconds": 3600,
    "assertions": [
      {
        "kind": "file-count",
        "exact": 1
      },
      {
        "kind": "file-names",
        "exact": [
          "sound.wav"
        ]
      },
      {
        "kind": "media-type",
        "allowed": [
          "audio/wav"
        ]
      },
      {
        "kind": "minimum-bytes",
        "value": 44
      },
      {
        "kind": "format",
        "format": "wav"
      },
      {
        "kind": "audio-metadata",
        "media_type": "audio/wav",
        "channels": 2,
        "sample_rate": 44100,
        "sample_width_bytes": 2,
        "minimum_duration_seconds": 1.9,
        "maximum_duration_seconds": 2.1
      }
    ]
  }
}
