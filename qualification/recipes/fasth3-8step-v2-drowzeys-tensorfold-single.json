{
  "id": "vonk-forge/fasth3-8step-v2-drowzeys-tensorfold-single",
  "recipes": {
    "interface": "video-job",
    "parameters": {
      "num-frames": 124
    },
    "inputs": [
      {
        "slot": "prompt",
        "fixture": "generic-prompt-text"
      }
    ],
    "output_limits": {
      "max_files": 1,
      "max_file_bytes": 536870912,
      "max_total_bytes": 536870912,
      "allowed_media_types": [
        "video/mp4"
      ]
    },
    "timeout_seconds": 3600,
    "assertions": [
      {
        "kind": "file-count",
        "exact": 1
      },
      {
        "kind": "media-type",
        "allowed": [
          "video/mp4"
        ]
      },
      {
        "kind": "minimum-bytes",
        "value": 1024
      },
      {
        "kind": "format",
        "format": "mp4"
      },
      {
        "kind": "video-metadata",
        "media_type": "video/mp4",
        "width": 864,
        "height": 480,
        "fps": 24,
        "fps_tolerance": 0.01,
        "frame_count": 124,
        "minimum_duration_seconds": 5.125,
        "maximum_duration_seconds": 5.208333333333333,
        "stream_count": 2,
        "audio_streams": 1,
        "codec": "h264"
      }
    ]
  }
}
