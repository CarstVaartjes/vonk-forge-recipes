{
  "id": "vonk-forge/hunyuan-video-foley-xl-pytorch-single",
  "recipes": {
    "interface": "audio-job",
    "parameters": {},
    "inputs": [
      {
        "slot": "prompt",
        "fixture": "generic-prompt-text"
      },
      {
        "slot": "video",
        "fixture": "foley-video-1s"
      }
    ],
    "output_limits": {
      "max_files": 1,
      "max_file_bytes": 536870912,
      "max_total_bytes": 536870912,
      "allowed_media_types": [
        "audio/wav"
      ]
    },
    "timeout_seconds": 3600,
    "assertions": [
      {
        "kind": "file-count",
        "exact": 1
      },
      {
        "kind": "file-names",
        "exact": [
          "foley-video-1s_generated.wav"
        ]
      },
      {
        "kind": "media-type",
        "allowed": [
          "audio/wav"
        ]
      },
      {
        "kind": "minimum-bytes",
        "value": 44
      },
      {
        "kind": "format",
        "format": "wav"
      },
      {
        "kind": "audio-metadata",
        "media_type": "audio/wav",
        "channels": 2,
        "sample_rate": 48000,
        "sample_width_bytes": 2,
        "minimum_duration_seconds": 1.0,
        "maximum_duration_seconds": 1.0
      }
    ]
  }
}
