{
  "id": "vonk-forge/chord-pbr-material-pytorch-single",
  "recipes": {
    "interface": "image-job",
    "parameters": {},
    "inputs": [
      {
        "slot": "image",
        "fixture": "generic-image-png"
      }
    ],
    "output_limits": {
      "max_files": 4,
      "max_file_bytes": 67108864,
      "max_total_bytes": 268435456,
      "allowed_media_types": [
        "image/png"
      ]
    },
    "timeout_seconds": 3600,
    "assertions": [
      {
        "kind": "file-count",
        "exact": 4
      },
      {
        "kind": "file-names",
        "exact": [
          "basecolor.png",
          "metalness.png",
          "normal.png",
          "roughness.png"
        ]
      },
      {
        "kind": "media-type",
        "allowed": [
          "image/png"
        ]
      },
      {
        "kind": "minimum-bytes",
        "value": 1
      },
      {
        "kind": "format",
        "format": "png"
      },
      {
        "kind": "image-metadata",
        "media_type": "image/png",
        "bit_depth": 8,
        "width": 64,
        "height": 64
      }
    ]
  }
}
