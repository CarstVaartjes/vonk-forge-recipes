{
  "id": "vonk-forge/moss-ttsd-v1-0-pytorch-single",
  "recipes": {
    "interface": "audio-job",
    "parameters": {
      "max-new-tokens": 256
    },
    "inputs": [
      {
        "slot": "script",
        "fixture": "ttsd-script"
      }
    ],
    "output_limits": {
      "max_files": 1,
      "max_file_bytes": 33554432,
      "max_total_bytes": 33554432,
      "allowed_media_types": [
        "audio/wav"
      ]
    },
    "timeout_seconds": 1800,
    "assertions": [
      {
        "kind": "file-count",
        "exact": 1
      },
      {
        "kind": "file-names",
        "exact": [
          "speech.wav"
        ]
      },
      {
        "kind": "media-type",
        "allowed": [
          "audio/wav"
        ]
      },
      {
        "kind": "minimum-bytes",
        "value": 44
      },
      {
        "kind": "format",
        "format": "wav"
      },
      {
        "kind": "audio-metadata",
        "media_type": "audio/wav",
        "channels": 1,
        "sample_rate": 24000,
        "sample_width_bytes": 2,
        "minimum_duration_seconds": 0.5,
        "maximum_duration_seconds": 30.0
      }
    ],
    "cases": [
      {
        "id": "clone-s1-with-transcript",
        "inputs": [
          {
            "slot": "script",
            "fixture": "ttsd-script"
          },
          {
            "slot": "reference_audio",
            "fixture": "tts-reference-audio"
          },
          {
            "slot": "reference_text",
            "fixture": "tts-reference-text"
          }
        ]
      }
    ]
  }
}
