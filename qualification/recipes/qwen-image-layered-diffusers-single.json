{
  "id": "vonk-forge/qwen-image-layered-diffusers-single",
  "recipes": {
    "interface": "artifact-job",
    "parameters": {},
    "inputs": [
      {
        "slot": "image",
        "fixture": "generic-image-png"
      }
    ],
    "output_limits": {
      "max_files": 4,
      "max_file_bytes": 8388608,
      "max_total_bytes": 33554432,
      "allowed_media_types": [
        "image/png"
      ]
    },
    "timeout_seconds": 3600,
    "assertions": [
      {
        "kind": "file-count",
        "exact": 4
      },
      {
        "kind": "media-type",
        "allowed": [
          "image/png"
        ]
      },
      {
        "kind": "minimum-bytes",
        "value": 1
      },
      {
        "kind": "format",
        "format": "png"
      },
      {
        "kind": "file-names",
        "exact": [
          "layer-00.png",
          "layer-01.png",
          "layer-02.png",
          "layer-03.png"
        ]
      },
      {
        "kind": "image-metadata",
        "media_type": "image/png",
        "width": 640,
        "height": 640,
        "bit_depth": 8,
        "color_type": 6
      }
    ]
  }
}
