    "A391": {
      "method": "POST",
      "path": "/chat/completions",
      "body": {
        "model": "$ALIAS",
        "messages": [
          {
            "role": "user",
            "content": "Return only the decimal integer equal to 17 multiplied by 23. No words or punctuation."
          }
        ],
        "temperature": 0,
        "max_tokens": 256,
        "stream": false,
        "chat_template_kwargs": {
          "enable_thinking": false,
          "thinking": false
        }
      },
      "timeout_seconds": 180,
      "max_response_bytes": 262144,
      "assertions": [
        {
          "kind": "path.equals",
          "path": "model",
          "value": "$ALIAS"
        },
        {
          "kind": "path.count",
          "path": "choices",
          "value": 1
        },
        {
          "kind": "path.nonempty",
          "path": "choices.0.message.content"
        },
        {
          "kind": "raw.not-contains",
          "values": [
            "<|channel>",
            "<|tool_call>",
            "<think>",
            "</think>"
          ]
        }
      ],
      "quality_assertions": [
        {
          "kind": "path.regex",
          "path": "choices.0.message.content",
          "value": "[\\s\\S]*(?<![-0-9])391(?![0-9])[\\s\\S]*",
          "expected": "391"
        },
        {
          "kind": "path.regex",
          "path": "choices.0.message.content",
          "value": "^\\s*-?[0-9]+\\s*$",
          "expected": "only the integer in content"
        }
      ]
    },
