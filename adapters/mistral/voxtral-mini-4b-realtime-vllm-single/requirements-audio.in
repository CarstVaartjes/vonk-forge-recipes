# vLLM's `audio` extra (vllm/setup.py at v0.32.0: av, scipy, soundfile, soxr,
# mistral_common[audio]), which the vLLM recipe for Voxtral Mini 4B Realtime installs with
# `uv pip install "mistral-common[audio]>=1.9.0"` (its `audio` extra is soundfile and soxr).
# The immutable vLLM 0.32.0 base does not install the extra, so its packages are added here, limited to
# the packages the extra names. mistral_common is already in the base (vLLM's own requirement); verify-runtime.py
# checks it is at least 1.9.0. The versions are the ones the Qwen3-ASR and Nemotron 3.5 Transcribe recipes
# already lock on this same base.
av==19.0.2
scipy==1.17.1
soundfile==0.13.1
soxr==1.0.0
