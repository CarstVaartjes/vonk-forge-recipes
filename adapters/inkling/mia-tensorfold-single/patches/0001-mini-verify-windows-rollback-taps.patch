+    const int v = static_cast<int>(i / (R + 1)), r = static_cast<int>(i % (R + 1));
+    const uint16_t o = tobf(y[static_cast<size_t>(r) * V + v]);
+    if (r < R) phi[static_cast<size_t>(v) * R + r] = o;
+    else beta[v] = o;
+}
