+// walk[j + 1] = the first maximum of `n` fp32 logits (the lowest id among equals). One block of 1024.
+extern "C" __global__ void __launch_bounds__(1024) tf_ink2m_pick(const float* __restrict__ x, int n, int* __restrict__ walk, int j) {
+    __shared__ float sv[32];
+    __shared__ int si[32];
