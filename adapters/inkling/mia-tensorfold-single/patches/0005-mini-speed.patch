+        }
+        s = tf_common::warp_sum(s);
+        if (lane == 0) {
+            const float b = bfr(s + bt);
+            const float x = bfr(bf(base[st * base_stride + v]) + b);
+            out[st * out_stride + v] = v < valid ? bfr(tanhf(x / cap) * cap) : -INFINITY;
+        }
