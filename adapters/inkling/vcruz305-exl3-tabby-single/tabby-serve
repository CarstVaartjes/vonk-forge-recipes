#!/usr/bin/env python3
"""Vonk entrypoint for upstream's TabbyAPI launch (replaces dgx-spark/scripts/serve.sh).

Upstream's serve.sh renders a TabbyAPI config from shell variables and starts
`python main.py --config` from the TabbyAPI directory. This wrapper does the
same from command-line flags, so the recipe's settings can bind to them. Host,
port and the model view directory are platform specific; every other value is
the flag's, defaulting to upstream's measured set (24,576-token context, FP16
KV cache, one stream, the pack's MTP draft head).
"""

from __future__ import annotations

import argparse
import os
import resource
import string
import sys
from pathlib import Path

MODEL_DIR = Path("/models/target")
TEMPLATE = Path("/opt/vonk/tabby-config.yml")
TABBY = Path("/opt/tabbyAPI")

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--served-name", default="Inkling-2-Mini-SAGE-REXL3-4.23bpw")
parser.add_argument("--host", default="0.0.0.0")
parser.add_argument("--port", type=int, default=8000)
parser.add_argument("--max-seq-len", type=int, default=24576)
parser.add_argument("--cache-size", type=int, default=None)
parser.add_argument("--cache-mode", default="FP16")
parser.add_argument("--chunk-size", type=int, default=2048)
parser.add_argument("--max-batch-size", type=int, default=1)
parser.add_argument("--draft", choices=("mtp", "off"), default="mtp")
options = parser.parse_args()

# Upstream's own sizing checks (serve.sh): the KV pool defaults to one full context.
cache_size = options.max_seq_len if options.cache_size is None else options.cache_size
if cache_size % 256:
    raise SystemExit("cache-size must be a multiple of 256")
if cache_size < options.max_seq_len:
    raise SystemExit(
        f"cache-size ({cache_size}) < max-seq-len ({options.max_seq_len}): "
        "one full-length request would not fit"
    )

# upstream serve.sh: "ulimit -n 65536"; the CUDA driver fails mid-load on 1024 open files.
soft, hard = resource.getrlimit(resource.RLIMIT_NOFILE)
wanted = 65536 if hard == resource.RLIM_INFINITY else min(65536, hard)
if soft < wanted:
    resource.setrlimit(resource.RLIMIT_NOFILE, (wanted, hard))

for name in (
    "HOME",
    "XDG_CACHE_HOME",
    "XDG_CONFIG_HOME",
    "TRITON_CACHE_DIR",
    "TORCH_HOME",
    "TORCH_EXTENSIONS_DIR",
    "CUDA_CACHE_PATH",
):
    path = os.environ.get(name)
    if path:
        os.makedirs(path, exist_ok=True)

# TabbyAPI lists every directory under model_dir, so serve one isolated view
# holding a single symlink to the read-only model mount (upstream does the same).
state = Path(os.environ.get("XDG_CACHE_HOME", "/tmp")) / "tabby"
view = state / "models"
view.mkdir(parents=True, exist_ok=True)
for entry in view.iterdir():
    if entry.is_symlink():
        entry.unlink()
(view / options.served_name).symlink_to(MODEL_DIR)

values = {
    "HOST": options.host,
    "PORT": options.port,
    "DISABLE_AUTH": "true",
    "MODEL_PARENT": view,
    "MODEL_NAME": options.served_name,
    "MAX_SEQ_LEN": options.max_seq_len,
    "CACHE_SIZE": cache_size,
    "CACHE_MODE": options.cache_mode,
    "CHUNK_SIZE": options.chunk_size,
    "MAX_BATCH_SIZE": options.max_batch_size,
    "DRAFT_MODE": "mtp" if options.draft == "mtp" else "disabled",
}
config = state / "config.yml"
config.write_text(
    string.Template(TEMPLATE.read_text()).substitute({key: str(value) for key, value in values.items()})
)

# setup_logger runs before config loading and writes logs/ relative to cwd.
# Keep that cwd writable while preserving the pinned read-only template resources.
for name in ("templates", "sampler_overrides"):
    link = state / name
    if not link.is_symlink():
        link.symlink_to(TABBY / name, target_is_directory=True)
os.chdir(state)
os.execv(
    sys.executable,
    (sys.executable, "-u", str(TABBY / "main.py"), "--config", str(config)),
)
