#!/usr/bin/env python3
"""Bind Vonk's two-node placement and settings to the environment boot.py reads.

The upstream launcher (boot.py) assembles the SGLang command line from
environment variables. Vonk passes the exact placement as SGLang flags:
``--nnodes``, ``--node-rank`` and ``--dist-init-addr`` (the compiler
rendezvous sentinel), plus the two setting-bound flags ``--context-length`` and
``--max-running-requests``. Any other flag is appended to EXTRA_SGLANG_ARGS,
which boot.py adds to the SGLang command unchanged.
"""

from __future__ import annotations

import os
import sys
from ipaddress import ip_address

MAPPED = {
    "--context-length": "CONTEXT_LENGTH",
    "--max-running-requests": "MAX_RUNNING_REQUESTS",
}
PLACEMENT = ("--nnodes", "--node-rank", "--dist-init-addr")
FABRIC_NAMES = (
    "NCCL_SOCKET_IFNAME",
    "NCCL_IB_HCA",
    "NCCL_IB_GID_INDEX",
    "GLOO_SOCKET_IFNAME",
)


def main() -> None:
    arguments = sys.argv[1:]
    values: dict[str, str] = {}
    extra: list[str] = []
    index = 0
    while index < len(arguments):
        name = arguments[index]
        if name in MAPPED or name in PLACEMENT:
            if index + 1 >= len(arguments):
                raise SystemExit(f"{name} requires a value")
            values[name] = arguments[index + 1]
            index += 2
        else:
            extra.append(name)
            index += 1

    local_address = os.environ.get("VONK_LOCAL_ADDR")
    master_address = os.environ.get("VONK_MASTER_ADDR")
    master_port = os.environ.get("VONK_MASTER_PORT")
    try:
        if (
            values.get("--nnodes") != "2"
            or values.get("--node-rank") not in {"0", "1"}
            or values.get("--dist-init-addr") != "VONK_MASTER_ADDR:VONK_MASTER_PORT"
            or not local_address
            or not master_address
            or not master_port
            or any(not os.environ.get(name) for name in FABRIC_NAMES)
            or not master_port.isascii()
            or not master_port.isdigit()
            or not 1024 <= int(master_port) <= 65535
        ):
            raise ValueError
        ip_address(local_address)
        ip_address(master_address)
    except ValueError:
        raise SystemExit(
            "distributed MiMo-V2.6 requires complete two-node placement rendezvous and fabric"
        ) from None

    environment = dict(os.environ)
    environment.update(
        NNODES="2",
        NODE_RANK=values["--node-rank"],
        DIST_INIT_ADDR=f"{master_address}:{master_port}",
        HOST_IP=local_address,
    )
    for flag, variable in MAPPED.items():
        if flag in values:
            environment[variable] = values[flag]
    if extra:
        previous = environment.get("EXTRA_SGLANG_ARGS", "").strip()
        environment["EXTRA_SGLANG_ARGS"] = " ".join([*([previous] if previous else []), *extra])

    os.execve(
        sys.executable,
        [sys.executable, "-u", "/opt/mimo26/boot.py", "run"],
        environment,
    )


if __name__ == "__main__":
    main()
