#!/usr/bin/env python3
from __future__ import annotations

import os
import sys


arguments = sys.argv[1:]
try:
    model_index = arguments.index("--model-path")
    model_path = arguments[model_index + 1]
except (ValueError, IndexError):
    raise SystemExit("Ling DSpark requires --model-path /models") from None
if model_path != "/models":
    raise SystemExit("Ling DSpark requires the catalog model root at /models")
arguments[model_index + 1] = "/models/target"
max_requests_index=None
if "--max-running-requests" in arguments:
    max_requests_index=arguments.index("--max-running-requests")
    try:
        max_requests=arguments[max_requests_index + 1]
    except IndexError:
        raise SystemExit("--max-running-requests requires a value") from None
    del arguments[max_requests_index:max_requests_index + 2]
else:
    max_requests="6"
arguments.extend(
    (
        "--trust-remote-code",
        "--nnodes",
        "1",
        "--dist-init-addr",
        "127.0.0.1:2345",
        "--ep-size",
        "1",
        "--random-seed",
        "308534008",
        "--max-running-requests",
        max_requests,
        "--max-mamba-cache-size",
        "32",
        "--chunked-prefill-size",
        "8192",
        "--allow-auto-truncate",
        "--tool-call-parser",
        "ling3",
        "--reasoning-parser",
        "ling3",
        "--enable-fp32-lm-head",
        "--disable-shared-experts-fusion",
        "--kv-cache-dtype",
        "fp8_e4m3",
        "--speculative-algorithm",
        "DSPARK",
        "--speculative-draft-model-path",
        "/models/draft",
        "--enable-linear-replayssm-spec",
        "--linear-replayssm-cache-len",
        "32",
    )
)
os.execv(sys.executable, (sys.executable, "-m", "sglang.launch_server", *arguments))
