#!/usr/bin/env python3
"""Start r0b0tlab's Qwen3.8 Flash Next NVFP4 SGLang runtime under the platform contract."""

from __future__ import annotations

import os
import sys
from pathlib import Path

MODEL = Path("/models")
CACHE = Path("/outputs/cache")

for name in ("config.json", "model.safetensors.index.json", "model-fp8-mtp-ple.safetensors"):
    if not (MODEL / name).is_file():
        raise SystemExit(f"immutable model artifact is missing: {MODEL / name}")
for name in ("home", "hf", "jit", "xdg", "triton", "torch", "flashinfer", "ple"):
    (CACHE / name).mkdir(parents=True, exist_ok=True)

# The upstream entrypoint compiles the profile and locks into the exact server
# argv, prepares the verified PLE table under /cache/ple, then execs SGLang.
# It hard-codes the checkpoint at /model, but the platform mounts model files
# under /models, so rebind that one constant before running its main().
os.chdir("/opt/r0b0tlab")
sys.path.insert(0, "/opt/r0b0tlab")
from runtime import entrypoint  # noqa: E402

entrypoint.MODEL_PATH = str(MODEL)
raise SystemExit(entrypoint.main(sys.argv[1:]))
