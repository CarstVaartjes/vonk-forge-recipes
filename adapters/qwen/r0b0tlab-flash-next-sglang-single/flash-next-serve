#!/usr/bin/env python3
"""Start r0b0tlab's Qwen3.8 Flash Next NVFP4 SGLang runtime under the platform contract."""

from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path

# Consume the platform's endpoint arguments before the upstream profile parser
# sees them. The upstream entrypoint sets memory from the profile itself.
parser = argparse.ArgumentParser(add_help=False)
parser.add_argument("--host", required=True)
parser.add_argument("--port", required=True, type=int)
args, profile_args = parser.parse_known_args()
if not 0 < args.port <= 65535:
    parser.error("port must be between 1 and 65535")

MODEL = Path("/models")
CACHE = Path("/outputs/cache")

for name in ("config.json", "model.safetensors.index.json", "model-fp8-mtp-ple.safetensors"):
    if not (MODEL / name).is_file():
        raise SystemExit(f"immutable model artifact is missing: {MODEL / name}")
for name in ("home", "hf", "jit", "xdg", "triton", "torch", "flashinfer", "ple"):
    (CACHE / name).mkdir(parents=True, exist_ok=True)

# The upstream entrypoint compiles the profile and locks into the exact server
# argv, prepares the verified PLE table, then execs SGLang. It hard-codes the
# checkpoint at /model, but the platform mounts model files under /models. It
# hard-codes the table under /cache/ple, and its preparation walks that path one
# component at a time without following links, so the image's /cache symlink is
# refused (ENOTDIR); the table goes to the platform's real cache directory.
os.chdir("/opt/r0b0tlab")
sys.path.insert(0, "/opt/r0b0tlab")
from runtime import entrypoint  # noqa: E402
from sglang.srt.models import qwen4_exp_ple_cache as ple_cache  # noqa: E402

# Platform model files are hard links into the shared store, so the source has
# nlink > 1 by design. Relax only that count for "source"; the whole file is still
# hashed against the pinned plan and every other check stays as upstream wrote it.
ple_require_single_link = ple_cache._require_regular_single_link


def require_regular_link(st, what):
    if what == "source" and st.st_nlink > 1:
        st = os.stat_result((*st[:3], 1, *st[4:]))
    ple_require_single_link(st, what)


ple_cache._require_regular_single_link = require_regular_link

entrypoint.MODEL_PATH = str(MODEL)
entrypoint.PLE_DIR_ROOT = str(CACHE / "ple")
entrypoint.SERVE_HOST = args.host
entrypoint.SERVE_PORT = args.port
raise SystemExit(entrypoint.main(profile_args))
