#!/usr/bin/env python3
"""Vonk entrypoint for upstream's tools/serve_openai.py (replaces start.sh).

Takes upstream's own flags (--model, --draft_model, --cache_quant, --grid_size,
--cache_size) from the recipe. Upstream's start.sh omits --cache_quant when
CACHE_QUANT=none; the same is done here. Host and port are fixed for the
platform (0.0.0.0:8000) unless a flag is given.
"""

from __future__ import annotations

import os
import sys

arguments = sys.argv[1:]
for index, argument in enumerate(arguments):
    if argument == "--cache_quant" and index + 1 < len(arguments) and arguments[index + 1] == "none":
        del arguments[index : index + 2]
        break
if "--host" not in arguments:
    arguments += ["--host", "0.0.0.0"]
if "--port" not in arguments:
    arguments += ["--port", "8000"]

for name in (
    "HOME",
    "XDG_CACHE_HOME",
    "XDG_CONFIG_HOME",
    "HF_HOME",
    "TRITON_CACHE_DIR",
    "TORCH_HOME",
    "TORCH_EXTENSIONS_DIR",
    "CUDA_CACHE_PATH",
):
    path = os.environ.get(name)
    if path:
        os.makedirs(path, exist_ok=True)

os.execv(
    sys.executable,
    (sys.executable, "-u", "/opt/exl3/tools/serve_openai.py", *arguments),
)
