#!/bin/bash
# The Vonk Forge placement wrapper for KindlingAI's Qwen3.8-Flash-Next gr8 recipes (one Spark or two). It maps what the
# platform gives a workload (the arguments in the recipe, the VONK_* placement environment, the read-only /models
# mounts and the writable /outputs) onto the options gr8's launcher reads (the creator's .env lines, which the recipe's
# environment carries), then runs gr8's own image entrypoint, which starts this box's supervisor.
#
#   arguments    --host (accepted: the front end serves on every address), --port -> PORT,
#                --max-model-len -> MAX_MODEL_LEN, --sess -> SESS
#   placement    VONK_PEER_ADDRS -> PEERS (rank order, the head first), VONK_LOCAL_ADDR -> NODE_IP, VONK_MASTER_PORT ->
#                CONTROL_PORT (gr8's supervisor port; the S2 control port is a fixed 7341 and the fabric bootstrap uses
#                18600 upward, neither of them the platform's). One Spark: PEERS=127.0.0.1, as the creator's .env.
#                No IPS/IPS2: gr8 finds each box's RoCE rails itself.
#   model        /models/target is the exlr8 release used in place (MODEL, a local path: nothing is fetched). The
#                release's own drafter/dflash.q4_0.pack, when mounted, is found by the engine (GR8_QW38_DFL).
#   writable     gr8's working directory, model cache and SSD KV store are under /outputs/cache/gr8, where the creator's
#                compose file mounts /var/lib/gr8/{home,cache}; the recipe's own KV_STORE already names it.
#   engine flags the recipe's options are variables here, which this wrapper turns into the creator's EXTRA_ENV words:
#                VISION=1 -> GR8_QW38_VISION=1, NO_MTP=1 -> GR8_QW38_NO_MTP=1, DFL=0 -> GR8_QW38_DFL=0. They are
#                appended to the recipe's EXTRA_ENV and unset before the entrypoint runs.
set -euo pipefail

gr8=/opt/gr8
release=/models/target
state=/outputs/cache/gr8

host= port= max_model_len= sess=
while [ $# -gt 0 ]; do
  case "$1" in
    --host) host=$2; shift 2 ;;
    --host=*) host=${1#*=}; shift ;;
    --port) port=$2; shift 2 ;;
    --port=*) port=${1#*=}; shift ;;
    --max-model-len) max_model_len=$2; shift 2 ;;
    --max-model-len=*) max_model_len=${1#*=}; shift ;;
    --sess) sess=$2; shift 2 ;;
    --sess=*) sess=${1#*=}; shift ;;
    *) echo "gr8-serve: unknown argument $1" >&2; exit 2 ;;
  esac
done
: "$host"
[ -z "$port" ] || export PORT=$port
[ -z "$max_model_len" ] || export MAX_MODEL_LEN=$max_model_len
[ -z "$sess" ] || export SESS=$sess

mkdir -p "$state/home" "$state/cache" /outputs/tmp
export GR8_WORK_DIR=$state/home MODEL_CACHE=$state/cache TMPDIR=/outputs/tmp

# placement
if [ "${VONK_WORLD_SIZE:-1}" -gt 1 ]; then
  : "${VONK_PEER_ADDRS:?gr8-serve: VONK_PEER_ADDRS is not set}" "${VONK_LOCAL_ADDR:?gr8-serve: VONK_LOCAL_ADDR is not set}"
  export PEERS=$VONK_PEER_ADDRS NODE_IP=$VONK_LOCAL_ADDR
  [ -z "${VONK_MASTER_PORT:-}" ] || export CONTROL_PORT=$VONK_MASTER_PORT
  unset IPS IPS2
else
  export PEERS=127.0.0.1
fi

# the release is used in place; the creator's Hugging Face URL is not
export MODEL=$release

# the engine flags the options carry
extra=${EXTRA_ENV:-}
[ "${VISION:-0}" = 0 ] || extra="${extra:+$extra }GR8_QW38_VISION=1"
[ "${NO_MTP:-0}" = 0 ] || extra="${extra:+$extra }GR8_QW38_NO_MTP=1"
[ "${DFL:-1}" != 0 ] || extra="${extra:+$extra }GR8_QW38_DFL=0"
[ -z "$extra" ] || export EXTRA_ENV=$extra
unset VISION NO_MTP DFL

exec "$gr8/docker/entrypoint.sh"
