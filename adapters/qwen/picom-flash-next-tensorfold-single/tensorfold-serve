#!/bin/sh
# Entrypoint for the pico-dgx-qwen38 TensorFold Flash Next recipe. The recipe passes only named
# `tensorfold-native serve` options; the catalog model root is always /models.
set -eu
: "${HOME:?}" "${CUDA_CACHE_PATH:?}" "${TORCH_EXTENSIONS_DIR:?}" "${TRITON_CACHE_DIR:?}" "${TMPDIR:?}"
# The platform binds /outputs/cache; the cache and temporary directories below
# it are created here (nothing else is writable).
mkdir -p "$HOME/.cache/tensorfold" "$CUDA_CACHE_PATH" "$TORCH_EXTENSIONS_DIR" "$TRITON_CACHE_DIR" "$TMPDIR"
# The two-stage draft head (the creator's HEAD2 lever, patch 0115) reads a 30.7 MB file made from the checkpoint's own lm_head
# rows and the shipped rotation: the creator's `recipe.sh head2` step, run once into the cache. Like the creator's start, a
# missing file only means the engine starts without the lever (it drafts, so replies are the same either way). The step delays
# first readiness (about a minute); the start deadline bounds it.
head2_dir=$HOME/.cache/tensorfold/q38
head2=$head2_dir/head2_r9.bin
if [ ! -s "$head2" ]; then
  mkdir -p "$head2_dir"
  tmp=$head2_dir/.head2_r9.$$.bin
  if python3 -I /opt/vonk/head2/mkhead2.py /models /opt/vonk/head2/draft_vocab_default.txt /opt/vonk/head2/head2_rot_r9.rot "$tmp" 512 && [ -s "$tmp" ]; then
    mv "$tmp" "$head2"
  else
    rm -f "$tmp"
    echo "tensorfold-serve: the two-stage draft head file could not be made; starting without it" >&2
  fi
fi
if [ -s "$head2" ]; then
  export TF_FLASHNEXT_Q38_HEAD2="$head2" TF_FLASHNEXT_Q38_HEAD2_FAST=3 TF_FLASHNEXT_Q38_HEAD2_SAMPLED=1
fi
exec tensorfold-native serve /models "$@"
