#!/usr/bin/env python3
from __future__ import annotations

import os
import sys


arguments = sys.argv[1:]
try:
    model_index = arguments.index("--model-path")
    model_path = arguments[model_index + 1]
except (ValueError, IndexError):
    raise SystemExit("Qwen3.8 27B DSpark requires --model-path /models") from None
if model_path != "/models":
    raise SystemExit("Qwen3.8 27B DSpark requires the catalog model root at /models")
arguments[model_index + 1] = "/models/target"
if "--max-running-requests" in arguments:
    max_requests_index=arguments.index("--max-running-requests")
    try:
        max_requests=arguments[max_requests_index + 1]
    except IndexError:
        raise SystemExit("--max-running-requests requires a value") from None
    del arguments[max_requests_index:max_requests_index + 2]
else:
    max_requests="10"
arguments.extend(
    (
        "--trust-remote-code",
        "--attention-backend",
        "flashinfer",
        "--chunked-prefill-size",
        "8192",
        "--disable-prefill-cuda-graph",
        "--kv-cache-dtype",
        "fp8_e4m3",
        "--mamba-ssm-dtype",
        "bfloat16",
        "--mamba-radix-cache-strategy",
        "extra_buffer_lazy",
        "--mamba-full-memory-ratio",
        "4.21",
        "--max-mamba-cache-size",
        "40",
        "--max-running-requests",
        max_requests,
        "--speculative-algorithm",
        "DSPARK",
        "--speculative-draft-model-path",
        "/models/draft",
        "--speculative-dspark-block-size",
        "7",
        "--speculative-num-draft-tokens",
        "8",
        "--speculative-draft-model-quantization",
        "unquant",
        "--enable-torch-compile",
        "--torch-compile-max-bs",
        "4",
        "--cuda-graph-max-bs-decode",
        "4",
        "--num-continuous-decode-steps",
        "2",
        "--reasoning-parser",
        "qwen3",
        "--tool-call-parser",
        "qwen3_coder",
        "--sampling-defaults",
        "model",
        "--enable-metrics",
        "--enable-cache-report",
    )
)
os.execv(sys.executable, (sys.executable, "-m", "sglang.launch_server", *arguments))
