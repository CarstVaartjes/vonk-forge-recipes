#!/usr/bin/env python3
"""Preserve canonical vLLM arguments and bind Controller placement."""
import os
import sys
from ipaddress import ip_address
arguments = sys.argv[1:]
# The b12x checkpoint reader auto-selects io_uring bounce I/O on GB10,
# independently of B12X_DISK_BACKEND. Keep its compute kernels, but load the
# same checkpoint with vLLM's standard safetensors reader in our sandbox.
SANDBOX_LOAD_FORMAT = "safetensors"
# Normalize both CLI spellings, including omitted/default and repeated options.
# Always append the image-owned loader so no upstream default can select io_uring.
safe_arguments = []
skip_value = False
for argument in arguments:
    if skip_value:
        skip_value = False
    elif argument == "--load-format":
        skip_value = True
    elif not argument.startswith("--load-format="):
        safe_arguments.append(argument)
arguments = [*safe_arguments, "--load-format", SANDBOX_LOAD_FORMAT]

address = os.environ.get("VONK_MASTER_ADDR", "")
local = os.environ.get("VONK_LOCAL_ADDR", "")
port = os.environ.get("VONK_MASTER_PORT", "")
try:
    ip_address(address)
    ip_address(local)
    if not (port.isascii() and port.isdigit() and 1024 <= int(port) <= 65535):
        raise ValueError("invalid rendezvous port")
except ValueError as error:
    raise SystemExit("FP4 TP2 requires valid Controller rendezvous and local addresses") from error
arguments += ["--master-addr", address, "--master-port", port]
os.environ["VLLM_HOST_IP"] = local
os.environ["MASTER_ADDR"] = address
os.environ["MASTER_PORT"] = port
os.execv(sys.executable, [sys.executable, "-m", "vllm.entrypoints.cli.main", *arguments])
