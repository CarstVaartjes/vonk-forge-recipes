#!/usr/bin/env python3
"""Launch the pinned SGLang for r0b0tlab's Ornith 1.5 NVFP4 W4A16 profile."""

from __future__ import annotations

import os
import shutil
import sys
from pathlib import Path

MODEL = Path("/models")
PREWARM = Path("/opt/vonk/prewarm")


def seed(source: Path, target: Path) -> None:
    """Seed a pre-warmed JIT cache once into its writable cache location.

    The cache is an optimisation: when it cannot be copied the workload starts
    without it (the engine compiles what it needs) and says so; it never aborts.
    """
    marker = target / ".vonk-prewarmed"
    if not source.is_dir() or marker.exists():
        return
    try:
        target.mkdir(parents=True, exist_ok=True)
        shutil.copytree(source, target, dirs_exist_ok=True)
        marker.write_text("seeded\n", encoding="utf-8")
    except OSError as error:
        print(
            f"sglang-serve: warning: pre-warmed cache {source} was not seeded "
            f"({error}); starting without it",
            file=sys.stderr,
            flush=True,
        )


def main() -> None:
    arguments = sys.argv[1:]
    if str(MODEL) not in arguments or not (MODEL / "config.json").is_file():
        raise SystemExit("the immutable /models checkpoint is required")
    seed(PREWARM / "sglang", Path(os.environ["HOME"]) / ".cache" / "sglang")
    seed(PREWARM / "triton", Path(os.environ["TRITON_CACHE_DIR"]))
    os.execv(sys.executable, (sys.executable, "-m", "sglang.launch_server", *arguments))


if __name__ == "__main__":
    main()
