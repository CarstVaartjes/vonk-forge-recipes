{
  "kit": {
    "dependencies": {
      "draft": {
        "binds": "draft",
        "datasource": "hf-revision",
        "file": "scripts/env.sh",
        "pattern": "^: \"\\$\\{DRAFT_REV:=(?P<version>[0-9a-f]{40})\\}\"$",
        "repo_pattern": "^: \"\\$\\{DRAFT_REPO:=(?P<repo>[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)\\}\"$"
      },
      "image": {
        "datasource": "oci-image",
        "file": "scripts/env.sh",
        "pattern": "^: \"\\$\\{BASE_IMAGE:=lmsysorg/sglang:[A-Za-z0-9_.-]+@(?P<version>sha256:[0-9a-f]{64})\\}\"$",
        "repo": "docker.io/lmsysorg/sglang"
      },
      "model": {
        "binds": "primary",
        "datasource": "hf-revision",
        "file": "scripts/env.sh",
        "pattern": "^: \"\\$\\{MODEL_REV:=(?P<version>[0-9a-f]{40})\\}\"$",
        "repo_pattern": "^: \"\\$\\{MODEL_REPO:=(?P<repo>[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)\\}\"$"
      }
    }
  },
  "ours": [
    "sglang-serve",
    "scan-sm121.py",
    "docker/patches/README.md",
    "docker/patches/sglang-v0.5.22/0009-dflash-sampling-no-flashinfer.patch"
  ],
  "source": {
    "commit": "362fe245bc1ddd4de7bc50870ebfe3b0cb8ceb34",
    "repo": "vcruz305/GLM-5.3-Flash-EXL3-SAGE-SGLang-Spark-recipe"
  }
}
