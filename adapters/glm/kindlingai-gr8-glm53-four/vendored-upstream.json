{
  "kit": {
    "dependencies": {
      "drafter": {
        "binds": "drafter",
        "datasource": "hf-revision",
        "file": ".env.example",
        "pattern": "^DRAFTER=https://huggingface\\.co/(?P<repo>[\\w.-]+/[\\w.-]+)@(?P<version>[0-9a-f]{40})\\s*$"
      },
      "image": {
        "datasource": "oci-image",
        "file": "compose.yaml",
        "pattern": "^\\s+image: \\$\\{GR8_IMAGE:-ghcr\\.io/kindlingai/gr8:[\\w.-]+@(?P<version>sha256:[0-9a-f]{64})\\}\\s*$",
        "repo": "ghcr.io/kindlingai/gr8"
      },
      "model": {
        "binds": "primary",
        "datasource": "hf-revision",
        "file": ".env.example",
        "pattern": "^MODEL=https://huggingface\\.co/(?P<repo>[\\w.-]+/[\\w.-]+)@(?P<version>[0-9a-f]{40})\\s*$"
      }
    }
  },
  "ours": [
    "gr8-serve",
    "licenses/"
  ],
  "source": {
    "commit": "8ffb1e06ea4e195e5fcbae0314dbc1c271b9987d",
    "repo": "kindlingai/glm-5.3-exlr8-4x-spark"
  }
}
