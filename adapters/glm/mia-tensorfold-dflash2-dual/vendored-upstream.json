{
  "kit": {
    "dependencies": {
      "drafter": {
        "binds": "drafter",
        "datasource": "hf-revision",
        "file": "scripts/config.sh",
        "pattern": "^_rev=\\\"\\\"; \\[\\[ \\\"\\$DFLASH2_ID\\\" == (?P<repo>[\\w.-]+/[\\w.-]+) \\]\\] && _rev=(?P<version>[0-9a-f]{40})$"
      },
      "image": {
        "datasource": "oci-image",
        "file": "scripts/config.sh",
        "pattern": "^IMAGE_DIGEST=\\\"\\$\\{IMAGE_DIGEST:-(?P<version>sha256:[0-9a-f]{64})\\}\\\"$",
        "repo_pattern": "^GHCR_IMAGE=\\\"\\$\\{GHCR_IMAGE:-(?P<repo>[^}\\\"\\s]+)\\}\\\"$"
      },
      "model": {
        "binds": "primary",
        "datasource": "hf-revision",
        "file": "scripts/config.sh",
        "pattern": "^\\s*(?P<repo>[\\w.-]+/[\\w.-]+(?<!-Ablit))\\) _rev=(?P<version>[0-9a-f]{40}) ;;$"
      }
    }
  },
  "ours": [
    "licenses/",
    "tensorfold-serve"
  ],
  "source": {
    "commit": "3fd60dfc836fab0f1ed0fd4f0afaf2a1d62b2aab",
    "repo": "MiaAI-Lab/GLM-5.3-Flash-EXL3-2x-DGX-Sparks-TensorFold"
  }
}
