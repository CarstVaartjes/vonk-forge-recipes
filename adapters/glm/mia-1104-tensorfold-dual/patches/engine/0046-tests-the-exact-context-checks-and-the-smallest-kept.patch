From 112c7ac7624333033be1664024089e663f995caf Mon Sep 17 00:00:00 2001
From: MiaAI-Lab <mia.ailab1@gmail.com>
Date: Fri, 30 Oct 2026 19:37:43 +0200
Subject: [PATCH 46/63] tests: the exact-context checks and the smallest kept
 state follow the verify window's rows (W16 beside mem3)

mem3's checks of a request at exactly --context (cuda_pages_test, glm_fp8_pages_host) wrote the verify window as 8
rows; with draft2's 16-row windows (cuda_state.window_rows) the capacity is context + 16 rounded up to 64, and a
paged stream leases prompt + reply + 16 rows. They now take window_rows: the fp8 pages test opens 8,000 + the rest of
8,192 less a window on its 16 pages and refuses one more token, and the capacity test adds the context that makes
context + a window exactly 8,192. glm_snapshot_host pins the smallest TP2 state at 256K: 16-row windows double the
KDA layers' window saves every state carries, 203,423,744 -> 222,298,112 bytes (+18 MiB, measured on the branch with
W16 alone too).

---
 zig/glm_fp8_pages_host.zig               | 15 +++++++++------
 zig/glm_snapshot_host.zig                |  3 ++-
 zig/src/families/glm/cuda_pages_test.zig |  9 +++++----
 3 files changed, 16 insertions(+), 11 deletions(-)

diff --git a/zig/glm_fp8_pages_host.zig b/zig/glm_fp8_pages_host.zig
index 80592316..91740ce8 100644
--- a/zig/glm_fp8_pages_host.zig
+++ b/zig/glm_fp8_pages_host.zig
@@ -464,9 +464,11 @@ test "GLM FP8 pages: a begin that fails on rank 0 after its step went out frees
     try t.expect(!g.p.used[slot] and f.p.pool.idle() and f.census().free == 8);
 }
 
-test "GLM FP8 pages: a request exactly at --context opens (8,000 + 184 at 8,184), one token past it is PromptTooLong" {
+test "GLM FP8 pages: a request exactly at --context opens (8,000 + the rest of 8,192 less a window), one token past it is PromptTooLong" {
+    const window: u32 = glm.native.window_rows; // a verify window's rows (8; 16 with W16's windows)
+    const context = 8192 - window; // + a verify window: 8,192 rows, already a multiple of 64
     var f: Fixture = undefined;
-    try f.prepare(false, glm.native.capacity(8184)); // 8,184 + a verify window: 8,192 rows, already a multiple of 64
+    try f.prepare(false, glm.native.capacity(context));
     try t.expectEqual(@as(usize, 8192), f.e.capacity);
     const l = try glm.pages.layout(t.allocator, &f.e, 0);
     f.p = try glm.pages.Pages.init(t.allocator, &f.e, l, 2, 16, true);
@@ -484,14 +486,15 @@ test "GLM FP8 pages: a request exactly at --context opens (8,000 + 184 at 8,184)
     defer t.allocator.free(prompt);
     @memset(prompt, 7);
     const b = back.backend();
-    for ([_]u32{ 184, 185 }) |max_new| {
+    const fits = context - 8000;
+    for ([_]u32{ fits, fits + 1 }) |max_new| {
         var stream = try lanes.Stream.init(t.allocator, .{ .id = "fp8-context-test", .prompt = prompt, .max_new = max_new });
         defer stream.deinit(t.allocator);
-        // 8,000 + 184 + 8 == 8,192: its 16 pages taken, then the begin step; 8,000 + 185 is refused before any page
-        try t.expectError(if (max_new == 184) error.TooManyIds else error.PromptTooLong, b.vtable.prefill_step.?(b.ptr, &stream));
+        // 8,000 + fits + a window == 8,192: its 16 pages taken, then the begin step; one more is refused before any page
+        try t.expectError(if (max_new == fits) error.TooManyIds else error.PromptTooLong, b.vtable.prefill_step.?(b.ptr, &stream));
         try t.expect(f.p.pool.idle() and f.census().free == 16 and back.lanes.count() == 0);
     }
-    try t.expectEqual(@as(usize, 16), glm.pages.need(l, 8000, 184)); // the table's every entry: the pool's whole
+    try t.expectEqual(@as(usize, 16), glm.pages.need(l, 8000, fits)); // the table's every entry: the pool's whole
 }
 
 test "GLM FP8 pages: a refused table upload cancels the lease, and a retry takes and returns every page" {
diff --git a/zig/glm_snapshot_host.zig b/zig/glm_snapshot_host.zig
index f6fc15e7..aee61b24 100644
--- a/zig/glm_snapshot_host.zig
+++ b/zig/glm_snapshot_host.zig
@@ -448,7 +448,8 @@ test "GLM snapshots: 0.3 GiB fits the first default TP2 prefix at 256K but not a
     e.capacity = seq.st.capacity;
     const minimum = glm.native.snap_min_bytes(&e);
     const budget: u64 = 322122547;
-    try t.expectEqual(@as(u64, 203423744), minimum);
+    // 203,423,744 at 8-row windows; W16's 16-row windows double the KDA layers' window saves a state carries (+18 MiB)
+    try t.expectEqual(@as(u64, if (glm.forward.window_rows == 16) 222298112 else 203423744), minimum);
     try t.expect(minimum <= budget);
     try t.expect(glm.native.snap_bytes(&e, 34816) > budget);
 }
diff --git a/zig/src/families/glm/cuda_pages_test.zig b/zig/src/families/glm/cuda_pages_test.zig
index ede81b1a..080b0778 100644
--- a/zig/src/families/glm/cuda_pages_test.zig
+++ b/zig/src/families/glm/cuda_pages_test.zig
@@ -339,17 +339,18 @@ test "TF_KV_PAGES on a model of KDA layers alone without the MTP head: nothing t
 
 test "capacity keeps a request exactly at --context: prompt + max_tokens == context passes the opening and prompt checks" {
     const native = @import("cuda_native.zig");
-    for ([_]usize{ 8184, 8192, 8191, 245_760, 864_256, 1_048_576 }) |context| {
+    const window: usize = @import("cuda_state.zig").window_rows; // a verify window's rows past the reply (8, or 16 with W16)
+    for ([_]usize{ 8192 - window, 8184, 8192, 8191, 245_760, 864_256, 1_048_576 }) |context| {
         const cap = native.capacity(context);
         for ([_]usize{ 1, 184, context / 2 }) |max_new| {
             const prompt = context - max_new;
             try expect(Lanes.fitsContext(prompt, max_new, cap));
-            const rows = pages_mod.tableLen(prompt + max_new + 8) * @import("cuda_state.zig").page_rows; // its pages' rows
+            const rows = pages_mod.tableLen(prompt + max_new + window) * @import("cuda_state.zig").page_rows; // its pages' rows
             try expect(Engine.promptFits(prompt, @min(rows, cap))); // a paged stream's capacity (Pages.mapped)
             try expect(Engine.promptFits(prompt + max_new, cap)); // a prompt-only turn at the context too
         }
-        try expect(!Lanes.fitsContext(cap - 8, 1, cap)); // a window past the capacity
-        try expect(!Engine.promptFits(cap - 7, cap));
+        try expect(!Lanes.fitsContext(cap - window, 1, cap)); // a window past the capacity
+        try expect(!Engine.promptFits(cap - window + 1, cap));
         try expect(!Engine.promptFits(0, cap));
     }
 }
