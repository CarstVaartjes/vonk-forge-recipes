From c82ae8938964c139b8d18db216dfa9fa8dbef27a Mon Sep 17 00:00:00 2001
From: MiaAI-Lab <mia.ailab1@gmail.com>
Date: Fri, 30 Oct 2026 18:21:04 +0200
Subject: [PATCH 33/63] tests: GLM TP3's KDA projections record the f_b + g_b
 pair launch, and find it only on tiled decode windows

test-glm-tp3-host no longer compiled: its hand-built mm.Kernels lacked packed_prompt (the two-stage prompt kernels)
and pair (glm_mm*_16x2). The recording driver now takes the pair kernel's launch as its two problems, so every
weight's rows, strides and widths are checked as before, and the test asserts the pair fires exactly on an aligned
(tiled) stack's decode window of up to 16 rows: an uneven (row-major) KDA stack never takes it. 9/9; with
project's tiledInput guard removed it fails.

---
 zig/src/families/glm/cuda_kda_tp3_test.zig | 16 ++++++++++++++--
 1 file changed, 14 insertions(+), 2 deletions(-)

diff --git a/zig/src/families/glm/cuda_kda_tp3_test.zig b/zig/src/families/glm/cuda_kda_tp3_test.zig
index 252757ef..f4b63414 100644
--- a/zig/src/families/glm/cuda_kda_tp3_test.zig
+++ b/zig/src/families/glm/cuda_kda_tp3_test.zig
@@ -10,6 +10,7 @@ const Capture = struct {
     const Call = struct { id: usize, x: u64, w: u64, ldx: u64, n: u64, k: u64, rows: u64 };
     var calls: [32]Call = undefined;
     var count: usize = 0;
+    var pairs: usize = 0;
     fn arg(args: ?[*]?*anyopaque, index: usize, wide: bool) u64 {
         const p: [*]const u8 = @ptrCast(args.?[index].?);
         return if (wide) std.mem.readInt(u64, p[0..8], .little) else std.mem.readInt(u32, p[0..4], .little);
@@ -17,6 +18,14 @@ const Capture = struct {
     fn launch(f: cuda.abi.Function, _: c_uint, _: c_uint, _: c_uint, _: c_uint, _: c_uint, _: c_uint, _: c_uint, _: cuda.abi.Stream, args: ?[*]?*anyopaque, _: ?[*]?*anyopaque) callconv(.c) cuda.abi.Result {
         const id = @intFromPtr(f);
         if (id == 3 or id == 6) return cuda.abi.success;
+        if (id == 7) { // glm_mm*_16x2 (matmulPair): f_b and g_b in one launch, recorded as its two problems
+            pairs += 1;
+            for (0..2) |z| {
+                calls[count] = .{ .id = id, .x = arg(args, z, true), .w = arg(args, 3 + z, true), .ldx = arg(args, 2, true), .n = arg(args, 11, false), .k = arg(args, 12, false), .rows = arg(args, 10, false) };
+                count += 1;
+            }
+            return cuda.abi.success;
+        }
         const tiled = id == 1 or id == 2;
         const row = id == 5;
         calls[count] = .{
@@ -43,7 +52,7 @@ test "GLM TP3: real KDA projections accept uneven shares and retain aligned tile
     var d: cuda.Driver = undefined;
     d.api.cuLaunchKernel = Capture.launch;
     const stream: cuda.Stream = .{ .d = &d, .handle = null };
-    var kernels: mm.Kernels = .{ .by_rows = @splat(function(&d, 1)), .prompt = function(&d, 2), .reduce = function(&d, 3), .pdl = false, .packed_rows = undefined, .tile = undefined, .tile_packed = undefined };
+    var kernels: mm.Kernels = .{ .by_rows = @splat(function(&d, 1)), .prompt = function(&d, 2), .reduce = function(&d, 3), .pdl = false, .packed_rows = undefined, .packed_prompt = undefined, .pair = @splat(function(&d, 7)), .tile = undefined, .tile_packed = undefined };
     var raw: glue.Kernels = undefined;
     raw.bmm_decode = function(&d, 4);
     raw.bmm_rows = function(&d, 5);
@@ -57,6 +66,7 @@ test "GLM TP3: real KDA projections accept uneven shares and retain aligned tile
         if (world == 3) try std.testing.expectEqual(@as(usize, if (rank == 0) 8726 else 8341), width);
         for ([_]usize{ 1, 17, 64, 65, 127, 128, 2066 }) |rows| for ([_]bool{ false, true }) |prompt| {
             Capture.count = 0;
+            Capture.pairs = 0;
             try kda.project(.{ .glue = &raw, .mm = &kernels, .prompt = prompt }, stream, l, scratch, 0x900000000, c.hidden, rows);
             const weights = [_]u64{ l.proj.bf16, l.fb, l.gb };
             const xs = [_]u64{ 0x900000000, scratch.p + 3 * l.heads * 128 * 2, scratch.p + (3 * l.heads * 128 + 128) * 2 };
@@ -65,11 +75,13 @@ test "GLM TP3: real KDA projections accept uneven shares and retain aligned tile
             const ks = [_]usize{ c.hidden, 128, 128 };
             const per: usize = if (aligned and !prompt and rows > 64 and rows < 128) 2 else 1;
             try std.testing.expectEqual(3 * per, Capture.count);
+            // a tiled decode window of up to 16 rows takes f_b and g_b in one launch; a row-major (uneven) stack never
+            try std.testing.expectEqual(@intFromBool(aligned and !prompt and rows <= 16), Capture.pairs);
             for (weights, xs, strides, ns, ks) |w, x, stride, n, k| {
                 var done: usize = 0;
                 var found: usize = 0;
                 for (Capture.calls[0..Capture.count]) |call| if (call.w == w) {
-                    try std.testing.expectEqual(aligned, call.id == 1 or call.id == 2);
+                    try std.testing.expectEqual(aligned, call.id == 1 or call.id == 2 or call.id == 7);
                     try std.testing.expectEqual(x + done * stride * 2, call.x);
                     try std.testing.expectEqual(@as(u64, stride), call.ldx);
                     try std.testing.expectEqual(@as(u64, n), call.n);
-- 
