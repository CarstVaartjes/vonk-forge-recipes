diff --git a/zig/tests/cuda/glm_solo_tests.zig b/zig/tests/cuda/glm_solo_tests.zig
new file mode 100644
index 000000000..97b6164b5
--- /dev/null
+++ b/zig/tests/cuda/glm_solo_tests.zig
@@ -0,0 +1,189 @@
+//! GLM-5.3-Flash's busy prompt steps (TF_GLM_CHUNK_SOLO=4096: TF_GLM_CHUNK rows of a chunk a step beside a decoding
+//! stream) against twins a whole chunk a step, on one Engine and its ranks. Adapted from upstream's glm_solo_tests
+//! (#1823), whose solo pass doubles a 2,048-row grid; here the grid is 4,096 and the busy step divides it.
+
+const std = @import("std");
+const cuda = @import("cuda");
+const check = @import("check.zig");
+const Gpu = check.Gpu;
+
+/// The marks a twin's prompt pass stood at (Marks.call), in order: both twins must keep states at the same chunks.
+const Kept = struct {
+    at: std.ArrayList(u32) = .empty,
+    gpa: std.mem.Allocator,
+
+    fn call(ctx: *anyopaque, at: u32) void {
+        const k: *Kept = @ptrCast(@alignCast(ctx));
+        k.at.append(k.gpa, at) catch {};
+    }
+};
+
+/// The KDA records' copy a state reads next (State.cur), both copies cleared in `bytes`: every prompt pass writes the
+/// other copy and flips (cuda_forward line "a prompt chunk keeps every row: the layer commits now"), so after a prompt
+/// the stale copy holds the state before the last pass, which a decode window never reads (it reads recAt(cur) and
+/// replays from it into 1 - cur). Twins that took a different number of passes differ there and in `cur` legitimately;
+/// upstream's glm_solo_tests does the same.
+fn takeRecords(a: std.mem.Allocator, st: anytype, bytes: []u8) ![]const u8 {
+    const at = st.rec - st.arena.buf.ptr;
+    const one = st.kda_layers * st.rec_layer;
+    const out = try a.alloc(u8, one);
+    for (0..st.kda_layers) |li| { // each layer's current copy (State.cur is per layer)
+        const cur: usize = st.cur[li];
+        @memcpy(out[li * st.rec_layer ..][0..st.rec_layer], bytes[at + cur * one + li * st.rec_layer ..][0..st.rec_layer]);
+    }
+    @memset(bytes[at..][0 .. 2 * one], 0);
+    return out;
+}
+
+/// The state field a byte offset into the arena falls in, so a differing byte names its region.
+fn region(st: anytype, offset: usize) []const u8 {
+    const base = st.arena.buf.ptr;
+    var name: []const u8 = "before the first field";
+    var best: usize = 0;
+    const fixed = [_]struct { []const u8, u64 }{
+        .{ "pos", st.pos_dev },                      .{ "KDA conv windows", st.conv },                         .{ "KDA records (both copies)", st.rec },
+        .{ "KDA proj (window)", st.proj },           .{ "KDA save_k (window)", st.save_k },                    .{ "KDA save_v (window)", st.save_v },
+        .{ "KDA save_g (window)", st.save_g },       .{ "KDA save_b (window)", st.save_b },                    .{ "MTP latent rows", st.mtp_caches.lc },
+        .{ "MTP index-key ring", st.mtp_caches.ik }, .{ "MTP index-gate ring", st.mtp_caches.ig },             .{ "MTP pooled keys", st.mtp_caches.pk },
+        .{ "MTP position", st.mtp_pos_dev },         .{ "prompt hidden (first-draft row)", st.prompt_hidden },
+    };
+    for (fixed) |f| {
+        if (f[1] >= base and f[1] - base <= offset and f[1] - base >= best) {
+            best = f[1] - base;
+            name = f[0];
+        }
+    }
+    for (st.caches) |c| {
+        const layer = [_]struct { []const u8, u64 }{ .{ "DSA latent rows", c.lc }, .{ "DSA index-key ring", c.ik }, .{ "DSA index-gate ring", c.ig }, .{ "DSA pooled keys", c.pk } };
+        for (layer) |f| {
+            if (f[1] >= base and f[1] - base <= offset and f[1] - base >= best) {
+                best = f[1] - base;
+                name = f[0];
+            }
+        }
+    }
+    return name;
+}
+
+/// `glm-solo-check`: prompts a step at a time, busy (as beside a decoding stream) and whole; first token, next window
+/// and every state byte equal (the KDA records' stale copy and parity aside), and the kept-state marks called at the
+/// same chunks.
+pub fn soloCheck(gpu: Gpu, checkpoint: []const u8, dc_path: []const u8, rank: c_int, world: c_int, id_path: []const u8) !void {
+    const glm = @import("glm_cuda");
+    var arena = std.heap.ArenaAllocator.init(gpu.gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const dc = try std.json.parseFromSliceLeaky(struct { capacity: usize = 8192 }, a, try std.Io.Dir.cwd().readFileAlloc(gpu.io, dc_path, a, .limited(1 << 26)), .{ .ignore_unknown_fields = true });
+    var lib = try cuda.nccl.Library.open();
+    defer lib.close();
+    const comm = try @import("glm_lanes_tests.zig").openComm(gpu, &lib, rank, world, id_path);
+    defer _ = lib.api.ncclCommDestroy(comm);
+    var problem: []const u8 = "";
+    var set = glm.ranks.Settings.read(&glm.ranks.environment, &problem) catch |err| {
+        std.debug.print("REFUSE {s}\n", .{problem});
+        return err;
+    };
+    try check.expect(set.chunk != 0, "glm-solo-check needs TF_GLM_CHUNK_SOLO=4096 (and TF_GLM_CHUNK=2048 or 1024)", .{});
+    set.pair = false; // twin 0 is a whole chunk a step, not a pair (glm-pair-check covers pairs), so no twin buffers
+    const C = glm.engine.prompt_rows;
+    const B: usize = set.chunk;
+    const capacity = @max(dc.capacity, 6 * C);
+    const e = try glm.engine.Engine.init(gpu.gpa, gpu.io, gpu.d, gpu.ctx, checkpoint, &lib, comm, @intCast(rank), @intCast(world), .{ .capacity = capacity, .drafts = true, .settings = set });
+    defer e.deinit();
+    var link = try glm.follow.Link.init(gpu.gpa, gpu.d, &lib, comm, e.stream, capacity);
+    defer link.deinit();
+    if (rank != 0) {
+        try glm.follow.follow(e, &link);
+        check.pass("rank {d} followed rank 0's busy and whole prompt steps to the end", .{rank});
+        return;
+    }
+    const x: glm.follow.Leader = .{ .e = e, .link = &link };
+    defer x.end() catch {};
+    const V = e.share.vocab.len();
+    const Case = struct { len: usize, marks: []const u32 = &.{} };
+    const cases = [_]Case{
+        .{ .len = 2 * C + 300 }, // two chunks in busy steps and a short tail
+        .{ .len = B + 1 }, // a busy step, then one row ends the prompt
+        .{ .len = B }, // one busy step to the end
+        .{ .len = C + 1 }, // a chunk's busy steps, then one row
+        .{ .len = 3 * C }, // three chunks, the ring's first rebase at chunk 2
+        .{ .len = 2 * C }, // a ring's worth, no rebase
+        .{ .len = 5 * C + 7 }, // rebases at chunks 2 and 4, inside busy steps
+        .{ .len = 4 * C, .marks = &.{ C, 3 * C } }, // kept states at chunks 1 and 3: the mark is called where the chunk starts
+    };
+    var failed = false;
+    const slots: [2]u32 = .{ 1, 2 }; // slot 0 stays the engine's own; both twins' freed after each prompt
+    for (cases, 0..) |case, i| {
+        const len = case.len;
+        const ids = try a.alloc(u32, len);
+        for (ids, 0..) |*u, j| u.* = @intCast(100 + (j * 7919 + i * 31) % 5000);
+        var firsts: [2]u32 = undefined;
+        var outs: [2][4]u32 = undefined;
+        var logits: [2][]u16 = undefined;
+        var busy: [2]u64 = undefined;
+        var kept: [2]Kept = .{ .{ .gpa = a }, .{ .gpa = a } };
+        for (0..2) |twin| { // twin 0 a whole chunk a step (solo), twin 1 busy steps where it can (beside a decoder)
+            const marks: ?glm.engine.Marks = if (case.marks.len == 0) null else .{ .at = case.marks, .ctx = &kept[twin], .call = Kept.call };
+            try x.bind(slots[twin]);
+            try x.begin(null);
+            const before = e.busy_steps;
+            var at: usize = 0;
+            const t = while (true) {
+                const r = x.chunk(ids, at, twin == 0, null, null, marks) catch |err| {
+                    std.debug.print("FAIL solo: prompt of {d}, twin {d}: the step at {d}: {s}\n", .{ len, twin, at, @errorName(err) });
+                    return err;
+                };
+                if (r.first) |f| break f;
+                at += r.rows;
+            };
+            busy[twin] = e.busy_steps - before;
+            firsts[twin] = t;
+            const win = [_]u32{ t, 101, 202, 303 };
+            try x.verify(&win, &outs[twin], 0);
+            logits[twin] = try a.alloc(u16, win.len * V);
+            try gpu.d.check(gpu.d.api.cuMemcpyDtoH_v2(logits[twin].ptr, e.bd.logits, win.len * V * 2), "cuMemcpyDtoH");
+        }
+        const st = &e.seqs.items[slots[0]].?.st;
+        const tw = &e.seqs.items[slots[1]].?.st;
+        var want: u64 = 0; // the busy steps prompt_solo.busyAt allows over this prompt, the rings' base followed here
+        var base: usize = 0;
+        var at: usize = 0;
+        while (at < len) {
+            const rows = @min(len - at, C);
+            if (glm.prompt_solo.ringsAgree(base, st.ring_rows, at, rows, B)) {
+                want += (rows + B - 1) / B; // every step of the chunk is busy, the last one short
+            }
+            if (at + rows > base + st.ring_rows) base = at; // State.ready rebases at the step's start, a whole pool
+            at += rows;
+        }
+        if (busy[0] != 0 or busy[1] != want) {
+            std.debug.print("FAIL solo: prompt of {d}: {d} busy steps a whole chunk a step, {d} busy (want {d})\n", .{ len, busy[0], busy[1], want });
+            failed = true;
+        }
+        if (!std.mem.eql(u32, kept[0].at.items, kept[1].at.items)) {
+            std.debug.print("FAIL solo: prompt of {d}: the marks were called at {any} whole, {any} busy\n", .{ len, kept[0].at.items, kept[1].at.items });
+            failed = true;
+        }
+        if (firsts[0] != firsts[1] or !std.mem.eql(u32, &outs[0], &outs[1]) or !std.mem.eql(u16, logits[0], logits[1])) {
+            std.debug.print("FAIL solo: prompt of {d}: first {d}/{d}, the next window's tokens or logits differ\n", .{ len, firsts[0], firsts[1] });
+            failed = true;
+        }
+        try e.stream.synchronize();
+        const n = st.arena.buf.len;
+        const h0 = try a.alloc(u8, n);
+        const h1 = try a.alloc(u8, n);
+        try st.arena.buf.download(0, h0);
+        try tw.arena.buf.download(0, h1);
+        const r0 = try takeRecords(a, st, h0);
+        const r1 = try takeRecords(a, tw, h1);
+        const diff = std.mem.indexOfDiff(u8, h0, h1);
+        if (st.pos != tw.pos or st.mtp_len != tw.mtp_len or st.base != tw.base or st.mtp_base != tw.mtp_base or !std.mem.eql(u8, r0, r1) or diff != null) {
+            std.debug.print("FAIL solo: prompt of {d}: the busy state differs (pos {d}/{d}, rings' base {d}/{d}, MTP base {d}/{d}, KDA records {s}, first byte {?d} of {d} in {s})\n", .{ len, st.pos, tw.pos, st.base, tw.base, st.mtp_base, tw.mtp_base, if (std.mem.eql(u8, r0, r1)) "equal" else "DIFFER", diff, n, if (diff) |o| region(tw, o) else "-" });
+            failed = true;
+        }
+        try x.release(slots[0]);
+        try x.release(slots[1]);
+    }
+    if (failed) return error.TestFailed;
+    check.pass("busy prompt steps of {d} rows at TP={d}: {d} prompts, one with kept states at chunks 1 and 3, equal their twins a whole chunk a step in the first token, the next window's logits and tokens, the rings' bases, the MTP base, the marks called, the KDA records read next and every other state byte", .{ B, world, cases.len });
+}
