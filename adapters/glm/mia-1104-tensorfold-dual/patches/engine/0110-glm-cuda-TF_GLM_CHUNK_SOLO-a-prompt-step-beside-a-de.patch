index 000000000..ca13efb84
--- /dev/null
+++ b/zig/src/families/glm/cuda_prompt_solo.zig
@@ -0,0 +1,146 @@
+//! A prompt step beside a decoding stream (TF_GLM_CHUNK_SOLO=4096): TF_GLM_CHUNK rows of the 4,096-row chunk a step,
+//! so a stream decoding beside a long prompt waits on a shorter pass; alone, a step takes the whole chunk (or a pair,
+//! cuda_prompt_pair).
+//!
+//! Upstream main (#1823, option C of #1554) grows its 2,048-row grid to a 4,096-row pass while no other stream
+//! decodes. This tree's grid is already 4,096 (patches 0094/0095: the chunk kept prompt states are cut on, the index
+//! rings' half, the prompt buffers' rows), so the same observable behaviour comes from the other side: the grid, the
+//! rings, the buffers and the kept-state cuts stay at 4,096, and a step beside decoders takes a part of a chunk. No
+//! buffer grows for it, so upstream's refusal beside --drafter has no counterpart here: DFlash2 ingests each step's
+//! rows as it does a paired step's second chunk (dflash.promptRun keeps a step's rows from len - WIN on, whatever its
+//! width).
+const std = @import("std");
+const fw = @import("cuda_forward.zig");
+const engine = @import("cuda_engine.zig");
+const Engine = engine.Engine;
+
+/// The rows a step beside a decoding stream may take (TF_GLM_CHUNK): each divides the chunk, so every step of a split
+/// chunk but the prompt's last ends on the TF_GLM_CHUNK grid and a whole chunk can start at every chunk boundary.
+pub const choices = [_]u32{ 2048, 1024 };
+/// TF_GLM_CHUNK's default under TF_GLM_CHUNK_SOLO=4096: half a chunk, upstream's own busy pass.
+pub const default_rows: u32 = 2048;
+
+/// Whether `rows` is one of `choices`.
+pub fn valid(rows: u32) bool {
+    return std.mem.indexOfScalar(u32, &choices, rows) != null;
+}
+
+/// The chunk (grid point) a step at `start` belongs to.
+pub fn chunkAt(start: usize) usize {
+    return start / fw.prefill_rows * fw.prefill_rows;
+}
+
+/// That chunk's rows in a `len`-id prompt (the prompt's last chunk may be short).
+pub fn chunkRows(start: usize, len: usize) usize {
+    return @min(len - chunkAt(start), fw.prefill_rows);
+}
+
+/// Whether steps of `busy` rows over the chunk at `c` (`rows` rows) rebase the index rings where one whole chunk does:
+/// at the chunk's start (its first step overflows the ring, as the whole chunk would) or not at all. Otherwise a later
+/// step would rebase part way into the chunk, and the DSA pools would be read from another base than a whole chunk's.
+pub fn ringsAgree(base: usize, ring: usize, c: usize, rows: usize, busy: usize) bool {
+    return c + busy > base + ring or c + rows <= base + ring;
+}
+
+/// The rows a busy step at `start` of a `len`-id prompt takes.
+pub fn rowsAt(start: usize, len: usize, busy: usize) usize {
+    return @min(len - start, busy);
+}
+
+/// Rank 0's choice for the step at `start` (the others take the ids it sends and the chunk's flag 4): a busy step when
+/// the setting is on, another stream decodes (`solo` false) and nothing reads a chunk's rows. Off the chunk grid the
+/// step is a busy one whatever `solo`: a chunk split into busy steps is finished in them, as no whole chunk starts there.
+pub fn busyAt(e: *const Engine, start: usize, len: usize, solo: bool, from: ?engine.Resume) bool {
+    const busy: usize = e.settings.chunk;
+    if (busy == 0 or start >= len) return false;
+    if (start % fw.prefill_rows != 0) return true;
+    if (solo or e.prompt_logprobs != null or e.prompt_profs[3] != null) return false;
+    if (e.images) |v| if (v.rowCount() > 0) return false;
+    // a resumed step restores its kept state, and the rings' base, after this choice
+    const base = if (from) |r| (e.snaps.get(r.id) orelse return false).bases[0] else e.cur.st.base;
+    return ringsAgree(base, e.cur.st.ring_rows, start, chunkRows(start, len), busy);
+}
+
+/// `busyAt`'s rule on every rank, its kept state restored: whether a busy step at `start` may run. A step continuing a
+/// split chunk passes by construction (its first step either rebased at the chunk's start or the whole chunk fits).
+pub fn allowed(e: *const Engine, start: usize, len: usize) bool {
+    const busy: usize = e.settings.chunk;
+    if (busy == 0 or start >= len or start % busy != 0 or e.prompt_logprobs != null) return false;
+    return ringsAgree(e.cur.st.base, e.cur.st.ring_rows, chunkAt(start), chunkRows(start, len), busy);
+}
+
+/// The rows one MTP head pass takes over a prompt step's `nxt` ids: with the setting on, TF_GLM_CHUNK rows, so a whole
+/// chunk's head passes are the same passes a split chunk's steps make and the head's index ring rebases (State.readyMtp,
+/// at mtp_len - window_rows when a pass would overflow it) at the same rows either way; off, the step's rows in one.
+pub fn mtpPiece(e: *const Engine, nxt: usize) usize {
+    return if (e.settings.chunk != 0) @min(nxt, @as(usize, e.settings.chunk)) else nxt;
+}
+
+/// decode._absorb_rows of a prompt step: the MTP head over its next ids `nxt` on its final-norm rows `hidden` (row i for
+/// nxt[i]), mtpPiece rows a pass, mtp_len advanced after each (upstream's mtpRows, in this tree's direction). Beside a
+/// drafter the head's caches are never read, so nothing runs (cuda_engine's note).
+pub fn mtpRows(e: *Engine, f: *fw.Forward, nxt: []const i32, hidden: u64) !void {
+    if (!e.mtp or e.drafter != null or nxt.len == 0) return;
+    const mp = f.prof;
+    defer f.prof = mp;
+    f.prof = null; // the head's passes as one section
+    var done: usize = 0;
+    while (done < nxt.len) {
+        const piece = nxt[done .. done + mtpPiece(e, nxt.len - done)];
+        try f.mtp(piece, &.{hidden + done * e.c.hidden * 2});
+        try e.cur.st.setMtpLen(e.stream, e.cur.st.mtp_len + piece.len);
+        done += piece.len;
+    }
+}
+
+test "a busy step belongs to the chunk it starts in, and takes its rows to the chunk's end or the prompt's" {
+    const C = fw.prefill_rows;
+    try std.testing.expectEqual(@as(usize, 0), chunkAt(0));
+    try std.testing.expectEqual(@as(usize, 0), chunkAt(C / 2));
+    try std.testing.expectEqual(@as(usize, 2 * C), chunkAt(2 * C + 1024));
+    try std.testing.expectEqual(@as(usize, C), chunkRows(C / 2, 3 * C));
+    try std.testing.expectEqual(@as(usize, 300), chunkRows(2 * C, 2 * C + 300)); // the prompt's last chunk
+    try std.testing.expectEqual(@as(usize, 1324), chunkRows(2 * C + 1024, 2 * C + 1324)); // the chunk's, not the step's
+    try std.testing.expectEqual(@as(usize, 2048), rowsAt(0, 3 * C, 2048));
+    try std.testing.expectEqual(@as(usize, 300), rowsAt(2 * C + 2048, 2 * C + 2348, 2048)); // a short last step
+    try std.testing.expectEqual(@as(usize, 1024), rowsAt(C + 3072, 3 * C, 1024));
+}
+
+test "busy steps rebase the index rings where a whole chunk does: at its start, or not at all" {
+    const C = fw.prefill_rows;
+    const R = 2 * C; // cuda_state.index_ring
+    try std.testing.expect(ringsAgree(0, R, 0, C, C / 2)); // neither rebases
+    try std.testing.expect(ringsAgree(0, R, C, C, C / 2)); // neither: the second chunk fits the ring
+    try std.testing.expect(ringsAgree(0, R, 2 * C, C, C / 2)); // both at the chunk's start: its first step overflows
+    try std.testing.expect(ringsAgree(0, R, 2 * C, C, C / 4));
+    try std.testing.expect(ringsAgree(2 * C, R, 3 * C, C, C / 2)); // neither, after a rebase at chunk 2
+    try std.testing.expect(!ringsAgree(0, R - C / 2, C, C, C / 2)); // a ring the whole chunk overflows but its first half fits: a step part way would rebase
+    try std.testing.expect(ringsAgree(0, R - C / 2, C, C / 2, C / 2)); // a half-chunk prompt tail fits whole
+    try std.testing.expect(!ringsAgree(0, R - C / 4, C, C, C / 2)); // the second step would rebase at C + C / 2
+    try std.testing.expect(ringsAgree(0, R - C / 4, C, C, C / 4 * 3 + 1)); // a first step past the ring's end rebases at C
+}
+
+test "the MTP head's pass over a step's next ids: the step's rows in one unset, TF_GLM_CHUNK rows a pass on" {
+    var e: Engine = undefined;
+    e.settings = .{};
+    try std.testing.expectEqual(@as(usize, fw.prefill_rows), mtpPiece(&e, fw.prefill_rows));
+    try std.testing.expectEqual(@as(usize, 300), mtpPiece(&e, 300));
+    e.settings.chunk = 2048;
+    try std.testing.expectEqual(@as(usize, 2048), mtpPiece(&e, fw.prefill_rows)); // a whole chunk's head passes: two, as its two busy steps make
+    try std.testing.expectEqual(@as(usize, 2048), mtpPiece(&e, fw.prefill_rows - 1)); // and the last id's row goes with the second
+    try std.testing.expectEqual(@as(usize, 300), mtpPiece(&e, 300));
+    e.settings.chunk = 1024;
+    try std.testing.expectEqual(@as(usize, 1024), mtpPiece(&e, 3000));
+}
+
+test "TF_GLM_CHUNK takes a divisor of the chunk: 2048 or 1024" {
+    for (choices) |c| {
+        try std.testing.expect(valid(c));
+        try std.testing.expectEqual(@as(u32, 0), @as(u32, fw.prefill_rows) % c);
+    }
+    try std.testing.expect(valid(default_rows));
+    try std.testing.expect(!valid(0));
+    try std.testing.expect(!valid(fw.prefill_rows)); // the whole chunk is the unset case
+    try std.testing.expect(!valid(512));
+    try std.testing.expect(!valid(3000));
+}
