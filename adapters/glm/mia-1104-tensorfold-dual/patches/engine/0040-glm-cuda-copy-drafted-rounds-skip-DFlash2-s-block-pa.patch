From 99e24107e884b37303e79e6cac76a6c6c60d5b86 Mon Sep 17 00:00:00 2001
From: MiaAI-Lab <mia.ailab1@gmail.com>
Date: Fri, 30 Oct 2026 18:39:37 +0200
Subject: [PATCH 40/63] glm cuda: copy-drafted rounds skip DFlash2's block pass
 by default (TF_GLM_DFLASH2_COPY_SKIP=0 runs it)

Measured at the production shape (4 bpw, paged fp8, 864256): replies hash as before on every T=0 prompt, and file
rewrites decode 5.3-5.6% faster (the copy rounds' 0.8 ms of drafter work a round gone).

---
 zig/src/families/glm/cuda_lanes.zig | 4 ++--
 zig/src/families/glm/draft_rule.zig | 4 ++--
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/zig/src/families/glm/cuda_lanes.zig b/zig/src/families/glm/cuda_lanes.zig
index e903db6e..be05ca3e 100644
--- a/zig/src/families/glm/cuda_lanes.zig
+++ b/zig/src/families/glm/cuda_lanes.zig
@@ -516,8 +516,8 @@ pub const Lanes = struct {
     }
 
     /// DFlash2: every request's kept rows committed, then one block round for them all (cuda_follow's block step).
-    /// With TF_GLM_DFLASH2_COPY_SKIP=1 a stream whose next window a copy takes (the core asks one draft while its room
-    /// holds more) has its kept rows ingested with no block pass: those drafts would be thrown away.
+    /// A stream whose next window a copy takes (the core asks one draft while its room holds more) has its kept rows
+    /// ingested with no block pass, since those drafts would be thrown away (TF_GLM_DFLASH2_COPY_SKIP=0: the pass runs).
     fn draftBlock(self: *Lanes, requests: []const be.DraftRequest) !void {
         if (requests.len > dflash.MAX_S) return error.TooManyStreams;
         var reqs: [dflash.MAX_S]dflash.Req = undefined;
diff --git a/zig/src/families/glm/draft_rule.zig b/zig/src/families/glm/draft_rule.zig
index 026ea799..1b3f9fc9 100644
--- a/zig/src/families/glm/draft_rule.zig
+++ b/zig/src/families/glm/draft_rule.zig
@@ -173,7 +173,7 @@ pub const Knobs = struct {
     rule: enum { cut, tpm } = .cut,
     trace: bool = false,
     coupled: bool = false, // TF_GLM_DFLASH2_COUPLED=1: a sampled stream's drafts race under its target rows' keyed noise
-    copy_skip: bool = false, // TF_GLM_DFLASH2_COPY_SKIP=1: no block pass for a stream whose next window a copy takes
+    copy_skip: bool = true, // TF_GLM_DFLASH2_COPY_SKIP=0 turns it off: no block pass for a stream a copy drafts next
     force: ?[]const u8 = null, // TF_GLM_DFLASH2_FORCE: a window's rows in turn (diagnostic), e.g. "8,1,8,2,..."
     verify_a: f64 = 9.4, // TF_GLM_VERIFY_MS=a,b,d: the cost seed (measured: sm_120 x8 400 W, 0005-0013, forced widths 1-8)
     verify_b: f64 = 1.31,
@@ -191,7 +191,7 @@ pub const Knobs = struct {
         }
         if (get("TF_GLM_DFLASH2_TRACE")) |v| k.trace = !std.mem.eql(u8, v, "0");
         if (get("TF_GLM_DFLASH2_COUPLED")) |v| k.coupled = !std.mem.eql(u8, v, "0");
-        if (get("TF_GLM_DFLASH2_COPY_SKIP")) |v| k.copy_skip = !std.mem.eql(u8, v, "0");
+        if (get("TF_GLM_DFLASH2_COPY_SKIP")) |v| k.copy_skip = !std.mem.eql(u8, v, "0"); // on unless "0"
         k.force = get("TF_GLM_DFLASH2_FORCE");
         if (get("TF_GLM_VERIFY_MS")) |v| {
             var it = std.mem.splitScalar(u8, v, ',');
-- 
