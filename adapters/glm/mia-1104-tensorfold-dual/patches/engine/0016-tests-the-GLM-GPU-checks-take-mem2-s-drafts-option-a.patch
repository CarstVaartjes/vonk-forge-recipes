From 96a491c52365bec54e1bc55460e791d23c881ccb Mon Sep 17 00:00:00 2001
From: MiaAI-Lab <mia.ailab1@gmail.com>
Date: Fri, 30 Oct 2026 17:12:19 +0200
Subject: [PATCH 16/25] tests: the GLM GPU checks take mem2's drafts option and
 weights' Heads

The engine's Options.mtp is now drafts, and weights.load takes a Heads instead of a bool.
glm-pair-check, glm-split-check, glm-lanes-cover, glm-paged-check and the loader gate still
used the old fields, so tf-cuda-test did not build on this branch. They now pass
.drafts = true and .mtp, the values the old ones meant.

---
 zig/tests/cuda/glm_lanes_tests.zig | 6 +++---
 zig/tests/cuda/glm_loader_gate.zig | 2 +-
 zig/tests/cuda/glm_paged_tests.zig | 2 +-
 zig/tests/cuda/glm_split_tests.zig | 2 +-
 4 files changed, 6 insertions(+), 6 deletions(-)

diff --git a/zig/tests/cuda/glm_lanes_tests.zig b/zig/tests/cuda/glm_lanes_tests.zig
index dda400fa..4e03ea77 100644
--- a/zig/tests/cuda/glm_lanes_tests.zig
+++ b/zig/tests/cuda/glm_lanes_tests.zig
@@ -42,7 +42,7 @@ pub fn coverCheck(gpu: Gpu, checkpoint: []const u8, dc_path: []const u8, rank: c
         std.debug.print("REFUSE {s}\n", .{problem});
         return err;
     };
-    const e = try glm.engine.Engine.init(gpu.gpa, gpu.io, gpu.d, gpu.ctx, checkpoint, &lib, comm, @intCast(rank), @intCast(world), .{ .capacity = dc.capacity, .mtp = true, .settings = set });
+    const e = try glm.engine.Engine.init(gpu.gpa, gpu.io, gpu.d, gpu.ctx, checkpoint, &lib, comm, @intCast(rank), @intCast(world), .{ .capacity = dc.capacity, .drafts = true, .settings = set });
     defer e.deinit();
     try e.prepareSnapshots(2 * e.stateBytes(4096));
     var link = try glm.follow.Link.init(gpu.gpa, gpu.d, &lib, comm, e.stream, dc.capacity);
@@ -151,7 +151,7 @@ pub fn concurrentCheck(gpu: Gpu, checkpoint: []const u8, dc_path: []const u8, ra
         std.debug.print("REFUSE {s}\n", .{problem});
         return err;
     };
-    const e = try glm.engine.Engine.init(gpu.gpa, gpu.io, gpu.d, gpu.ctx, checkpoint, &lib, comm, @intCast(rank), @intCast(world), .{ .capacity = dc.capacity, .mtp = true, .settings = set });
+    const e = try glm.engine.Engine.init(gpu.gpa, gpu.io, gpu.d, gpu.ctx, checkpoint, &lib, comm, @intCast(rank), @intCast(world), .{ .capacity = dc.capacity, .drafts = true, .settings = set });
     defer e.deinit();
     var link = try glm.follow.Link.init(gpu.gpa, gpu.d, &lib, comm, e.stream, dc.capacity);
     defer link.deinit();
@@ -230,7 +230,7 @@ pub fn sharedCheck(gpu: Gpu, checkpoint: []const u8, dc_path: []const u8, rank:
         std.debug.print("REFUSE {s}\n", .{problem});
         return err;
     };
-    const e = try glm.engine.Engine.init(gpu.gpa, gpu.io, gpu.d, gpu.ctx, checkpoint, &lib, comm, @intCast(rank), @intCast(world), .{ .capacity = dc.capacity, .mtp = true, .settings = set });
+    const e = try glm.engine.Engine.init(gpu.gpa, gpu.io, gpu.d, gpu.ctx, checkpoint, &lib, comm, @intCast(rank), @intCast(world), .{ .capacity = dc.capacity, .drafts = true, .settings = set });
     defer e.deinit();
     var link = try glm.follow.Link.init(gpu.gpa, gpu.d, &lib, comm, e.stream, dc.capacity);
     defer link.deinit();
diff --git a/zig/tests/cuda/glm_loader_gate.zig b/zig/tests/cuda/glm_loader_gate.zig
index d65c7dd5..0fffd6b5 100644
--- a/zig/tests/cuda/glm_loader_gate.zig
+++ b/zig/tests/cuda/glm_loader_gate.zig
@@ -440,7 +440,7 @@ const Tamper = struct { name: ?[]const u8, done: usize = 0, caught: usize = 0 };
 /// Rank `rank` of `world` loaded, each upload compared: how many differ or are not known, one more if none was.
 fn rankGate(gpu: check.Gpu, a: std.mem.Allocator, ck: *core.Checkpoint, c: *const Config, m: *const glm.forward.Modules, stream: cuda.Stream, dir: []const u8, layers: []const u32, rank: usize, world: usize, tamper: *Tamper) !usize {
     const s = try glm.shard.Share.of(c, rank, world);
-    var w = try glm.weights.load(gpu.gpa, gpu.io, gpu.d, stream, m.tools(), dir, c.*, s, layers, true);
+    var w = try glm.weights.load(gpu.gpa, gpu.io, gpu.d, stream, m.tools(), dir, c.*, s, layers, .mtp);
     defer w.deinit();
     var bad: usize = 0;
     var cut: usize = 0;
diff --git a/zig/tests/cuda/glm_paged_tests.zig b/zig/tests/cuda/glm_paged_tests.zig
