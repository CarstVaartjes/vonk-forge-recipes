+//! TF_GLM_KV_SHARD's owner-computed attention (GLM patch 0118 by Robert Wojciechowski, GitHub @wojo, X @rwojo):
+//! per DSA layer, a segment whose latent rows only one rank holds (its owner, with no twin on the other) has that rank
+//! attend for both ranks' heads. After the replicated projections, the other rank sends its absorbed queries for the
+//! segment's rows; the holder attends its own heads and then the peer's (the same kernels, token lists and call shapes
+//! the peer would have run) and sends those outputs back into the peer's rows. The forward is eager (no graphs), so
+//! every exchange is sized to the round's segments on the host: grouped NCCL send/recv of whole row ranges, one group
+//! a phase, on the main stream. A segment both ranks hold (a prompt pass's twin) attends locally, as unsharded.
+const std = @import("std");
+const cuda = @import("cuda");
+const kvs = @import("cuda_kv_shard.zig");
+const fw = @import("cuda_forward.zig");
+const dsa_block = @import("cuda_dsa_block.zig");
+const latent = @import("cuda_latent.zig");
+const weights = @import("cuda_weights.zig");
+const prof = @import("cuda_prof.zig");
+
+/// A segment's part on this rank: both ranks hold its rows (`local`), this rank lacks them (`give`: its queries out,
+/// its outputs in), or this rank alone holds them (`take`: the peer's queries in, its outputs out).
+pub const Role = enum { local, give, take };
+
+pub fn role(hold: ?kvs.Hold, rank: usize) Role {
+    const h = hold orelse return .local;
+    if (h.twin) return .local;
+    return if (h.owner == rank) .take else .give;
+}
+
+/// One segment of a layer: rows [row0, row0 + rows) of the window, and its role here.
+pub const Seg = struct { row0: usize, rows: usize, role: Role };
+
+/// Which buffer an exchange moves: this rank's queries (`qa`) or outputs (`ol`) rows, the peer queries this rank
+/// received (`pq`), or the peer outputs it computed (`po`).
+pub const Buf = enum { qa, ol, pq, po };
+
+/// The pass an `attend` makes over a segment: its own heads (queries `qa` into `ol`), the peer's (`pq` into `po`), or
+/// none (the rows' writes and token lists alone).
+pub const Pass = enum { own, peer, none };
+
+/// Whether any segment exchanges rows (else the layer runs as unsharded, with no exchange posted).
+pub fn exchanges(segs: []const Seg) bool {
+    for (segs) |g| if (g.role != .local) return true;
+    return false;
+}
+
+/// One DSA layer's attention over `segs` on this rank, through `d` (the device, or a host model in tests):
+/// 1. queries: every give segment's `qa` rows to the peer, every take segment's into `pq`, in segment order;
+/// 2. each segment in order: local, its own heads; take, its own heads then the peer's; give, its writes and lists;
+/// 3. outputs: every take segment's `po` rows to the peer, every give segment's into `ol`, in segment order.
+/// Both ranks see the same segments with opposite roles, so every send meets the peer's receive of the same rows.
+pub fn run(comptime D: type, d: D, segs: []const Seg) !void {
+    if (!exchanges(segs)) {
+        for (segs) |g| try d.attend(g, .own);
+        return;
+    }
+    try d.group(.begin);
+    for (segs) |g| switch (g.role) {
+        .give => try d.move(.qa, g, .send),
+        .take => try d.move(.pq, g, .recv),
+        .local => {},
+    };
+    try d.group(.end);
+    for (segs) |g| switch (g.role) {
+        .local => try d.attend(g, .own),
+        .take => {
+            try d.attend(g, .own);
+            if (!mut(.peer_skipped)) try d.attend(g, .peer);
+        },
+        .give => try d.attend(g, .none),
+    };
+    try d.group(.begin);
+    for (segs) |g| switch (g.role) {
+        .take => try d.move(.po, g, .send),
+        .give => try d.move(if (mut(.output_recv_into_qa)) .qa else .ol, g, .recv),
+        .local => {},
+    };
+    try d.group(.end);
+}
+
+pub const Dir = enum { send, recv };
+pub const Edge = enum { begin, end };
+
+/// The engine's exchange room and this rank's place (null in a Forward unsharded).
+pub const Ctx = struct {
+    rank: usize,
+    lib: *const cuda.nccl.Library,
+    comm: cuda.nccl.Comm,
+    pq: u64, // bf16 [rows][heads][lw]: the peer's queries for the rows this rank attends for it
+    po: u64, // bf16 [rows][heads][lw]: this rank's outputs of the peer's heads
+    rows: usize, // the rows pq and po hold
+    counts: ?*kvs.Counts = null, // rank 0's counters (the other rank's own are not reported)
+
+    pub fn peer(c: *const Ctx) usize {
+        return 1 - c.rank;
+    }
+};
+
+/// Bytes one row of a rank's absorbed queries or latent outputs takes: its heads x lw bf16.
+pub fn rowBytes(l: dsa_block.Layer) usize {
+    return l.heads * l.lw * 2;
+}
+
+/// The exchange room's bytes: two buffers of `rows` rows of `heads` x `lw` bf16.
+pub fn roomBytes(rows: usize, heads: usize, lw: usize) usize {
+    return 2 * rows * heads * lw * 2;
+}
+
+/// The device side of `run`: the CUDA forward's buffers and kernels for one DSA layer over one sequence or a shared
+/// window's segments.
+const Gpu = struct {
+    f: *const fw.Forward,
+    kv: *const Ctx,
+    k: dsa_block.Kernels,
+    a: dsa_block.Layer,
+    b: *fw.Buffers,
+    caches: []const dsa_block.Caches, // each segment's sequence's cache of this layer
+    states: []const *fw.State,
+    nch: usize, // single-sequence: the call's chunks (a shared window computes each segment's)
+    single: bool,
+
+    fn base(g: Gpu, which: Buf) u64 {
+        return switch (which) {
+            .qa => g.b.dsa.qa,
+            .ol => g.b.dsa.ol,
+            .pq => g.kv.pq,
+            .po => g.kv.po,
+        };
+    }
+
+    pub fn group(g: Gpu, e: Edge) !void {
+        const lib = g.kv.lib;
+        switch (e) {
+            .begin => try lib.check(lib.api.ncclGroupStart(), "ncclGroupStart"),
+            .end => try lib.check(lib.api.ncclGroupEnd(), "ncclGroupEnd"),
+        }
+    }
+
+    pub fn move(g: Gpu, which: Buf, s: Seg, dir: Dir) !void {
+        const rb = rowBytes(g.a);
+        if (s.row0 + s.rows > g.kv.rows and (which == .pq or which == .po)) return error.KvShardRoom;
+        const at = g.base(which) + s.row0 * rb;
+        const lib = g.kv.lib;
+        const peer: c_int = @intCast(g.kv.peer());
+        switch (dir) {
+            .send => try lib.check(lib.api.ncclSend(at, s.rows * rb, .u8, peer, g.kv.comm, g.f.stream.handle), "ncclSend"),
+            .recv => try lib.check(lib.api.ncclRecv(at, s.rows * rb, .u8, peer, g.kv.comm, g.f.stream.handle), "ncclRecv"),
+        }
+        if (g.kv.counts) |c| if (dir == .send) {
+            c.owner_bytes += s.rows * rb;
+        };
+    }
+
+    fn index(g: Gpu, s: Seg) usize {
+        if (g.single) return 0;
+        for (g.f.ranks[0].segs, 0..) |x, i| if (x.row0 == s.row0) return i;
+        unreachable;
+    }
+
+    pub fn attend(g: Gpu, s: Seg, pass: Pass) !void {
+        const i = g.index(s);
+        const st = g.states[i];
+        const c = g.caches[i];
+        const nch = if (g.single) g.nch else @min(latent.chunksFor(st.pos + s.rows), g.b.nch);
+        switch (pass) {
+            .own => try dsa_block.attend(g.k, g.f.stream, g.a, c, g.b.dsa, s.row0, s.rows, st.pos_dev, st.pos, nch, g.b.part_rows),
+            .none => _ = try dsa_block.attendNoLatent(g.k, g.f.stream, g.a, c, g.b.dsa, s.row0, s.rows, st.pos_dev, st.pos),
+            .peer => { // right after the own pass: its token lists are in the scratch's first rows
+                const rb = rowBytes(g.a);
+                try dsa_block.attendOnly(g.k, g.f.stream, g.a, c, g.b.dsa, s.rows, st.pos_dev, st.pos, nch, g.b.part_rows, g.kv.pq + s.row0 * rb, g.kv.po + s.row0 * rb, g.b.dsa.tokens, g.b.dsa.counts);
+            },
+        }
+    }
+};
+
+/// Whether this forward's rank attends any segment owner-computed this layer (null Ctx: never).
+pub fn wanted(f: *const fw.Forward, r: fw.Rank) bool {
+    const kv = f.kv orelse return false;
+    if (r.segs.len == 0) return role(r.st.hold, kv.rank) != .local;
+    for (r.segs) |g| if (role(g.st.hold, kv.rank) != .local) return true;
+    return false;
+}
+
+/// Forward.mixer's DSA block on one sequence whose latent rows one rank holds: the projections, the exchange, its
+/// attention or the peer's, expand_v (o_proj stays the caller's fill).
+pub fn single(f: *const fw.Forward, r: fw.Rank, a: dsa_block.Layer, di: usize, rows: usize, nch: usize, k: dsa_block.Kernels) !void {
+    const kv = f.kv.?;
+    const st = r.st;
+    try dsa_block.prepareProfile(k.set, f.stream, a, r.b.dsa, r.b.normed, r.w.config.hidden, rows, dsa_block.sparseRows(a, st.pos, rows), k.prof);
+    const caches = [_]dsa_block.Caches{st.caches[di]};
+    const states = [_]*fw.State{st};
+    const d: Gpu = .{ .f = f, .kv = kv, .k = k, .a = a, .b = r.b, .caches = &caches, .states = &states, .nch = nch, .single = true };
+    const seg = [_]Seg{.{ .row0 = 0, .rows = rows, .role = role(st.hold, kv.rank) }};
+    try run(Gpu, d, &seg);
+    note(kv, &seg);
+    const stamp = prof.span(k.prof, f.stream, .projections);
+    defer stamp.end();
+    try latent.expandV(k.set, f.stream, r.b.dsa.ol, a.wv, r.b.dsa.vn, rows, a.heads, a.dv, a.lw);
+}
+
+/// The shared window's DSA block (cuda_shared.mixer's) with owner-computed segments: every segment on its own
+/// launches (the batched ones' bits), the exchanges around them, then expand_v for every row.
+pub fn shared(f: *const fw.Forward, r: fw.Rank, a: dsa_block.Layer, di: usize, rows: usize) !void {
+    const kv = f.kv.?;
+    const b = r.b;
+    var sparse_any = false;
+    for (r.segs) |g| sparse_any = sparse_any or dsa_block.sparseRows(a, g.st.pos, g.rows);
+    try dsa_block.prepare(f.set(), f.stream, a, b.dsa, b.normed, r.w.config.hidden, rows, sparse_any);
+    var caches: [latent.max_segs]dsa_block.Caches = undefined;
+    var states: [latent.max_segs]*fw.State = undefined;
+    var segs: [latent.max_segs]Seg = undefined;
+    if (r.segs.len > latent.max_segs) return error.TooManySegments;
+    for (r.segs, 0..) |g, i| {
+        caches[i] = g.st.caches[di];
+        states[i] = g.st;
+        segs[i] = .{ .row0 = g.row0, .rows = g.rows, .role = role(g.st.hold, kv.rank) };
+    }
+    const n = r.segs.len;
+    const d: Gpu = .{ .f = f, .kv = kv, .k = .{ .set = f.set(), .ops = f.m.ops() }, .a = a, .b = b, .caches = caches[0..n], .states = states[0..n], .nch = 0, .single = false };
+    try run(Gpu, d, segs[0..n]);
+    note(kv, segs[0..n]);
+    try latent.expandV(f.set(), f.stream, b.dsa.ol, a.wv, b.dsa.vn, rows, a.heads, a.dv, a.lw);
+}
+
+/// Rank 0's counters for a layer's exchange.
+fn note(kv: *const Ctx, segs: []const Seg) void {
+    const c = kv.counts orelse return;
+    if (!exchanges(segs)) return;
+    c.owner_layers += 1;
+    for (segs) |g| c.owner_rows += if (g.role != .local) g.rows else 0;
+}
+
+// -- mutants (test builds only) -------------------------------------------------------------------------------------
+
+pub const Mutant = enum { none, peer_skipped, output_recv_into_qa };
+pub var mutant: Mutant = .none;
+
+fn mut(comptime m: Mutant) bool {
+    return @import("builtin").is_test and mutant == m;
+}
diff --git a/zig/src/families/glm/cuda_kv_shard_attn_test.zig b/zig/src/families/glm/cuda_kv_shard_attn_test.zig
new file mode 100644
index 000000000..af1c283de
--- /dev/null
+++ b/zig/src/families/glm/cuda_kv_shard_attn_test.zig
@@ -0,0 +1,208 @@
+//! Owner-computed attention (cuda_kv_shard_attn.run) on a two-rank host model: each rank on its own thread, NCCL's
+//! grouped send/recv as a barrier at each group's end, attention as a function of a row's query and its segment's
+//! latent rows. Every rank's outputs must equal what it computes unsharded; a rank never attends rows it lacks; every
+//! send meets the peer's receive of the same rows.
+const std = @import("std");
+const attn = @import("cuda_kv_shard_attn.zig");
+const kvs = @import("cuda_kv_shard.zig");
+
+const max_rows = 64;
+const max_phases = 8;
+
+fn mix(a: u64, b: u64) u64 {
+    var h = std.hash.Wyhash.init(a);
+    h.update(std.mem.asBytes(&b));
+    return h.final();
+}
+
+/// What both ranks see: the segments' holds and rows, and the exchanges in flight, a mailbox a phase.
+const World = struct {
+    mutex: std.Io.Mutex = .init,
+    cond: std.Io.Condition = .init,
+    holds: []const kvs.Hold,
+    rows: []const usize, // each segment's rows
+    gen: [2]usize = .{ 0, 0 },
+    mail: [2][max_phases]std.ArrayList([]u64) = @splat(@splat(.empty)),
+    gpa: std.mem.Allocator,
+    failed: ?anyerror = null,
+
+    fn deinit(w: *World) void {
+        for (&w.mail) |*r| for (r) |*m| {
+            for (m.items) |x| w.gpa.free(x);
+            m.deinit(w.gpa);
+        };
+    }
+};
+
+/// One rank: its query and output rows, the peer's queries and the outputs it computed for the peer.
+const Rank = struct {
+    w: *World,
+    rank: usize,
+    qa: [max_rows]u64 = undefined,
+    ol: [max_rows]u64 = @splat(0),
+    pq: [max_rows]u64 = @splat(0),
+    po: [max_rows]u64 = @splat(0),
+    out: std.ArrayList([]u64) = .empty,
+    want: std.ArrayList(struct { buf: attn.Buf, seg: attn.Seg }) = .empty,
+
+    fn buf(r: *Rank, b: attn.Buf) *[max_rows]u64 {
+        return switch (b) {
+            .qa => &r.qa,
+            .ol => &r.ol,
+            .pq => &r.pq,
+            .po => &r.po,
+        };
+    }
+
+    fn segIndex(r: *const Rank, s: attn.Seg) usize {
+        var at: usize = 0;
+        for (r.w.rows, 0..) |n, i| {
+            if (at == s.row0) return i;
+            at += n;
+        }
+        unreachable;
+    }
+};
+
+/// cuda_kv_shard_attn.run's device: `Rank` behind a pointer.
+const Model = struct {
+    r: *Rank,
+
+    pub fn group(m: Model, e: attn.Edge) !void {
+        const r = m.r;
+        const w = r.w;
+        switch (e) {
+            .begin => {
+                r.out.clearRetainingCapacity();
+                r.want.clearRetainingCapacity();
+            },
+            .end => {
+                const io = std.testing.io;
+                w.mutex.lockUncancelable(io);
+                defer w.mutex.unlock(io);
+                const phase = w.gen[r.rank];
+                const peer = 1 - r.rank;
+                try w.mail[peer][phase].appendSlice(w.gpa, r.out.items);
+                r.out.clearRetainingCapacity();
+                w.gen[r.rank] += 1;
+                w.cond.broadcast(io);
+                while (w.gen[peer] <= phase and w.failed == null) w.cond.waitUncancelable(io, &w.mutex);
+                if (w.failed) |err| return err;
+                const got = w.mail[r.rank][phase].items;
+                if (got.len != r.want.items.len) return error.UnpairedExchange;
+                for (got, r.want.items) |rows, x| {
+                    if (rows.len != x.seg.rows) return error.UnpairedExchange;
+                    @memcpy(r.buf(x.buf)[x.seg.row0..][0..x.seg.rows], rows);
+                }
+            },
+        }
+    }
+
+    pub fn move(m: Model, which: attn.Buf, s: attn.Seg, dir: attn.Dir) !void {
+        const r = m.r;
+        switch (dir) {
+            .send => try r.out.append(r.w.gpa, try r.w.gpa.dupe(u64, r.buf(which)[s.row0..][0..s.rows])),
+            .recv => try r.want.append(r.w.gpa, .{ .buf = which, .seg = s }),
+        }
+    }
+
+    pub fn attend(m: Model, s: attn.Seg, pass: attn.Pass) !void {
+        const r = m.r;
+        const i = r.segIndex(s);
+        if (pass == .none) return;
+        if (!r.w.holds[i].has(r.rank)) return error.AttendedWithoutRows;
+        const lat = mix(0x1a7e, i);
+        const q = if (pass == .own) &r.qa else &r.pq;
+        const o = if (pass == .own) &r.ol else &r.po;
+        for (s.row0..s.row0 + s.rows) |row| o[row] = mix(q[row], lat);
+    }
+};
+
+fn rankMain(r: *Rank, segs: []const attn.Seg) void {
+    attn.run(Model, .{ .r = r }, segs) catch |err| {
+        const io = std.testing.io;
+        r.w.mutex.lockUncancelable(io);
+        defer r.w.mutex.unlock(io);
+        if (r.w.failed == null) r.w.failed = err;
+        r.w.cond.broadcast(io);
+    };
+}
+
+/// Both ranks over segments of `rows` rows held as `holds`; every rank's outputs against its unsharded ones.
+fn check(gpa: std.mem.Allocator, holds: []const kvs.Hold, rows: []const usize) !void {
+    var w: World = .{ .holds = holds, .rows = rows, .gpa = gpa };
+    defer w.deinit();
+    var ranks: [2]Rank = .{ .{ .w = &w, .rank = 0 }, .{ .w = &w, .rank = 1 } };
+    defer for (&ranks) |*r| {
+        for (r.out.items) |x| gpa.free(x);
+        r.out.deinit(gpa);
+        r.want.deinit(gpa);
+    };
+    var segs: [2][16]attn.Seg = undefined;
+    var total: usize = 0;
+    for (rows, holds, 0..) |n, h, i| {
+        for (0..2) |rk| segs[rk][i] = .{ .row0 = total, .rows = n, .role = attn.role(h, rk) };
+        total += n;
+    }
+    for (&ranks) |*r| for (0..total) |row| {
+        r.qa[row] = mix(r.rank + 1, row);
+    };
+    var threads: [2]std.Thread = undefined;
+    for (&threads, &ranks) |*t, *r| t.* = try std.Thread.spawn(.{}, rankMain, .{ r, segs[r.rank][0..rows.len] });
+    for (threads) |t| t.join();
+    if (w.failed) |err| return err;
+    var at: usize = 0;
+    for (rows, 0..) |n, i| {
+        const lat = mix(0x1a7e, i);
+        for (&ranks) |*r| for (at..at + n) |row| {
+            if (r.ol[row] != mix(r.qa[row], lat)) return error.WrongOutput;
+        };
+        at += n;
+    }
+}
+
+test "kv shard attention: both ranks' outputs are their unsharded ones: owners, twins, both ranks owning" {
+    const gpa = std.testing.allocator;
+    try check(gpa, &.{.{ .owner = 0 }}, &.{16}); // one stream on rank 0: rank 1 gives
+    try check(gpa, &.{.{ .owner = 1 }}, &.{1});
+    try check(gpa, &.{.{ .owner = 1, .twin = true }}, &.{4096 % 64}); // a twin: both attend locally
+    try check(gpa, &.{ .{ .owner = 0 }, .{ .owner = 1 }, .{ .owner = 0, .twin = true }, .{ .owner = 1 } }, &.{ 3, 16, 1, 9 });
+    try check(gpa, &.{ .{ .owner = 1 }, .{ .owner = 1 }, .{ .owner = 1 } }, &.{ 2, 2, 2 });
+}
+
+test "kv shard attention: random windows of up to 16 segments" {
+    const gpa = std.testing.allocator;
+    var prng = std.Random.DefaultPrng.init(0x5aded);
+    const rnd = prng.random();
+    for (0..150) |_| {
+        const n = rnd.intRangeAtMost(usize, 1, 16);
+        var holds: [16]kvs.Hold = undefined;
+        var rows: [16]usize = undefined;
+        var left: usize = max_rows;
+        for (0..n) |i| {
+            holds[i] = .{ .owner = rnd.intRangeAtMost(u8, 0, 1), .twin = rnd.uintLessThan(u8, 4) == 0 };
+            rows[i] = rnd.intRangeAtMost(usize, 1, @max(1, @min(16, left - (n - 1 - i))));
+            left -= rows[i];
+        }
+        try check(gpa, holds[0..n], rows[0..n]);
+    }
+}
+
+test "kv shard attention: roles: no hold or a twin attends locally; the owner takes; the other rank gives" {
+    try std.testing.expectEqual(attn.Role.local, attn.role(null, 0));
+    try std.testing.expectEqual(attn.Role.local, attn.role(.{ .owner = 0, .twin = true }, 1));
+    try std.testing.expectEqual(attn.Role.take, attn.role(.{ .owner = 1 }, 1));
+    try std.testing.expectEqual(attn.Role.give, attn.role(.{ .owner = 1 }, 0));
+    try std.testing.expect(!attn.exchanges(&.{ .{ .row0 = 0, .rows = 1, .role = .local }, .{ .row0 = 1, .rows = 2, .role = .local } }));
+    try std.testing.expect(attn.exchanges(&.{ .{ .row0 = 0, .rows = 1, .role = .local }, .{ .row0 = 1, .rows = 2, .role = .give } }));
+    try std.testing.expectEqual(@as(usize, 2 * 4096 * 32 * 512 * 2), attn.roomBytes(4096, 32, 512)); // 256 MiB at TP2
+}
+
+test "kv shard attention: each guard's mutant is caught" {
+    const gpa = std.testing.allocator;
+    defer attn.mutant = .none;
+    inline for (.{ attn.Mutant.peer_skipped, attn.Mutant.output_recv_into_qa }) |m| {
+        attn.mutant = m;
+        try std.testing.expectError(error.WrongOutput, check(gpa, &.{ .{ .owner = 0 }, .{ .owner = 1 } }, &.{ 4, 4 }));
+    }
+}
diff --git a/zig/src/families/glm/cuda_kv_shard_keep.zig b/zig/src/families/glm/cuda_kv_shard_keep.zig
new file mode 100644
index 000000000..b15606b0f
--- /dev/null
+++ b/zig/src/families/glm/cuda_kv_shard_keep.zig
@@ -0,0 +1,107 @@
+//! TF_GLM_KV_SHARD's kept states (GLM patch 0118 by Robert Wojciechowski, GitHub @wojo, X @rwojo): a state's home is
+//! its stream's owner part; the home rank's copy holds every part as unsharded, the other rank's every part but the
+//! DSA caches' latent codes and scales. Both lease the unsharded size, so rank 0's admission, which charges its own
+//! lease, never passes a keep the other rank's pages cannot hold. A resume restores each rank's own parts, then the
+//! home rank sends the latent rows to every rank that holds the new stream's rows but is not the home (`carry`): a
+//! stream placed outside the home part (TF_GLM_KV_SHARD_CARRY), or a resumed pass's twin. Host side: who keeps,
+//! who sends, and the pieces both ranks cut alike.
+const std = @import("std");
+const kvs = @import("cuda_kv_shard.zig");
+
+/// Bytes a carry moves in one piece (the staging buffer's size on each rank).
+pub const piece_bytes: usize = 32 << 20;
+
+/// Whether this rank's copy of a kept state holds its latent rows: unsharded always; sharded on the stream's owner.
+pub fn keepsLatent(hold: ?kvs.Hold, rank: usize) bool {
+    const h = hold orelse return true;
+    return h.owner == rank or mut(.everyone_keeps);
+}
+
+/// This rank's side of a resume's carry: the home rank sends when the other rank holds the new stream's rows; the other
+/// rank receives when it does. `home` null: an unsharded state (no carry).
+pub const Side = enum { none, send, recv };
+
+pub fn carry(home: ?u8, hold: ?kvs.Hold, rank: usize) Side {
+    const hp = home orelse return .none;
+    const h = hold orelse return .none;
+    const peer = 1 - rank;
+    if (rank == hp) return if (h.has(peer) and peer != hp) .send else .none;
+    return if (h.has(rank) or mut(.recv_without_rows)) .recv else .none;
+}
+
+/// Whether a resume restores the latent parts of its own copy into the live sequence: on its home, when it holds the
+/// new stream's rows (else its copy's latent parts are only sent, or skipped).
+pub fn restoresLatent(home: ?u8, hold: ?kvs.Hold, rank: usize) bool {
+    const hp = home orelse return true;
+    const h = hold orelse return true;
+    return rank == hp and h.has(rank);
+}
+
+/// The pieces of a carry over latent parts of `lens` bytes, `piece` at most: (part, offset in it, bytes), in order.
+/// The sender cuts its copy's parts and the receiver its live parts by this one rule, so each send meets its receive.
+pub fn pieces(gpa: std.mem.Allocator, lens: []const usize, piece: usize) ![]const [3]usize {
+    var out: std.ArrayList([3]usize) = .empty;
+    errdefer out.deinit(gpa);
+    for (lens, 0..) |len, i| {
+        var done: usize = 0;
+        while (done < len) {
+            const n = @min(piece, len - done);
+            try out.append(gpa, .{ i, done, n });
+            done += n;
+        }
+    }
+    return out.toOwnedSlice(gpa);
+}
+
+pub const Mutant = enum { none, everyone_keeps, recv_without_rows };
+pub var mutant: Mutant = .none;
+
+fn mut(comptime m: Mutant) bool {
+    return @import("builtin").is_test and mutant == m;
+}
+
+test "kv shard keep: the owner's copy alone keeps the latent rows; unsharded every copy does" {
+    try std.testing.expect(keepsLatent(null, 0) and keepsLatent(null, 1));
+    try std.testing.expect(keepsLatent(.{ .owner = 1 }, 1));
+    try std.testing.expect(!keepsLatent(.{ .owner = 1 }, 0));
+    try std.testing.expect(!keepsLatent(.{ .owner = 0, .twin = true }, 1)); // a twin's rows are not the state's
+}
+
+test "kv shard keep: a resume's carry: the home rank sends to the rank that holds the new stream's rows" {
+    for ([_]u8{ 0, 1 }) |home| for ([_]u8{ 0, 1 }) |owner| for ([_]bool{ false, true }) |twin| {
+        const h: kvs.Hold = .{ .owner = owner, .twin = twin };
+        const a = carry(home, h, home);
+        const b = carry(home, h, 1 - home);
+        const needs = h.has(1 - home); // the other rank holds the new stream's rows
+        try std.testing.expectEqual(if (needs) Side.send else Side.none, a);
+        try std.testing.expectEqual(if (needs) Side.recv else Side.none, b);
+        try std.testing.expectEqual(h.has(home), restoresLatent(home, h, home));
+        try std.testing.expect(!restoresLatent(home, h, 1 - home));
+    };
+    try std.testing.expectEqual(Side.none, carry(null, .{ .owner = 0 }, 1)); // unsharded state
+    try std.testing.expectEqual(Side.none, carry(1, null, 0));
+    try std.testing.expect(restoresLatent(null, .{ .owner = 0 }, 1));
+}
+
+test "kv shard keep: both ranks cut a carry's pieces alike, whole parts covered once in order" {
+    const gpa = std.testing.allocator;
+    const lens = [_]usize{ 70 << 20, 2048, 0, 64 << 20 };
+    const p = try pieces(gpa, &lens, piece_bytes);
+    defer gpa.free(p);
+    try std.testing.expectEqual(@as(usize, 3 + 1 + 2), p.len);
+    var sum: [4]usize = @splat(0);
+    for (p) |x| {
+        try std.testing.expect(x[2] > 0 and x[2] <= piece_bytes);
+        try std.testing.expectEqual(sum[x[0]], x[1]);
+        sum[x[0]] += x[2];
+    }
+    try std.testing.expectEqualSlices(usize, &lens, &sum);
+}
+
+test "kv shard keep: each guard's mutant is caught" {
+    defer mutant = .none;
+    mutant = .everyone_keeps;
+    try std.testing.expect(keepsLatent(.{ .owner = 1 }, 0));
+    mutant = .recv_without_rows;
+    try std.testing.expectEqual(Side.recv, carry(0, .{ .owner = 0 }, 1)); // the peer would wait on a send never made
+}
diff --git a/zig/src/families/glm/cuda_kv_shard_keep_test.zig b/zig/src/families/glm/cuda_kv_shard_keep_test.zig
new file mode 100644
index 000000000..623d83e22
--- /dev/null
+++ b/zig/src/families/glm/cuda_kv_shard_keep_test.zig
@@ -0,0 +1,134 @@
+//! TF_GLM_KV_SHARD's kept states on a driver of addresses alone: a restore that skips its latent parts leaves their
+//! bytes in place and every other part's offsets as they were; a carry's staging copy walks device pages; and the two
+//! parts' leases over random admissions, twins and ends stay whole, placed alike on both ranks.
+const std = @import("std");
+const cuda = @import("cuda");
+const snap_pages = @import("cuda_snapshot_pages.zig");
+const layout = @import("cuda_snapshot_layout.zig");
+const kvs = @import("cuda_kv_shard.zig");
+const expect = std.testing.expect;
+const expectEqual = std.testing.expectEqual;
+
+const MiB = 1 << 20;
+
+/// The driver: one arena at a fixed address, every device-to-device copy recorded.
+const F = struct {
+    const base: u64 = 1 << 40;
+    var copies: [32][3]u64 = undefined; // (dst, src, bytes)
+    var n: usize = 0;
+    fn alloc(out: *u64, _: usize) callconv(.c) cuda.abi.Result {
+        out.* = base;
+        return 0;
+    }
+    fn free(_: u64) callconv(.c) cuda.abi.Result {
+        return 0;
+    }
+    fn copy(dst: u64, src: u64, bytes: usize, _: cuda.abi.Stream) callconv(.c) cuda.abi.Result {
+        copies[n] = .{ dst, src, bytes };
+        n += 1;
+        return 0;
+    }
+};
+
+fn driver() cuda.Driver {
+    var d: cuda.Driver = undefined;
+    d.api.cuMemAlloc_v2 = F.alloc;
+    d.api.cuMemFree_v2 = F.free;
+    d.api.cuMemcpyDtoDAsync_v2 = F.copy;
+    return d;
+}
+
+test "kv shard keep: a restore without its latent parts copies the others from their own offsets" {
+    const gpa = std.testing.allocator;
+    var d = driver();
+    var pool = try snap_pages.Pool.init(gpa, &d, 3 * snap_pages.page);
+    defer pool.deinit();
+    var plan: layout.Plan = .{};
+    const live: [3]u64 = .{ 0x1000_0000, 0x2000_0000, 0x3000_0000 };
+    plan.parts[0] = .{ .live = live[0], .len = 1 * MiB };
+    plan.parts[1] = .{ .live = live[1], .len = 3 * MiB, .lat = true };
+    plan.parts[2] = .{ .live = live[2], .len = MiB / 2 };
+    plan.count = 3;
+    plan.len = 4 * MiB + MiB / 2;
+    var lease = try pool.take(plan.len);
+    defer pool.give(&lease);
+    const stream: cuda.Stream = .{ .d = &d, .handle = null };
+    F.n = 0;
+    try pool.moveParts(stream, &lease, &plan, false, false);
+    try expectEqual(@as(usize, 2), F.n); // the first part, then the last: the latent part's 3 MiB skipped
+    try expectEqual([3]u64{ live[0], F.base, MiB }, F.copies[0]);
+    try expectEqual([3]u64{ live[2], F.base + 2 * snap_pages.page, MiB / 2 }, F.copies[1]); // still at byte 4 MiB
+    F.n = 0;
+    try pool.move(stream, &lease, &plan, false);
+    try expectEqual(@as(usize, 4), F.n); // the latent part too, over its two pages
+    try expectEqual([3]u64{ live[1], F.base + MiB, MiB }, F.copies[1]);
+    try expectEqual([3]u64{ live[1] + MiB, F.base + snap_pages.page, 2 * MiB }, F.copies[2]);
+    // a carry's staging copy: 1 MiB from byte 1.5 MiB, across a page's end
+    F.n = 0;
+    try pool.copyOut(stream, &lease, 3 * MiB / 2, 0x9000_0000, MiB);
+    try expectEqual(@as(usize, 2), F.n);
+    try expectEqual([3]u64{ 0x9000_0000, F.base + 3 * MiB / 2, MiB / 2 }, F.copies[0]);
+    try expectEqual([3]u64{ 0x9000_0000 + MiB / 2, F.base + snap_pages.page, MiB / 2 }, F.copies[1]);
+    try std.testing.expectError(error.SnapshotSize, pool.copyOut(stream, &lease, 5 * MiB, 0x9000_0000, 2 * MiB));
+}
+
+test "kv shard parts: random admissions, twins and ends on two ranks: every page held once, placed alike" {
+    const gpa = std.testing.allocator;
+    var prng = std.Random.DefaultPrng.init(0x0118);
+    const rnd = prng.random();
+    const h = 40;
+    const slots = 6;
+    var lead = try kvs.Parts.init(gpa, h, 4096, slots, true);
+    defer lead.deinit();
+    var other = try kvs.Parts.init(gpa, h, 4096, slots, false);
+    defer other.deinit();
+    for (0..3000) |_| {
+        const slot = rnd.uintLessThan(usize, slots);
+        const s = &lead.slots[slot];
+        switch (rnd.uintLessThan(u8, 4)) {
+            0, 1 => if (!s.used) {
+                const n = rnd.intRangeAtMost(usize, 1, 16);
+                const home: ?u8 = if (rnd.boolean()) rnd.uintLessThan(u8, 2) else null;
+                const part = lead.choose(n, home) orelse continue;
+                if (home) |hp| if (lead.pools[hp].fits(n)) try expectEqual(hp, part);
+                try lead.open(slot, part, n, if (rnd.boolean()) rnd.intRangeAtMost(usize, 1, n) else 0);
+                try other.map(slot, s.ids.items, s.twin.items);
+            },
+            2 => if (s.used) {
+                _ = lead.giveBack(slot);
+                _ = other.giveBack(slot);
+            },
+            else => if (s.used) {
+                lead.close(slot);
+                other.close(slot);
+            },
+        }
+        try expectEqual(lead.digest(), other.digest());
+        // every page of each part held by one slot at most, and the free counts the rest
+        var held: [2][h]bool = @splat(@splat(false));
+        var count: [2]usize = .{ 0, 0 };
+        for (lead.slots) |x| if (x.used) {
+            for (x.ids.items) |id| {
+                const p = kvs.partOf(id, h);
+                try expectEqual(@as(usize, x.part), p);
+                try expect(!held[p][id - p * h]);
+                held[p][id - p * h] = true;
+                count[p] += 1;
+            }
+            for (x.twin.items) |id| {
+                const p = kvs.partOf(id, h);
+                try expect(p != x.part);
+                try expect(!held[p][id - p * h]);
+                held[p][id - p * h] = true;
+                count[p] += 1;
+            }
+        };
+        for (0..2) |p| try expectEqual(h - count[p], lead.pools[p].available());
+    }
+    for (0..slots) |slot| {
+        lead.close(slot);
+        other.close(slot);
+    }
+    try expectEqual(@as(usize, h), lead.pools[0].available());
+    try expectEqual(@as(usize, h), lead.pools[1].available());
+}
diff --git a/zig/src/families/glm/cuda_kv_shard_pages_test.zig b/zig/src/families/glm/cuda_kv_shard_pages_test.zig
new file mode 100644
index 000000000..1e9a1c6a1
--- /dev/null
+++ b/zig/src/families/glm/cuda_kv_shard_pages_test.zig
@@ -0,0 +1,332 @@
+//! TF_GLM_KV_SHARD's pages on a driver of addresses alone: every page's keys and this rank's latent pages, each
+//! stream's two tables, twins, a follower's map, the layout digest, and the unsharded pages unchanged.
+const std = @import("std");
+const cuda = @import("cuda");
+const weights = @import("cuda_weights.zig");
+const shard = @import("cuda_shard.zig");
+const pages_mod = @import("cuda_pages.zig");
+const state = @import("cuda_state.zig");
+const kvs = @import("cuda_kv_shard.zig");
+const Engine = @import("cuda_engine.zig").Engine;
+const expect = std.testing.expect;
+const expectEqual = std.testing.expectEqual;
+const expectEqualSlices = std.testing.expectEqualSlices;
+
+/// The driver: each allocation a fresh address and its size, the tables written kept by address.
+const F = struct {
+    var next: u64 = 1 << 30;
+    var live: usize = 0;
+    var sizes: [32][2]u64 = undefined; // (address, bytes) of each allocation
+    var n_alloc: usize = 0;
+    var at: [16]u64 = @splat(0);
+    var words: [16][64]u32 = undefined;
+    var fills: usize = 0;
+    fn alloc(out: *u64, n: usize) callconv(.c) cuda.abi.Result {
+        out.* = next;
+        if (n_alloc < sizes.len) sizes[n_alloc] = .{ next, n };
+        n_alloc += 1;
+        next += std.mem.alignForward(u64, n + 1, 1 << 20);
+        live += 1;
+        return 0;
+    }
+    fn free(_: u64) callconv(.c) cuda.abi.Result {
+        live -= 1;
+        return 0;
+    }
+    fn clear(_: u64, _: u8, _: usize) callconv(.c) cuda.abi.Result {
+        return 0;
+    }
+    fn fill(_: u64, v: c_uint, _: usize, _: cuda.abi.Stream) callconv(.c) cuda.abi.Result {
+        fills += @intFromBool(v == 0xFFFF_FFFF);
+        return 0;
+    }
+    fn put(dst: u64, src: ?*const anyopaque, n: usize) callconv(.c) cuda.abi.Result {
+        const ids: [*]const u32 = @ptrCast(@alignCast(src.?));
+        for (&at, &words) |*a, *w| if (a.* == 0 or (dst >= a.* and dst < a.* + 256)) {
+            if (a.* == 0) a.* = dst;
+            const from = (dst - a.*) / 4;
+            @memcpy(w[from..][0 .. n / 4], ids[0 .. n / 4]);
+            return 0;
+        };
+        return 1;
+    }
+    fn wait(_: cuda.abi.Stream) callconv(.c) cuda.abi.Result {
+        return 0;
+    }
+    fn table(t: u64, n: usize) []const u32 {
+        for (at, &words) |a, *w| if (a == t) return w[0..n];
+        return &.{};
+    }
+    fn size(ptr: u64) u64 {
+        for (sizes[0..@min(n_alloc, sizes.len)]) |s| if (s[0] == ptr) return s[1];
+        return 0;
+    }
+};
+
+/// An engine of TP=2's shapes on a KDA, a DSA and a KDA layer, 4,096 rows, E4M3 beside DFlash2, sharded or not.
+const Fake = struct {
+    d: cuda.Driver,
+    layers: [3]weights.Layer,
+    e: Engine,
+
+    /// A fresh driver's records (each test's first fake; a second one shares them).
+    fn reset() void {
+        F.live = 0;
+        F.n_alloc = 0;
+        F.at = @splat(0);
+        F.fills = 0;
+    }
+
+    fn init(f: *Fake, gpa: std.mem.Allocator, rank: usize, on: bool) !void {
+        f.d = undefined;
+        f.d.api.cuMemAlloc_v2 = F.alloc;
+        f.d.api.cuMemFree_v2 = F.free;
+        f.d.api.cuMemsetD8_v2 = F.clear;
+        f.d.api.cuMemsetD32Async = F.fill;
+        f.d.api.cuMemcpyHtoD_v2 = F.put;
+        f.d.api.cuStreamSynchronize = F.wait;
+        for (&f.layers, [_]bool{ false, true, false }) |*l, mla| l.mixer = if (mla) .{ .mla = undefined } else .{ .kda = undefined };
+        f.e = undefined;
+        f.e.gpa = gpa;
+        f.e.d = &f.d;
+        f.e.stream = .{ .d = &f.d, .handle = null };
+        f.e.capacity = 4096;
+        f.e.seqs = .empty;
+        f.e.pages = null;
+        f.e.images = null;
+        f.e.settings = .{ .kv8 = true, .pages = true, .kv_shard = .{ .on = on } };
+        f.e.mtp = false;
+        f.e.w = undefined;
+        f.e.w.config = .{};
+        f.e.w.share = try shard.Share.of(&f.e.w.config, rank, 2);
+        f.e.share = f.e.w.share;
+        f.e.w.layers = &f.layers;
+    }
+
+    fn deinit(f: *Fake, p: ?*pages_mod.Pages) void {
+        if (p) |q| q.deinit();
+        for (f.e.seqs.items) |q| if (q) |s| {
+            s.st.deinit();
+            f.e.gpa.destroy(s);
+        };
+        f.e.seqs.deinit(f.e.gpa);
+    }
+
+    fn pool(f: *Fake, streams: usize, pages: usize, leader: bool) !*pages_mod.Pages {
+        const l = try pages_mod.layout(f.e.gpa, &f.e, 0);
+        try pages_mod.ownSequence(&f.e);
+        const p = try pages_mod.Pages.init(f.e.gpa, &f.e, l, streams, pages, leader);
+        f.e.pages = p;
+        return p;
+    }
+
+    fn st(f: *Fake, slot: usize) *state.State {
+        return &f.e.seqs.items[slot].?.st;
+    }
+};
+
+test "kv shard pages: a token's bytes are every page's keys and half its latent rows; a stream adds a latent table" {
+    var f: Fake = undefined;
+    Fake.reset();
+    try f.init(std.testing.allocator, 0, false);
+    const whole = try pages_mod.layout(std.testing.allocator, &f.e, 0);
+    try expectEqual(@as(u64, 512 + 4 + 64), whole.token_bytes); // unsharded: as before
+    f.e.settings.kv_shard.on = true;
+    const l = try pages_mod.layout(std.testing.allocator, &f.e, 0);
+    const g = pages_mod.geometry(&f.e);
+    try expectEqual(@as(u64, 264_192), g.latPage());
+    try expectEqual(@as(u64, 32_768), g.keyPage());
+    try expectEqual(@as(u64, (32_768 + 132_096) / 512), l.token_bytes); // 322
+    try expectEqual(whole.fixed_bytes + 256, l.fixed_bytes); // the latent table, 256-aligned
+}
+
+test "kv shard pages: every page's keys, this rank's part's latent pages and a trash page; a stream's two tables" {
+    const gpa = std.testing.allocator;
+    var f: Fake = undefined;
+    Fake.reset();
+    try f.init(gpa, 0, true);
+    const p = try f.pool(3, 20, true); // 20 pages: two parts of 8
+    defer f.deinit(p);
+    const x = p.shard.?;
+    try expectEqual(@as(usize, 8), x.parts.h);
+    try expectEqual(@as(u64, 16 * 32_768), F.size(x.keys.?.ptr));
+    try expectEqual(@as(u64, 9 * 264_192), F.size(x.lat.?.ptr));
+    try expectEqual(@as(usize, 0), p.pool.total()); // the unsharded pool holds no page
+    try expect(p.fits(600, 100));
+    const wire = try p.openFor(1, 600, 100, null); // 2 pages in part 0, a twin of 2 in part 1
+    try expectEqualSlices(u32, &.{ 0, 1, 8, 9 }, wire);
+    try expectEqual(@as(usize, 2), p.twinCount(1));
+    const s1 = f.st(1);
+    try expectEqualSlices(u32, &.{ 0, 1 }, F.table(s1.table, 2));
+    try expectEqualSlices(u32, &.{ 0, 1 }, F.table(s1.ltable, 2)); // its owner: its own pages, part-local
+    try expectEqual(kvs.Hold{ .owner = 0, .twin = true }, s1.hold.?);
+    const c = s1.caches[0];
+    try expectEqual(x.lat.?.ptr, c.lc); // the only DSA layer: latent page 0's start
+    try expectEqual(c.lc + 512 * 512, c.ls);
+    try expectEqual(x.keys.?.ptr, c.pk);
+    try expectEqual(s1.table, c.pt);
+    try expectEqual(@as(u64, 32_768), c.ps);
+    try expectEqual(s1.ltable, c.latPt());
+    try expectEqual(@as(u64, 264_192), c.latPs());
+    try expectEqual(@as(usize, 1024), s1.capacity);
+    // the next stream goes to part 1 (fewer live streams), its twin of one page in part 0: rank 0's latent table on it
+    const wire2 = try p.openFor(2, 300, 100, null);
+    try expectEqualSlices(u32, &.{ 10, 2 }, wire2);
+    try expectEqual(@as(usize, 1), p.twinCount(2));
+    try expectEqualSlices(u32, &.{2}, F.table(f.st(2).ltable, 1));
+    try p.giveTwin(2);
+    try expectEqualSlices(u32, &.{8}, F.table(f.st(2).ltable, 1)); // the twin given back: the trash page
+    // a resume's home part first, though it has more streams
+    p.close(2);
+    _ = try p.openFor(2, 300, 100, 0);
+    try expectEqual(@as(u8, 0), f.st(2).hold.?.owner);
+    try p.giveTwin(1);
+    try expectEqual(@as(usize, 0), p.twinCount(1));
+    try expectEqual(kvs.Hold{ .owner = 0 }, f.st(1).hold.?);
+    p.close(1);
+    p.close(2);
+    try expectEqual(@as(usize, 8), x.parts.pools[0].available());
+    try expectEqual(@as(usize, 8), x.parts.pools[1].available());
+}
+
+test "kv shard pages: a request past a part is admitted at once and refused, never left waiting" {
+    const gpa = std.testing.allocator;
+    var f: Fake = undefined;
+    Fake.reset();
+    try f.init(gpa, 0, true);
+    const p = try f.pool(2, 14, true); // parts of 5 pages
+    defer f.deinit(p);
+    try expect(p.fits(2900, 100)); // 6 pages
+    try std.testing.expectError(error.PoolTooSmall, p.openFor(1, 2900, 100, null));
+    try expect(!p.used[1] and p.shard.?.parts.pools[0].available() == 5);
+}
+
+test "kv shard pages: a follower maps rank 0's ids and twin, its latent table on the twin, the digests alike" {
+    const gpa = std.testing.allocator;
+    var lead: Fake = undefined;
+    Fake.reset();
+    try lead.init(gpa, 0, true);
+    const p0 = try lead.pool(3, 20, true);
+    defer lead.deinit(p0);
+    const wire = try gpa.dupe(u32, try p0.openFor(1, 900, 100, null));
+    defer gpa.free(wire);
+    const twin = p0.twinCount(1);
+    try expectEqual(@as(usize, 2), twin);
+    var other: Fake = undefined;
+    try other.init(gpa, 1, true);
+    const p1 = try other.pool(3, 20, false);
+    defer other.deinit(p1);
+    try p1.mapWith(1, wire, twin);
+    const s = other.st(1);
+    try expectEqualSlices(u32, wire[0..2], F.table(s.table, 2));
+    try expectEqualSlices(u32, &.{ 0, 1 }, F.table(s.ltable, 2)); // twin pages 8 and 9: part 1's first two, part-local
+    try expect(s.hold.?.has(0) and s.hold.?.has(1));
+    try expectEqual(p0.digest(), p1.digest());
+    try p1.giveTwin(1);
+    try expectEqualSlices(u32, &.{ 8, 8 }, F.table(s.ltable, 2)); // the trash page: rank 0 alone holds its rows
+    try expect(p0.digest() != p1.digest());
+    try p0.giveTwin(1);
+    try expectEqual(p0.digest(), p1.digest());
+    try std.testing.expectError(error.BadStep, p1.mapWith(2, wire, 5)); // a twin longer than the step
+    try std.testing.expectError(error.KvShardPlacement, p1.mapWith(2, &.{ 1, 9 }, 0)); // across the parts
+    try std.testing.expect(!p1.used[2]);
+}
+
+test "kv shard pages: a twin the other part has no room for is refused and counted, the stream placed alone" {
+    const gpa = std.testing.allocator;
