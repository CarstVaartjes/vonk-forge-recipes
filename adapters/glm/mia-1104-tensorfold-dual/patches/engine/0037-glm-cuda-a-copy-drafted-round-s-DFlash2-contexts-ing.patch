From 333b55e1e830738684f90eb7d2d129f966d1c3d4 Mon Sep 17 00:00:00 2001
From: MiaAI-Lab <mia.ailab1@gmail.com>
Date: Fri, 30 Oct 2026 16:01:48 +0200
Subject: [PATCH 37/63] glm cuda: a copy-drafted round's DFlash2 contexts
 ingest their rows with no block pass (TF_GLM_DFLASH2_COPY_SKIP=1)

When the lane core asks one draft of a stream whose room holds more, a context copy takes its next window and the
block pass's seven drafts are thrown away. With the variable set, such streams' kept rows go into their drafter
contexts on every rank (the block step with flags 1) and the pass runs only for the streams that draft. The stream
holds one placeholder draft at chance 0, so a window that does not take the copy offers no draft. Replies are the
target's picks either way.

---
 zig/src/families/glm/cuda_engine.zig |  7 ++++++
 zig/src/families/glm/cuda_follow.zig | 15 +++++++++---
 zig/src/families/glm/cuda_lanes.zig  | 34 +++++++++++++++++++++++-----
 zig/src/families/glm/dflash.zig      | 22 ++++++++++++++----
 zig/src/families/glm/draft_rule.zig  |  2 ++
 5 files changed, 66 insertions(+), 14 deletions(-)

diff --git a/zig/src/families/glm/cuda_engine.zig b/zig/src/families/glm/cuda_engine.zig
index 39626a30..e96cb7e6 100644
--- a/zig/src/families/glm/cuda_engine.zig
+++ b/zig/src/families/glm/cuda_engine.zig
@@ -559,6 +559,13 @@ pub const Engine = struct {
         try dr.draft(e, reqs);
     }
 
+    /// The kept rows into the contexts of streams a copy drafts next, with no block pass (every rank).
+    pub fn ingestBlock(e: *Engine, reqs: []dflash.Req) !void {
+        const dr = e.drafter orelse return error.NoDrafter;
+        for (reqs) |*q| q.pos = @intCast((e.seqs.items[q.slot] orelse return error.UnknownSlot).st.pos);
+        try dr.ingestOnly(e, reqs);
+    }
+
     pub const holdPrompt = @import("cuda_prompt_hold.zig").save;
     pub const prefillMany = @import("cuda_prompts.zig").prefillMany;
 
