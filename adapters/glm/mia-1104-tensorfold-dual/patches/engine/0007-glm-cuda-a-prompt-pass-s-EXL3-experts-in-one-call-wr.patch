 zig/kernels/cuda/exl3_experts.cu        | 15 +++++++------
 zig/src/cuda/exl3_prompt.zig            | 28 ++++++++++++++++++-------
 zig/src/families/glm/cuda_exl3.zig      | 27 +++++++++++++-----------
 zig/src/families/glm/cuda_exl3_test.zig |  4 ++--
 zig/tests/cuda/exl3_prompt_k6_tests.zig |  2 +-
 5 files changed, 48 insertions(+), 28 deletions(-)

diff --git a/zig/kernels/cuda/exl3_experts.cu b/zig/kernels/cuda/exl3_experts.cu
index c6ddd90f..c5a0ed2e 100644
--- a/zig/kernels/cuda/exl3_experts.cu
+++ b/zig/kernels/cuda/exl3_experts.cu
@@ -497,7 +497,8 @@ extern "C" __global__ void __launch_bounds__(256, 2) tf_exl3_prompt_gu_k6(const
 // Block (256 model-width columns, item): y[row][slot][:] = the down epilogue of the item's pairs (this rank's share).
 template <int K2>
 __device__ __forceinline__ void prompt_down(const half* __restrict__ Xd, const uint64_t* __restrict__ Td, const half* __restrict__ svh_d,
-        float* __restrict__ y, int K, int D, unsigned char* smem_raw, const int* rows_sh, int cb, int e, int cnt, int warp, int lane) {
+        float* __restrict__ y, int K, int D, int ys, int yrow, unsigned char* smem_raw, const int* rows_sh, int cb, int e, int cnt, int warp,
+        int lane) {
     float acc[TMT][TNB][4];
     tmain<1, TPM, K2>(Xd, Xd, Td, Td, rows_sh, cnt, e, K, D >> 4, cb, 1, reinterpret_cast<half*>(smem_raw), acc);
     float* Ed = reinterpret_cast<float*>(smem_raw);
@@ -514,7 +515,9 @@ __device__ __forceinline__ void prompt_down(const half* __restrict__ Xd, const u
 #pragma unroll
                 for (int j = 0; j < 4; ++j) v[j] = Ed[(size_t)i * DN_ES + blk * 128 + 4 * lane + j];
                 fwht128(v, lane);
-                float* o = y + (size_t)p * D + n;
+                // yrow 0: y [pairs][D]; else pair p = row * ys + slot lands in y [rows][yrow][D] (the MoE slot rows, no copy)
+                const size_t at = yrow ? (size_t)(p / ys) * yrow + p % ys : (size_t)p;
+                float* o = y + at * D + n;
 #pragma unroll
                 for (int j = 0; j < 4; ++j) o[j] = v[j] * HAD_SCALE * __half2float(svh_d[(size_t)e * D + n + j]);
             }
@@ -524,22 +527,22 @@ __device__ __forceinline__ void prompt_down(const half* __restrict__ Xd, const u
 
 extern "C" __global__ void __launch_bounds__(256, 2) tf_exl3_prompt_down(const half* __restrict__ Xd, const uint64_t* __restrict__ Td,
         const int* __restrict__ items, const int* __restrict__ counts, const int* __restrict__ members, const half* __restrict__ svh_d,
-        float* __restrict__ y, int K, int D, int ys) {
+        float* __restrict__ y, int K, int D, int ys, int yrow) {
 
     __shared__ __align__(16) unsigned char smem_raw[tsmem_bytes<8>()];
     __shared__ int rows_sh[TPM];
     TF_EXL3_PROMPT_DOWN_HEAD()
-    prompt_down<8>(Xd, Td, svh_d, y, K, D, smem_raw, rows_sh, cb, e, cnt, warp, lane);
+    prompt_down<8>(Xd, Td, svh_d, y, K, D, ys, yrow, smem_raw, rows_sh, cb, e, cnt, warp, lane);
 }
 
 // The same at 3 bits (3-bit mcg down), the arguments tf_exl3_prompt_down's.
 extern "C" __global__ void __launch_bounds__(256, 2) tf_exl3_prompt_down_k6(const half* __restrict__ Xd, const uint64_t* __restrict__ Td,
         const int* __restrict__ items, const int* __restrict__ counts, const int* __restrict__ members, const half* __restrict__ svh_d,
-        float* __restrict__ y, int K, int D, int ys) {
+        float* __restrict__ y, int K, int D, int ys, int yrow) {
 
     __shared__ __align__(16) unsigned char smem_raw[tsmem_bytes<6>()];
     __shared__ int rows_sh[TPM];
     TF_EXL3_PROMPT_DOWN_HEAD()
-    prompt_down<6>(Xd, Td, svh_d, y, K, D, smem_raw, rows_sh, cb, e, cnt, warp, lane);
+    prompt_down<6>(Xd, Td, svh_d, y, K, D, ys, yrow, smem_raw, rows_sh, cb, e, cnt, warp, lane);
 }
 #undef TF_EXL3_PROMPT_DOWN_HEAD
diff --git a/zig/src/cuda/exl3_prompt.zig b/zig/src/cuda/exl3_prompt.zig
index 03f53195..5aac9a90 100644
--- a/zig/src/cuda/exl3_prompt.zig
+++ b/zig/src/cuda/exl3_prompt.zig
@@ -8,7 +8,9 @@ const Function = @import("module.zig").Function;
 const Stream = @import("stream.zig").Stream;
 
 pub const tile = 64;
-pub const Scratch = struct { xg: u64, xu: u64, xd: u64, y: u64, rows: usize, slots: usize };
+/// `y` [pairs][dims] fp32 when `yrow` is 0; with `yrow` set the caller points `y` at its own slot rows ([rows][yrow][dims],
+/// pair p = row * slots + slot at row * yrow + slot) and the down kernel writes there, so no copy follows.
+pub const Scratch = struct { xg: u64, xu: u64, xd: u64, y: u64, rows: usize, slots: usize, yrow: usize = 0 };
 /// A group's verified half-bit width: its own field, else uniform_k2; 0 when unverified or the two disagree.
 fn verified(group: u32, uniform: u32) u32 {
     if (group == 0) return uniform;
@@ -35,23 +37,34 @@ fn aligned(n: usize) !usize {
     return (try add(n, 255)) / 256 * 256;
 }
 fn sizes(l: ex.Layer, rows: usize, slots: usize) ![4]usize {
+    return sizesFor(l, rows, slots, true);
+}
+/// `own_y` false: the caller's slot rows take the output (Scratch.yrow), so the arena holds no y.
+fn sizesFor(l: ex.Layer, rows: usize, slots: usize, own_y: bool) ![4]usize {
     if (!eligible(l) or rows == 0 or slots == 0 or slots > 32 or l.experts == 0 or l.experts > grouped.max_experts) return error.Exl3Shape;
     const pairs = try mul(rows, slots);
     if (pairs > std.math.maxInt(i32) or l.dims > std.math.maxInt(i32) or l.width > std.math.maxInt(i32)) return error.Exl3Shape;
     const rotated = try aligned(try mul(try mul(if (l.shared_input) rows else pairs, l.dims), 2));
-    return .{ rotated, if (l.shared_input) 0 else rotated, try aligned(try mul(try mul(pairs, l.width), 2)), try aligned(try mul(try mul(pairs, l.dims), 4)) };
+    return .{ rotated, if (l.shared_input) 0 else rotated, try aligned(try mul(try mul(pairs, l.width), 2)), if (own_y) try aligned(try mul(try mul(pairs, l.dims), 4)) else 0 };
 }
 pub fn bytes(l: ex.Layer, rows: usize, slots: usize) !usize {
-    const ns = try sizes(l, rows, slots);
+    return bytesFor(l, rows, slots, true);
+}
+pub fn bytesFor(l: ex.Layer, rows: usize, slots: usize, own_y: bool) !usize {
+    const ns = try sizesFor(l, rows, slots, own_y);
     var sum: usize = 0;
     for (ns) |n| sum = try add(sum, n);
     return sum;
 }
 pub fn scratch(base: u64, l: ex.Layer, rows: usize, slots: usize) !Scratch {
-    const ns = try sizes(l, rows, slots);
-    const total = try bytes(l, rows, slots);
+    return scratchFor(base, l, rows, slots, true);
+}
+/// `own_y` false: `y` is 0 until the caller sets it and `yrow` (its slot rows).
+pub fn scratchFor(base: u64, l: ex.Layer, rows: usize, slots: usize, own_y: bool) !Scratch {
+    const ns = try sizesFor(l, rows, slots, own_y);
+    const total = try bytesFor(l, rows, slots, own_y);
     _ = std.math.add(u64, base, total) catch return error.Exl3Shape;
-    return .{ .xg = base, .xu = if (l.shared_input) base else base + ns[0], .xd = base + ns[0] + ns[1], .y = base + ns[0] + ns[1] + ns[2], .rows = rows, .slots = slots };
+    return .{ .xg = base, .xu = if (l.shared_input) base else base + ns[0], .xd = base + ns[0] + ns[1], .y = if (own_y) base + ns[0] + ns[1] + ns[2] else 0, .rows = rows, .slots = slots };
 }
 fn go(f: Function, s: Stream, grid: [3]usize, threads: u32, values: anytype) !void {
     var args: launch.Args = .{};
@@ -78,6 +91,7 @@ pub const Kernels = struct {
     }
     pub fn run(k: Kernels, e: *const ex.Experts, router: grouped.Router, s: Stream, l: ex.Layer, x: u64, stride: usize, picks: u64, rows: usize, sc: Scratch, p: grouped.Plan) !void {
         if (!eligible(l) or rows == 0 or rows > sc.rows or stride < l.dims or stride > std.math.maxInt(i32)) return error.Exl3Shape;
+        if (sc.y == 0 or (sc.yrow != 0 and sc.yrow < sc.slots)) return error.Exl3Shape;
         _ = try bytes(l, rows, sc.slots);
         const pairs = rows * sc.slots;
         const w = widths(l);
@@ -91,7 +105,7 @@ pub const Kernels = struct {
         }
         const items = grouped.maxItems(pairs, l.experts, tile);
         try go(if (w.gu == 6) k.gateup_k6 else k.gateup, s, .{ l.width / 128, items, 1 }, 256, .{ sc.xg, sc.xu, l.gate, l.up, p.items, p.counts, p.members, l.svh_g, l.svh_u, l.suh_d, sc.xd, i(l.dims), i(l.width), i(if (l.shared_input) sc.slots else 1), l.limit, l.act_mode });
-        try go(if (w.d == 6) k.down_k6 else k.down, s, .{ l.dims / 256, items, 1 }, 256, .{ sc.xd, l.down, p.items, p.counts, p.members, l.svh_d, sc.y, i(l.width), i(l.dims), i(sc.slots) });
+        try go(if (w.d == 6) k.down_k6 else k.down, s, .{ l.dims / 256, items, 1 }, 256, .{ sc.xd, l.down, p.items, p.counts, p.members, l.svh_d, sc.y, i(l.width), i(l.dims), i(sc.slots), i(sc.yrow) });
     }
 };
 
diff --git a/zig/src/families/glm/cuda_exl3.zig b/zig/src/families/glm/cuda_exl3.zig
index 81ae73ea..125d58cc 100644
--- a/zig/src/families/glm/cuda_exl3.zig
+++ b/zig/src/families/glm/cuda_exl3.zig
@@ -220,8 +220,10 @@ pub const Kernels = cuda.exl3_experts.Experts;
 const common = cuda.exl3_experts;
 pub const Scratch = struct { picks: u64, xg: u64, xu: u64, z: u64 };
 pub const top_k = 8;
-/// Rows a call to the common experts takes: each call reads every expert's weights, so a prompt pass needs few calls.
-pub const chunk_rows = 1024;
+/// Rows a call to the common experts takes: each call decodes every expert's weights, so a prompt pass takes one call
+/// (it follows cuda_state.prefill_rows, 4,096 with PR #1576). At 1024 every trellis tile was decoded twice a pass for ~28
+/// pairs an expert; a pair's sums do not depend on which item holds it, so the bits are the same.
+pub const chunk_rows = @import("cuda_state.zig").prefill_rows;
 /// The common module's layer: a width table a projection, and the widths the loader found uniform.
 pub fn layer(w: Experts, count: usize, dims: usize, width: usize, limit: f32) common.Layer {
     return .{
@@ -259,7 +261,8 @@ pub fn picksBytes(rows: usize) usize {
 pub fn scratchFor(rows: usize, dims: usize, width: usize, prefill: bool, w: Experts) [4]usize {
     const n: usize = @min(rows, chunk_rows);
     const l = layer(w, cuda.grouped.max_experts, dims, width, 0);
-    if (prefill and common.prompt.eligible(l)) return .{ picksBytes(rows) + (common.prompt.bytes(l, n, top_k) catch unreachable), 4, 4, 4 };
+    // the prompt kernels write the slot rows (Scratch.yrow): no y [pairs][dims] in the arena
+    if (prefill and common.prompt.eligible(l)) return .{ picksBytes(rows) + (common.prompt.bytesFor(l, n, top_k, false) catch unreachable), 4, 4, 4 };
     return .{ picksBytes(rows) + (common.scratchBytes(l, n, top_k) catch unreachable), 4, 4, 4 };
 }
 /// `scratchFor` a 4-bit layer (every projection 8 half-bits), `shx` its shared rotation.
@@ -287,16 +290,16 @@ pub fn run(k: *const Kernels, ek: *const experts.Kernels, stream: cuda.Stream, w
     while (at < rows) : (at += chunk_rows) {
         const n: usize = @min(chunk_rows, rows - at);
         try copyRows(stream, sc.picks, top_k * 4, picks + at * slots * 4, slots * 4, top_k * 4, n, "EXL3 compact route rows");
-        const output = if (fused) blk: {
-            const scratch = try common.prompt.scratch(arena, l, cap, top_k);
+        if (fused) { // the down kernel writes this chunk's routed slots of ey straight (slot top_k: the shared expert's)
+            var scratch = try common.prompt.scratchFor(arena, l, cap, top_k, false);
+            scratch.y = ey + at * slots * dims * 4;
+            scratch.yrow = slots;
             try k.prompt.run(k, ek.router, stream, l, x + at * x_stride * 2, x_stride, sc.picks, n, scratch, plan_buf);
-            break :blk scratch.y;
-        } else blk: {
-            const scratch = try common.scratch(arena, l, cap, top_k);
-            try k.runSlots(stream, l, x + at * x_stride * 2, x_stride, .bf16, sc.picks, n, scratch);
-            break :blk scratch.y;
-        };
-        try copyRows(stream, ey + at * slots * dims * 4, slots * dims * 4, output, top_k * dims * 4, top_k * dims * 4, n, "EXL3 routed output slots");
+            continue;
+        }
+        const scratch = try common.scratch(arena, l, cap, top_k);
+        try k.runSlots(stream, l, x + at * x_stride * 2, x_stride, .bf16, sc.picks, n, scratch);
+        try copyRows(stream, ey + at * slots * dims * 4, slots * dims * 4, scratch.y, top_k * dims * 4, top_k * dims * 4, n, "EXL3 routed output slots");
     }
 }
 
