 zig/src/server/tool_guard.zig  | 90 ++++++++++++++++++++++++++++++++++
 zig/src/server/tool_stream.zig | 25 ++++++++--
 3 files changed, 140 insertions(+), 8 deletions(-)
 create mode 100644 zig/src/server/tool_guard.zig

