diff --git a/zig/src/families/glm/cuda_fp8block.zig b/zig/src/families/glm/cuda_fp8block.zig
new file mode 100644
index 000000000..b15bdf803
--- /dev/null
+++ b/zig/src/families/glm/cuda_fp8block.zig
@@ -0,0 +1,76 @@
+//! GLM-5.3-Flash checkpoints in block FP8 (quant_method "fp8": e4m3 codes with fp32 128 x 128 scales, Z.AI's and
+//! unsloth's layout): their admission. The routed experts load as cuda/experts.zig's fp8g layer (cuda_weights.zig),
+//! every other FP8 linear as the lane's block-FP8 projection (cuda_formats.zig's fp8_pb), the rest bf16 as stored.
+
+const std = @import("std");
+const core = @import("core");
+const modelopt = core.modelopt;
+
+/// The scale block the kernels take, both ways (cuda/experts.zig Fp8Experts.block, cuda_fp8pb's tiles).
+pub const block = 128;
+
+/// config.json's quantization_config (top level, else text_config's), when it has one.
+fn table(root: std.json.Value) ?std.json.ObjectMap {
+    if (root != .object) return null;
+    if (root.object.get("quantization_config")) |q| if (q == .object) return q.object;
+    if (root.object.get("text_config")) |t| if (t == .object) if (t.object.get("quantization_config")) |q| if (q == .object) return q.object;
+    return null;
+}
+
+fn method(q: std.json.ObjectMap) ?[]const u8 {
+    const m = q.get("quant_method") orelse return null;
+    return if (m == .string) m.string else null;
+}
+
+/// Whether config.json names block FP8 (quant_method "fp8"): `admit` then says whether this family reads it.
+pub fn isFp8(gpa: std.mem.Allocator, config_json: []const u8) bool {
+    const parsed = std.json.parseFromSlice(std.json.Value, gpa, config_json, .{}) catch return false;
+    defer parsed.deinit();
+    const q = table(parsed.value) orelse return false;
+    return std.mem.eql(u8, method(q) orelse return false, "fp8");
+}
+
+/// The block-FP8 checkpoints the kernels read: e4m3 with 128 x 128 weight blocks. A per-tensor FP8 (no block size),
+/// another block, or another code format is refused by name.
+pub fn admit(gpa: std.mem.Allocator, config_json: []const u8, why: *modelopt.Why) !void {
+    const parsed = try std.json.parseFromSlice(std.json.Value, gpa, config_json, .{});
+    defer parsed.deinit();
+    const q = table(parsed.value) orelse {
+        why.set("no quantization_config", .{});
+        return error.UnsupportedQuant;
+    };
+    if (!std.mem.eql(u8, method(q) orelse "", "fp8")) {
+        why.set("quant_method is not fp8", .{});
+        return error.UnsupportedQuant;
+    }
+    if (q.get("fmt")) |f| if (f != .string or !std.mem.eql(u8, f.string, "e4m3")) {
+        why.set("fp8 fmt is not e4m3: the kernels read e4m3 codes", .{});
+        return error.UnsupportedQuant;
+    };
+    const bs = q.get("weight_block_size") orelse {
+        why.set("fp8 without weight_block_size (per-tensor scales): the lanes read 128 x 128 block scales", .{});
+        return error.UnsupportedQuant;
+    };
+    if (bs != .array or bs.array.items.len != 2 or bs.array.items[0] != .integer or bs.array.items[1] != .integer or bs.array.items[0].integer != block or bs.array.items[1].integer != block) {
+        why.set("fp8 weight_block_size is not [{d}, {d}]", .{ block, block });
+        return error.UnsupportedQuant;
+    }
+}
+
+test "block FP8 with 128 x 128 scales is admitted; per-tensor FP8, other blocks and other methods are refused by name" {
+    const gpa = std.testing.allocator;
+    var why: modelopt.Why = .{};
+    const good = "{\"quantization_config\": {\"quant_method\": \"fp8\", \"fmt\": \"e4m3\", \"activation_scheme\": \"dynamic\", \"weight_block_size\": [128, 128]}}";
+    try std.testing.expect(isFp8(gpa, good));
+    try admit(gpa, good, &why);
+    const nested = "{\"text_config\": {\"quantization_config\": {\"quant_method\": \"fp8\", \"weight_block_size\": [128, 128]}}}";
+    try std.testing.expect(isFp8(gpa, nested));
+    try admit(gpa, nested, &why);
+    try std.testing.expectError(error.UnsupportedQuant, admit(gpa, "{\"quantization_config\": {\"quant_method\": \"fp8\", \"fmt\": \"e4m3\"}}", &why));
+    try std.testing.expect(std.mem.indexOf(u8, why.text(), "per-tensor") != null);
+    try std.testing.expectError(error.UnsupportedQuant, admit(gpa, "{\"quantization_config\": {\"quant_method\": \"fp8\", \"weight_block_size\": [64, 64]}}", &why));
+    try std.testing.expectError(error.UnsupportedQuant, admit(gpa, "{\"quantization_config\": {\"quant_method\": \"fp8\", \"fmt\": \"e5m2\", \"weight_block_size\": [128, 128]}}", &why));
+    try std.testing.expect(!isFp8(gpa, "{\"quantization_config\": {\"quant_method\": \"exl3\"}}"));
+    try std.testing.expectError(error.UnsupportedQuant, admit(gpa, "{\"quantization_config\": {\"quant_method\": \"exl3\"}}", &why));
+    try std.testing.expect(!isFp8(gpa, "{}"));
+}
