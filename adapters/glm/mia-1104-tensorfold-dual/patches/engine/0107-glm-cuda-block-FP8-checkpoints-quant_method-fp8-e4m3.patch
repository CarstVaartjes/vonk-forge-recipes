+    /// Layer `i`'s routed block FP8 experts (quant_method "fp8", the MTP layer's too) as cuda/experts.zig's fp8g layer:
+    /// gate and up by the rank's rows, down by the rank's inputs, the e4m3 codes packed on the host
+    /// (Fp8Experts.packGateUp, packOne) and the fp32 128 x 128 scales cut to the rank's blocks, gate's then up's
+    /// ([E][2][ni/128][d/128]) and down's ([E][1][d/128][ni/128]); dequantized = codes x scale, as stored.
+    fn fp8Experts(L: *Loader, i: u32) !cuda.experts.Layer {
+        const F = cuda.experts.Fp8Experts;
+        const c = &L.w.config;
+        const d: usize = c.hidden;
+        const cut = L.w.share.moe;
+        const ni = cut.len();
+        const count: usize = c.experts;
+        const b = F.block;
+        if (ni % b != 0 or d % b != 0 or cut.lo % b != 0) {
+            std.log.err("layers.{d}: a rank's {d} expert rows from {d} and {d} inputs are not whole {d} x {d} FP8 blocks", .{ i, ni, cut.lo, d, b, b });
+            return error.BadFp8Share;
+        }
+        const nb = ni / b; // the rank's row blocks (gate, up) and input blocks (down)
+        const db = d / b;
+        const sb = nb * db; // scale blocks of one of the rank's matrices
+        const up_len = ni * d / 2; // u32 words: gate and up interleaved (two e4m3 [ni][d])
+        const down_len = d * ni / 4; // down [d][ni]
+        const up = try L.gpa.alloc(u32, count * up_len);
+        defer L.gpa.free(up);
+        const down = try L.gpa.alloc(u32, count * down_len);
+        defer L.gpa.free(down);
+        const up_scale = try L.gpa.alloc(f32, count * 2 * sb);
+        defer L.gpa.free(up_scale);
+        const down_scale = try L.gpa.alloc(f32, count * sb);
+        defer L.gpa.free(down_scale);
+        const dcodes = try L.gpa.alloc(u8, d * ni); // down's rows cut to the rank's inputs
+        defer L.gpa.free(dcodes);
+        for (0..count) |e| {
+            var ps: [3]formats.fp8pb.Fp8pb = undefined;
+            var made: usize = 0;
+            defer for (ps[0..made]) |p| p.deinit(L.gpa);
+            inline for (.{ "gate_proj", "up_proj", "down_proj" }, 0..) |proj, m| {
+                const name = try std.fmt.bufPrint(&L.name_buf, prefix ++ "layers.{d}.mlp.experts.{d}." ++ proj, .{ i, e });
+                try L.formatIn(L.ck, name, .fp8_pb);
+                ps[m] = try formats.fp8pb.Fp8pb.read(L.gpa, L.ck, name);
+                made += 1;
+                const want_n: usize = if (m < 2) c.moe_inter else d;
+                const want_k: usize = if (m < 2) d else c.moe_inter;
+                if (ps[m].n != want_n or ps[m].k != want_k) {
+                    std.log.err("{s}: [{d}, {d}], not [{d}, {d}]", .{ name, ps[m].n, ps[m].k, want_n, want_k });
+                    return error.UnexpectedTensor;
+                }
+            }
+            // gate and up: rows [lo, hi) and their block rows; down: inputs [lo, hi) of every row and their block columns
+            try F.packGateUp(L.gpa, up[e * up_len ..][0..up_len], ps[0].codes[cut.lo * d ..][0 .. ni * d], ps[1].codes[cut.lo * d ..][0 .. ni * d], ni, d);
+            for (0..2) |m| @memcpy(up_scale[(2 * e + m) * sb ..][0..sb], ps[m].scales[(cut.lo / b) * db ..][0..sb]);
+            const kt = ps[2].k;
+            for (0..d) |r| @memcpy(dcodes[r * ni ..][0..ni], ps[2].codes[r * kt + cut.lo ..][0..ni]);
+            F.packOne(down[e * down_len ..][0..down_len], dcodes, d, ni);
+            const kb = kt / b;
+            for (0..db) |rb| @memcpy(down_scale[e * sb + rb * nb ..][0..nb], ps[2].scales[rb * kb + cut.lo / b ..][0..nb]);
+        }
+        var ptrs: [4]u64 = undefined;
+        for (&ptrs, [_][]const u8{ std.mem.sliceAsBytes(up), std.mem.sliceAsBytes(down), std.mem.sliceAsBytes(up_scale), std.mem.sliceAsBytes(down_scale) }, [_][]const u8{ "up", "down", "up_scale", "down_scale" }) |*p, bytes, what| {
+            try L.host.appendSlice(L.gpa, bytes);
+            p.* = try L.put("layers.{d}.moe.experts.{s}", .{ i, what });
+        }
+        return .{ .format = .fp8g, .up = ptrs[0], .down = ptrs[1], .up_scale = ptrs[2], .down_scale = ptrs[3], .width = ni, .dims = d, .experts = count, .limit = c.swiglu_limit };
+    }
