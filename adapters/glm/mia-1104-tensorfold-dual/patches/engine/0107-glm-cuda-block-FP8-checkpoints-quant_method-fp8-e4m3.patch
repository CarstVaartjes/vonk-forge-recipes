+test "a block FP8 checkpoint's module is bf16 or block FP8, never NVFP4 or MXFP8" {
+    const w = meta(.bf16, &.{ 8192, 4096 });
+    try testing.expectEqual(Format.bf16, try of(.fp8_block, .{ .weight = w }));
+    const pb = Stored{ .weight = meta(.f8_e4m3, &.{ 2048, 4096 }), .scale = meta(.f32, &.{ 16, 32 }) };
+    try testing.expectEqual(Format.fp8_pb, try of(.fp8_block, pb));
+    const q = Stored{ .weight = meta(.u8, &.{ 2048, 2048 }), .scale = meta(.f8_e4m3, &.{ 2048, 256 }) };
+    try testing.expectError(error.FormatMismatch, of(.fp8_block, q));
+    const mx = Stored{ .weight = meta(.f8_e4m3, &.{ 2048, 4096 }), .scale = meta(.u8, &.{ 2048, 128 }) };
+    try testing.expectError(error.FormatMismatch, of(.fp8_block, mx));
