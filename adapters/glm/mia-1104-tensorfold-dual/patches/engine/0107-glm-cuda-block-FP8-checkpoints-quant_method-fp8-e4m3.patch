-    /// `module`'s weight and weight_scale ([Rb, 1, Cb, 1] or [Rb, Cb]), checked as formats.of checks them.
+    /// `module`'s weight and weight_scale or weight_scale_inv ([Rb, 1, Cb, 1] or [Rb, Cb]), checked as formats.of checks them.
     pub fn read(gpa: std.mem.Allocator, ck: *core.Checkpoint, module: []const u8) !Fp8pb {
         var buf: [256]u8 = undefined;
         const w = try ck.get(try std.fmt.bufPrint(&buf, "{s}.weight", .{module}));
-        const s = try ck.get(try std.fmt.bufPrint(&buf, "{s}.weight_scale", .{module}));
+        var sbuf: [256]u8 = undefined;
+        const s = try ck.get(formats.scaleName(ck, &sbuf, module) orelse return error.BadFp8pb);
         _ = formats.of(.{ .mixed = .fp8_pb_wo }, .{ .weight = formats.metaOf(&w), .scale = formats.metaOf(&s) }) catch return error.BadFp8pb;
         const scales = try gpa.alloc(f32, s.numel());
         for (scales, 0..) |*v, j| v.* = @bitCast(std.mem.readInt(u32, s.bytes[4 * j ..][0..4], .little));
diff --git a/zig/src/families/glm/cuda_mlp.zig b/zig/src/families/glm/cuda_mlp.zig
index 68a94468f..7f6abccfc 100644
--- a/zig/src/families/glm/cuda_mlp.zig
+++ b/zig/src/families/glm/cuda_mlp.zig
@@ -6,11 +6,13 @@ const glue = @import("cuda_glue.zig");
 const b16 = @import("cuda_b16.zig");
 const projection = @import("cuda_proj.zig");
 
-/// A dense layer's weights: NVFP4 as Fp4Linear holds them, an EXL3 checkpoint's bf16, or FP4-Local's MXFP8.
+/// A dense layer's weights: NVFP4 as Fp4Linear holds them, an EXL3 checkpoint's bf16, FP4-Local's MXFP8, or a
+/// block FP8 checkpoint's (quant_method "fp8").
 pub const Weights = union(enum) {
     nvfp4: struct { gate: cuda.qmmf.Weight, up: cuda.qmmf.Weight, down: cuda.qmmf.Weight },
     bf16: struct { gu: u64, down: u64 }, // [gate | up] rows [2 width][dims], down [dims][width]
     mxfp8: struct { gu: cuda.qmmf.Weight, down: cuda.qmmf.Weight }, // the same two, packed for the lane
+    fp8g: struct { gu: cuda.qmmf.Weight, down: cuda.qmmf.Weight }, // the same two, block FP8 packed for the lane
 };
 
 /// One dense layer on a rank: gate and up [width][dims] and down [dims][width].
@@ -44,6 +46,7 @@ pub fn fill(k: Kernels, stream: cuda.Stream, l: Layer, s: Scratch, lo: usize, hi
         .nvfp4 => |w| try mm(k, stream, w.down, s.act + lo * l.width * 2, l.width, hi - lo, out, true, prompt),
         .bf16 => |w| try b16.matmul(k.set, stream, s.act + lo * l.width * 2, l.width, w.down, out, s.mm_part, hi - lo, l.dims, l.width, true),
         .mxfp8 => |w| try projection.matmul(k.set, stream, .{ .mxfp8 = w.down }, s.act + lo * l.width * 2, l.width, out, s.mm_part, hi - lo, l.dims, l.width, true),
+        .fp8g => |w| try projection.matmul(k.set, stream, .{ .fp8g = w.down }, s.act + lo * l.width * 2, l.width, out, s.mm_part, hi - lo, l.dims, l.width, true),
     }
 }
 
@@ -60,6 +63,10 @@ pub fn body(k: Kernels, stream: cuda.Stream, l: Layer, s: Scratch, x: u64, x_str
             try projection.matmul(k.set, stream, .{ .mxfp8 = m.gu }, x, x_stride, s.gu, s.mm_part, rows, 2 * w, l.dims, false);
             return glue.swiglu(k.set, stream, s.gu, s.act, s.xs_act, l.limit, rows, w);
         },
+        .fp8g => |m| { // the same, block FP8
+            try projection.matmul(k.set, stream, .{ .fp8g = m.gu }, x, x_stride, s.gu, s.mm_part, rows, 2 * w, l.dims, false);
+            return glue.swiglu(k.set, stream, s.gu, s.act, s.xs_act, l.limit, rows, w);
+        },
     };
     for ([_]cuda.qmmf.Weight{ q.gate, q.up }, 0..) |proj, j| {
         // Fp4Linear(out=a column slice): the rows computed contiguous, then copied into their half of each row
