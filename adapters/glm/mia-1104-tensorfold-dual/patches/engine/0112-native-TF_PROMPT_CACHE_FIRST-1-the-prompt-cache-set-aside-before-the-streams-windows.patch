From 59360119ad3145bf7423c96234485e4597b84981 Mon Sep 17 00:00:00 2001
From: MiaAI Lab <mia.ailab1@gmail.com>
Date: Fri, 6 Nov 2026 10:58:41 +0200
Subject: [PATCH] native: TF_PROMPT_CACHE_FIRST=1, an opt-in: the prompt cache
 (--prompt-cache-gib) is set aside before the room is counted in whole
 windows, so the streams share the pages left (the engine's own window at
 least) instead of the cache taking what whole windows leave; unset, the plan
 is as before. The startup log says when the room funds less cache than
 --prompt-cache-gib asks, and what frees more

---
 zig/src/core/kv_pool.zig        | 30 +++++++++++++++++++++++++++++-
 zig/src/native/cuda_kv_pool.zig | 13 +++++++++++--
 2 files changed, 40 insertions(+), 3 deletions(-)

diff --git a/zig/src/core/kv_pool.zig b/zig/src/core/kv_pool.zig
index a1e0cbc09..73d10a811 100644
--- a/zig/src/core/kv_pool.zig
+++ b/zig/src/core/kv_pool.zig
@@ -56,6 +56,9 @@ pub const Budget = struct {
     window: u64 = 0,
     /// The engine's own rows are pages too: a window of them first, then the cache after the windows the room holds.
     engine_paged: bool = false,
+    /// The cache is set aside before the room is counted in windows (TF_PROMPT_CACHE_FIRST=1): the other streams
+    /// share the pages left, at least the engine's own window, instead of the cache taking what whole windows leave.
+    cache_first: bool = false,
 };
 
 /// The streams served, the cache's slots and copied-KV bytes, and the pages left for the streams; `skipped`: cache bytes
@@ -104,7 +107,8 @@ fn held(l: Layout, b: Budget, fit: u64) u64 {
 fn windows(l: Layout, b: Budget) u64 {
     if (!b.engine_paged or b.window == 0) return 1;
     const own = ownPages(l, b);
-    return @min(b.lanes, 1 + (b.room - own) / (own + l.fixed_bytes));
+    const room = if (b.cache_first) b.room -| b.cache else b.room;
+    return @min(b.lanes, 1 + (room -| own) / (own + l.fixed_bytes));
 }
 
 /// The bytes of the engine's own window as pages, set aside first when its rows are pages (0 when it has a window).
@@ -384,6 +388,30 @@ pub const Pool = struct {
     }
 };
 
+test "kv plan: cache_first sets the cache aside before the windows, the pool keeping the engine's own window" {
+    // GLM on a 2-Spark pair at a 1M window: 2,049 pages a window, 378 MiB fixed a stream, 19 GiB of room.
+    const l: Layout = .{ .fixed_bytes = 378 << 20, .token_bytes = 6380, .page_tokens = 512, .snap_bytes = 0 };
+    const b: Budget = .{ .room = 19 << 30, .engine = 0, .lanes = 8, .cache = 16 << 30, .window = 1 << 20, .engine_paged = true };
+    const window_pages = l.pages(1 << 20);
+    const late = try plan(l, b);
+    var first_b = b;
+    first_b.cache_first = true;
+    const first = try plan(l, first_b);
+    try std.testing.expectEqual(@as(u32, 8), late.lanes);
+    try std.testing.expectEqual(@as(u32, 8), first.lanes);
+    try std.testing.expect(late.pages >= 2 * window_pages); // two whole windows first, the cache what they leave
+    try std.testing.expect(first.pages >= window_pages and first.pages < 2 * window_pages);
+    try std.testing.expect(first.copied > late.copied + (5 << 30));
+    try std.testing.expect(first.copied <= b.cache);
+    try std.testing.expect(holds(l, .{ .room = 19 << 30, .engine = 0, .lanes = 8, .cache = 8 << 30, .window = 1 << 20, .engine_paged = true, .cache_first = true }));
+    // A cache under what one window leaves changes nothing.
+    var small = b;
+    small.cache = 1 << 30;
+    var small_first = small;
+    small_first.cache_first = true;
+    try std.testing.expectEqual(try plan(l, small), try plan(l, small_first));
+}
+
 test {
     _ = @import("kv_pool_test.zig");
     _ = @import("kv_pool_counts_test.zig");
diff --git a/zig/src/native/cuda_kv_pool.zig b/zig/src/native/cuda_kv_pool.zig
index 79a669090..8b9a67d51 100644
--- a/zig/src/native/cuda_kv_pool.zig
+++ b/zig/src/native/cuda_kv_pool.zig
@@ -68,7 +68,7 @@ pub fn placeHost(comptime F: type, a: Allocator, loaded: anytype, o: api.Open, a
 fn fits(comptime F: type, loaded: anytype, o: api.Open, room: u64, window: u64, stream_bytes: u64) bool {
     const want = budget.cacheBytes(o.prompt_cache_gib, std.math.maxInt(u64), 0);
     const rows: u64 = if (comptime @hasDecl(F, "window_rows")) F.window_rows else 0;
-    if (layout(loaded)) |l| return kv_pool.holds(l, .{ .room = room, .engine = 0, .lanes = o.lanes, .fixed = o.lanes_fixed, .cache = want, .snaps = named(o), .window = window + rows, .engine_paged = enginePaged(loaded) });
+    if (layout(loaded)) |l| return kv_pool.holds(l, .{ .room = room, .engine = 0, .lanes = o.lanes, .fixed = o.lanes_fixed, .cache = want, .snaps = named(o), .window = window + rows, .engine_paged = enginePaged(loaded), .cache_first = cacheFirst() });
     const n = budget.admit(room, stream_bytes, loaded.free_streams, o.lanes, o.lanes_fixed) catch return false;
     return room -| stream_bytes * (n -| loaded.free_streams) >= want;
 }
@@ -87,11 +87,13 @@ pub const Facts = struct { reserve: ?Reserve = null, min_state: u64 = 0 };
 pub fn plan(comptime F: type, a: Allocator, l: kv_pool.Layout, room: u64, o: api.Open, window: u64, problem: *[]const u8, host_mode: bool, engine_paged: bool, facts: Facts) !?Plan {
     const rows: u64 = if (comptime @hasDecl(F, "window_rows")) F.window_rows else 0;
     const want = if (host_mode) 0 else budget.cacheBytes(o.prompt_cache_gib, std.math.maxInt(u64), 0);
-    var b: kv_pool.Budget = .{ .room = room, .engine = 0, .lanes = o.lanes, .fixed = o.lanes_fixed, .cache = want, .snaps = named(o), .window = window + rows, .engine_paged = engine_paged };
+    var b: kv_pool.Budget = .{ .room = room, .engine = 0, .lanes = o.lanes, .fixed = o.lanes_fixed, .cache = want, .snaps = named(o), .window = window + rows, .engine_paged = engine_paged, .cache_first = cacheFirst() };
     var p = kv_pool.plan(l, b) catch |e| {
         problem.* = try refusal(a, l, b, e, window, rows, facts.reserve);
         return null;
     };
+    if (!host_mode and engine_paged and o.prompt_cache_gib != null and p.copied + (256 << 20) < want)
+        std.log.info("prompt cache: the room funds {d:.1} GiB of the {d:.1} GiB --prompt-cache-gib asks, after {d} pages for the streams; a lower --context or --parallel leaves more{s}", .{ toGib(p.copied), toGib(want), p.pages, if (b.cache_first) "" else ", or TF_PROMPT_CACHE_FIRST=1 sets the cache aside before the streams' windows" });
     if (comptime @hasDecl(F, "snap_host_tier")) if (p.copied > 0 and p.copied < facts.min_state) {
         b.cache = 0; // the same streams: neither refusal reads the cache
         const skipped = p.copied;
@@ -191,6 +193,13 @@ pub fn text(comptime F: type, a: Allocator, stream_bytes: u64, l: ?kv_pool.Layou
     return .{ shape, cache };
 }
 
+/// TF_PROMPT_CACHE_FIRST=1: the prompt cache (--prompt-cache-gib) is set aside before the room is counted in whole
+/// windows, so the streams share what is left (the engine's own window at least). Unset or 0: windows first, as before.
+fn cacheFirst() bool {
+    const v = std.c.getenv("TF_PROMPT_CACHE_FIRST") orelse return false;
+    return std.mem.eql(u8, std.mem.span(v), "1");
+}
+
 fn named(o: api.Open) ?usize {
     return if (o.keep) |k| @intCast(@max(k, 0)) else null;
 }
