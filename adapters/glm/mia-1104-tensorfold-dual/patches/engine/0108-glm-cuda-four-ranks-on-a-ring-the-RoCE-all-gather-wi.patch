diff --git a/zig/src/cuda/roce_ring.zig b/zig/src/cuda/roce_ring.zig
new file mode 100644
index 000000000..aca9fe5ac
--- /dev/null
+++ b/zig/src/cuda/roce_ring.zig
@@ -0,0 +1,617 @@
+//! Four ranks on a switchless ring: all-gathers as one-shot RoCE writes, each rank's shard written to both neighbours,
+//! who relay one logical half each to the rank across the ring (no cable reaches it). roce.zig's protocol (stage,
+//! doorbell, proxy writes, flags, copy out in rank order, a device epoch for graph replays), its verbs ABI and the
+//! lab's older recipe's ring relay as the design (half the shard round each way); TF_ROCE_RING=1 asks for it.
+//!
+//! Rank r's neighbours: L = r - 1 and R = r + 1 (mod 4), the rank across F = r + 2. HCA 0 is the device cabled to L,
+//! HCA 1 the one cabled to R (TF_ROCE_HCA names them in that order). A gather of sequence s on slot s & 1:
+//!   1. the kernel stages this rank's shard in send[slot] and rings the doorbell (ctrl);
+//!   2. the proxy writes the shard to L and R: the data, then one flag line a logical half (seq, bytes), on that
+//!      neighbour's queue pair, so a flag lands after its data;
+//!   3. the proxy relays: L's shard arrived (its half-0 flag) -> its half 0 goes on to R; R's shard arrived (its
+//!      half-1 flag) -> its half 1 goes on to L; each relay posts data then the flag on the outgoing queue pair,
+//!      keeping the original source's slot and flag address;
+//!   4. the kernel waits for six flags (two halves from each of L, R and F) and copies the four shards out in rank
+//!      order; the last block advances the epoch.
+//! Before this rank posts its own sequence s it has posted and retired (completed) its relays of s - 1: a neighbour
+//! cannot start s + 1 without this rank's s, so no neighbour overwrites a slot a relay still reads from.
+
+const std = @import("std");
+const platform = @import("sys");
+const abi = @import("abi.zig");
+const Driver = @import("driver.zig").Driver;
+const memory = @import("memory.zig");
+const Module = @import("module.zig").Module;
+const Function = @import("module.zig").Function;
+const launch = @import("launch.zig");
+const tp_group = @import("tp_group.zig");
+const Stream = @import("stream.zig").Stream;
+const kernels = @import("kernels.zig");
+const nap = @import("roce_nap.zig");
+const roce = @import("roce.zig");
+
+pub const world = 4;
+const hcas = 2; // toward L, toward R
+const halves = 2;
+const slots = 2;
+const flag_stride = roce.flag_stride;
+const send_depth = roce.send_depth;
+const port_num = roce.port_num;
+const threads = roce.threads;
+const max_blocks = roce.max_blocks;
+const idle_spins = roce.idle_spins;
+const spin_limit = roce.spin_limit;
+const max_relay_spins: u64 = 1_000_000; // busy polls of a relay's completion (well past its microseconds)
+const max_relay_naps: u64 = 100_000; // then naps, before the proxy gives up (seconds)
+
+/// TF_ROCE_RING=1 asks for the ring path at world 4 (every rank must ask); unset or anything else keeps NCCL.
+pub fn wanted() bool {
+    const v = std.c.getenv("TF_ROCE_RING") orelse return false;
+    return std.mem.eql(u8, std.mem.span(v), "1");
+}
+
+pub fn prev(rank: usize) usize {
+    return (rank + world - 1) % world;
+}
+pub fn next(rank: usize) usize {
+    return (rank + 1) % world;
+}
+pub fn across(rank: usize) usize {
+    return (rank + 2) % world;
+}
+
+/// A shard's two logical halves in 16-byte packs: half 0 holds the larger part, half 1 may be empty (its flag still lands).
+pub fn halfPacks(packs: u32) [2]u32 {
+    const h0 = (packs + 1) / 2;
+    return .{ h0, packs - h0 };
+}
+
+// -- the region's layout (the same on every rank) -----------------------------------------------------------------------
+pub const Layout = struct {
+    slot_bytes: usize,
+    send: usize, // [slot][B]
+    recv: usize, // [source][slot][B]
+    flags: usize, // [source][slot][half] lines of flag_stride: word 0 the sequence, word 1 the shard's bytes
+    ctrl: usize,
+    total: usize,
+
+    pub fn of(max_bytes: usize) Layout {
+        const s = std.mem.alignForward(usize, max_bytes, 4096);
+        const send = 0;
+        const recv = send + slots * s;
+        const flags = recv + world * slots * s;
+        const ctrl = flags + world * slots * halves * flag_stride;
+        return .{ .slot_bytes = s, .send = send, .recv = recv, .flags = flags, .ctrl = ctrl, .total = ctrl + flag_stride };
+    }
+    pub fn recvAt(l: Layout, source: usize, slot: usize) usize {
+        return l.recv + (source * slots + slot) * l.slot_bytes;
+    }
+    pub fn flagAt(l: Layout, source: usize, slot: usize, half: usize) usize {
+        return l.flags + ((source * slots + slot) * halves + half) * flag_stride;
+    }
+};
+const c_seq = 0;
+const c_nbytes = 1; // + slot
+const c_error = 3;
+const c_hca = 4;
+
+/// What a rank tells the others: its region, and per HCA (toward L, toward R) its key, queue pair and address.
+const Blob = extern struct {
+    ok: u32,
+    n_hca: u32,
+    slot_bytes: u64,
+    max_bytes: u64,
+    addr: u64,
+    rkey: [hcas]u32,
+    qpn: [hcas]u32,
+    mtu: [hcas]u32,
+    lid: [hcas]u16,
+    gid: [hcas][16]u8,
+};
+
+const Hca = struct {
+    ctx: ?*roce.Context = null,
+    pd: ?*roce.Pd = null,
+    mr: ?*roce.Mr = null,
+    cq: ?*roce.Cq = null,
+    qp: ?*roce.Qp = null,
+    gid: [16]u8 = @splat(0),
+    gid_index: c_int = 0,
+    lid: u16 = 0,
+    mtu: u32 = 0,
+    outstanding: u32 = 0, // signalled work requests not yet reaped
+    peer_addr: u64 = 0, // the neighbour this HCA is cabled to: its region and the key of its MR on the HCA facing us
+    peer_rkey: u32 = 0,
+    relay_posted: u32 = 0, // the last sequence whose relay toward this neighbour was posted
+    relay_retired: u32 = 0, // and whose relay completed
+};
+
+/// A rank's place on the ring: its neighbours, and which HCA and flag halves each source's shard takes.
+pub const Plan = struct {
+    rank: u8,
+    left: u8,
+    right: u8,
+    far: u8,
+    pub fn of(rank: usize) Plan {
+        return .{ .rank = @intCast(rank), .left = @intCast(prev(rank)), .right = @intCast(next(rank)), .far = @intCast(across(rank)) };
+    }
+    /// The six flags the kernel waits for: (source, half) in a fixed order (L0 L1 R0 R1 F0 F1).
+    pub fn waits(p: Plan) [6][2]u8 {
+        return .{ .{ p.left, 0 }, .{ p.left, 1 }, .{ p.right, 0 }, .{ p.right, 1 }, .{ p.far, 0 }, .{ p.far, 1 } };
+    }
+};
+
+pub const Gather = struct {
+    gpa: std.mem.Allocator,
+    d: *const Driver,
+    lib: platform.DynLib,
+    api: roce.Api,
+    plan: Plan,
+    hca: [hcas]Hca = @splat(.{}),
+    layout: Layout,
+    region: memory.HostBuffer,
+    region_dev: abi.DevicePtr,
+    counters: memory.DeviceBuffer,
+    module: Module,
+    f: Function,
+    max_bytes: usize,
+    last_seq: u32 = 0,
+    running: std.atomic.Value(bool) = .init(false),
+    failed: std.atomic.Value(bool) = .init(false),
+    thread: ?std.Thread = null,
+    err: [256]u8 = @splat(0),
+    gathers: u64 = 0,
+
+    /// Every rank's exchange or null on every rank; setup crosses ``group``'s communicator on ``s``.
+    pub fn init(gpa: std.mem.Allocator, io: std.Io, d: *const Driver, group: *const tp_group.Group, s: Stream, want: bool, max_bytes: usize) !?*Gather {
+        if (group.world != world) return error.PeerRefused;
+        const g = try gpa.create(Gather);
+        var mine: Blob = std.mem.zeroes(Blob);
+        const ok = want and blk: {
+            g.setup(gpa, io, d, group.rank, max_bytes) catch |e| {
+                std.log.warn("RoCE ring all-gather: {s} ({s}); NCCL carries every gather", .{ @errorName(e), std.mem.sliceTo(&g.err, 0) });
+                break :blk false;
+            };
+            break :blk true;
+        };
+        if (ok) g.blob(&mine);
+        var all: [world]Blob = undefined;
+        group.gather(Blob, d, s, mine, &all) catch |e| {
+            if (ok) g.teardown();
+            gpa.destroy(g);
+            return e;
+        };
+        var agreed = ok;
+        for (all) |b| if (b.ok == 0 or b.n_hca != hcas or b.slot_bytes != mine.slot_bytes) {
+            agreed = false;
+        };
+        if (!agreed) {
+            if (ok) g.teardown();
+            gpa.destroy(g);
+            return null;
+        }
+        var cap: u64 = mine.max_bytes;
+        for (all) |b| cap = @min(cap, b.max_bytes);
+        g.max_bytes = @intCast(cap);
+        const connected = blk: {
+            g.connect(&all[g.plan.left], &all[g.plan.right]) catch |e| {
+                std.log.warn("RoCE ring all-gather: {s} ({s}); NCCL carries every gather", .{ @errorName(e), std.mem.sliceTo(&g.err, 0) });
+                break :blk false;
+            };
+            break :blk true;
+        };
+        var verdicts: [world]u32 = undefined;
+        group.gather(u32, d, s, @intFromBool(connected), &verdicts) catch |e| {
+            g.teardown();
+            gpa.destroy(g);
+            return e;
+        };
+        for (verdicts) |v| if (v == 0) {
+            g.teardown();
+            gpa.destroy(g);
+            return null;
+        };
+        std.log.info("RoCE ring all-gather: rank {d} writes to ranks {d} and {d}, relays to rank {d}; shards up to {d} KiB by RDMA writes", .{ g.plan.rank, g.plan.left, g.plan.right, g.plan.far, g.max_bytes >> 10 });
+        return g;
+    }
+
+    fn fail(g: *Gather, comptime fmt: []const u8, args: anytype) void {
+        _ = std.fmt.bufPrint(g.err[0 .. g.err.len - 1], fmt, args) catch {};
+    }
+
+    fn setup(g: *Gather, gpa: std.mem.Allocator, io: std.Io, d: *const Driver, rank: usize, max_bytes: usize) !void {
+        g.* = .{ .gpa = gpa, .d = d, .lib = undefined, .api = undefined, .plan = .of(rank), .layout = .of(max_bytes), .region = undefined, .region_dev = 0, .counters = undefined, .module = undefined, .f = undefined, .max_bytes = max_bytes };
+        g.lib = platform.DynLib.open("libibverbs.so.1") catch return platform.optional_libraries.unavailable(.verbs);
+        errdefer g.lib.close();
+        const info = @typeInfo(roce.Api).@"struct";
+        inline for (info.field_names, info.field_types) |name, T| {
+            @field(g.api, name) = g.lib.lookup(T, name) orelse return platform.optional_libraries.unavailable(.verbs);
+        }
+        var names: [roce.max_hcas][64]u8 = undefined;
+        var lens: [roce.max_hcas]usize = undefined;
+        const n = try roce.hcaNames(io, gpa, &names, &lens);
+        if (n != hcas) {
+            g.fail("TF_ROCE_HCA must name two devices on a ring, the one cabled to the previous rank then the one to the next (got {d})", .{n});
+            return error.NoHca;
+        }
+        g.region = try memory.HostBuffer.allocMapped(d, g.layout.total);
+        errdefer g.region.free();
+        @memset(g.region.bytes, 0);
+        g.region_dev = try g.region.device();
+        g.counters = try memory.DeviceBuffer.alloc(d, 64 * 4);
+        errdefer g.counters.free();
+        const zeros: [64 * 4]u8 = @splat(0);
+        try g.counters.upload(0, &zeros);
+        g.module = try Module.load(d, kernels.roce_ring_gather);
+        errdefer g.module.unload();
+        g.f = try g.module.function("roce_ring_gather");
+        errdefer g.closeHcas();
+        for (0..hcas) |h| try g.openHca(io, gpa, h, names[h][0..lens[h]]);
+    }
+
+    fn closeHcas(g: *Gather) void {
+        for (&g.hca) |*x| {
+            if (x.qp) |q| _ = g.api.ibv_destroy_qp(q);
+            if (x.cq) |q| _ = g.api.ibv_destroy_cq(q);
+            if (x.mr) |m| _ = g.api.ibv_dereg_mr(m);
+            if (x.pd) |p| _ = g.api.ibv_dealloc_pd(p);
+            if (x.ctx) |c| _ = g.api.ibv_close_device(c);
+            x.* = .{};
+        }
+    }
+
+    fn openHca(g: *Gather, io: std.Io, gpa: std.mem.Allocator, h: usize, name: []const u8) !void {
+        const a = &g.api;
+        var num: c_int = 0;
+        const list = a.ibv_get_device_list(&num) orelse return error.NoHca;
+        defer a.ibv_free_device_list(list);
+        var dev: ?*roce.Device = null;
+        for (0..@intCast(num)) |i| {
+            const n = a.ibv_get_device_name(list[i].?) orelse continue;
+            if (std.mem.eql(u8, std.mem.span(n), name)) dev = list[i];
+        }
+        const x = &g.hca[h];
+        x.ctx = a.ibv_open_device(dev orelse {
+            g.fail("RDMA device {s} not found", .{name});
+            return error.NoHca;
+        }) orelse return error.HcaFailed;
+        var port: roce.PortAttr = std.mem.zeroes(roce.PortAttr);
+        if (a.ibv_query_port(x.ctx.?, port_num, &port) != 0) return error.HcaFailed;
+        if (std.mem.readInt(u32, port.bytes[0..4], .little) != roce.port_active) {
+            g.fail("{s} port 1 is not active", .{name});
+            return error.NoHca;
+        }
+        x.mtu = std.mem.readInt(u32, port.bytes[8..12], .little);
+        x.lid = std.mem.readInt(u16, port.bytes[34..36], .little);
+        x.gid_index = try roce.gidIndex(io, gpa, name);
+        if (a.ibv_query_gid(x.ctx.?, port_num, x.gid_index, &x.gid) != 0) return error.HcaFailed;
+        x.pd = a.ibv_alloc_pd(x.ctx.?) orelse return error.HcaFailed;
+        x.mr = a.ibv_reg_mr(x.pd.?, g.region.bytes.ptr, g.region.bytes.len, roce.access_local_write | roce.access_remote_write) orelse {
+            g.fail("{s}: registering the pinned region failed", .{name});
+            return error.HcaFailed;
+        };
+        x.cq = a.ibv_create_cq(x.ctx.?, send_depth, null, null, 0) orelse return error.HcaFailed;
+        var attr: roce.QpInitAttr = .{ .send_cq = x.cq, .recv_cq = x.cq, .qp_type = roce.qpt_rc, .cap = .{ .max_send_wr = send_depth, .max_recv_wr = 1, .max_send_sge = 1, .max_recv_sge = 1, .max_inline_data = 16 } };
+        x.qp = a.ibv_create_qp(x.pd.?, &attr) orelse return error.HcaFailed;
+        var init_attr: roce.QpAttr = .{ .qp_state = roce.qps_init, .port_num = port_num, .qp_access_flags = roce.access_remote_write };
+        if (a.ibv_modify_qp(x.qp.?, &init_attr, roce.qp_state | roce.qp_pkey_index | roce.qp_port | roce.qp_access_flags) != 0) return error.HcaFailed;
+    }
+
+    fn blob(g: *Gather, b: *Blob) void {
+        b.ok = 1;
+        b.n_hca = hcas;
+        b.slot_bytes = g.layout.slot_bytes;
+        b.max_bytes = g.max_bytes;
+        b.addr = @intFromPtr(g.region.bytes.ptr);
+        for (0..hcas) |h| {
+            const x = &g.hca[h];
+            b.rkey[h] = x.mr.?.rkey;
+            b.qpn[h] = x.qp.?.qp_num;
+            b.mtu[h] = x.mtu;
+            b.lid[h] = x.lid;
+            b.gid[h] = x.gid;
+        }
+    }
+
+    /// HCA 0 meets L's HCA 1 (L's device toward its next rank, us); HCA 1 meets R's HCA 0.
+    fn connect(g: *Gather, l: *const Blob, r: *const Blob) !void {
+        const peers = [hcas]*const Blob{ l, r };
+        const theirs = [hcas]usize{ 1, 0 };
+        for (0..hcas) |h| {
+            const x = &g.hca[h];
+            const p = peers[h];
+            const t = theirs[h];
+            x.peer_addr = p.addr;
+            x.peer_rkey = p.rkey[t];
+            var rtr: roce.QpAttr = .{ .qp_state = roce.qps_rtr, .path_mtu = @min(p.mtu[t], x.mtu), .dest_qp_num = p.qpn[t], .max_dest_rd_atomic = 1, .min_rnr_timer = 12, .ah_attr = .{ .is_global = 1, .dlid = p.lid[t], .port_num = port_num, .grh = .{ .dgid = p.gid[t], .sgid_index = @intCast(x.gid_index), .hop_limit = 64 } } };
+            if (g.api.ibv_modify_qp(x.qp.?, &rtr, roce.qp_state | roce.qp_av | roce.qp_path_mtu | roce.qp_dest_qpn | roce.qp_rq_psn | roce.qp_max_dest_rd_atomic | roce.qp_min_rnr_timer) != 0) {
+                g.fail("HCA {d}: the queue pair refused RTR", .{h});
+                return error.PeerRefused;
+            }
+            var rts: roce.QpAttr = .{ .qp_state = roce.qps_rts, .timeout = 14, .retry_cnt = 7, .rnr_retry = 7, .max_rd_atomic = 1 };
+            if (g.api.ibv_modify_qp(x.qp.?, &rts, roce.qp_state | roce.qp_timeout | roce.qp_retry_cnt | roce.qp_rnr_retry | roce.qp_sq_psn | roce.qp_max_qp_rd_atomic) != 0) {
+                g.fail("HCA {d}: the queue pair refused RTS", .{h});
+                return error.PeerRefused;
+            }
+        }
+        g.running.store(true, .release);
+        g.thread = try std.Thread.spawn(.{}, proxy, .{g});
+    }
+
+    fn ctrl(g: *Gather) [*]u32 {
+        return @ptrCast(@alignCast(g.region.bytes.ptr + g.layout.ctrl));
+    }
+    fn flagWords(g: *Gather, source: usize, slot: usize, half: usize) [*]u32 {
+        return @ptrCast(@alignCast(g.region.bytes.ptr + g.layout.flagAt(source, slot, half)));
+    }
+
+    /// Reap this HCA's completions: a relay's completion retires it (wr_id = 1 + its sequence); a failed write ends the exchange.
+    fn drain(g: *Gather, h: usize) !void {
+        const x = &g.hca[h];
+        var wc: [32]roce.Wc = undefined;
+        const n = roce.opsCall(roce.PollCq, x.ctx.?, roce.ops_poll_cq)(x.cq.?, wc.len, &wc);
+        if (n < 0) return error.ProxyFailed;
+        for (wc[0..@intCast(n)]) |w| {
+            if (w.status != 0) {
+                const why = g.api.ibv_wc_status_str(w.status) orelse "?";
+                g.fail("RDMA write on HCA {d} failed: {s} (vendor 0x{x}, seq {d})", .{ h, std.mem.span(why), w.vendor_err, g.last_seq });
+                return error.ProxyFailed;
+            }
+            x.outstanding -= 1;
+            if (w.wr_id != 0) x.relay_retired = @intCast(w.wr_id - 1);
+        }
+    }
+
+    /// Data then a flag line on HCA `h`'s queue pair: `bytes` from this region's `from` to the neighbour's `to`, then
+    /// {seq, nbytes} to its flag line `flag_off`. `wr_id` marks the flag's completion (0: an own post; 1 + seq: a relay).
+    fn write(g: *Gather, h: usize, from: u64, to: u64, bytes: u32, flag_off: u64, seq: u32, nbytes: u32, wr_id: u64) !void {
+        const x = &g.hca[h];
+        while (x.outstanding >= send_depth / 4) {
+            try g.drain(h);
+            if (!g.running.load(.monotonic)) return error.ProxyFailed;
+        }
+        var line: [2]u32 = .{ seq, nbytes };
+        var flag_sge: roce.Sge = .{ .addr = @intFromPtr(&line), .length = 8, .lkey = 0 };
+        var flag: roce.SendWr = .{ .wr_id = wr_id, .sg_list = &flag_sge, .num_sge = 1, .opcode = roce.wr_rdma_write, .send_flags = roce.send_signaled | roce.send_inline, .remote_addr = x.peer_addr + flag_off, .rkey = x.peer_rkey };
+        var data_sge: roce.Sge = .{ .addr = @intFromPtr(g.region.bytes.ptr) + from, .length = bytes, .lkey = x.mr.?.lkey };
+        var data: roce.SendWr = .{ .wr_id = wr_id, .next = &flag, .sg_list = &data_sge, .num_sge = 1, .opcode = roce.wr_rdma_write, .remote_addr = x.peer_addr + to, .rkey = x.peer_rkey };
+        var bad: ?*roce.SendWr = null;
+        const first: *roce.SendWr = if (bytes != 0) &data else &flag;
+        const rc = roce.opsCall(roce.PostSend, x.ctx.?, roce.ops_post_send)(x.qp.?, first, &bad);
+        if (rc != 0) {
+            g.fail("ibv_post_send on HCA {d}: {d}", .{ h, rc });
+            return error.ProxyFailed;
+        }
+        x.outstanding += 1;
+    }
+
+    /// This rank's shard of sequence `seq` to both neighbours: the data once, then a flag line a logical half.
+    fn post(g: *Gather, seq: u32, nbytes: u32) !void {
+        if (nbytes == 0 or nbytes % 16 != 0 or nbytes > g.layout.slot_bytes) {
+            g.fail("bad shard size {d} at seq {d}", .{ nbytes, seq });
+            return error.ProxyFailed;
+        }
+        const slot: usize = seq & 1;
+        const me: usize = g.plan.rank;
+        const from = g.layout.send + slot * g.layout.slot_bytes;
+        const to = g.layout.recvAt(me, slot);
+        for (0..hcas) |h| {
+            try g.write(h, from, to, nbytes, g.layout.flagAt(me, slot, 0), seq, nbytes, 0);
+            try g.write(h, from, to, 0, g.layout.flagAt(me, slot, 1), seq, nbytes, 0);
+        }
+        for (0..hcas) |h| try g.drain(h);
+    }
+
+    /// The relays ready for sequence `seq`: L's shard's half 0 on to R (HCA 1), R's shard's half 1 on to L (HCA 0),
+    /// each once its source's flag for that half carries `seq`. True when both were posted.
+    fn relay(g: *Gather, seq: u32) !bool {
+        const slot: usize = seq & 1;
+        const sources = [hcas]u8{ g.plan.left, g.plan.right }; // what HCA 0 / HCA 1 bring in
+        const out_hca = [hcas]usize{ 1, 0 }; // and where each goes on: L's half 0 to R, R's half 1 to L
+        const half = [hcas]usize{ 0, 1 };
+        var done: u32 = 0;
+        for (0..hcas) |in| {
+            const o = out_hca[in];
+            if (g.hca[o].relay_posted >= seq) {
+                done += 1;
+                continue;
+            }
+            const src = sources[in];
+            const words = g.flagWords(src, slot, half[in]);
+            if (@atomicLoad(u32, &words[0], .acquire) != seq) continue;
+            const nbytes = @atomicLoad(u32, &words[1], .acquire);
+            if (nbytes == 0 or nbytes % 16 != 0 or nbytes > g.layout.slot_bytes) {
+                g.fail("relay: bad shard size {d} from rank {d} at seq {d}", .{ nbytes, src, seq });
+                return error.ProxyFailed;
+            }
+            const hp = halfPacks(nbytes / 16);
+            const off: u64 = if (half[in] == 0) 0 else @as(u64, hp[0]) * 16;
+            const bytes: u32 = hp[half[in]] * 16;
+            const at = g.layout.recvAt(src, slot) + off;
+            try g.write(o, at, at, bytes, g.layout.flagAt(src, slot, half[in]), seq, nbytes, 1 + @as(u64, seq));
+            g.hca[o].relay_posted = seq;
+            done += 1;
+        }
+        return done == hcas;
+    }
+
+    /// Both relays of `seq` retired (their flags' completions reaped), draining meanwhile; false past the wait.
+    fn retired(g: *Gather, seq: u32) !bool {
+        var waited: u64 = 0;
+        while (true) {
+            var all = true;
+            for (0..hcas) |h| {
+                try g.drain(h);
+                if (g.hca[h].relay_retired < seq) all = false;
+            }
+            if (all) return true;
+            if (!g.running.load(.monotonic)) return error.ProxyFailed;
+            waited += 1;
+            if (waited > max_relay_spins + max_relay_naps) {
+                g.fail("relays of seq {d} did not complete", .{seq});
+                return false;
+            }
+            if (waited > max_relay_spins) nap.pause(); // a completion takes microseconds; past that, yield
+        }
+    }
+
+    /// The proxy: the doorbell's sequences posted in order, each after the previous sequence's relays are posted and
+    /// retired; relays serviced on every turn, doorbell or not (a sequence's far half must move before the next rings).
+    fn proxy(g: *Gather) void {
+        const c = g.ctrl();
+        var idle: u64 = 0;
+        var relay_seq: u32 = 1; // the next sequence whose relays this rank owes
+        while (g.running.load(.monotonic)) {
+            // relays first: a neighbour's shard can be waiting whatever this rank's own doorbell says
+            while (true) {
+                const both = g.relay(relay_seq) catch {
+                    g.failed.store(true, .release);
+                    return;
+                };
+                if (!both) break;
+                relay_seq +%= 1;
+            }
+            const seq = @atomicLoad(u32, &c[c_seq], .acquire);
+            if (seq == g.last_seq) {
+                idle += 1;
+                if (idle % 64 == 0) for (0..hcas) |h| g.drain(h) catch {
+                    g.failed.store(true, .release);
+                    return;
+                };
+                if (idle >= idle_spins) nap.pause();
+                continue;
+            }
+            idle = 0;
+            var pending = seq -% g.last_seq;
+            if (pending > slots) {
+                g.fail("the doorbell skipped {d} sequences (last {d}, now {d})", .{ pending, g.last_seq, seq });
+                g.failed.store(true, .release);
+                return;
+            }
+            var s = g.last_seq +% 1;
+            while (pending > 0) : ({
+                s +%= 1;
+                pending -= 1;
+            }) {
+                // the previous sequence's relays posted and completed before this rank's shard goes out
+                if (s > 1) {
+                    while (relay_seq < s) {
+                        const both = g.relay(relay_seq) catch {
+                            g.failed.store(true, .release);
+                            return;
+                        };
+                        if (both) relay_seq +%= 1 else {
+                            if (!g.running.load(.monotonic)) return;
+                            for (0..hcas) |h| g.drain(h) catch {
+                                g.failed.store(true, .release);
+                                return;
+                            };
+                        }
+                    }
+                    const ok = g.retired(s - 1) catch false;
+                    if (!ok) {
+                        g.failed.store(true, .release);
+                        return;
+                    }
+                }
+                const nbytes = @atomicLoad(u32, &c[c_nbytes + (s & 1)], .acquire);
+                g.post(s, nbytes) catch {
+                    g.failed.store(true, .release);
+                    return;
+                };
+                g.last_seq = s;
+            }
+        }
+    }
+
+    /// Whether a gather of ``bytes`` a rank goes this way: the size alone decides, so every rank picks the same path.
+    pub fn fits(g: *const Gather, bytes: usize) bool {
+        return bytes > 0 and bytes <= g.max_bytes and bytes % 16 == 0;
+    }
+
+    /// Every rank's ``bytes`` from ``send`` into ``recv`` in rank order (as ncclAllGather); misaligned is an error.
+    pub fn gather(g: *Gather, stream: abi.Stream, send: abi.DevicePtr, recv: abi.DevicePtr, bytes: usize) !void {
+        if (send % 16 != 0 or recv % 16 != 0) return error.Misaligned;
+        const packs = bytes / 16;
+        const need = @max(1, std.math.divCeil(usize, packs, 2 * threads) catch unreachable);
+        const grid: u32 = @intCast(@min(std.math.ceilPowerOfTwo(usize, need) catch max_blocks, max_blocks));
+        const klass: i32 = @intCast(std.math.log2_int(u32, grid));
+        const base = g.region_dev;
+        var a: launch.Args = .{};
+        a.add(send);
+        a.add(recv);
+        a.add(@as(i32, @intCast(packs)));
+        a.add(@as(i32, g.plan.rank));
+        a.add(base + g.layout.recv);
+        a.add(base + g.layout.flags);
+        a.add(base + g.layout.send);
+        a.add(base + g.layout.ctrl);
+        a.add(@as(i64, @intCast(g.layout.slot_bytes)));
+        a.add(g.counters.ptr);
+        a.add(klass);
+        a.add(spin_limit);
+        try launch.launch(g.f, .{ .grid = .{ .x = grid }, .block = .{ .x = threads } }, .{ .handle = stream, .d = g.d }, &a);
+        g.gathers += 1;
+    }
+
+    /// An error if a wait timed out on the GPU or the proxy failed (the host checks after a synchronize).
+    pub fn check(g: *Gather) !void {
+        const c = g.ctrl();
+        const bad = @atomicLoad(u32, &c[c_error], .acquire);
+        if (bad == 0 and !g.failed.load(.acquire)) return;
+        std.log.err("RoCE ring all-gather failed (sequence {d}, wait {d}): {s}", .{ bad, c[c_hca], std.mem.sliceTo(&g.err, 0) });
+        return error.ProxyFailed;
+    }
+
+    fn teardown(g: *Gather) void {
+        if (g.running.swap(false, .acq_rel)) if (g.thread) |t| t.join();
+        g.closeHcas();
+        g.module.unload();
+        g.counters.free();
+        g.region.free();
+        g.lib.close();
+    }
+
+    pub fn deinit(g: *Gather) void {
+        g.teardown();
+        g.gpa.destroy(g);
+    }
+};
+
+test "a ring of four: neighbours, the rank across, and the six flags a rank waits for" {
+    for (0..world) |r| {
+        const p = Plan.of(r);
+        try std.testing.expectEqual(@as(u8, @intCast((r + 3) % 4)), p.left);
+        try std.testing.expectEqual(@as(u8, @intCast((r + 1) % 4)), p.right);
+        try std.testing.expectEqual(@as(u8, @intCast((r + 2) % 4)), p.far);
+        try std.testing.expect(p.left != p.right and p.far != p.left and p.far != p.right and p.far != p.rank);
+        const w = p.waits();
+        var seen: [world][halves]bool = @splat(@splat(false));
+        for (w) |pair| seen[pair[0]][pair[1]] = true;
+        for (0..world) |src| for (0..halves) |h| try std.testing.expectEqual(src != r, seen[src][h]);
+    }
+}
+
+test "halves: half 0 holds the larger part, an odd pack count leaves half 1 one short, one pack leaves it empty" {
+    try std.testing.expectEqual([2]u32{ 1, 0 }, halfPacks(1));
+    try std.testing.expectEqual([2]u32{ 2, 1 }, halfPacks(3));
+    try std.testing.expectEqual([2]u32{ 512, 512 }, halfPacks(1024));
+    try std.testing.expectEqual([2]u32{ 513, 512 }, halfPacks(1025));
+}
+
+test "the layout keeps every source's slots and flag lines apart, aligned and inside the region" {
+    const l = Layout.of(512 << 10);
+    try std.testing.expectEqual(@as(usize, 512 << 10), l.slot_bytes);
+    for (0..world) |src| for (0..slots) |slot| {
+        const r = l.recvAt(src, slot);
+        try std.testing.expect(r % 4096 == 0 and r + l.slot_bytes <= l.flags);
+        for (0..halves) |h| {
+            const f = l.flagAt(src, slot, h);
+            try std.testing.expect(f % flag_stride == 0 and f >= l.flags and f + flag_stride <= l.ctrl);
+        }
+    };
+    try std.testing.expect(l.send + slots * l.slot_bytes <= l.recv);
+    try std.testing.expectEqual(l.ctrl + flag_stride, l.total);
+    // the cap both ranks test must round to one slot on every rank
+    try std.testing.expectEqual(Layout.of(511 << 10).slot_bytes, Layout.of(512 << 10).slot_bytes);
+}
