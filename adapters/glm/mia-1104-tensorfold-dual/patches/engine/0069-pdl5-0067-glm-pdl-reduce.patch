-            try cuda.launch.launch(k.reduce, .{ .grid = .{ .x = @intCast((total + 255) / 256) }, .block = .{ .x = 256 } }, s, &r);
+            // with chain.reduce it may start while the matmul runs: it waits for it before reading `part`
