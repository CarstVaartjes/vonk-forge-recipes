+            const pick = [_]usize{ 0, 1, 511, 512, 513, 1537, 2051 };
+            n.* = @intCast(if (row < pick.len) pick[row] else r.rng.uintLessThan(usize, w + 1));
+            for (tok[row * w ..][0..@intCast(n.*)]) |*t| t.* = @intCast(r.rng.uintLessThan(usize, keys));
+        }
