+            .{ .name = "E4M3 rows", .cache = f8c, .scales = f8c + keys * lw, .t = .{} },
+            .{ .name = "E4M3 pages", .cache = pgc, .scales = pgc + page_rows * lw, .t = .{ .pt = dpt, .ps = pstep, .page_rows = page_rows, .logical = true } },
