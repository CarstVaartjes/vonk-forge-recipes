diff --git a/zig/src/server/think_off_split.zig b/zig/src/server/think_off_split.zig
new file mode 100644
index 000000000..c5b5ea7c8
--- /dev/null
+++ b/zig/src/server/think_off_split.zig
@@ -0,0 +1,79 @@
+//! TF_THINK_OFF_SPLIT=<tokens>: a chat reply served with thinking off that writes the think block's close token anyway,
+//! within its first <tokens> tokens, has the text before that token as its reasoning and the text after it as its
+//! answer, as a thinking reply does. GLM-5.3 does this on some list-heavy prompts: it drafts in its hidden-reasoning
+//! voice, writes `</think>`, then answers. Without the split, the draft and the stray marker are the reply's content.
+//! While a reply streams, its content is held until the close token arrives, the hold's tokens pass or the reply ends,
+//! so a streamed reply and the same reply unstreamed split alike. A close token after the hold stays text. Unset or 0:
+//! off. Raw completions, the JSON channel and replies that ask for logprobs are never split.
+const std = @import("std");
+
+var cached: std.atomic.Value(u64) = .init(std.math.maxInt(u64)); // maxInt: unread
+
+/// Tests set the hold here instead of the environment, which is read once per process.
+pub var test_hold: ?u32 = null;
+
+/// The hold in tokens TF_THINK_OFF_SPLIT asks for (read once); 0 when unset, empty, 0 or not a number.
+pub fn hold() u32 {
+    if (test_hold) |h| return h;
+    const v = cached.load(.monotonic);
+    if (v != std.math.maxInt(u64)) return @intCast(v);
+    const n = parse(if (std.c.getenv("TF_THINK_OFF_SPLIT")) |s| std.mem.span(s) else "");
+    cached.store(n, .monotonic);
+    return n;
+}
+
+pub fn parse(s: []const u8) u32 {
+    return std.fmt.parseInt(u32, std.mem.trim(u8, s, " \t"), 10) catch 0;
+}
+
+pub const Decision = enum {
+    /// Not split: the hold is off or the tokenizer has no close token.
+    off,
+    /// The reply has not written the close token and may still: its content waits.
+    hold,
+    /// The close token is among the reply's first `limit` tokens: the text before it is reasoning.
+    split,
+    /// The hold passed (or the reply ended) without the close token: the reply is all content, as without the hold.
+    release,
+};
+
+/// What a thinking-off reply does with its text so far: its tokens, the close token's id, the hold, and whether it ended.
+pub fn decide(tokens: []const u32, close_id: ?u32, limit: u32, finished: bool) Decision {
+    if (limit == 0) return .off;
+    const id = close_id orelse return .off;
+    if (std.mem.indexOfScalar(u32, tokens[0..@min(tokens.len, limit)], id) != null) return .split;
+    if (finished or tokens.len >= limit) return .release;
+    return .hold;
+}
+
+const close: u32 = 154842; // GLM-5.3's </think>
+
+test "think off split: the close token within the hold splits, held until then, released after the hold or at the end" {
+    try std.testing.expectEqual(Decision.off, decide(&.{ 1, close, 2 }, close, 0, true));
+    try std.testing.expectEqual(Decision.off, decide(&.{ 1, close, 2 }, null, 1024, true));
+    // streaming: held while the reply may still close, split the moment it does
+    try std.testing.expectEqual(Decision.hold, decide(&.{ 1, 2, 3 }, close, 8, false));
+    try std.testing.expectEqual(Decision.split, decide(&.{ 1, 2, 3, close }, close, 8, false));
+    try std.testing.expectEqual(Decision.split, decide(&.{ 1, 2, 3, close, 4, 5, 6, 7, 8, 9 }, close, 8, false));
+    // an ordinary reply: released at its end, or when the hold passes while it is still writing
+    try std.testing.expectEqual(Decision.release, decide(&.{ 1, 2, 3 }, close, 8, true));
+    try std.testing.expectEqual(Decision.release, decide(&.{ 1, 2, 3, 4, 5, 6, 7, 8 }, close, 8, false));
+    // a close token after the hold stays text, before and after the reply ends: the decision never flips back
+    const late = [_]u32{ 1, 2, 3, 4, 5, 6, 7, 8, close, 9 };
+    try std.testing.expectEqual(Decision.release, decide(&late, close, 8, false));
+    try std.testing.expectEqual(Decision.release, decide(&late, close, 8, true));
+    // streamed and unstreamed agree: every prefix's decision ends where the whole reply's does
+    const draft = [_]u32{ 5, 6, 7, close, 9, 10 };
+    var last: Decision = .hold;
+    for (1..draft.len + 1) |k| last = decide(draft[0..k], close, 8, k == draft.len);
+    try std.testing.expectEqual(decide(&draft, close, 8, true), last);
+}
+
+test "think off split: the hold parses as a token count, anything else is off" {
+    try std.testing.expectEqual(@as(u32, 1024), parse("1024"));
+    try std.testing.expectEqual(@as(u32, 1024), parse(" 1024 "));
+    try std.testing.expectEqual(@as(u32, 0), parse(""));
+    try std.testing.expectEqual(@as(u32, 0), parse("0"));
+    try std.testing.expectEqual(@as(u32, 0), parse("on"));
+    try std.testing.expectEqual(@as(u32, 0), parse("-5"));
+}
diff --git a/zig/src/server/think_off_split_test.zig b/zig/src/server/think_off_split_test.zig
new file mode 100644
index 000000000..c28b6c003
--- /dev/null
+++ b/zig/src/server/think_off_split_test.zig
@@ -0,0 +1,211 @@
+//! TF_THINK_OFF_SPLIT on the chat route: a thinking-off reply that writes `</think>` within the hold has its text before
+//! it as reasoning_content, whole and streamed alike; an ordinary reply, a late close and the setting off are unchanged.
+const std = @import("std");
+const api = @import("engine_api");
+const server = @import("root.zig");
+const json = server.json;
+const model_text = @import("model_text.zig");
+const openai = @import("openai.zig");
+const think_off_split = @import("think_off_split.zig");
+const Conn = @import("http_conn.zig").Conn;
+const t = std.testing;
+
+const think_end: u32 = 300;
+
+/// Bytes as tokens and `</think>` as token 300; every prompt renders as "prompt".
+const Text = struct {
+    fn text(x: *@This()) model_text.Text {
+        return .{ .ctx = x, .vtable = &.{ .encode = encode, .decode = decode, .token_id = tokenId, .token_string = tokenString, .vocab_size = vocabSize, .eos_ids = eosIds, .render = render, .template_source = templateSource } };
+    }
+    fn encode(_: *anyopaque, a: std.mem.Allocator, input: []const u8, _: bool) model_text.Error![]u32 {
+        const ids = try a.alloc(u32, input.len);
+        for (input, ids) |byte, *id| id.* = byte;
+        return ids;
+    }
+    fn decode(_: *anyopaque, a: std.mem.Allocator, ids: []const u32) std.mem.Allocator.Error![]u8 {
+        var out: std.ArrayList(u8) = .empty;
+        for (ids) |id| if (id == think_end) try out.appendSlice(a, "</think>") else try out.append(a, @intCast(id));
+        return out.items;
+    }
+    fn tokenId(_: *anyopaque, p: []const u8) ?u32 {
+        return if (std.mem.eql(u8, p, "</think>")) think_end else null;
+    }
+    fn tokenString(_: *anyopaque, a: std.mem.Allocator, id: u32) std.mem.Allocator.Error![]u8 {
+        return std.fmt.allocPrint(a, "{d}", .{id});
+    }
+    fn vocabSize(_: *anyopaque) u32 {
+        return 301;
+    }
+    fn eosIds(_: *anyopaque) []const u32 {
+        return &.{};
+    }
+    fn render(_: *anyopaque, a: std.mem.Allocator, _: json.Value, _: model_text.RenderOptions, _: *[]const u8) model_text.Error!model_text.Rendered {
+        return .{ .text = try (a.dupe(u8, "prompt")) };
+    }
+    fn templateSource(_: *anyopaque) []const u8 {
+        return "";
+    }
+};
+
+/// Writes `reply` (bytes, with "|" as the `</think>` token), one token an event or all at once.
+const Writer = struct {
+    reply: []const u8,
+    batched: bool = false,
+
+    fn engine(e: *@This()) api.Engine {
+        return .{ .ctx = e, .vtable = &.{ .info = info, .submit = submit, .cancel = cancel, .status = status, .memory = memory } };
+    }
+    fn info(_: *anyopaque) api.Info {
+        return api.Info.ofLanes(.{ .context_window = 4096 });
+    }
+    fn submit(ctx: *anyopaque, id: api.Id, _: *const api.Request, sink: api.Sink) api.SubmitError!void {
+        const e: *@This() = @ptrCast(@alignCast(ctx));
+        var ids: [256]u32 = undefined;
+        for (e.reply, 0..) |b, i| ids[i] = if (b == '|') think_end else b;
+        const all = ids[0..e.reply.len];
+        sink.event(sink.ctx, id, &.{ .prefilled = 0 });
+        if (e.batched) sink.event(sink.ctx, id, &.{ .tokens = all }) else for (all) |*tok| sink.event(sink.ctx, id, &.{ .tokens = tok[0..1] });
+        sink.event(sink.ctx, id, &.{ .finished = .{ .reason = .stop, .stats = .{} } });
+    }
+    fn cancel(_: *anyopaque, _: api.Id) void {}
+    fn status(_: *anyopaque, out: *api.Status, _: []u32) void {
+        out.* = .{};
+    }
+    fn memory(_: *anyopaque, _: bool) ?api.Memory {
+        return null;
+    }
+};
+
+const Wire = struct {
+    a: std.mem.Allocator,
+    status: ?u16 = null,
+    whole: json.Value = .null,
+    events: std.ArrayList(json.Value) = .empty,
+    done: bool = false,
+
+    fn out(w: *Wire) openai.Out {
+        return .{ .ctx = w, .vt = &.{ .open = open, .event = event, .reply = reply } };
+    }
+    fn copy(w: *Wire, v: json.Value) !json.Value {
+        return (try json.parse(w.a, try json.stringify(w.a, v, .{}))).ok;
+    }
+    fn open(_: *anyopaque, _: usize) error{Closed}!void {}
+    fn event(ctx: *anyopaque, payload: ?json.Value) error{Closed}!void {
+        const w: *Wire = @ptrCast(@alignCast(ctx));
+        const p = payload orelse {
+            w.done = true;
+            return;
+        };
+        w.events.append(w.a, w.copy(p) catch return error.Closed) catch return error.Closed;
+    }
+    fn reply(ctx: *anyopaque, code: u16, payload: json.Value) void {
+        const w: *Wire = @ptrCast(@alignCast(ctx));
+        w.status = code;
+        w.whole = w.copy(payload) catch .null;
+    }
+};
+
+const View = struct { reasoning: []const u8 = "", content: []const u8 = "", reasoning_tokens: ?i64 = null };
+
+fn view(a: std.mem.Allocator, w: *const Wire) !View {
+    var v: View = .{};
+    if (w.status) |code| {
+        try t.expectEqual(@as(u16, 200), code);
+        const message = w.whole.get("choices").?.array[0].get("message").?;
+        v.reasoning = message.strField("reasoning_content") orelse "";
+        v.content = message.strField("content") orelse "";
+        if (w.whole.get("usage")) |u| if (u.get("completion_tokens_details")) |d| if (d.get("reasoning_tokens")) |r| {
+            v.reasoning_tokens = r.int64();
+        };
+        return v;
+    }
+    try t.expect(w.done);
+    var thought: std.ArrayList(u8) = .empty;
+    var text: std.ArrayList(u8) = .empty;
+    for (w.events.items) |e| {
+        const choices = (e.get("choices") orelse continue).array;
+        if (choices.len == 0) continue;
+        const d = choices[0].get("delta") orelse continue;
+        try thought.appendSlice(a, d.strField("reasoning_content") orelse "");
+        try text.appendSlice(a, d.strField("content") orelse "");
+    }
+    v.reasoning = thought.items;
+    v.content = text.items;
+    return v;
+}
+
+/// One chat completion on a server that serves thinking off by default (or on), with this hold.
+fn chat(a: std.mem.Allocator, e: *Writer, hold: u32, thinking: bool, stream: bool) !View {
+    think_off_split.test_hold = hold;
+    defer think_off_split.test_hold = null;
+    var text: Text = .{};
+    const cfg: server.Config = .{ .served_name = "m", .model_ids = &.{"m"}, .use_drafts = false, .enable_thinking = thinking };
+    var srv = try server.Server.init(t.allocator, t.io, e.engine(), text.text(), cfg, null);
+    defer srv.deinit();
+    const body = try std.fmt.allocPrint(a, "{{\"model\":\"m\",\"max_tokens\":200,\"stream\":{},\"messages\":[{{\"role\":\"user\",\"content\":\"x\"}}]}}", .{stream});
+    var conn: Conn = .{ .fd = -1, .peer = "", .buf = &.{}, .gpa = a };
+    var wire: Wire = .{ .a = a };
+    openai.run(srv, a, wire.out(), .{ .conn = &conn }, true, (try json.parse(a, body)).ok);
+    return view(a, &wire);
+}
+
+/// Every way a client reads the reply: whole and streamed, one token an event and all at once.
+fn each(a: std.mem.Allocator, reply: []const u8, hold: u32, thinking: bool) ![4]View {
+    var out: [4]View = undefined;
+    var i: usize = 0;
+    for ([_]bool{ false, true }) |batched| for ([_]bool{ false, true }) |stream| {
+        var e: Writer = .{ .reply = reply, .batched = batched };
+        out[i] = try chat(a, &e, hold, thinking, stream);
+        i += 1;
+    };
+    return out;
+}
+
+test "think off split: a thinking-off draft closed within the hold is reasoning, its answer the content, every way" {
+    var arena: std.heap.ArenaAllocator = .init(t.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    for (try each(a, "We need the codes. Draft.|badger: 41318", 64, false)) |v| {
+        try t.expectEqualStrings("We need the codes. Draft.", std.mem.trimEnd(u8, v.reasoning, "\n"));
+        try t.expectEqualStrings("badger: 41318", v.content);
+    }
+}
+
+test "think off split: an ordinary thinking-off reply is all content, every way, with the hold on" {
+    var arena: std.heap.ArenaAllocator = .init(t.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    for (try each(a, "badger: 41318", 64, false)) |v| {
+        try t.expectEqualStrings("", v.reasoning);
+        try t.expectEqualStrings("badger: 41318", v.content);
+    }
+    // longer than the hold: the stream lets it go when the hold passes, and it is the same reply
+    for (try each(a, "a reply longer than eight tokens", 8, false)) |v| {
+        try t.expectEqualStrings("", v.reasoning);
+        try t.expectEqualStrings("a reply longer than eight tokens", v.content);
+    }
+}
+
+test "think off split: a close after the hold, or the hold off, leaves the reply as it was" {
+    var arena: std.heap.ArenaAllocator = .init(t.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    for (try each(a, "a draft past the hold|answer", 8, false)) |v| {
+        try t.expectEqualStrings("", v.reasoning);
+        try t.expectEqualStrings("a draft past the hold</think>answer", v.content);
+    }
+    for (try each(a, "draft|answer", 0, false)) |v| {
+        try t.expectEqualStrings("", v.reasoning);
+        try t.expectEqualStrings("draft</think>answer", v.content);
+    }
+}
+
+test "think off split: a thinking reply splits as before, with the hold on or off" {
+    var arena: std.heap.ArenaAllocator = .init(t.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    for ([_]u32{ 0, 64 }) |hold| for (try each(a, "thinking|answer", hold, true)) |v| {
+        try t.expectEqualStrings("thinking", std.mem.trimEnd(u8, v.reasoning, "\n"));
+        try t.expectEqualStrings("answer", v.content);
+    };
+}
