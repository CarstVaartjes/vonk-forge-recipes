+test "GLM EXL3: a trellis's last dimension gives whole-bit mcg widths from 1 to 8; half steps and wider are refused" {
+    for ([_][2]usize{ .{ 16, 2 }, .{ 32, 4 }, .{ 48, 6 }, .{ 64, 8 }, .{ 80, 10 }, .{ 96, 12 }, .{ 112, 14 }, .{ 128, 16 } }) |c|
