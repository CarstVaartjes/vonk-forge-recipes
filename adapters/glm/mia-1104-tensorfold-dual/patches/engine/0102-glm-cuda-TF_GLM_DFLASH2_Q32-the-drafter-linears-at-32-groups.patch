diff --git a/zig/kernels/cuda/affine4_pack.cu b/zig/kernels/cuda/affine4_pack.cu
index a9461659..96cdd373 100644
--- a/zig/kernels/cuda/affine4_pack.cu
+++ b/zig/kernels/cuda/affine4_pack.cu
@@ -34,3 +34,28 @@ extern "C" __global__ void tf_transpose_pad16(const uint16_t* __restrict__ x, in
     const int g = static_cast<int>(idx / npad), col = static_cast<int>(idx % npad);
     out[idx] = col < n ? x[static_cast<long long>(col) * kg + g] : 0;
 }
+
+// The 32-group tile: one 64-row x 32-col group a (t, g), 256 words, the v half of the 64-group layout
+// (lane = idx & 31, j = (idx >> 5) & 7, tg = idx >> 8); the GS=32 group_kernel consumes it at local j*32+lane.
+extern "C" __global__ void tf_pack_dense_g32(const uint32_t* __restrict__ w, int n, int k8, int kg, uint32_t* __restrict__ out,
+                                             long long total) {
+    const long long idx = static_cast<long long>(blockIdx.x) * blockDim.x + threadIdx.x;
+    if (idx >= total) return;
+    const int lane = static_cast<int>(idx & 31), j = static_cast<int>((idx >> 5) & 7);
+    const long long tg = idx >> 8;
+    const int g = static_cast<int>(tg % kg);
+    const long long t = tg / kg;
+    const long long row = t * 64 + j * 8 + (lane >> 2);
+    const int c = lane & 3;
+    const int offs[8] = {0, 8, 16, 24, 1, 9, 17, 25};
+    uint32_t word = 0;
+    if (row < n) {
+#pragma unroll
+        for (int p = 0; p < 8; ++p) {
+            const int input = g * 32 + 2 * c + offs[p];
+            const uint32_t src = w[row * k8 + (input >> 3)];
+            word |= ((src >> (4 * (input & 7))) & 0xFu) << (4 * p);
+        }
+    }
+    out[idx] = word;
+}
diff --git a/zig/kernels/cuda/glm_dflash.cu b/zig/kernels/cuda/glm_dflash.cu
index 468dbcdc..4f7a9eb2 100644
--- a/zig/kernels/cuda/glm_dflash.cu
+++ b/zig/kernels/cuda/glm_dflash.cu
@@ -350,3 +350,14 @@ extern "C" __global__ void df_gsum(const __nv_bfloat16* __restrict__ x, int ldx,
         xs[(long long)r * groups + g] = s;
     }
 }
+
+// The 32-group sums (TF_GLM_DFLASH2_Q32's linears): groups of 32, xs [rows][k / 32].
+extern "C" __global__ void df_gsum32(const __nv_bfloat16* __restrict__ x, int ldx, int k, float* __restrict__ xs) {
+    const int r = blockIdx.x, groups = k / 32;
+    const __nv_bfloat16* xr = x + (long long)r * ldx;
+    for (int g = threadIdx.x; g < groups; g += blockDim.x) {
+        float s = 0.f;
+        for (int i = 0; i < 32; ++i) s += bf(xr[g * 32 + i]);
+        xs[(long long)r * groups + g] = s;
+    }
+}
diff --git a/zig/kernels/cuda/glm_quant.cu b/zig/kernels/cuda/glm_quant.cu
index 866b5ade..ab475269 100644
--- a/zig/kernels/cuda/glm_quant.cu
+++ b/zig/kernels/cuda/glm_quant.cu
@@ -128,3 +128,44 @@ extern "C" __global__ void tf_glm_quantize4(const __nv_bfloat16* __restrict__ w,
     scales[i] = sb;
     biases[i] = bb;
 }
+
+// The 32-group variant (the reference engine's qwen4_exp quantize4): a thread per 32-group, same stores.
+extern "C" __global__ void tf_glm_quantize4_32(const __nv_bfloat16* __restrict__ w, long long groups,
+                                               int32_t* __restrict__ words, __nv_bfloat16* __restrict__ scales,
+                                               __nv_bfloat16* __restrict__ biases) {
+    const long long i = static_cast<long long>(blockIdx.x) * blockDim.x + threadIdx.x;
+    if (i >= groups) return;
+    const uint4* src = reinterpret_cast<const uint4*>(w) + 4 * i;
+    float x[32];
+#pragma unroll
+    for (int t = 0; t < 4; ++t) widen8(src[t], x + 8 * t);
+    float lo = x[0], hi = x[0];
+#pragma unroll
+    for (int j = 1; j < 32; ++j) lo = fminf(lo, x[j]), hi = fmaxf(hi, x[j]);
+    if (lo == 0.0f) {
+        int best = -1;
+#pragma unroll
+        for (int j = 0; j < 32; ++j) {
+            const int r = static_cast<int>(__brev(static_cast<unsigned>(j)) >> 27);
+            if (x[j] == 0.0f && r > best) best = r, lo = x[j];
+        }
+    }
+    const __nv_bfloat16 sb = __float2bfloat16_rn(fmaxf((hi - lo) * (1.0f / 15.0f), (float)1e-8));
+    const __nv_bfloat16 bb = __float2bfloat16_rn(lo);
+    const float scale = __bfloat162float(sb), bias = __bfloat162float(bb);
+    uint32_t out[4];
+#pragma unroll
+    for (int t = 0; t < 4; ++t) {
+        uint32_t word = 0;
+#pragma unroll
+        for (int j = 0; j < 8; ++j) {
+            const float q = fminf(fmaxf(rintf(__fdiv_rn(x[8 * t + j] - bias, scale)), 0.0f), 15.0f);
+            word |= static_cast<uint32_t>(q) << (4 * j);
+        }
+        out[t] = word;
+    }
+    uint4* dst = reinterpret_cast<uint4*>(words) + i;
+    dst[0] = make_uint4(out[0], out[1], out[2], out[3]);
+    scales[i] = sb;
+    biases[i] = bb;
+}
