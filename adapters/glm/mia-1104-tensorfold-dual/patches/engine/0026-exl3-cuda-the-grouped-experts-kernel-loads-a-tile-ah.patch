From 4d8f4733729d2d735b0ea8c10951d230f4dbe72c Mon Sep 17 00:00:00 2001
From: ajensenwaud <ajensenwaud@users.noreply.github.com>
Date: Tue, 27 Oct 2026 20:08:53 +1100
Subject: [PATCH 26/63] exl3 cuda: the grouped experts kernel loads a tile
 ahead

warp_tiles issues the next k tile's lane words before decoding the current one (exllamav3's experts kernel at
pf = 1). The decode, the mma chain and the warp sums are unchanged: same SASS arithmetic, same bits. On GB10,
MiMo-V2.6-Flash's routed experts go from 110 to 97 us a layer step; GLM-5.3-Flash decodes the same tokens.
Records: nvcc 13.0's measured on all five SMs (registers 145-168) and marked later_pending; nvcc 13.3's measured
receipt in pending_133.zig; 13.2 stays pending (no 13.2 compiler here), and its stale grouped_1 override goes.
---
 zig/kernels/cuda/exl3_experts.cu                  | 15 ++++++++++++---
 .../core/contract/measurements/pending_133.zig    |  3 +++
 zig/src/core/contract/registry.zig                |  7 +++----
 3 files changed, 18 insertions(+), 7 deletions(-)

diff --git a/zig/kernels/cuda/exl3_experts.cu b/zig/kernels/cuda/exl3_experts.cu
index c5a0ed2e..e03bbbba 100644
--- a/zig/kernels/cuda/exl3_experts.cu
+++ b/zig/kernels/cuda/exl3_experts.cu
@@ -23,17 +23,26 @@ struct GroupedArgs {
     int k, n, p, sk, maxm, slots, nexp_max, mats, ns, standard, skip;
 };
 
-// One warp's k tiles [kt0, kt0 + nkt) of an expert matrix into acc: per-lane loads and the shared decode (same bits).
+// One warp's k tiles [kt0, kt0 + nkt) of an expert matrix into acc: per-lane loads a tile ahead, the shared decode.
 template <int CB, int K2, int NT>
 __device__ __forceinline__ void warp_tiles(const uint32_t* T, int ntiles, int kt0, int nkt, int nt0, const half* x0,
                                            const half* x1, bool ok0, bool ok1, int lane, float (&acc)[NT][2][4]) {
     constexpr int TW = tile_words<K2>(), LW = lane_words<K2>();
     const size_t kstride = (size_t)ntiles * TW;
+    const uint32_t* tb = T + (size_t)kt0 * kstride + (size_t)nt0 * TW;
+    uint32_t nx[NT][LW];  // the next tile's words, in flight while this one decodes
+    if (nkt > 0)
+#pragma unroll
+        for (int j = 0; j < NT; ++j) ldg_lane_words<K2>(tb + j * TW, lane, nx[j]);
     for (int i = 0; i < nkt; ++i) {
-        const uint32_t* t0 = T + (size_t)(kt0 + i) * kstride + (size_t)nt0 * TW;
         uint32_t w[NT][LW];
 #pragma unroll
-        for (int j = 0; j < NT; ++j) ldg_lane_words<K2>(t0 + j * TW, lane, w[j]);
+        for (int j = 0; j < NT; ++j)
+#pragma unroll
+            for (int l = 0; l < LW; ++l) w[j][l] = nx[j][l];
+        if (i + 1 < nkt)
+#pragma unroll
+            for (int j = 0; j < NT; ++j) ldg_lane_words<K2>(tb + (size_t)(i + 1) * kstride + j * TW, lane, nx[j]);
         const int k = (kt0 + i) * 16;
         const uint32_t a[4] = {ok0 ? *reinterpret_cast<const uint32_t*>(x0 + k) : 0u,
                                ok1 ? *reinterpret_cast<const uint32_t*>(x1 + k) : 0u,
