From df309a6d383631d0f8ba1bdc9d1564a232468259 Mon Sep 17 00:00:00 2001
From: MiaAI-Lab <mia.ailab1@gmail.com>
Date: Fri, 30 Oct 2026 16:06:56 +0200
Subject: [PATCH 58/63] glm cuda: TF_GLM_DFLASH2_RING_DIGEST hashes a prompt's
 drafter context (a check, off by default)

With TF_GLM_DFLASH2_RING_DIGEST=1, once the last chunk of a prompt of 8,192 ids or more is in
(a chunk at a time, or a paired step), each rank logs a hash of the slot's whole DFlash2
context ring. Two runs that should build the drafter the same context, such as a prompt
paired and the same prompt a chunk at a time, can then be compared row for row instead of
through acceptance counts. Unset, nothing runs; shorter prompts are skipped so their timing
stays clean.

---
 zig/src/families/glm/cuda_engine.zig      |  1 +
 zig/src/families/glm/cuda_prompt_pair.zig |  1 +
 zig/src/families/glm/dflash.zig           | 13 +++++++++++++
 3 files changed, 15 insertions(+)

diff --git a/zig/src/families/glm/cuda_engine.zig b/zig/src/families/glm/cuda_engine.zig
index e9e75411..150327e3 100644
--- a/zig/src/families/glm/cuda_engine.zig
+++ b/zig/src/families/glm/cuda_engine.zig
@@ -456,6 +456,7 @@ pub const Engine = struct {
         stamp.end();
         stamp = prof_mod.span(f.prof, e.stream, .drafter);
         if (e.drafter) |dr| try dr.prompt(e, e.slot, start, rows, len);
+        if (e.drafter) |dr| if (start + rows == len) try dr.ringDigest(e, e.slot, len);
         stamp.end();
         stamp = prof_mod.span(f.prof, e.stream, .draw);
         const last = start + rows == len;
diff --git a/zig/src/families/glm/cuda_prompt_pair.zig b/zig/src/families/glm/cuda_prompt_pair.zig
index ce8cba57..ddee4525 100644
--- a/zig/src/families/glm/cuda_prompt_pair.zig
+++ b/zig/src/families/glm/cuda_prompt_pair.zig
@@ -118,6 +118,7 @@ pub fn prefill(e: *Engine, part: []const u32, start: usize, len: usize, cancel:
     if (e.drafter) |dr| { // a's rows from its taps_prefill, then b's from the twin's, each as its own chunk would
         try dr.prompt(e, e.slot, start, ra, len);
         try dr.promptFrom(e, e.slot, start + ra, rb, len, pair.taps.?.ptr);
+        if (start + ra + rb == len) try dr.ringDigest(e, e.slot, len);
     }
     try mtpRows(e, &fa, ids[1 .. ra + 1], e.bp.fnormed);
     try fa.commit(ra);
diff --git a/zig/src/families/glm/dflash.zig b/zig/src/families/glm/dflash.zig
index 4b0cbe60..9da8bda8 100644
--- a/zig/src/families/glm/dflash.zig
+++ b/zig/src/families/glm/dflash.zig
@@ -243,6 +243,19 @@ pub const Drafter = struct {
         s.* = .{ .ring = s.ring, .from = s.from, .first = s.first, .end = s.end, .v_step = dr.verifies, .v_row0 = row0, .v_rows = rows, .v_pos0 = @intCast(pos0) };
     }
 
+    /// TF_GLM_DFLASH2_RING_DIGEST=1 (a check, off by default): once a prompt is in, slot `i`'s whole context ring hashed
+    /// and logged for prompts of 8192 ids or more, so two runs (paired or a chunk at a time) can show the same context.
+    pub fn ringDigest(dr: *Drafter, e: anytype, i: u32, len: usize) !void {
+        const v = std.c.getenv("TF_GLM_DFLASH2_RING_DIGEST") orelse return;
+        if (!std.mem.eql(u8, std.mem.span(v), "1") or len < 8192) return; // long prompts only: a short one's time stays clean
+        const s = try dr.slot(i);
+        try e.stream.synchronize();
+        const host = try dr.gpa.alloc(u8, ring_bytes);
+        defer dr.gpa.free(host);
+        try s.ring.?.download(0, host);
+        std.log.info("dflash2: ring digest slot {d} after a {d}-id prompt: {x:0>16}", .{ i, len, std.hash.Wyhash.hash(0, host) });
+    }
+
     /// A prompt chunk on slot `i` (rows start.. of a `len`-id prompt): its rows within the last window into the ring.
     pub fn prompt(dr: anytype, e: anytype, i: u32, start: usize, rows: usize, len: usize) !void {
         return dr.promptSegment(e, i, start, rows, len, 0);
-- 
2.53.0

