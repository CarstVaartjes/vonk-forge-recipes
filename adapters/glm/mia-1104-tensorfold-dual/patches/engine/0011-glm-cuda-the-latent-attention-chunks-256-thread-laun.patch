From c6dcdfd8969126aeeb215e1fa5a528854e458788 Mon Sep 17 00:00:00 2001
From: MiaAI-Lab <mia.ailab1@gmail.com>
Date: Fri, 30 Oct 2026 14:39:07 +0200
Subject: [PATCH 11/13] glm cuda: the latent attention chunks' 256-thread
 launch is a named contract

chunks_wide splits its 8 warps into key groups and head blocks, and since the FP8 tile loads
moved to 8-byte units each thread also owns KT * (LW / 8) / 256 of a tile's units. Both
assumed the 256 threads cuda_latent.chunks launches, by a literal on each side.
glm_glue_attn.cuh now names it CHUNK_THREADS (static_assert: a tile's units split evenly) and
the kernel traps on any other block width instead of leaving keys unloaded;
cuda_latent.chunk_threads launches it. Same SASS apart from the guard: on sm_120 the HB32
FP8 instance stays at 167 registers (130 before the 8-byte loads), no spills, one block an SM
as before (101,120 bytes of shared memory); HB16 FP8 125. The contract records'
sm_120 register counts for the FP8 instances still say 130/64 and need the new receipts.

---
 zig/kernels/cuda/glm_glue_attn.cuh   | 11 ++++++++---
 zig/src/families/glm/cuda_latent.zig |  6 +++++-
 2 files changed, 13 insertions(+), 4 deletions(-)

diff --git a/zig/kernels/cuda/glm_glue_attn.cuh b/zig/kernels/cuda/glm_glue_attn.cuh
index b92c2e7e..19752cd6 100644
--- a/zig/kernels/cuda/glm_glue_attn.cuh
+++ b/zig/kernels/cuda/glm_glue_attn.cuh
@@ -7,6 +7,10 @@
 namespace glm_attn {
 
 constexpr int LW = 512, KT = 32, CH = 512, KPAD = LW + 8;
+// chunks_wide's block: its 8 warps' (key group, head block) split and the FP8 tiles' units a thread both assume it;
+// cuda_latent.chunk_threads launches it, and a launch of any other width traps instead of leaving keys unloaded.
+constexpr int CHUNK_THREADS = 256;
+static_assert(KT * (LW / 8) % CHUNK_THREADS == 0, "an FP8 tile's 8-code units split evenly over the block");
 
 // p fp32 summed as Triton's tile does: a thread's two columns, the quad (xor 2, 1), then warps (w0 + w2) + (w1 + w3).
 __device__ __forceinline__ float quad_sum(float v) {
@@ -62,6 +66,7 @@ __device__ void chunks_wide(const __nv_bfloat16* qa, const __nv_bfloat16* lc, co
   __nv_bfloat16* ps = kvs + 2 * KT * LW;
   float* red = reinterpret_cast<float*>(ps + HB * KT);
   float* stat = red + HB * 4;
+  if (blockDim.x != CHUNK_THREADS) __trap();  // the launch contract above, not a tuning knob
   const int t = threadIdx.x, lane = t & 31, warp = t >> 5, g = lane >> 2, q = lane & 3;
   const int kg = warp & 3, hh = warp >> 2;
   const int64_t r = blockIdx.x, h0 = (int64_t)blockIdx.y * HB, c = blockIdx.z;
@@ -71,7 +76,7 @@ __device__ void chunks_wide(const __nv_bfloat16* qa, const __nv_bfloat16* lc, co
   const __nv_bfloat16* keys_at = !FP8 && pt && !sparse && live ? lc + ((int64_t)pt[c] * (pstep / 2) - start * LW) : lc;
   // E4M3 tiles: each thread's 8-code units in one 8-byte load apiece, all issued before any is converted (fetch8),
   // then converted value for value as before (store8); the loop fetches tile + 2 before its math and stores it after.
-  constexpr int UPT = KT * (LW / 8) / 256;  // units a thread moves a tile: the launches' 256 threads (cuda_latent)
+  constexpr int UPT = KT * (LW / 8) / CHUNK_THREADS;  // units a thread moves a tile
   uint2 raw[FP8 ? UPT : 1];
   float rsc[FP8 ? UPT : 1];
   auto fetch8 = [&](int tile) {
@@ -79,7 +84,7 @@ __device__ void chunks_wide(const __nv_bfloat16* qa, const __nv_bfloat16* lc, co
     const int64_t first = start + tile * KT;
 #pragma unroll
     for (int i = 0; i < UPT; ++i) {
-      const int idx = t + i * 256, key = idx / (LW / 8), u = idx % (LW / 8);
+      const int idx = t + i * CHUNK_THREADS, key = idx / (LW / 8), u = idx % (LW / 8);
       const int64_t ki = first + key;
       const bool ok = sparse ? ki < n : ki <= limit;
       const int64_t src = ok ? (sparse ? (int64_t)tok[r * w + ki] : ki) : 0;
@@ -91,7 +96,7 @@ __device__ void chunks_wide(const __nv_bfloat16* qa, const __nv_bfloat16* lc, co
     __nv_bfloat16* dst = kvs + (tile & 1) * KT * LW;
 #pragma unroll
     for (int i = 0; i < UPT; ++i) {
-      const int idx = t + i * 256, key = idx / (LW / 8), u = idx % (LW / 8);
+      const int idx = t + i * CHUNK_THREADS, key = idx / (LW / 8), u = idx % (LW / 8);
       const uint32_t wv[2] = {raw[i].x, raw[i].y};
 #pragma unroll
       for (int j = 0; j < 8; j += 2) {
diff --git a/zig/src/families/glm/cuda_latent.zig b/zig/src/families/glm/cuda_latent.zig
index 8cc7b2ee..1672714f 100644
--- a/zig/src/families/glm/cuda_latent.zig
+++ b/zig/src/families/glm/cuda_latent.zig
@@ -12,6 +12,10 @@ pub const heads_tile_wide = 32;
 pub const prompt_rows = 64;
 pub const prompt_rb = 64;
 
+/// The chunk kernels' block (glm_glue_attn.cuh CHUNK_THREADS): their warp split and FP8 tile loads assume it, and they
+/// trap on any other width.
+pub const chunk_threads = 256;
+
 /// latent.head_block: a rank's 32 heads a program in prompt chunks (each key read once), 16 in decode windows.
 pub fn headBlock(rows: usize) usize {
     return if (rows >= 64) heads_tile_wide else heads_tile;
@@ -105,7 +109,7 @@ fn chunks(set: glue.Set, stream: cuda.Stream, qa: u64, cache: u64, scales: u64,
         a.add(@as(i64, @intCast(t.ps)));
     }
     const shared = if (hb == heads_tile_wide) glue.chunksSmem(heads_tile_wide) else glue.chunksSmem(heads_tile);
-    try cuda.launch.launch(f, .{ .grid = .{ .x = @intCast(rows), .y = cdiv(heads, hb), .z = @intCast(nch) }, .block = .{ .x = 256 }, .shared = shared }, stream, &a);
+    try cuda.launch.launch(f, .{ .grid = .{ .x = @intCast(rows), .y = cdiv(heads, hb), .z = @intCast(nch) }, .block = .{ .x = chunk_threads }, .shared = shared }, stream, &a);
 }
 
 /// latent.sparse_attention: rows with counts > 0 over their selected tokens (i32 [rows][w]); others left alone.
