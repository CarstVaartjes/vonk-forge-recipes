+    try expectCutBefore("\n</tool_call>", named ++ "{\"path\": \"a.txt\"}}", 1, "{\"path\":\"a.txt\"}", "", "");
+}
+
+test "a cut JSON call reads parameters, and arguments written before the name" {
+    const params = "<tool_call>\n{\"name\": \"write_file\", \"parameters\": {\"path\": \"no";
+    try expectCutBefore("tes.txt\"}}\n</tool_call>", params, 1, "{\"path\": \"no", "", "");
+    const first = "<tool_call>\n{\"arguments\": {\"path\": \"a.txt\"}, \"name\": \"write_file\"";
+    try expectCutBefore("}\n</tool_call>", first, 1, "{\"path\":\"a.txt\"}", "", "");
+    // the arguments' own "name" is not the call's: cut before the call's, the reply is text
+    const unnamed = "<tool_call>\n{\"arguments\": {\"name\": \"write_file\", \"path\": \"a";
+    try expectCutBefore(".txt\"}, \"name\": \"write_file\"}\n</tool_call>", unnamed, 0, "", unnamed, "");
+}
+
+test "a cut JSON call keeps the one-call policy, and one not yet named or not offered stays text" {
+    const cut = "Writing it.\n<tool_call>\n{\"name\": \"write_file\", \"arguments\": {\"path\": \"no";
+    try expectCutBefore("tes.txt\"}}\n</tool_call>", cut, 0, "", null, ",\"parallel_tool_calls\":false");
+    try expectCutBefore("e\": \"write_file\"}\n</tool_call>", "<tool_call>\n{\"nam", 0, "", "<tool_call>\n{\"nam", "");
+    const unoffered = "<tool_call>\n{\"name\": \"launch\", \"arguments\": {\"x\": 1";
+    try expectCutBefore("}}\n</tool_call>", unoffered, 0, "", unoffered, "");
+}
+
 test "a chunked XML cut drops only the pending framing newline" {
     var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
     defer arena.deinit();
diff --git a/zig/src/server/tool_json_cut.zig b/zig/src/server/tool_json_cut.zig
new file mode 100644
index 000000000..2ec8279a6
--- /dev/null
+++ b/zig/src/server/tool_json_cut.zig
@@ -0,0 +1,219 @@
+//! A JSON call max_tokens cut (``<tool_call>\n{"name": "f", "arguments": {...``, Ripple's form): the call, cut.
+const std = @import("std");
+const json = @import("json");
+const ids = @import("ids.zig");
+const reply_text = @import("reply_text.zig");
+const tool_parse = @import("tool_parse.zig");
+const tool_specs = @import("tool_specs.zig");
+const Value = json.Value;
+const Allocator = std.mem.Allocator;
+
+/// The keys ``tool_parse.payload`` reads a call's name and arguments from (a nested `function` names by the first 3).
+const name_keys = [_][]const u8{ "name", "tool", "function", "call" };
+const argument_keys = [_][]const u8{ "arguments", "args", "parameters" };
+
+/// A reply max_tokens cut inside a JSON call: the whole calls before it, then it, cut; null when it ends in none.
+pub fn cutCalls(a: Allocator, text: []const u8, tools: []const Value) Allocator.Error!?[]Value {
+    const start = tool_parse.openCall(text) orelse return null;
+    const cut = try cutCall(a, text[start + "<tool_call>".len ..], tools) orelse return null;
+    const before = (try tool_parse.parse(a, text[0..start], tools, null)).calls orelse &.{};
+    return try std.mem.concat(a, Value, &.{ before, &.{cut} });
+}
+
+/// The JSON string at `s[0]` (a quote): its end past the closing quote; null when the cut came first.
+fn stringEnd(s: []const u8) ?usize {
+    var i: usize = 1;
+    while (i < s.len) : (i += 1) switch (s[i]) {
+        '\\' => i += 1,
+        '"' => return i + 1,
+        else => {},
+    };
+    return null;
+}
+
+/// The end of the JSON value `s` begins with when it is whole (balanced brackets outside strings); null if cut.
+fn valueEnd(s: []const u8) ?usize {
+    var depth: usize = 0;
+    var i: usize = 0;
+    while (i < s.len) {
+        switch (s[i]) {
+            '"' => {
+                i += stringEnd(s[i..]) orelse return null;
+                if (depth == 0) return i;
+                continue;
+            },
+            '{', '[' => depth += 1,
+            '}', ']' => {
+                if (depth == 0) return i;
+                depth -= 1;
+                if (depth == 0) return i + 1;
+            },
+            else => if (depth == 0 and (s[i] == ',' or std.ascii.isWhitespace(s[i]))) return i,
+        }
+        i += 1;
+    }
+    return null;
+}
+
+/// A member of a written object: its key, its value as far as written, and whether the cut came inside the value.
+const Member = struct { key: []const u8, value: []const u8, cut: bool };
+
+/// The members the object text `body` (from its `{`) writes before the cut, in order.
+fn members(a: Allocator, body: []const u8) Allocator.Error![]const Member {
+    var out: std.ArrayList(Member) = .empty;
+    var i = skip(body, 1);
+    while (i < body.len and body[i] == '"') {
+        const key_end = i + (stringEnd(body[i..]) orelse break);
+        const key = switch (try json.parseText(a, body[i..key_end])) {
+            .ok => |v| if (v == .string) v.string else break,
+            .err => break,
+        };
+        i = skip(body, key_end);
+        if (i >= body.len or body[i] != ':') break;
+        i = skip(body, i + 1);
+        if (i >= body.len) break;
+        const end = valueEnd(body[i..]) orelse {
+            try out.append(a, .{ .key = key, .value = body[i..], .cut = true });
+            break;
+        };
+        if (end == 0) break; // a key with no value written (`{"name":,`): nothing past it is a member
+        try out.append(a, .{ .key = key, .value = body[i..][0..end], .cut = false });
+        i = skip(body, i + end);
+        if (i >= body.len or body[i] != ',') break;
+        i = skip(body, i + 1);
+    }
+    return out.items;
+}
+
+fn skip(s: []const u8, from: usize) usize {
+    var i = from;
+    while (i < s.len and std.ascii.isWhitespace(s[i])) i += 1;
+    return i;
+}
+
+/// The first written member named `key`.
+fn find(ms: []const Member, key: []const u8) ?Member {
+    for (ms) |m| if (std.mem.eql(u8, m.key, key)) return m;
+    return null;
+}
+
+/// The call the whole payload `doc` makes in a closed envelope, as ``tool_parse.parse`` reads it; null if none.
+fn closed(a: Allocator, doc: []const u8, tools: []const Value) Allocator.Error!?Value {
+    const text = try std.mem.concat(a, u8, &.{ "<tool_call>", doc, "</tool_call>" });
+    const calls = (try tool_parse.parse(a, text, tools, null)).calls orelse return null;
+    return calls[0];
+}
+
+/// The call an open envelope's `written` payload begins, keyed as a closed one; null unless it names a tool.
+fn cutCall(a: Allocator, written: []const u8, tools: []const Value) Allocator.Error!?Value {
+    const body = reply_text.pyLstrip(written);
+    if (body.len == 0 or body[0] != '{') return null;
+    if (valueEnd(body)) |end| return closed(a, body[0..end], tools);
+    const top = try members(a, body);
+    const nested = find(top, "function");
+    const inner = nested != null and nested.?.value[0] == '{';
+    const holder = if (inner) try members(a, nested.?.value) else top;
+    const quoted = for (if (inner) name_keys[0..3] else &name_keys) |k| {
+        const m = find(holder, k) orelse continue;
+        if (m.cut) return null; // the name is whole once its closing quote came
+        if (m.value[0] == '"' and m.value.len > 2) break m.value;
+    } else return null;
+    const args = for (argument_keys) |k| {
+        if (find(holder, k)) |m| break m;
+    } else return null; // no arguments written yet: the text stays
+    if (!args.cut) {
+        const doc = try std.mem.concat(a, u8, &.{ "{\"name\":", quoted, ",\"arguments\":", args.value, "}" });
+        return closed(a, doc, tools);
+    }
+    const name = switch (try json.parseText(a, quoted)) {
+        .ok => |v| if (v == .string) (try offered(a, v.string, tools)) orelse return null else return null,
+        .err => return null,
+    };
+    const function = try json.newObject(a);
+    try function.put(a, "name", .{ .string = name });
+    const written_args = if (args.value[0] == '"') try cutString(a, args.value) else args.value;
+    try function.put(a, "arguments", .{ .string = written_args });
+    const call = try json.newObject(a);
+    try call.put(a, "id", .{ .string = try ids.make(a, "call_", 24) });
+    try call.put(a, "type", .{ .string = "function" });
+    try call.put(a, "function", .{ .object = function });
+    return .{ .object = call };
+}
+
+/// A cut JSON string's text as far as written; an escape the cut split is dropped.
+fn cutString(a: Allocator, s: []const u8) Allocator.Error![]const u8 {
+    var end = s.len;
+    while (end > 1 and end + 6 > s.len) : (end -= 1) {
+        switch (try json.parseText(a, try std.mem.concat(a, u8, &.{ s[0..end], "\"" }))) {
+            .ok => |v| if (v == .string) return v.string,
+            .err => {},
+        }
+    }
+    return "";
+}
+
+/// The offered tool's spelling of `name`, as ``tool_parse.parse`` matches it (trimmed, any case); null if none.
+fn offered(a: Allocator, name: []const u8, tools: []const Value) Allocator.Error!?[]const u8 {
+    const want = std.mem.trim(u8, name, " \t\r\n\x0b\x0c");
+    for (tools) |tool| {
+        const spelled = try tool_specs.toolName(a, tool);
+        if (spelled.len > 0 and std.ascii.eqlIgnoreCase(spelled, want)) return spelled;
+    }
+    return null;
+}
+
+const weather = "[{\"type\":\"function\",\"function\":{\"name\":\"get_weather\",\"parameters\":{}}}]";
+
+/// The arguments of the call `payload` begins in an open envelope; null when it stays text.
+fn cutArguments(a: Allocator, payload: []const u8) !?[]const u8 {
+    const tools = (try json.parseText(a, weather)).ok.array;
+    const calls = try cutCalls(a, try std.mem.concat(a, u8, &.{ "<tool_call>\n", payload }), tools) orelse return null;
+    try std.testing.expectEqual(@as(usize, 1), calls.len);
+    try std.testing.expectEqualStrings("get_weather", calls[0].get("function").?.strField("name").?);
+    return calls[0].get("function").?.strField("arguments").?;
+}
+
+test "a JSON call cut inside its arguments is the call, cut; one cut before its name is whole stays text" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const tools = (try json.parseText(a, weather)).ok.array;
+    const head = "<think>\nok\n</think>\n\n<tool_call>\n{\"name\": \"get_weather\", \"arguments\": ";
+    const mid = (try cutCalls(a, head ++ "{\"city\": \"Syd", tools)).?;
+    try std.testing.expectEqual(@as(usize, 1), mid.len);
+    const f = mid[0].get("function").?;
+    try std.testing.expectEqualStrings("get_weather", f.strField("name").?);
+    try std.testing.expectEqualStrings("{\"city\": \"Syd", f.strField("arguments").?);
+    const whole = (try cutCalls(a, head ++ "{\"city\": \"Sydney\"}}\n</", tools)).?;
+    try std.testing.expectEqualStrings("{\"city\":\"Sydney\"}", whole[0].get("function").?.strField("arguments").?);
+    try std.testing.expect(try cutCalls(a, "<tool_call>\n{\"na", tools) == null);
+    try std.testing.expect(try cutCalls(a, "<tool_call>\n{\"name\": \"other\", \"arguments\": {", tools) == null);
+    try std.testing.expect(try cutCalls(a, "<tool_call>\n{\"name\": \"get_weather\"}\n</tool_call>", tools) == null);
+}
+
+test "a cut JSON call reads the keys a closed one does, and whole arguments spell as the closed call's" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const city = "{\"city\":\"Sydney\"}";
+    const named = "{\"name\": \"get_weather\", ";
+    try expectArguments(a, city, named ++ "\"arguments\": {\"city\": \"Sydney\"}");
+    try expectArguments(a, city, "{\"arguments\": {\"city\": \"Sydney\"}, \"name\": \"get_weather\"");
+    try expectArguments(a, "{\"city\": \"Sy", named ++ "\"parameters\": {\"city\": \"Sy");
+    try expectArguments(a, "{\"city\": \"Sy", "{\"tool\": \"get_weather\", \"args\": {\"city\": \"Sy");
+    const nested = "{\"type\": \"function\", \"function\": " ++ named ++ "\"arguments\": ";
+    try expectArguments(a, "{\"city\": \"Sy", nested ++ "\"{\\\"city\\\": \\\"Sy");
+    try expectArguments(a, "{\"city\": \"Sy", nested ++ "\"{\\\"city\\\": \\\"Sy\\");
+    try expectArguments(a, city, nested ++ "{\"city\": \"Sydney\"}");
+    // the arguments' own "name" is not the call's, and a call with no arguments key yet stays text
+    try std.testing.expect(try cutArguments(a, "{\"arguments\": {\"name\": \"get_weather\", \"city\": \"Sy") == null);
+    try std.testing.expect(try cutArguments(a, named ++ "\"argu") == null);
+    // a key with no value stays text, and a name in another case is the offered tool's, as a closed call's is
+    try std.testing.expect(try cutArguments(a, "{\"name\":, \"arguments\": {\"city\": \"Sy") == null);
+    try std.testing.expect(try cutArguments(a, "{\"function\":, \"arguments\": {\"city\": \"Sy") == null);
+    try expectArguments(a, "{\"city\": \"Sy", "{\"name\": \" GET_WEATHER \", \"arguments\": {\"city\": \"Sy");
+}
+
+fn expectArguments(a: Allocator, want: []const u8, payload: []const u8) !void {
+    try std.testing.expectEqualStrings(want, (try cutArguments(a, payload)) orelse return error.NoCall);
+}
diff --git a/zig/src/server/tool_json_cut_routes_test.zig b/zig/src/server/tool_json_cut_routes_test.zig
new file mode 100644
index 000000000..16c2432c5
--- /dev/null
+++ b/zig/src/server/tool_json_cut_routes_test.zig
@@ -0,0 +1,221 @@
+//! A JSON call max_tokens cuts on /v1/messages and /v1/responses, whole and streamed (the chat run's cut call).
+const std = @import("std");
+const api = @import("engine_api");
+const server = @import("root.zig");
+const json = server.json;
+const model_text = @import("model_text.zig");
+const exchange = @import("late_system_test.zig").exchange;
+const testing = std.testing;
+const Allocator = std.mem.Allocator;
+
+/// Bytes as tokens, no end token; every prompt renders as "prompt".
+const ByteText = struct {
+    fn text(t: *@This()) model_text.Text {
+        return .{ .ctx = t, .vtable = &.{
+            .encode = encode,
+            .decode = decode,
+            .token_id = tokenId,
+            .token_string = tokenString,
+            .vocab_size = vocabSize,
+            .eos_ids = eosIds,
+            .render = render,
+            .template_source = templateSource,
+        } };
+    }
+
+    fn encode(_: *anyopaque, a: Allocator, input: []const u8, _: bool) model_text.Error![]u32 {
+        const out = try a.alloc(u32, input.len);
+        for (input, out) |byte, *id| id.* = byte;
+        return out;
+    }
+
+    fn decode(_: *anyopaque, a: Allocator, tokens: []const u32) Allocator.Error![]u8 {
+        const out = try a.alloc(u8, tokens.len);
+        for (tokens, out) |id, *byte| byte.* = @intCast(id);
+        return out;
+    }
+
+    fn tokenId(_: *anyopaque, _: []const u8) ?u32 {
+        return null;
+    }
+
+    fn tokenString(_: *anyopaque, a: Allocator, id: u32) Allocator.Error![]u8 {
+        return decode(undefined, a, &.{id});
+    }
+
+    fn vocabSize(_: *anyopaque) u32 {
+        return 256;
+    }
+
+    fn eosIds(_: *anyopaque) []const u32 {
+        return &.{};
+    }
+
+    const Rendered = model_text.Error!model_text.Rendered;
+
+    fn render(_: *anyopaque, a: Allocator, _: json.Value, _: model_text.RenderOptions, _: *[]const u8) Rendered {
+        return .{ .text = try a.dupe(u8, "prompt") };
+    }
+
+    fn templateSource(_: *anyopaque) []const u8 {
+        return "";
+    }
+};
+
+/// Writes `reply` a byte a token, then stops at max_tokens.
+const Script = struct {
+    reply: []const u8,
+
+    fn engine(e: *@This()) api.Engine {
+        return .{ .ctx = e, .vtable = &.{
+            .info = info,
+            .submit = submit,
+            .cancel = cancel,
+            .status = status,
+            .memory = memory,
+        } };
+    }
+
+    fn info(_: *anyopaque) api.Info {
+        return .{ .context_window = 4096 };
+    }
+
+    fn submit(ctx: *anyopaque, id: api.Id, _: *const api.Request, sink: api.Sink) api.SubmitError!void {
+        const e: *Script = @ptrCast(@alignCast(ctx));
+        sink.event(sink.ctx, id, &.{ .prefilled = 0 });
+        for (e.reply) |byte| sink.event(sink.ctx, id, &.{ .tokens = &.{byte} });
+        sink.event(sink.ctx, id, &.{ .finished = .{ .reason = .length } });
+    }
+
+    fn cancel(_: *anyopaque, _: api.Id) void {}
+
+    fn status(_: *anyopaque, out: *api.Status, _: []u32) void {
+        out.* = .{};
+    }
+
+    fn memory(_: *anyopaque, _: bool) ?api.Memory {
+        return null;
+    }
+};
+
+const schema = "{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"}," ++
+    "\"content\":{\"type\":\"string\"}}}";
+const named = "Writing it.\n<tool_call>\n{\"name\": \"write_file\", \"arguments\": ";
+const cut_args = "{\"path\": \"notes.txt\", \"content\": \"The history of";
+const whole_args = "{\"path\": \"notes.txt\"}";
+const compact = "{\"path\":\"notes.txt\"}";
+const cut_closed = "{\"path\":\"notes.txt\",\"content\":\"The history of\"}";
+const xml_cut = "Writing it.\n<tool_call>\n<function=write_file>\n<parameter=path>\nnotes.txt\n</parameter>\n" ++
+    "<parameter=content>\nThe history of";
+
+const messages_tool = "{\"name\":\"write_file\",\"input_schema\":" ++ schema ++ "}";
+const responses_tool = "{\"type\":\"function\",\"name\":\"write_file\",\"parameters\":" ++ schema ++ "}";
+
+/// What a route's reply says: its status, text, the call's arguments, and why it ended.
+const Seen = struct { status: u16, text: []const u8 = "", args: []const u8 = "", finish: []const u8 = "" };
+
+/// `reply` cut at its end on `path`, whole or streamed, read back as `Seen`.
+fn send(a: Allocator, path: []const u8, reply: []const u8, stream: bool) !Seen {
+    var text: ByteText = .{};
+    var backend: Script = .{ .reply = reply };
+    const srv = try server.Server.init(testing.allocator, testing.io, backend.engine(), text.text(), .{
+        .served_name = "m",
+        .model_ids = &.{"m"},
+        .enable_thinking = false,
+        .use_drafts = false,
+    }, null);
+    defer srv.deinit();
+    const messages = std.mem.eql(u8, path, "/v1/messages");
+    const body = try std.fmt.allocPrint(a, "{{\"model\":\"m\",\"{s}\":{d},\"stream\":{s},{s},\"tools\":[{s}]}}", .{
+        if (messages) "max_tokens" else "max_output_tokens",
+        reply.len,
+        if (stream) "true" else "false",
+        if (messages) "\"messages\":[{\"role\":\"user\",\"content\":\"x\"}]" else "\"input\":\"x\"",
+        if (messages) messages_tool else responses_tool,
+    });
+    const got = try exchange(srv, path, body);
+    defer testing.allocator.free(got.body);
+    const raw = try a.dupe(u8, got.body);
+    var seen: Seen = .{ .status = got.status };
+    if (got.status != 200) return seen;
+    if (!stream) {
+        const doc = (try json.parseText(a, raw)).ok;
+        if (messages) {
+            for (doc.get("content").?.array) |b| {
+                if (b.typeIs("text")) seen.text = b.strField("text").?;
+                const compacted: json.Options = .{ .ascii = false, .compact = true };
+                if (b.typeIs("tool_use")) seen.args = try json.stringify(a, b.get("input").?, compacted);
+            }
+            seen.finish = doc.strField("stop_reason").?;
+            return seen;
+        }
+        for (doc.get("output").?.array) |item| {
+            if (item.typeIs("message")) seen.text = item.get("content").?.array[0].strField("text").?;
+            if (item.typeIs("function_call")) seen.args = item.strField("arguments").?;
+        }
+        seen.finish = doc.get("incomplete_details").?.strField("reason").?;
+        return seen;
+    }
+    var text_out: std.ArrayList(u8) = .empty;
+    var args_out: std.ArrayList(u8) = .empty;
+    var lines = std.mem.splitScalar(u8, raw, '\n');
+    while (lines.next()) |line| {
+        if (!std.mem.startsWith(u8, line, "data: ")) continue;
+        const ev = switch (try json.parseText(a, std.mem.trim(u8, line[6..], "\r"))) {
+            .ok => |v| v,
+            .err => continue,
+        };
+        if (messages) {
+            if (ev.get("delta")) |d| {
+                if (d.typeIs("text_delta")) try text_out.appendSlice(a, d.strField("text").?);
+                if (d.typeIs("input_json_delta")) try args_out.appendSlice(a, d.strField("partial_json").?);
+                if (d.strField("stop_reason")) |r| seen.finish = r;
+            }
+            continue;
+        }
+        if (ev.typeIs("response.output_text.delta")) try text_out.appendSlice(a, ev.strField("delta").?);
+        if (ev.typeIs("response.function_call_arguments.delta")) try args_out.appendSlice(a, ev.strField("delta").?);
+        // the stream only grows: its pieces join to the arguments it ends with
+        if (ev.typeIs("response.function_call_arguments.done"))
+            try testing.expectEqualStrings(args_out.items, ev.strField("arguments").?);
+        const details = if (ev.typeIs("response.incomplete")) ev.get("response").?.get("incomplete_details") else null;
+        if (details) |d| seen.finish = d.strField("reason").?;
+    }
+    seen.text = text_out.items;
+    seen.args = args_out.items;
+    return seen;
+}
+
+fn expectSeen(want: Seen, got: Seen) !void {
+    try testing.expectEqual(want.status, got.status);
+    try testing.expectEqualStrings(want.text, got.text);
+    try testing.expectEqualStrings(want.args, got.args);
+    try testing.expectEqualStrings(want.finish, got.finish);
+}
+
+test "a cut JSON call on /v1/responses is the cut function_call, whole and streamed" {
+    var arena: std.heap.ArenaAllocator = .init(testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    for ([_]bool{ false, true }) |stream| {
+        const cut: Seen = .{ .status = 200, .text = "Writing it.", .args = cut_args, .finish = "max_output_tokens" };
+        try expectSeen(cut, try send(a, "/v1/responses", named ++ cut_args, stream));
+        const whole: Seen = .{ .status = 200, .text = "Writing it.", .args = compact, .finish = "max_output_tokens" };
+        try expectSeen(whole, try send(a, "/v1/responses", named ++ whole_args, stream));
+    }
+}
+
+test "a cut JSON or XML call on /v1/messages is a tool_use with its input as far as written, whole and streamed" {
+    var arena: std.heap.ArenaAllocator = .init(testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const cut: Seen = .{ .status = 200, .text = "Writing it.", .args = cut_args, .finish = "max_tokens" };
+    try expectSeen(cut, try send(a, "/v1/messages", named ++ cut_args, true));
+    const whole: Seen = .{ .status = 200, .text = "Writing it.", .args = compact, .finish = "max_tokens" };
+    for ([_]bool{ false, true }) |stream|
+        try expectSeen(whole, try send(a, "/v1/messages", named ++ whole_args, stream));
+    // a whole Messages reply needs an input object: the cut arguments closed as far as written, the XML cut's alike
+    const closed: Seen = .{ .status = 200, .text = "Writing it.", .args = cut_closed, .finish = "max_tokens" };
+    try expectSeen(closed, try send(a, "/v1/messages", named ++ cut_args, false));
+    try expectSeen(closed, try send(a, "/v1/messages", xml_cut, false));
+}
