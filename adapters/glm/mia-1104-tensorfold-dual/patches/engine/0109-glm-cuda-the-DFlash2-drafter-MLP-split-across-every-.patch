     succ: []u16 = &.{},
-    split: bool, // the MLP split across two ranks (gate and up by rows, down by K)
+    split: bool, // the MLP split across the ranks (gate and up by rows, down by K): mlpSplit
     ff: usize, // the MLP width this rank holds
     rank: usize,
