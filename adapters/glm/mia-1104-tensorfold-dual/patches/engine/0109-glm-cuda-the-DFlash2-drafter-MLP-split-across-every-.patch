     succ: []u16 = &.{},
diff --git a/zig/kernels/cuda/glm_dflash.cu b/zig/kernels/cuda/glm_dflash.cu
index 4f7a9eb23..18c679bf0 100644
--- a/zig/kernels/cuda/glm_dflash.cu
+++ b/zig/kernels/cuda/glm_dflash.cu
@@ -261,11 +261,16 @@ extern "C" __global__ void df_add(__nv_bfloat16* __restrict__ x, const __nv_bflo
 }
 
 // out = bf16(g rank 0 + g rank 1): both ranks' gathered fp32 partials [2][R][D] of a split linear.
-extern "C" __global__ void df_sum2(const float* __restrict__ g, __nv_bfloat16* __restrict__ out, int R) {
+// The split down's fp32 partials g[world][R][D] summed in rank order into bf16 out[R][D]: rank 0's, plus rank 1's,
+// plus ... (at world 2 the one add df_sum2 did), so every rank holds the same sum and a world's choice moves no bit
+// that a two-rank sum would not.
+extern "C" __global__ void df_sumn(const float* __restrict__ g, __nv_bfloat16* __restrict__ out, int R, int world) {
     const long long r = blockIdx.x;
     for (int c = blockIdx.y * 1024 + threadIdx.x; c < (blockIdx.y + 1) * 1024; c += blockDim.x) {
         const long long i = r * D + c;
-        out[i] = tobf(g[i] + g[(long long)R * D + i]);
+        float s = g[i];
+        for (int k = 1; k < world; ++k) s += g[(long long)k * R * D + i];
+        out[i] = tobf(s);
     }
 }
 
