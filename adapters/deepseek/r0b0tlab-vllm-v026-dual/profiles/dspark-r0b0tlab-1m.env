# Native regular C1 one-million-context capacity qualification profile.
# Max-context NIAH target: depths at 25/50/90% of physical usable context under max_model_len=1M.
# KV is auto-profiled (not production 16GiB pin) to maximize token capacity.
DSPARK_RUNTIME_LANE=native-v026
DSPARK_QUALIFICATION_MODE=long-1m
DSPARK_VLLM_IMAGE=dspark-r0b0tlab:production-v026-b12x-native-v11
EXPECTED_INTEGRATED_VLLM_COMMIT=fbad93432ebf60c8345397b3032fe03bf5d239cc
EXPECTED_MODEL_REVISION=9e165c30e2704aec5d9d593cce3eebd58bbef1cb
EXPECTED_VLLM_VERSION=0.26.0+dspark.sm121.3
EXPECTED_IMAGE_SOURCE_REVISION=cc6b2be9baa75d227f4f54d45bbbc98fb5b64094
EXPECTED_RUNTIME_AUDIT_MANIFEST_SHA256=f6777b31e8c8977361d629ca99c37a199d3b52b9abc134f1de624eb202f083a9
RUNTIME_AUDIT_MANIFEST=${RUNTIME_AUDIT_MANIFEST:-${DSPARK_REPO_ROOT:-.}/recipe/runtime-manifest.vllm-sm121.3.json}
DSPARK_RUNTIME_AUDIT_MANIFEST=${DSPARK_RUNTIME_AUDIT_MANIFEST:-$RUNTIME_AUDIT_MANIFEST}
KV_CACHE_DTYPE=nvfp4_ds_mla
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=1
# Prefill batch: 8192 required so auto-KV still holds full 1M on dual-GB10.
# (16384→~642k tokens; 32768 fails start needing 31GiB KV with only ~16GiB free)
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.88
KV_CACHE_MEMORY_BYTES=auto
MTP_NUM_TOKENS=6
MOE_BACKEND=flashinfer_b12x
OPTIMIZATION_LEVEL=2
PERFORMANCE_MODE=balanced
ENABLE_FLASHINFER_AUTOTUNE=1
JIT_MONITOR_MODE=error
ENFORCE_EAGER=0
CUDAGRAPH_IMPLEMENTATION=regular
CUDAGRAPH_STRICT=1
FLASHINFER_CACHE=${HOME}/.cache/dspark-v026-flashinfer-topk256
VLLM_USE_FLASHINFER_SAMPLER=1
VLLM_USE_AOT_COMPILE=0
VLLM_DISABLE_COMPILE_CACHE=1
VLLM_DSV4_ENABLE_MULTI_STREAM=0
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
NCCL_RAS_ENABLE=1
