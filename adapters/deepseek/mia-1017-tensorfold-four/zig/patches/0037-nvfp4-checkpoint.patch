+// |v| to the nearest E2M1 magnitude code (ties to the even code), saturating at 6, with v's sign (nvfp4q.cuh).
+__device__ __forceinline__ uint32_t nv_e2m1(float v) {
+    const float a = fabsf(v);
+    uint32_t c;
+    if (a <= 0.25f) c = 0;
+    else if (a < 0.75f) c = 1;
+    else if (a <= 1.25f) c = 2;
+    else if (a < 1.75f) c = 3;
+    else if (a <= 2.5f) c = 4;
+    else if (a < 3.5f) c = 5;
+    else if (a <= 5.0f) c = 6;
+    else c = 7;
+    return (v < 0.0f && c != 0) ? (c | 8u) : c;
