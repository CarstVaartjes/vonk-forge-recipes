         /* Route small verifier batches to the decode-shaped q8 microbatch
          * kernel.  Env-based so the GPU backends need no new API surface;
@@ -26189,6 +26464,7 @@ void ds4_engine_close(ds4_engine *e) {
     vocab_free(&e->vocab);
     ds4_threads_shutdown();
