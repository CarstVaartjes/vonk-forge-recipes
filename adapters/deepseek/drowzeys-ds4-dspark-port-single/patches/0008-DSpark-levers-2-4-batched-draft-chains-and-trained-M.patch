+/* DSpark trained Markov drafter.
+ *
+ * DSpark's speculators ship a learned Markov head; the MTP GGUF does not.
+ * This is the small offline replacement: fit a confident-trigram table
+ * (context pair -> next token, kept only when the continuation is frequent
+ * and near-deterministic) on target-generated or domain text, and let the
+ * drafter chain from it when the local suffix-ngram has no match.  The file
+ * is a sorted key array plus a next-token array for binary search. */
+#define DS4_MARKOV_MAGIC "DS4MKV1"
+#define DS4_MARKOV_KEY(p2, p1) (((uint64_t)(uint32_t)(p2) << 21) | (uint32_t)(p1))
+
+typedef struct {
+    uint64_t key;
+    uint32_t next;
+} ds4_markov_pair;
+
+static int markov_pair_cmp(const void *a, const void *b) {
+    const ds4_markov_pair *pa = (const ds4_markov_pair *)a;
+    const ds4_markov_pair *pb = (const ds4_markov_pair *)b;
+    if (pa->key != pb->key) return pa->key < pb->key ? -1 : 1;
+    if (pa->next != pb->next) return pa->next < pb->next ? -1 : 1;
+    return 0;
+}
+
+int ds4_dspark_markov_fit(const char *model_path, const char *text,
+                          const char *out_path, int min_count) {
+    ds4_model model;
+    ds4_vocab vocab;
+    token_vec tokens = {0};
+    if (min_count < 2) min_count = 4;
+
+    model_open(&model, model_path, false, false);
+    vocab_load(&vocab, &model);
+    tokenize_rendered_chat_vocab(&vocab, text ? text : "", &tokens);
+    fprintf(stderr, "ds4: markov fit: %d corpus tokens\n", tokens.len);
+    if (tokens.len < 3) {
+        vocab_free(&vocab);
+        model_close(&model);
+        return 1;
+    }
+
+    const int n_tri = tokens.len - 2;
+    ds4_markov_pair *tri = xmalloc((size_t)n_tri * sizeof(tri[0]));
+    for (int i = 0; i + 2 < tokens.len; i++) {
+        tri[i].key = DS4_MARKOV_KEY(tokens.v[i], tokens.v[i + 1]);
+        tri[i].next = (uint32_t)tokens.v[i + 2];
+    }
+    qsort(tri, (size_t)n_tri, sizeof(tri[0]), markov_pair_cmp);
+
+    uint64_t *keys = xmalloc((size_t)n_tri * sizeof(keys[0]));
+    uint32_t *next = xmalloc((size_t)n_tri * sizeof(next[0]));
+    uint32_t n_out = 0;
+    int i = 0;
+    while (i < n_tri) {
+        int j = i;
+        while (j < n_tri && tri[j].key == tri[i].key) j++;
+        const int total = j - i;
+        if (total >= min_count) {
+            /* runs are sorted by next inside the key run */
+            int best_n = 0;
+            uint32_t best = 0;
+            int k = i;
+            while (k < j) {
+                int m = k;
+                while (m < j && tri[m].next == tri[k].next) m++;
+                if (m - k > best_n) {
+                    best_n = m - k;
+                    best = tri[k].next;
+                }
+                k = m;
+            }
+            if (3 * best_n >= 2 * total) {
+                keys[n_out] = tri[i].key;
+                next[n_out] = best;
+                n_out++;
+            }
+        }
+        i = j;
+    }
+    free(tri);
+
+    FILE *fp = fopen(out_path, "wb");
+    int rc = 1;
+    if (fp) {
+        char magic[8] = DS4_MARKOV_MAGIC;
+        uint32_t hdr[2] = {n_out, 0};
+        if (fwrite(magic, 1, 8, fp) == 8 &&
+            fwrite(hdr, sizeof(uint32_t), 2, fp) == 2 &&
+            fwrite(keys, sizeof(keys[0]), n_out, fp) == n_out &&
+            fwrite(next, sizeof(next[0]), n_out, fp) == n_out) {
+            rc = 0;
+        }
+        fclose(fp);
+    }
+    fprintf(stderr, "ds4: markov fit: kept %u confident trigrams -> %s\n",
+            n_out, out_path);
+    free(keys);
+    free(next);
+    token_vec_free(&tokens);
+    vocab_free(&vocab);
+    model_close(&model);
+    return rc;
+}
