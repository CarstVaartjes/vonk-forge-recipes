+    if (e->dspark_markov_map) munmap(e->dspark_markov_map, e->dspark_markov_map_len);
     model_close(&e->model);
 #ifndef DS4_NO_GPU
     ds4_gpu_cleanup();
@@ -27372,6 +27648,46 @@ static int dspark_ngram_propose(const int *hist, int hlen,
 #undef DS4_DSPARK_SEQ
     return n;
 }
+
+/* Confident-trigram lookup in the trained Markov table (see
+ * ds4_dspark_markov_fit).  Returns the next token or -1. */
+static int dspark_markov_next_token(const ds4_engine *e, int prev2, int prev1) {
+    if (!e->dspark_markov_n || prev2 < 0 || prev1 < 0) return -1;
+    const uint64_t key = DS4_MARKOV_KEY(prev2, prev1);
+    uint32_t lo = 0, hi = e->dspark_markov_n;
+    while (lo < hi) {
+        const uint32_t mid = lo + (hi - lo) / 2u;
+        if (e->dspark_markov_keys[mid] < key) lo = mid + 1u;
+        else hi = mid;
+    }
+    if (lo < e->dspark_markov_n && e->dspark_markov_keys[lo] == key) {
+        return (int)e->dspark_markov_next[lo];
+    }
+    return -1;
+}
+
+/* Chain confident-trigram continuations after hist ++ tail ++ out, up to
+ * max_out tokens.  The verifier prices every proposed row, so the table only
+ * holds near-deterministic continuations by construction. */
+static int dspark_markov_propose(const ds4_engine *e, const int *hist, int hlen,
+                                 const int *tail, int tail_n,
+                                 int max_out, int *out) {
+    if (!e->dspark_markov_n || max_out <= 0) return 0;
+#define DS4_DSPARK_SEQ2(i) ((i) < hlen ? hist[i] : \
+        ((i) - hlen < tail_n ? tail[(i) - hlen] : out[(i) - hlen - tail_n]))
+    const int base = hlen + tail_n;
+    if (base < 2) return 0;
+    int n = 0;
+    while (n < max_out) {
+        const int prev2 = DS4_DSPARK_SEQ2(base + n - 2);
+        const int prev1 = DS4_DSPARK_SEQ2(base + n - 1);
+        const int t = dspark_markov_next_token(e, prev2, prev1);
+        if (t < 0) break;
+        out[n++] = t;
+    }
+#undef DS4_DSPARK_SEQ2
+    return n;
+}
 #endif
 
 #ifndef DS4_NO_GPU
@@ -27528,7 +27844,68 @@ static int ds4_session_eval_speculative_argmax_once(
         s->graph.mtp_n_raw = keep_; \
     } while (0)
 
-    for (; !redraft && draft_n < draft_cap; draft_n++) {
+    /* Batched draft chain: encode every remaining MTP step into one command
+     * submission, feeding each step's token from the previous step's device-
+     * side top id, and read ids + margins back once.  Removes the per-step
+     * synchronize/readback the sequential loop pays (~1-2 ms per step). */
+    bool chain_done = false;
+    if (!redraft && e->dspark_draft_batch && e->backend == DS4_BACKEND_CUDA &&
+        e->dspark_early_margin > 0.0f &&
+        draft_n < draft_cap && s->graph.dspark_chain_ids)
+    {
+        const uint32_t base_raw_chain = s->graph.mtp_n_raw;
+        const int first = draft_n;
+        int planned = 0;
+        bool ok_chain = ds4_gpu_begin_commands() != 0;
+        for (int j = first; ok_chain && j < draft_cap; j++) {
+            ds4_gpu_tensor *prev_hc = (j & 1) ? s->graph.mtp_state_hc : s->graph.mtp_next_hc;
+            ds4_gpu_tensor *out_hc = (j & 1) ? s->graph.mtp_next_hc : s->graph.mtp_state_hc;
+            ok_chain = metal_graph_eval_mtp_draft_step_dev(&s->graph,
+                                                           &e->model,
+                                                           &e->weights,
+                                                           &e->mtp_model,
+                                                           &e->mtp_weights,
+                                                           prev_hc,
+                                                           out_hc,
+                                                           j == first ? drafts[j - 1] : -1,
+                                                           (uint32_t)(j - 1),
+                                                           (uint32_t)j,
+                                                           (uint32_t)(s->checkpoint.len + j - 1));
+            if (ok_chain) planned = j - first + 1;
+        }
+        if (ok_chain) ok_chain = ds4_gpu_end_commands() != 0;
+        else (void)ds4_gpu_synchronize();
+        int32_t chain_ids[16];
+        float chain_margins[16];
+        if (ok_chain && planned > 0) {
+            ok_chain = ds4_gpu_tensor_read(s->graph.dspark_chain_ids,
+                                             (uint64_t)first * sizeof(int32_t),
+                                             chain_ids + first,
+                                             (uint64_t)planned * sizeof(int32_t)) != 0 &&
+                       ds4_gpu_tensor_read(s->graph.dspark_chain_margins,
+                                             (uint64_t)first * sizeof(float),
+                                             chain_margins + first,
+                                             (uint64_t)planned * sizeof(float)) != 0;
+        }
+        chain_done = true;
+        if (!ok_chain) {
+            /* Chain encode failed: the ping-pong hc state is unusable, so give
+             * up on extending this cycle rather than falling to the loop. */
+            s->graph.mtp_n_raw = base_raw_chain;
+        } else {
+            for (int j = first; j < first + planned; j++) {
+                if (e->dspark_early_margin > 0.0f &&
+                    chain_margins[j] < e->dspark_early_margin) break;
+                drafts[j] = chain_ids[j];
+                if (mtp_need_logits && j + 1 == first + planned) {
+                    mtp_last_margin = chain_margins[j];
+                }
+                draft_n = j + 1;
+                if (drafts[j] == eos_token) break;
+            }
+        }
