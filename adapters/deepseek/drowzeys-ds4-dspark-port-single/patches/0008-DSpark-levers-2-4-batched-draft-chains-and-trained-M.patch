+__global__ static void logits_top2_margin_kernel(
+        int32_t *out_id,
+        float *out_margin,
+        const float *logits,
+        uint32_t n) {
+    __shared__ float s_v0[256];
+    __shared__ float s_v1[256];
+    __shared__ int32_t s_i0[256];
+    float v0 = -3.4e38f, v1 = -3.4e38f;
+    int32_t i0 = -1;
+    for (uint32_t i = threadIdx.x; i < n; i += blockDim.x) {
+        const float v = logits[i];
+        if (v > v0) {
+            v1 = v0;
+            v0 = v;
+            i0 = (int32_t)i;
+        } else if (v > v1) {
+            v1 = v;
+        }
+    }
+    s_v0[threadIdx.x] = v0;
+    s_v1[threadIdx.x] = v1;
+    s_i0[threadIdx.x] = i0;
+    __syncthreads();
+    for (uint32_t stride = blockDim.x >> 1u; stride > 0; stride >>= 1u) {
+        if (threadIdx.x < stride) {
+            const float ov0 = s_v0[threadIdx.x + stride];
+            const float ov1 = s_v1[threadIdx.x + stride];
+            if (ov0 > s_v0[threadIdx.x]) {
+                s_v1[threadIdx.x] = s_v0[threadIdx.x] > ov1 ? s_v0[threadIdx.x] : ov1;
+                s_v0[threadIdx.x] = ov0;
+                s_i0[threadIdx.x] = s_i0[threadIdx.x + stride];
+            } else if (ov0 > s_v1[threadIdx.x]) {
+                s_v1[threadIdx.x] = ov0;
+            }
+        }
+        __syncthreads();
+    }
+    if (threadIdx.x == 0) {
+        out_id[0] = s_i0[0];
+        out_margin[0] = s_v0[0] - s_v1[0];
+    }
+}
+
+extern "C" int ds4_gpu_logits_top2_margin_tensor(
+        ds4_gpu_tensor *out_id,
+        uint64_t        id_offset,
+        ds4_gpu_tensor *out_margin,
+        uint64_t        margin_offset,
+        const ds4_gpu_tensor *logits,
+        uint32_t        n) {
+    if (!out_id || !out_margin || !logits || n == 0 ||
+        out_id->bytes < id_offset + sizeof(int32_t) ||
+        out_margin->bytes < margin_offset + sizeof(float) ||
+        logits->bytes < (uint64_t)n * sizeof(float)) {
+        return 0;
+    }
+    logits_top2_margin_kernel<<<1, 256>>>(
+            (int32_t *)((char *)out_id->ptr + id_offset),
+            (float *)((char *)out_margin->ptr + margin_offset),
+            (const float *)logits->ptr,
+            n);
+    return cuda_ok(cudaGetLastError(), "logits top2 margin launch");
+}
