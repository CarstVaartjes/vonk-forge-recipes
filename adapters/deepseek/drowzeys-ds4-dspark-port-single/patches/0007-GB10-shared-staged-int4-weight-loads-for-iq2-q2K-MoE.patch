+/* Staged variant of the fused 6-expert decode down kernel; same int4
+ * shared-staging rationale as the gate/up kernel (q2_K blocks are 84 bytes,
+ * rows are 16-byte-aligned multiples). Bit-identical reduction order. */
+__global__ static void moe_down_sum6_staged_kernel(
+        float *out,
+        const char *down_base,
+        const cuda_block_q8_K *midq,
+        const int32_t *selected,
+        uint64_t down_expert_bytes,
+        uint64_t down_row_bytes,
+        uint32_t midq_blocks,
+        uint32_t out_dim) {
+    const uint32_t lane = threadIdx.x & 7u;
+    const uint32_t oct = threadIdx.x >> 3u;
+    const uint32_t row = blockIdx.x * 32u + oct;
+    __shared__ int4 srows[32][42];
+    if (down_row_bytes > sizeof(srows[0]) || (down_row_bytes & 15u) != 0) return;
+    if (row >= out_dim) return;
+    const uint32_t row_int4s = (uint32_t)(down_row_bytes >> 4u);
+    float total = 0.0f;
+    #pragma unroll
+    for (uint32_t slot = 0; slot < 6u; slot++) {
+        int32_t expert_i = selected[slot];
+        if (expert_i < 0) expert_i = 0;
+        const int4 *src = (const int4 *)(down_base +
+                (uint64_t)(uint32_t)expert_i * down_expert_bytes +
+                (uint64_t)row * down_row_bytes);
+        int4 *dst = srows[oct];
+        for (uint32_t w = lane; w < row_int4s; w += 8u) dst[w] = __ldcs(src + w);
+        __syncwarp();
