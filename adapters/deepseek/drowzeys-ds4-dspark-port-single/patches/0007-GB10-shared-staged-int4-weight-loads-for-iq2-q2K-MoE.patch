+/* Staged q8_0 GEMV.
+ *
+ * q8_0 blocks are 34 bytes, so the per-block scale+qs loads never vectorize
+ * (the qs pointer is 2-byte aligned) and the warp8 kernel is load-limited
+ * well under the DRAM ceiling on GB10.  Each warp stages a 64-block chunk of
+ * its weight row into shared memory with int4 streaming loads, then runs the
+ * exact dot from shared where byte addressing is free.  Per-lane block sets
+ * and accumulation order match the unstaged kernel.  Requires blocks % 8 == 0
+ * and a 16-byte-aligned weight base (enforced at dispatch). */
+#define DS4_CUDA_Q8_MBATCH_MAX 16
+#define DS4_Q8_STAGE_CHUNK 64u
+__global__ static void matmul_q8_0_preq_warp8_staged_kernel(
+        float *out,
+        const unsigned char *w,
+        const int8_t *xq,
+        const float *xscale,
+        uint64_t in_dim,
+        uint64_t out_dim,
+        uint64_t blocks,
+        int use_dp4a) {
+    const uint32_t warp = threadIdx.x >> 5u;
+    const uint32_t lane = threadIdx.x & 31u;
+    const uint64_t row = (uint64_t)blockIdx.x * 8u + warp;
+    __shared__ int4 srow[8][(DS4_Q8_STAGE_CHUNK * 34u) >> 4u];
+    if (row >= out_dim) return;
+    const unsigned char *wr = w + row * blocks * 34u;
+    float acc = 0.0f;
+    for (uint64_t c0 = 0; c0 < blocks; c0 += DS4_Q8_STAGE_CHUNK) {
+        const uint32_t nb = blocks - c0 < DS4_Q8_STAGE_CHUNK ?
+                (uint32_t)(blocks - c0) : DS4_Q8_STAGE_CHUNK;
+        const uint32_t n_int4 = (nb * 34u) >> 4u;
+        const int4 *src = (const int4 *)(wr + c0 * 34u);
+        for (uint32_t i = lane; i < n_int4; i += 32u) srow[warp][i] = __ldcs(src + i);
+        __syncwarp();
+        const unsigned char *sw = (const unsigned char *)srow[warp];
+        for (uint32_t b = lane; b < nb; b += 32u) {
+            const uint64_t gb = c0 + b;
+            const uint64_t i0 = gb * 32u;
+            const uint64_t bn = in_dim - i0 < 32 ? in_dim - i0 : 32;
+            const __half *scale_h = (const __half *)(sw + b * 34u);
+            const int8_t *qs = (const int8_t *)(sw + b * 34u + 2u);
+            int dot = dot_i8_block(qs, xq + gb * 32u, bn, use_dp4a);
+            acc += __half2float(*scale_h) * xscale[gb] * (float)dot;
+        }
+        __syncwarp();
+    }
+    acc = warp_sum_f32(acc);
+    if (lane == 0) out[row] = acc;
+}
+
+/* Staged multi-token variant for speculative verifier microbatches. */
+__global__ static void matmul_q8_0_preq_mrow_warp8_staged_kernel(
+        float *out,
+        const unsigned char *w,
+        const int8_t *xq,
+        const float *xscale,
+        uint64_t in_dim,
+        uint64_t out_dim,
+        uint64_t n_tok,
+        uint64_t blocks,
+        int use_dp4a) {
+    const uint32_t warp = threadIdx.x >> 5u;
+    const uint32_t lane = threadIdx.x & 31u;
+    const uint64_t row = (uint64_t)blockIdx.x * 8u + warp;
+    __shared__ int4 srow[8][(DS4_Q8_STAGE_CHUNK * 34u) >> 4u];
+    if (row >= out_dim) return;
+    const unsigned char *wr = w + row * blocks * 34u;
+    float acc[DS4_CUDA_Q8_MBATCH_MAX];
+    for (uint32_t t = 0; t < n_tok; t++) acc[t] = 0.0f;
+    for (uint64_t c0 = 0; c0 < blocks; c0 += DS4_Q8_STAGE_CHUNK) {
+        const uint32_t nb = blocks - c0 < DS4_Q8_STAGE_CHUNK ?
+                (uint32_t)(blocks - c0) : DS4_Q8_STAGE_CHUNK;
+        const uint32_t n_int4 = (nb * 34u) >> 4u;
+        const int4 *src = (const int4 *)(wr + c0 * 34u);
+        for (uint32_t i = lane; i < n_int4; i += 32u) srow[warp][i] = __ldcs(src + i);
+        __syncwarp();
+        const unsigned char *sw = (const unsigned char *)srow[warp];
+        for (uint32_t b = lane; b < nb; b += 32u) {
+            const uint64_t gb = c0 + b;
+            const uint64_t i0 = gb * 32u;
+            const uint64_t bn = in_dim - i0 < 32 ? in_dim - i0 : 32;
+            const float ws = __half2float(*(const __half *)(sw + b * 34u));
+            const int8_t *qs = (const int8_t *)(sw + b * 34u + 2u);
+            for (uint32_t t = 0; t < n_tok; t++) {
+                int dot = dot_i8_block(qs, xq + t * blocks * 32u + gb * 32u, bn, use_dp4a);
+                acc[t] += ws * xscale[t * blocks + gb] * (float)dot;
+            }
+        }
+        __syncwarp();
+    }
+    for (uint32_t t = 0; t < n_tok; t++) {
+        const float v = warp_sum_f32(acc[t]);
+        if (lane == 0) out[t * out_dim + row] = v;
+    }
+}
+
+/* Staged fused pair variant (two weight matrices, one activation row). */
+__global__ static void matmul_q8_0_pair_preq_warp8_staged_kernel(
+        float *out0,
+        float *out1,
+        const unsigned char *w0,
+        const unsigned char *w1,
+        const int8_t *xq,
+        const float *xscale,
+        uint64_t in_dim,
+        uint64_t out0_dim,
+        uint64_t out1_dim,
+        uint64_t blocks,
+        int use_dp4a) {
+    const uint32_t warp = threadIdx.x >> 5u;
+    const uint32_t lane = threadIdx.x & 31u;
+    const uint64_t row = (uint64_t)blockIdx.x * 8u + warp;
+    __shared__ int4 srow[2][8][(DS4_Q8_STAGE_CHUNK * 34u) >> 4u];
+    if (row >= out0_dim && row >= out1_dim) return;
+    const unsigned char *wr0 = row < out0_dim ? w0 + row * blocks * 34u : NULL;
+    const unsigned char *wr1 = row < out1_dim ? w1 + row * blocks * 34u : NULL;
+    float acc0 = 0.0f;
+    float acc1 = 0.0f;
+    for (uint64_t c0 = 0; c0 < blocks; c0 += DS4_Q8_STAGE_CHUNK) {
+        const uint32_t nb = blocks - c0 < DS4_Q8_STAGE_CHUNK ?
+                (uint32_t)(blocks - c0) : DS4_Q8_STAGE_CHUNK;
+        const uint32_t n_int4 = (nb * 34u) >> 4u;
+        if (wr0) {
+            const int4 *src = (const int4 *)(wr0 + c0 * 34u);
+            for (uint32_t i = lane; i < n_int4; i += 32u) srow[0][warp][i] = __ldcs(src + i);
+        }
+        if (wr1) {
+            const int4 *src = (const int4 *)(wr1 + c0 * 34u);
+            for (uint32_t i = lane; i < n_int4; i += 32u) srow[1][warp][i] = __ldcs(src + i);
+        }
+        __syncwarp();
+        const unsigned char *sw0 = (const unsigned char *)srow[0][warp];
+        const unsigned char *sw1 = (const unsigned char *)srow[1][warp];
+        for (uint32_t b = lane; b < nb; b += 32u) {
+            const uint64_t gb = c0 + b;
+            const uint64_t i0 = gb * 32u;
+            const uint64_t bn = in_dim - i0 < 32 ? in_dim - i0 : 32;
+            const int8_t *xqb = xq + gb * 32u;
+            const float xs = xscale[gb];
+            if (wr0) {
+                const __half *scale_h = (const __half *)(sw0 + b * 34u);
+                const int8_t *qs = (const int8_t *)(sw0 + b * 34u + 2u);
+                int dot = dot_i8_block(qs, xqb, bn, use_dp4a);
+                acc0 += __half2float(*scale_h) * xs * (float)dot;
+            }
+            if (wr1) {
+                const __half *scale_h = (const __half *)(sw1 + b * 34u);
+                const int8_t *qs = (const int8_t *)(sw1 + b * 34u + 2u);
+                int dot = dot_i8_block(qs, xqb, bn, use_dp4a);
+                acc1 += __half2float(*scale_h) * xs * (float)dot;
+            }
+        }
+        __syncwarp();
+    }
+    acc0 = warp_sum_f32(acc0);
+    acc1 = warp_sum_f32(acc1);
+    if (lane == 0) {
+        if (row < out0_dim) out0[row] = acc0;
+        if (row < out1_dim) out1[row] = acc1;
+    }
+}
