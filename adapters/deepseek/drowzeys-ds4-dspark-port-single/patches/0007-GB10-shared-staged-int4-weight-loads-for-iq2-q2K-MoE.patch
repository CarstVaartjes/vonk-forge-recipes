+/* Staged variant of the decode gate/up kernel.
+ *
+ * The iq2_xxs block is 66 bytes, so per-block scalar loads never vectorize
+ * and the kernel sustains ~110 GB/s on GB10 where the same access pattern
+ * with int4 loads reaches ~170.  Each 8-lane oct stages one whole weight row
+ * (a 16-byte-aligned multiple) into its own shared slot with __ldcs int4
+ * loads, then decodes from shared where byte addressing is free.  Even octs
+ * take the gate row, odd octs the up row; reduction order per row matches
+ * the unstaged kernel, so results are bit-identical. */
+__global__ static void moe_gate_up_mid_decode_lut_staged_kernel(
+        float *gate_out,
+        float *up_out,
+        float *mid_out,
+        const char *gate_base,
+        const char *up_base,
+        const cuda_block_q8_K *xq,
+        const int32_t *selected,
+        const float *weights,
+        uint64_t gate_expert_bytes,
+        uint64_t gate_row_bytes,
+        uint32_t xq_blocks,
+        uint32_t expert_mid_dim,
+        uint32_t n_expert,
+        uint32_t write_aux,
+        float clamp) {
+    const uint32_t lane = threadIdx.x & 7u;
+    const uint32_t oct = threadIdx.x >> 3u;
+    const uint32_t row_slot = oct >> 1u;
+    const int is_up = oct & 1u;
+    const uint32_t pair = blockIdx.y;
+    const uint32_t tok = pair / n_expert;
+    const uint32_t slot = pair - tok * n_expert;
+    int32_t expert_i = selected[(uint64_t)tok * n_expert + slot];
+    if (expert_i < 0) expert_i = 0;
+    const uint32_t expert = (uint32_t)expert_i;
+    const cuda_block_q8_K *xqb = xq + (uint64_t)tok * xq_blocks;
+
+    __shared__ cuda_block_q8_K sxq[16];
+    __shared__ uint64_t s_iq2_grid[256];
+    __shared__ uint8_t s_iq2_signs[128];
+    __shared__ int4 srows[32][66];
+    if (xq_blocks > 16u || gate_row_bytes > sizeof(srows[0]) ||
+        (gate_row_bytes & 15u) != 0) {
+        return; /* dispatch guarantees this never triggers */
+    }
+    for (uint32_t i = threadIdx.x; i < xq_blocks; i += blockDim.x) sxq[i] = xqb[i];
+    for (uint32_t i = threadIdx.x; i < 256u; i += blockDim.x) s_iq2_grid[i] = cuda_iq2xxs_grid[i];
+    for (uint32_t i = threadIdx.x; i < 128u; i += blockDim.x) s_iq2_signs[i] = cuda_ksigns_iq2xs[i];
+    __syncthreads();
+    xqb = sxq;
+
+    const uint32_t row_int4s = (uint32_t)(gate_row_bytes >> 4u);
+    for (uint32_t rr = 0; rr < 4u; rr++) {
+        const uint32_t row = blockIdx.x * 64u + row_slot + rr * 16u;
+        if (row >= expert_mid_dim) continue;
+        const char *base = is_up ? up_base : gate_base;
+        const int4 *src = (const int4 *)(base + (uint64_t)expert * gate_expert_bytes +
+                                         (uint64_t)row * gate_row_bytes);
+        int4 *dst = srows[oct];
+        for (uint32_t w = lane; w < row_int4s; w += 8u) dst[w] = __ldcs(src + w);
+        __syncwarp();
+        const cuda_block_iq2_xxs *r = (const cuda_block_iq2_xxs *)dst;
+        float acc = 0.0f;
+        for (uint32_t b = lane; b < xq_blocks; b += 8u) {
+            acc += dev_dot_iq2_xxs_q8_K_block_lut(r + b, xqb + b, s_iq2_grid, s_iq2_signs);
+        }
+        acc = quarter_warp_sum_f32(acc, lane);
+        const float other = __shfl_sync(0xffffffffu, acc, (threadIdx.x + 8u) & 31u, 32);
+        if (lane == 0 && !is_up) {
+            float gate = acc;
+            float up = other;
+            if (clamp > 1.0e-6f) {
+                if (gate > clamp) gate = clamp;
+                if (up > clamp) up = clamp;
+                if (up < -clamp) up = -clamp;
+            }
+            const uint64_t off = (uint64_t)pair * expert_mid_dim + row;
+            if (write_aux) {
+                gate_out[off] = gate;
+                up_out[off] = up;
+            }
+            mid_out[off] = (gate / (1.0f + expf(-gate))) * up * weights[(uint64_t)tok * n_expert + slot];
+        }
+        __syncwarp();
+    }
+}
