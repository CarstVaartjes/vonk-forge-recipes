+#ifndef DS4_NO_GPU
+/* DSpark-style context drafter.
+ *
+ * DeepSeek's DSpark speculators ship a learned Markov head inside the draft
+ * checkpoint that biases drafting toward continuations already present in the
+ * context.  The MTP support GGUF has no such tensors, so we replicate the role
+ * at runtime with suffix-ngram lookup: find the longest (then most recent)
+ * earlier occurrence of the current token suffix and propose the tokens that
+ * followed it.  Proposals go through the normal target verifier, so a bad
+ * match costs wasted verifier rows, never correctness.
+ *
+ * The virtual sequence searched is hist[0..hlen) ++ tail[0..tail_n): committed
+ * tokens plus the not-yet-committed draft chain being extended.  Returns the
+ * number of continuation tokens written to out (at most max_out). */
+#define DS4_DSPARK_NGRAM_MAX_MATCH 8
+static int dspark_ngram_propose(const int *hist, int hlen,
+                                const int *tail, int tail_n,
+                                int min_match, int max_out, int *out) {
+    const int total = hlen + tail_n;
+    if (min_match < 1) min_match = 1;
+    if (total < min_match + 1 || max_out <= 0) return 0;
+#define DS4_DSPARK_SEQ(i) ((i) < hlen ? hist[i] : tail[(i) - hlen])
+    int best_pos = -1;
+    int best_len = 0;
+    for (int p = total - 2; p >= min_match - 1; p--) {
+        if (DS4_DSPARK_SEQ(p) != DS4_DSPARK_SEQ(total - 1)) continue;
+        int l = 1;
+        while (l < DS4_DSPARK_NGRAM_MAX_MATCH &&
+               p - l >= 0 &&
+               DS4_DSPARK_SEQ(p - l) == DS4_DSPARK_SEQ(total - 1 - l)) l++;
+        if (l > best_len) {
+            best_len = l;
+            best_pos = p;
+            if (l >= DS4_DSPARK_NGRAM_MAX_MATCH) break;
+        }
+    }
+    if (best_len < min_match) return 0;
+    int n = 0;
+    for (int i = best_pos + 1; i < total && n < max_out; i++) {
+        out[n++] = DS4_DSPARK_SEQ(i);
+        if (out[n - 1] < 0) return 0;
+    }
+#undef DS4_DSPARK_SEQ
+    return n;
+}
+#endif
