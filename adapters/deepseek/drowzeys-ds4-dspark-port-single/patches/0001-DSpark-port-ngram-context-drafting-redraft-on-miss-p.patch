+                            &mtp_last_top1, &v1);
+                mtp_last_margin = v0 - v1;
+            }
+            margin_low = mtp_last_margin < mtp_margin_threshold;
+        }
+        int try_n = margin_low ? 1 : draft_n;
+        if (drafts[try_n - 1] != eos_token) {
+            int ext_cap = try_n + e->dspark_ngram_tokens;
+            if (ext_cap > max_tokens - n_accept) ext_cap = max_tokens - n_accept;
+            if (ext_cap > accepted_cap - n_accept) ext_cap = accepted_cap - n_accept;
+            if (ext_cap > room - 1) ext_cap = room - 1;
+            if (ext_cap > 16) ext_cap = 16;
+            if (ext_cap > try_n) {
+                dspark_ngram_n = dspark_ngram_propose(s->checkpoint.v,
+                                                      s->checkpoint.len,
+                                                      drafts, try_n,
+                                                      e->dspark_ngram_min,
+                                                      ext_cap - try_n,
+                                                      drafts + try_n);
+                for (int i = 0; i < dspark_ngram_n; i++) {
+                    if (drafts[try_n + i] == eos_token) {
+                        dspark_ngram_n = i + 1;
+                        break;
+                    }
+                }
+            }
+        }
+        if (dspark_ngram_n > 0) draft_n = try_n + dspark_ngram_n;
+        if (redraft && dspark_ngram_n == 0) {
+            /* MTP missed and the context has no match: nothing is worth a
+             * verifier pass, keep the plain one-token cycle. */
+            return n_accept;
+        }
+        if (getenv("DS4_MTP_SPEC_LOG") && dspark_ngram_n > 0) {
+            fprintf(stderr,
+                    "ds4: dspark ngram extend mtp=%d ngram=%d redraft=%d margin_low=%d\n",
+                    try_n, dspark_ngram_n, redraft, margin_low);
+        }
+    }
+
+    /* Ngram/redraft-committed positions have no MTP raw rows.  The stock
+     * full-accept path already tolerates a one-row hole; longer stale runs
+     * make the drafter attend mostly garbage, so restart its ring instead
+     * and let normal decode probes refill it. */
