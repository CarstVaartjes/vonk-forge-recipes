+        if ((dspark_ngram_n > 0 || redraft) && \
+            (n_) - (dspark_mtp_rows - 1) > 2) { \
+            s->graph.mtp_n_raw = 0; \
+        } else { \
+            DS4_MTP_KEEP_ACCEPTED(n_); \
+        } \
+    } while (0)
