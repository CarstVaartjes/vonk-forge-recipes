@@ -11570,6 +11570,8 @@ static server_config parse_options(int argc, char **argv) {
             c.engine.dspark_rounds = parse_int_arg(need_arg(&i, argc, argv, arg), arg);
         } else if (!strcmp(arg, "--dspark-row-commit")) {
