             opt(fp, c, "--dspark-early-margin F", "Per-position MTP draft confidence stop; replaces the single --mtp-margin gate. Default: 0 (off)");
             opt(fp, c, "--dspark-rounds N", "Maximum chained speculative verify rounds per decode step. Default: 1");
             opt(fp, c, "--dspark-row-commit", "Commit partial speculative accepts from per-row frontier captures instead of replaying.");
+            opt(fp, c, "--dspark-adapt", "Pause speculation when measured acceptance stops paying for the draft/verify overhead.");
         }
         opt(fp, c, "--quality", "Prefer exact kernels where faster approximate paths exist.");
         opt(fp, c, "--warm-weights", "Touch mapped tensor pages at startup to reduce first-use stalls.");
