From c50699e02ac1d5a8a0f222cabbc8d7e9f68eb88e Mon Sep 17 00:00:00 2001
From: keyspark <kevin.on.the.rocks@gmail.com>
Date: Wed, 8 Jul 2026 08:57:39 -0400
Subject: [PATCH 5/8] DSpark port: adaptive speculation backoff
 (--dspark-adapt)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Analog of DSpark's hardware-aware confidence scheduler for a single stream:
track an EMA of extra tokens committed per speculative cycle and pause
drafting when it falls under roughly one token per cycle — on GB10 the probe
plus batch-verifier taxes are ~2 decode-equivalents, so low-acceptance text
(typical prose at temp 0) otherwise pays more than speculation returns.
While backed off, cycles run the plain decode path at full speed; drafting
re-tests every 24 cycles.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 ds4.c        | 31 ++++++++++++++++++++++++++++++-
 ds4.h        |  1 +
 ds4_cli.c    |  2 ++
 ds4_help.c   |  1 +
 ds4_server.c |  2 ++
 5 files changed, 36 insertions(+), 1 deletion(-)

diff --git a/ds4.c b/ds4.c
index 335a481..45f0c6a 100644
--- a/ds4.c
+++ b/ds4.c
@@ -21893,6 +21893,7 @@ struct ds4_engine {
     float dspark_early_margin;
     int dspark_rounds;
     bool dspark_row_commit;
+    bool dspark_adapt;
     char *directional_steering_file;
     float *directional_steering_dirs;
     float directional_steering_attn_scale;
@@ -23362,6 +23363,12 @@ struct ds4_session {
     bool dspark_seed_valid;
     int dspark_seed_token;
     int dspark_seed_pos;
+    /* Adaptive speculation backoff: EMA of extra tokens committed per
+     * speculative cycle.  When the text is not accepting drafts the probe and
+     * verifier taxes make MTP a strict loss, so drafting pauses and re-tests
+     * periodically. */
+    float dspark_accept_ema;
+    int dspark_backoff;
 };
 
 /* =========================================================================
@@ -25689,6 +25696,7 @@ int ds4_engine_open(ds4_engine **out, const ds4_engine_options *opt) {
     e->dspark_rounds = opt->dspark_rounds > 1 ? opt->dspark_rounds : 1;
     if (e->dspark_rounds > 32) e->dspark_rounds = 32;
     e->dspark_row_commit = opt->dspark_row_commit;
+    e->dspark_adapt = opt->dspark_adapt;
     if ((opt->directional_steering_attn != 0.0f || opt->directional_steering_ffn != 0.0f) &&
         (!opt->directional_steering_file || !opt->directional_steering_file[0]))
     {
@@ -26222,6 +26230,7 @@ int ds4_session_create(ds4_session **out, ds4_engine *e, int ctx_size) {
     if (e->mtp_ready) {
         s->mtp_logits = xmalloc((size_t)DS4_N_VOCAB * sizeof(s->mtp_logits[0]));
         s->mtp_draft_token = -1;
+        s->dspark_accept_ema = 1.0f; /* start optimistic; adapt down */
     }
     if (e->distributed.role == DS4_DISTRIBUTED_COORDINATOR) {
         char err[256];
@@ -27237,7 +27246,8 @@ static int ds4_session_eval_internal(ds4_session *s, int token, bool probe_mtp,
     const bool mtp_probe_log = getenv("DS4_MTP_PROBE") != NULL;
     const bool mtp_should_draft =
         probe_mtp && e->mtp_ready && s->mtp_logits &&
-        (e->mtp_draft_tokens > 1 || mtp_probe_log);
+        (e->mtp_draft_tokens > 1 || mtp_probe_log) &&
+        (!e->dspark_adapt || s->dspark_backoff == 0);
     if (probe_mtp && s->mtp_draft_valid) {
         if (mtp_probe_log) {
             s->mtp_probe_total++;
@@ -28393,6 +28403,25 @@ int ds4_session_eval_speculative_argmax(ds4_session *s, int first_token,
         n += r;
     }
 #endif
+    if (n > 0 && s->engine && s->engine->dspark_adapt) {
+        /* Adaptive backoff: on text that rejects drafts, the MTP probe and
+         * verifier passes are pure overhead.  Track extra tokens per cycle
+         * and pause drafting when the average falls under the taxes, waking
+         * periodically to re-test. */
+        if (s->dspark_backoff > 0) {
+            s->dspark_backoff--;
+        } else {
+            float gain = (float)(n - 1);
+            if (gain > 4.0f) gain = 4.0f;
+            s->dspark_accept_ema = 0.85f * s->dspark_accept_ema + 0.15f * gain;
+            /* Break-even is roughly one extra token per cycle: below that the
+             * probe plus verifier passes cost more than the tokens they add. */
+            if (s->dspark_accept_ema < 1.0f) {
+                s->dspark_backoff = 24;
+                s->dspark_accept_ema = 1.05f;
+            }
+        }
+    }
     return n;
 }
 
