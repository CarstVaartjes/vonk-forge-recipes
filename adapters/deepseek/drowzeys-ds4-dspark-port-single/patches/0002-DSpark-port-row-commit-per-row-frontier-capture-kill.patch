+/* Per-row generalization of the prefix1 capture (DSpark row commit).
+ *
+ * While the batch verifier steps the compressor token by token, save the
+ * small frontier state after every speculative row.  A partial accept of any
+ * prefix length then commits by copying one captured row back, instead of
+ * restoring the pre-verify snapshot and replaying the accepted tokens through
+ * a second full verifier pass. */
+static bool metal_graph_capture_rowcap_attn_state(ds4_gpu_graph *g, uint32_t il, uint32_t t) {
+    if (t >= g->spec_capture_rows || !g->spec_rowcap_attn_state_kv[il]) return true;
+    const uint64_t bytes = ds4_gpu_tensor_bytes(g->layer_attn_state_kv[il]);
+    g->spec_rowcap_n_comp[il][t] = g->layer_n_comp[il];
+    return ds4_gpu_tensor_copy(g->spec_rowcap_attn_state_kv[il], (uint64_t)t * bytes,
+                                 g->layer_attn_state_kv[il], 0, bytes) != 0 &&
+           ds4_gpu_tensor_copy(g->spec_rowcap_attn_state_score[il], (uint64_t)t * bytes,
+                                 g->layer_attn_state_score[il], 0, bytes) != 0;
+}
+
+static bool metal_graph_capture_rowcap_index_state(ds4_gpu_graph *g, uint32_t il, uint32_t t) {
+    if (t >= g->spec_capture_rows || !g->spec_rowcap_index_state_kv[il]) return true;
+    const uint64_t bytes = ds4_gpu_tensor_bytes(g->layer_index_state_kv[il]);
+    g->spec_rowcap_n_index_comp[il][t] = g->layer_n_index_comp[il];
+    return ds4_gpu_tensor_copy(g->spec_rowcap_index_state_kv[il], (uint64_t)t * bytes,
+                                 g->layer_index_state_kv[il], 0, bytes) != 0 &&
+           ds4_gpu_tensor_copy(g->spec_rowcap_index_state_score[il], (uint64_t)t * bytes,
+                                 g->layer_index_state_score[il], 0, bytes) != 0;
+}
