+/* Commit the row state captured by the batch verifier (DSpark row commit).
+ *
+ * Same idea as spec_frontier_commit_prefix1, generalized to any accepted
+ * prefix length: the frontier tensors and append counters are copied back
+ * from the captured row, and compressed rows past the accepted prefix stay
+ * behind the counters as invisible garbage. */
+static bool spec_frontier_commit_row(ds4_session *s, uint32_t row) {
+    ds4_gpu_graph *g = &s->graph;
+    if (row >= DS4_SPEC_ROWCAP_MAX) return false;
+    bool ok = ds4_gpu_begin_commands() != 0;
+    for (uint32_t il = 0; ok && il < DS4_N_LAYER; il++) {
+        const uint32_t ratio = ds4_layer_compress_ratio(il);
+        if (ratio == 0) continue;
+        if (!g->spec_rowcap_attn_state_kv[il]) { ok = false; break; }
+
+        g->layer_n_comp[il] = g->spec_rowcap_n_comp[il][row];
+        const uint64_t ab = ds4_gpu_tensor_bytes(g->layer_attn_state_kv[il]);
+        ok = ds4_gpu_tensor_copy(g->layer_attn_state_kv[il], 0,
+                                   g->spec_rowcap_attn_state_kv[il],
+                                   (uint64_t)row * ab, ab) != 0 &&
+             ds4_gpu_tensor_copy(g->layer_attn_state_score[il], 0,
+                                   g->spec_rowcap_attn_state_score[il],
+                                   (uint64_t)row * ab, ab) != 0;
+        if (ok && ratio == 4) {
+            g->layer_n_index_comp[il] = g->spec_rowcap_n_index_comp[il][row];
+            const uint64_t ib = ds4_gpu_tensor_bytes(g->layer_index_state_kv[il]);
+            ok = ds4_gpu_tensor_copy(g->layer_index_state_kv[il], 0,
+                                       g->spec_rowcap_index_state_kv[il],
+                                       (uint64_t)row * ib, ib) != 0 &&
+                 ds4_gpu_tensor_copy(g->layer_index_state_score[il], 0,
+                                       g->spec_rowcap_index_state_score[il],
+                                       (uint64_t)row * ib, ib) != 0;
+        }
+    }
+    if (ok) ok = ds4_gpu_end_commands() != 0;
+    else (void)ds4_gpu_synchronize();
+    return ok;
+}
