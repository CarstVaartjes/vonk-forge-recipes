diff --git a/ds4_cuda.cu b/ds4_cuda.cu
index 188b341..44e523a 100644
--- a/ds4_cuda.cu
+++ b/ds4_cuda.cu
@@ -3849,6 +3849,48 @@ __global__ static void matmul_q8_0_preq_batch_warp8_kernel(
     if (lane == 0) out[tok * out_dim + row] = acc;
