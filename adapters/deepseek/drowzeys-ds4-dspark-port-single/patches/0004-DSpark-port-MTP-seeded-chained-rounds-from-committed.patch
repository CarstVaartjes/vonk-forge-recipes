-/* One DSpark chained round: verify [seed ++ ngram continuation] in a single
- * batched pass, committing the accepted prefix through the row-commit path.
- * The seed is the target's own greedy next token, so row zero always commits.
- * Returns tokens committed, 0 if the round was not worth attempting, or -1 on
- * a decode error with the session invalidated. */
-static int dspark_eval_ngram_round(ds4_session *s, int max_new, int eos_token,
-                                   int *accepted, char *err, size_t errlen) {
+/* One DSpark chained round.
+ *
+ * After a committed speculative cycle the next position's logits are already
+ * on the host and the last committed row's hidden state has been captured,
+ * so both the target's next greedy token and a re-grounded MTP chain are
+ * available without a plain decode.  Verify [next ++ MTP chain ++ ngram
+ * continuation] in one batched pass and commit the accepted prefix through
+ * the row-commit path.  Returns tokens committed, 0 when a round is not
+ * worth attempting, or -1 on a decode error with the session invalidated. */
+static int dspark_eval_round(ds4_session *s, int max_new, int eos_token,
+                             int *accepted, char *err, size_t errlen) {
     ds4_engine *e = s->engine;
     ds4_gpu_graph *g = &s->graph;
     int batch[16];
     int seed = sample_argmax(s->logits, DS4_N_VOCAB);
     if (seed == eos_token) return 0;
     batch[0] = seed;
+    int n = 1;
 
-    int cap = 1 + e->dspark_ngram_tokens;
-    if (cap > max_new) cap = max_new;
+    int nmax = 1 + (e->mtp_draft_tokens - 1) + e->dspark_ngram_tokens;
+    if (nmax > max_new) nmax = max_new;
     int room = s->ctx_size - s->checkpoint.len;
-    if (cap > room - 1) cap = room - 1;
-    if (cap > 16) cap = 16;
-    if (cap < 3) return 0;
-
-    /* Chained rounds skip the plain decode entirely, so a whole-batch miss
-     * costs more than the decode it replaces.  Only bet on the strongest
-     * evidence: a full-length suffix match. */
-    int match_len = 0;
-    int m = dspark_ngram_propose(s->checkpoint.v, s->checkpoint.len,
-                                 batch, 1,
-                                 e->dspark_ngram_min,
-                                 cap - 1,
-                                 batch + 1,
-                                 &match_len);
-    for (int i = 0; i < m; i++) {
-        if (batch[1 + i] == eos_token) {
-            m = i + 1;
-            break;
+    if (nmax > room - 1) nmax = room - 1;
+    if (nmax > 16) nmax = 16;
+    if (nmax < 2) return 0;
+
+    /* MTP chain from the captured hidden state.  The first eval re-grounds
+     * the chain on the committed row and predicts the already-known seed
+     * token, which doubles as the position-0 agreement gate. */
+    const uint32_t base_raw = g->mtp_n_raw;
+    int mtp_rows = 0;
+    if (s->dspark_seed_valid && e->mtp_ready && s->mtp_logits &&
+        e->mtp_draft_tokens > 1 && batch[0] != eos_token)
+    {
+        const bool need_logits = e->dspark_early_margin > 0.0f;
+        int top = -1;
+        if (metal_graph_eval_mtp_draft_from_hc(g,
+                                               &e->model,
+                                               &e->weights,
+                                               &e->mtp_model,
+                                               &e->mtp_weights,
+                                               g->dspark_seed_hc,
+                                               g->mtp_state_hc,
+                                               s->dspark_seed_token,
+                                               (uint32_t)s->dspark_seed_pos,
+                                               need_logits ? s->mtp_logits : NULL,
+                                               &top))
+        {
+            mtp_rows = 1;
+            int pred = top >= 0 ? top : sample_argmax(s->mtp_logits, DS4_N_VOCAB);
+            if (pred == batch[0]) {
+                ds4_gpu_tensor *prev = g->mtp_state_hc;
+                while (n < nmax && n < e->mtp_draft_tokens) {
+                    ds4_gpu_tensor *out =
+                        (n & 1) ? g->mtp_next_hc : g->mtp_state_hc;
+                    top = -1;
+                    if (!metal_graph_eval_mtp_draft_from_hc(g,
+                                                            &e->model,
+                                                            &e->weights,
+                                                            &e->mtp_model,
+                                                            &e->mtp_weights,
+                                                            prev,
+                                                            out,
+                                                            batch[n - 1],
+                                                            (uint32_t)(s->dspark_seed_pos + n),
+                                                            need_logits ? s->mtp_logits : NULL,
+                                                            &top))
+                        break;
+                    mtp_rows++;
+                    pred = top >= 0 ? top : sample_argmax(s->mtp_logits, DS4_N_VOCAB);
+                    if (need_logits) {
+                        float v0 = 0.0f, v1 = 0.0f;
+                        int t0 = -1, t1 = -1;
+                        logits_top2(s->mtp_logits, DS4_N_VOCAB, &t0, &v0, &t1, &v1);
+                        if (v0 - v1 < e->dspark_early_margin) break;
+                    }
+                    batch[n++] = pred;
+                    prev = out;
+                    if (pred == eos_token) break;
+                }
+            }
+        }
+    }
+    const int mtp_n = n;
+
+    /* Ngram extension, capped by the suffix match length. */
+    int ngram_match = 0;
+    if (e->dspark_ngram_tokens > 0 && n < nmax && batch[n - 1] != eos_token) {
+        int m = dspark_ngram_propose(s->checkpoint.v, s->checkpoint.len,
+                                     batch, n,
+                                     e->dspark_ngram_min,
+                                     nmax - n,
+                                     batch + n,
+                                     &ngram_match);
+        if (m > ngram_match) m = ngram_match;
+        for (int i = 0; i < m; i++) {
+            if (batch[n + i] == eos_token) {
+                m = i + 1;
+                break;
+            }
         }
+        n += m;
     }
-    if (m < 2 || match_len < DS4_DSPARK_NGRAM_MAX_MATCH) return 0;
-    const int n = 1 + m;
+    if (n < 2) return 0;
+    /* Without a re-grounded MTP chain the round has no acceptance signal, so
+     * only bet a chainless verifier pass on the strongest ngram evidence. */
+    if (mtp_n < 2 && (ngram_match < DS4_DSPARK_NGRAM_MAX_MATCH || n < 3)) return 0;
 
     ds4_spec_frontier frontier;
     memset(&frontier, 0, sizeof(frontier));
@@ -28194,6 +28324,7 @@ static int dspark_eval_ngram_round(ds4_session *s, int max_new, int eos_token,
             free(row_logits);
             return -1;
         }
+        g->mtp_n_raw = base_raw;
         spec_frontier_free(&frontier);
         free(row_logits);
         return 0;
@@ -28205,12 +28336,21 @@ static int dspark_eval_ngram_round(ds4_session *s, int max_new, int eos_token,
     }
     s->checkpoint_valid = true;
     s->mtp_draft_valid = false;
-    /* Round-committed positions have no MTP raw rows; see the hole policy in
-     * the main speculative path. */
-    if (commit > 2) g->mtp_n_raw = 0;
-    if (getenv("DS4_MTP_SPEC_LOG")) {
-        fprintf(stderr, "ds4: dspark round drafted=%d committed=%d match=%d\n",
-                n, commit, match_len);
+    /* Draft-ring hole policy, as in the main speculative path: rows exist for
+     * the chain the drafter visited; positions committed beyond them are
+     * stale holes, tolerable when short. */
+    if (commit - (mtp_rows - 1) > 2) {
+        g->mtp_n_raw = 0;
+    } else {
+        uint32_t keep = base_raw + (uint32_t)commit;
+        if (keep > g->raw_window) keep = g->raw_window;
+        g->mtp_n_raw = keep;
+    }
+    (void)dspark_seed_from_batch_row(s, (uint32_t)(commit - 1),
+                                     batch[commit - 1], start + commit - 1);
+    if (getenv("DS4_MTP_SPEC_LOG") || getenv("DS4_MTP_TIMING")) {
+        fprintf(stderr, "ds4: dspark round drafted=%d committed=%d mtp=%d\n",
+                n, commit, mtp_n);
     }
     spec_frontier_free(&frontier);
     free(row_logits);
@@ -28232,9 +28372,8 @@ int ds4_session_eval_speculative_argmax(ds4_session *s, int first_token,
                                                      errlen);
 #ifndef DS4_NO_GPU
     ds4_engine *e = s ? s->engine : NULL;
-    if (n < 2 || !e ||
+    if (n < 1 || !e ||
         e->dspark_rounds <= 1 ||
-        e->dspark_ngram_tokens <= 0 ||
         !e->dspark_row_commit ||
         s->distributed || ds4_session_is_cpu(s))
         return n;
@@ -28247,8 +28386,8 @@ int ds4_session_eval_speculative_argmax(ds4_session *s, int first_token,
         int max_new = max_tokens - n;
         if (max_new > accepted_cap - n) max_new = accepted_cap - n;
         if (max_new < 3) break;
-        int r = dspark_eval_ngram_round(s, max_new, eos_token,
-                                        accepted + n, err, errlen);
+        int r = dspark_eval_round(s, max_new, eos_token,
+                                  accepted + n, err, errlen);
         if (r < 0) return -1;
         if (r == 0) break;
         n += r;
