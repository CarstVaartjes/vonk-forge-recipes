+#ifndef DS4_NO_GPU
+/* Record the last committed row's target hidden state as the seed of a
+ * chained-round MTP draft.  One hc-row device copy. */
+static bool dspark_seed_from_batch_row(ds4_session *s, uint32_t row, int token, int pos) {
+    ds4_gpu_graph *g = &s->graph;
+    if (!g->dspark_seed_hc || !g->batch_cur_hc) return false;
+    const uint64_t hc_bytes = (uint64_t)DS4_N_HC * DS4_N_EMBD * sizeof(float);
+    bool ok = ds4_gpu_begin_commands() != 0;
+    if (ok) ok = ds4_gpu_tensor_copy(g->dspark_seed_hc, 0,
+                                       g->batch_cur_hc,
+                                       (uint64_t)row * hc_bytes, hc_bytes) != 0;
+    if (ok) ok = ds4_gpu_end_commands() != 0;
+    else (void)ds4_gpu_synchronize();
+    if (!ok) return false;
+    s->dspark_seed_token = token;
+    s->dspark_seed_pos = pos;
+    s->dspark_seed_valid = true;
+    return true;
+}
+
+/* Same, from the single-token decode path where the final hidden state is
+ * left in the graph's cur_hc. */
+static bool dspark_seed_from_cur_hc(ds4_session *s, int token, int pos) {
+    ds4_gpu_graph *g = &s->graph;
+    if (!g->dspark_seed_hc || !g->cur_hc) return false;
+    const uint64_t hc_bytes = (uint64_t)DS4_N_HC * DS4_N_EMBD * sizeof(float);
+    bool ok = ds4_gpu_begin_commands() != 0;
+    if (ok) ok = ds4_gpu_tensor_copy(g->dspark_seed_hc, 0, g->cur_hc, 0, hc_bytes) != 0;
+    if (ok) ok = ds4_gpu_end_commands() != 0;
+    else (void)ds4_gpu_synchronize();
+    if (!ok) return false;
+    s->dspark_seed_token = token;
+    s->dspark_seed_pos = pos;
+    s->dspark_seed_valid = true;
+    return true;
+}
+#endif
