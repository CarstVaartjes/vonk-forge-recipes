# dsv4.1-flash max-decode profile (4x GB10, TP=4/EP=4 + DeepEP + DP-attention)
# All decode levers pulled at once; qualification AFTER landing on the profile.
# Levers: DeepEP low-latency MoE a2a (fp8 dispatch), DP-attention (dp=tp=4,
# KV heads=1 makes TP attention pure overhead), DP lm-head, continuous decode
# steps. Vision tower zeroed via json-model-override (blocks DeepEP otherwise).

TP_SIZE=4
EP_SIZE=4
NNODES=4
MODEL_PATH=$HOME/models/llm/dsv41/DeepSeek-V4.1-Flash
PORT=30000

CONTEXT_LENGTH=524288
MAX_TOTAL_TOKENS=1100000
MAX_RUNNING_REQUESTS=32
CHUNKED_PREFILL_SIZE=16384
MEM_FRACTION_STATIC=0.88

SPEC_ALGO=DSPARK
DSPARK_BLOCK_SIZE=5
ADAPTIVE_VERIFICATION=0

DSV41_ENGRAM_FILE_STORE=1
DSV41_MODEL_PATH=$HOME/models/llm/dsv41/DeepSeek-V4.1-Flash

GPU_STATE_LOCK=1
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False
SGLANG_FLASHINFER_MOE_FUSED_FINALIZE=0
SGLANG_SM120_FLASHMLA_BACKEND=flashinfer

JSON_OVERRIDE='{"vision_n_layers":0}'
export JSON_OVERRIDE

EXTRA_SGLANG_ARGS="--json-model-override-args '{\"vision_n_layers\":0}' --fp8-gemm-backend cutlass --watchdog-timeout 1800 --moe-a2a-backend none --dp-size 4 --enable-dp-attention --enable-dp-attention-local-control-broadcast --enable-dp-lm-head --num-continuous-decode-steps 2"
