# dsv4.1-flash 1M NIAH lane profile (4x GB10, TP=4/EP=4)
# Corrected after the 2026-09-13 abort: the full 1,100,000-token KV reservation
# left insufficient host headroom on N1 once prefill filled past ~50% (NVRM
# NV_ERR_NO_MEMORY at 5.1 GiB MemAvailable). This lane profile bounds the KV
# pool to the advertised 1M window + minimal margin so the prefill fits:
# model shard + static pool + OS headroom with ~20 GiB to spare on the head.

TP_SIZE=4
EP_SIZE=4
NNODES=4
MODEL_PATH=$HOME/models/llm/dsv41/DeepSeek-V4.1-Flash
PORT=30000

CONTEXT_LENGTH=1048576            # model maximum (unchanged)
MAX_TOTAL_TOKENS=1049100          # advertised window + ~500 margin (was 1100000)
MAX_RUNNING_REQUESTS=1            # single-case lane; no second request ever resident
CHUNKED_PREFILL_SIZE=2048         # indexer logits buffers are the long-prompt peak
MEM_FRACTION_STATIC=0.80

SPEC_ALGO=DSPARK
DSPARK_BLOCK_SIZE=5
ADAPTIVE_VERIFICATION=0

DSV41_ENGRAM_FILE_STORE=1
DSV41_MODEL_PATH=$HOME/models/llm/dsv41/DeepSeek-V4.1-Flash

GPU_STATE_LOCK=1
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False
SGLANG_FLASHINFER_MOE_FUSED_FINALIZE=0
SGLANG_SM120_FLASHMLA_BACKEND=flashinfer

EXTRA_SGLANG_ARGS="--fp8-gemm-backend cutlass --watchdog-timeout 3600"
