# Exclusive C1 512k retrieval envelope. Vision remains enabled.
TP_SIZE=4
EP_SIZE=4
NNODES=4
MODEL_PATH=$HOME/models/llm/dsv41/DeepSeek-V4.1-Flash
PORT=30000
CONTEXT_LENGTH=524288
MAX_TOTAL_TOKENS=1100000
MAX_RUNNING_REQUESTS=1
CHUNKED_PREFILL_SIZE=256
MEM_FRACTION_STATIC=0.80
SPEC_ALGO=DSPARK
DSPARK_BLOCK_SIZE=5
ADAPTIVE_VERIFICATION=0
DSV41_ENGRAM_FILE_STORE=1
DSV41_MODEL_PATH=$MODEL_PATH
DSV41_ADAPTIVE_CHUNK=1
DSV41_CHUNK_BUDGET_TOKENS2=3e8
DSV41_CHUNK_MIN=256
DSV41_CHUNK_MAX=256
DSV41_INDEXER_SCORE_BUDGET_MIB=1024
DSV41_INDEXER_K_CHUNK_MAX=2048
DSV41_TORCH_INDEXER_KSLICE=1
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False,garbage_collection_threshold:0.6
SGLANG_FLASHINFER_MOE_FUSED_FINALIZE=0
SGLANG_SM120_FLASHMLA_BACKEND=flashinfer
NCCL_BUFFSIZE=1048576
