# Same torch pin as the hardware-proven kimodo, motionbricks and moss-vl-realtime recipes. The
# creator's environment is Python 3.8 with torch 2.4.1 + CUDA 12.1; neither runs on GB10
# (aarch64, CUDA 13), so the stack below is the creator's code on the platform's Python 3.12.
torch==2.14.0+cu130
# The creator's pins (environment.yaml) where they exist for Python 3.12 aarch64: numpy 1.24.4
# has no 3.12 wheel (1.26.4 keeps the pre-2.0 aliases the creator's code uses), transformers
# 4.46.3 with its tokenizers 0.20.3 and huggingface-hub 0.30.1, sentencepiece (T5Tokenizer).
numpy==1.26.4
transformers==4.46.3
tokenizers==0.20.3
huggingface-hub==0.30.1
safetensors==0.5.3
sentencepiece==0.2.0
num2words==0.5.14
tqdm==4.67.1
# model/conditioners.py imports spacy at module level (its WordTokenizer, which AnyTop does not use);
# the creator's spacy 3.7.2 / thinc 8.1.8 pair conflicts with itself, so spacy 3.7.5 resolves its own thinc.
spacy==3.7.5
# data_loaders/truebones/truebones_utils/plot_script.py imports moviepy.editor and matplotlib at
