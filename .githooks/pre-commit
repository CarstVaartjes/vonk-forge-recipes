#!/bin/sh
set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"

# The catalog index, packages and coverage are build outputs (ignored by Git);
# CI builds and validates them. This hook runs the same lint, format and type
# commands as CI (.github/workflows/validate.yml). Only the staged files that
# Ruff selects are checked, from the working tree (the index is not
# materialised); `ruff check --show-files` is the one owner of "which files are
# Python", including the extensionless executables in tools/.
export UV_CACHE_DIR="${UV_CACHE_DIR:-${TMPDIR:-/tmp}/vonk-forge-recipes-hook-uv-cache}"
python_files=$(uv run --frozen ruff check --show-files)
staged_python=""
newline='
'
for path in $(git diff --cached --name-only --diff-filter=ACMR); do
    case "$newline$python_files$newline" in
        *"/$path$newline"*) staged_python="$staged_python$path$newline" ;;
    esac
done
if [ -n "$staged_python" ]; then
    set -f
    IFS=$newline
    # shellcheck disable=SC2086 # newline-separated paths
    set -- $staged_python
    unset IFS
    set +f
    uv run --frozen ruff check --force-exclude -- "$@"
    uv run --frozen ruff format --check --force-exclude -- "$@"
    # The type gate reads the whole working tree (no baseline): any type error fails.
    scripts/check-python-types
fi
# Tests never use git (tools/check-test-git). The staged diff is captured first so
# a failure of the diff writer aborts the hook (a pipe has no pipefail under sh).
staged=$(python3 tools/added-lines --cached)
printf '%s\n' "$staged" | python3 tools/check-test-git --diff -
printf '%s\n' "$staged" | python3 tools/check-nccl-ib-hca --diff -
printf '%s\n' "$staged" | python3 tools/check-document-reads --diff -
printf '%s\n' "$staged" | python3 tools/check-serial-reads --diff -
printf '%s\n' "$staged" | python3 tools/check-estimate-gates --diff -
printf '%s\n' "$staged" | python3 tools/check-final-stage-ldd --diff -
printf '%s\n' "$staged" | python3 tools/check-identity-compare --diff -
# A file over 1 MiB is declared with tools/adapter-sources add, never committed.
changed=$(git diff --cached --name-only --diff-filter=AMR)
printf '%s\n' "$changed" | python3 tools/check-added-file-size --paths-from -
