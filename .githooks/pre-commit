#!/bin/sh
set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"

# The catalog index, packages and coverage are build outputs (ignored by Git);
# CI builds and validates them. This hook only runs the pinned static checks.
# Only the staged Python files are checked, from the working tree (the index is
# not materialised); unstaged edits no longer refuse the commit; lint and format check only staged
# paths; the type gate still reads the working tree. Extensionless
# executables count when their first line is a python shebang.
staged_python=""
newline='
'
for path in $(git diff --cached --name-only --diff-filter=ACMR); do
    [ -f "$path" ] || continue
    case "$path" in
        adapters/*) continue ;;
        *.py) staged_python="$staged_python$path$newline" ;;
        *.*) ;;
        *)
            IFS= read -r first_line < "$path" || continue
            case "$first_line" in
                '#!'*python*) staged_python="$staged_python$path$newline" ;;
            esac
            ;;
    esac
done
if [ -n "$staged_python" ]; then
    set -f
    IFS=$newline
    # shellcheck disable=SC2086 # newline-separated paths
    set -- $staged_python
    unset IFS
    set +f
    UV_TOOL_DIR="${UV_TOOL_DIR:-/private/tmp/vonk-forge-recipes-hook-uv-tools}" \
        tools/check-python-lint "$@"
    UV_TOOL_DIR="${UV_TOOL_DIR:-/private/tmp/vonk-forge-recipes-hook-uv-tools}" \
        tools/check-python-format "$@"
fi
# The reviewed pyright baseline is the type gate; bare pyright on changed files
# would fail on every accepted exception in them.
if [ -n "$(git diff --cached --name-only --diff-filter=d -- '*.py')" ]; then
    UV_CACHE_DIR="${UV_CACHE_DIR:-/private/tmp/vonk-forge-recipes-hook-uv-cache}" \
        scripts/check-python-types
fi
# Tests never use git (tools/check-test-git). The staged diff is captured first so
# a failure of the diff writer aborts the hook (a pipe has no pipefail under sh).
staged=$(python3 tools/added-lines --cached)
printf '%s\n' "$staged" | python3 tools/check-test-git --diff -
# A file over 1 MiB is declared with tools/adapter-sources add, never committed.
changed=$(git diff --cached --name-only --diff-filter=AMR)
printf '%s\n' "$changed" | python3 tools/check-added-file-size --paths-from -
