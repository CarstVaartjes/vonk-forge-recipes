#!/bin/sh
set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"

# The catalog index, packages and coverage are build outputs (ignored by Git);
# CI builds and validates them. This hook only runs the pinned static checks.
if [ -n "$(git diff --name-only)" ]; then
    echo "recipe hook: stage all tracked edits before committing" >&2
    exit 1
fi

UV_TOOL_DIR="${UV_TOOL_DIR:-/private/tmp/vonk-forge-recipes-hook-uv-tools}" \
    tools/check-python-lint
UV_TOOL_DIR="${UV_TOOL_DIR:-/private/tmp/vonk-forge-recipes-hook-uv-tools}" \
    tools/check-python-format
# The reviewed pyright baseline is the type gate; bare pyright on changed files
# would fail on every accepted exception in them.
if [ -n "$(git diff --cached --name-only --diff-filter=d -- '*.py')" ]; then
    UV_CACHE_DIR="${UV_CACHE_DIR:-/private/tmp/vonk-forge-recipes-hook-uv-cache}" \
        scripts/check-python-types
fi
# Tests never use git (tools/check-test-git); the hook is the edge that supplies
# the staged diff.
git diff --cached -U0 --no-color --diff-filter=AMR -- tests | python3 tools/check-test-git --diff -
