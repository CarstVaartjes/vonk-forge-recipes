#!/usr/bin/env -S uv run --frozen python
"""Fail on any Python type error.

The gate requires zero pyright errors. There is no baseline: a test that
deliberately passes malformed input, or reaches a dynamically loaded module,
carries a `# pyright: ignore[<rule>]` on that line, and
`reportUnnecessaryTypeIgnoreComment` fails the ignore once it stops being needed.

pyright, pytest, pydantic and Pillow come from the `dev` dependency group in
`pyproject.toml` (locked in `uv.lock`, the one owner of their versions): the suite
declares fixtures and assertion helpers with pytest, and canonical contract types
must be checked against their actual base classes, not unresolved imports.

Adapters follow their upstream recipe and are excluded from this gate.

pyright's default program only includes `**/*.py`, so the extensionless Python
executables under `tools/` are passed explicitly, alongside the project run. The
list comes from `ruff check --show-files` (the entries without a suffix), so
Ruff's `extend-include` stays the one owner of "which files are Python".

pyright is told to analyze for Linux, so the host platform cannot change the
findings: local and CI runs agree.

"""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]


def _entry_points() -> list[str]:
    """Return the extensionless Python executables pyright's glob skips."""

    listed = subprocess.run(
        [sys.executable, "-m", "ruff", "check", "--show-files"],
        cwd=ROOT,
        capture_output=True,
        text=True,
        check=True,
    )
    entry_points: list[str] = []
    for line in listed.stdout.splitlines():
        relative = Path(line).resolve().relative_to(ROOT)
        if not relative.suffix:
            entry_points.append(relative.as_posix())
    return sorted(entry_points)


def _pyright(paths: list[str]) -> list[dict[str, object]]:
    completed = subprocess.run(
        [
            sys.executable,
            "-m",
            "pyright",
            "--pythonpath",
            sys.executable,
            # Counts are defined for Linux, where CI runs; without this a
            # macOS run sees os.posix_fadvise as unknown and differs from CI.
            "--pythonplatform",
            "Linux",
            "--outputjson",
            *paths,
        ],
        cwd=ROOT,
        capture_output=True,
        text=True,
        check=False,
    )
    try:
        payload = json.loads(completed.stdout)
    except json.JSONDecodeError as error:
        print(completed.stdout[-4000:], file=sys.stderr)
        print(completed.stderr[-4000:], file=sys.stderr)
        raise SystemExit("pyright did not return a JSON report") from error
    diagnostics = []
    for diagnostic in payload.get("generalDiagnostics", []):
        if diagnostic.get("severity") != "error":
            continue
        diagnostics.append(
            {
                "file": Path(diagnostic["file"]).resolve().relative_to(ROOT).as_posix(),
                "rule": diagnostic.get("rule") or "unknown",
                "line": diagnostic["range"]["start"]["line"] + 1,
            }
        )
    return diagnostics


def _diagnostics() -> list[dict[str, object]]:
    diagnostics = _pyright([])
    entry_points = _entry_points()
    if entry_points:
        diagnostics.extend(_pyright(entry_points))
    return diagnostics


def main() -> int:
    argparse.ArgumentParser(description=__doc__).parse_args()
    diagnostics = _diagnostics()
    for diagnostic in diagnostics:
        print(
            f"{diagnostic['file']}:{diagnostic['line']}: {diagnostic['rule']}",
            file=sys.stderr,
        )
    if diagnostics:
        print(f"\n{len(diagnostics)} type error(s)", file=sys.stderr)
        return 1
    print("python types: no errors")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
