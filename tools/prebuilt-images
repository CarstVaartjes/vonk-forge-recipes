#!/usr/bin/env python3
"""Plan, look up and record the prebuilt runtime images of the recipe library.

Every distinct recipe image is built on a GitHub-hosted ARM64 runner and pushed
to GHCR as ``ghcr.io/<owner>/vonk-forge-recipe-<slug>:build-<key>``, where
``<key>`` is the executable build key Vonk Forge's ``scripts/recipe-image-plan``
derives (source bundle, Dockerfile, pinned base images, build options and
capabilities, runtime adapter). The Controller derives the same key for a
revision and prefers the pinned digest over a Spark build.

``select``  considers every recipe (or the slugs asked for) whose ``build-<key>``
            tag is missing, one build per distinct key. A key
            another recipe already has is copied instead of rebuilt. Successful
            PR builds write ``candidate-<key>``; these are promoted by digest.
            ``--base-plan`` limits PRs to changed executable keys (including
            excluded recipes); ``--reuse-only`` forbids publication rebuilds.
``resolve`` looks up every recipe's ``build-<key>`` digest for the signed index.

``platform-ref`` prints the Vonk Forge commit the library is validated with
            (``platform_ref`` in publish.yml). The image workflow plans and
            builds with that same commit, so there is one pin and it cannot
            drift between validation and images. Selection reconciles every
            current key on each publication, independently of release tags.

``resolve`` reports missing images; publication leaves those image pins absent
and reports them as pending while deferred/scheduled builds reconcile them.
It names the reason for every recipe without an image: refused by the
Controller's source policy (not planned), declared unbuildable in CI in
``prebuilt-image-exclusions.json`` (those are not retried until asked for by
name), or no image in the registry (the build failed or has not run).
"""

from __future__ import annotations

import argparse
import json
import re
import sys
import urllib.error
import urllib.request
from collections.abc import Callable, Iterable, Mapping
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path
from typing import Any

REGISTRY = "ghcr.io"
PACKAGE_PREFIX = "vonk-forge-recipe-"
# A matrix may hold at most 256 jobs; the rest wait for the next run.
MAX_BUILDS = 256
_MANIFEST_TYPES = (
    "application/vnd.oci.image.manifest.v1+json, "
    "application/vnd.docker.distribution.manifest.v2+json, "
    "application/vnd.oci.image.index.v1+json, "
    "application/vnd.docker.distribution.manifest.list.v2+json"
)

# (owner, package, tag) -> manifest digest or None
Lookup = Callable[[str, str, str], "str | None"]


def package(slug: str) -> str:
    return f"{PACKAGE_PREFIX}{slug}"


def repository(owner: str, slug: str) -> str:
    return f"{REGISTRY}/{owner.lower()}/{package(slug)}"


def ghcr_digest(owner: str, name: str, tag: str) -> str | None:
    """Anonymous manifest lookup; ``None`` when the tag does not exist."""

    scope = f"repository:{owner.lower()}/{name}:pull"
    for attempt in range(3):
        try:
            with urllib.request.urlopen(
                f"https://{REGISTRY}/token?scope={scope}", timeout=30
            ) as response:
                token = json.load(response)["token"]
            request = urllib.request.Request(
                f"https://{REGISTRY}/v2/{owner.lower()}/{name}/manifests/{tag}",
                method="HEAD",
                headers={"Authorization": f"Bearer {token}", "Accept": _MANIFEST_TYPES},
            )
            with urllib.request.urlopen(request, timeout=30) as response:
                digest = response.headers.get("Docker-Content-Digest")
                return digest if isinstance(digest, str) else None
        except urllib.error.HTTPError as error:
            # A package that was never pushed denies the token or the manifest.
            if error.code in {401, 403, 404}:
                return None
            if attempt == 2:
                raise
        except (urllib.error.URLError, TimeoutError, OSError):
            if attempt == 2:
                raise
    return None


def _recipes(plan: Mapping[str, Any]) -> Iterable[tuple[str, Mapping[str, Any]]]:
    for image in plan.get("images", []):
        for recipe in image.get("recipes", []):
            yield str(image["build_key"]), recipe


def select(
    plan: Mapping[str, Any],
    *,
    owner: str,
    candidates: set[str] | None,
    lookup: Lookup = ghcr_digest,
) -> dict[str, Any]:
    """What to build and what to copy for the candidate recipes.

    ``candidates`` of ``None`` means every recipe. A key is built once, into
    the first candidate recipe that lacks it; recipes sharing a key another
    package already holds are copied from it.
    """

    builds: dict[str, dict[str, Any]] = {}
    copies: list[dict[str, str]] = []
    for image in plan.get("images", []):
        key = str(image["build_key"])
        recipes = list(image.get("recipes", []))
        wanted = [
            recipe
            for recipe in recipes
            if candidates is None or str(recipe["slug"]) in candidates
        ]
        if not wanted:
            continue
        tag = f"build-{key}"
        present = {
            str(recipe["slug"]): lookup(owner, package(str(recipe["slug"])), tag)
            for recipe in recipes
        }
        source = next((slug for slug, digest in present.items() if digest), None)
        missing = [recipe for recipe in wanted if not present[str(recipe["slug"])]]
        if not missing:
            continue
        # Only a successful build + smoke run writes a candidate tag. Promote
        # its immutable digest; recipe versions and commits do not affect reuse.
        if source is None:
            for recipe in recipes:
                slug = str(recipe["slug"])
                digest = lookup(owner, package(slug), f"candidate-{key}")
                if digest:
                    source = slug
                    present[slug] = digest
                    break
        if source is not None:
            digest = present[source]
            assert digest is not None
            copies.extend(
                {
                    "from": f"{repository(owner, source)}@{digest}",
                    "to": f"{repository(owner, str(recipe['slug']))}:{tag}",
                    "version_tag": f"{repository(owner, str(recipe['slug']))}:"
                    f"{recipe.get('version') or 'latest'}",
                }
                for recipe in missing
            )
            continue
        builds[key] = {
            "build_key": key,
            "recipes": [
                {
                    "slug": str(recipe["slug"]),
                    "version": recipe.get("version"),
                    "repository": repository(owner, str(recipe["slug"])),
                }
                for recipe in missing
            ],
        }
    ordered = sorted(builds.values(), key=lambda item: item["recipes"][0]["slug"])
    return {
        "builds": ordered[:MAX_BUILDS],
        "deferred": [item["build_key"] for item in ordered[MAX_BUILDS:]],
        "deferred_slugs": [
            recipe["slug"]
            for item in ordered[MAX_BUILDS:]
            for recipe in item["recipes"]
        ],
        "copies": copies,
    }


EXCLUSIONS = Path("prebuilt-image-exclusions.json")


def read_exclusions(path: Path = EXCLUSIONS) -> dict[str, str]:
    """Recipes CI cannot build, each with the reason, from the repository file."""

    if not path.is_file():
        return {}
    document = json.loads(path.read_text(encoding="utf-8"))
    return {str(slug): str(reason) for slug, reason in document.items()}


def without_excluded(
    plan: Mapping[str, Any],
    candidates: set[str] | None,
    excluded: Mapping[str, str],
    *,
    requested: list[str],
) -> set[str] | None:
    """Drop recipes declared unbuildable in CI, unless a run names them.

    A build that cannot finish on a hosted runner would otherwise burn its full
    job timeout on every platform move.
    """

    if requested and requested != ["all"]:
        return candidates
    universe = (
        {slug for _key, recipe in _recipes(plan) for slug in [str(recipe["slug"])]}
        if candidates is None
        else candidates
    )
    return universe - set(excluded)


def resolve(
    plan: Mapping[str, Any], *, owner: str, lookup: Lookup = ghcr_digest
) -> tuple[dict[str, dict[str, str]], list[str]]:
    """Map each recipe's content digest to its pinned prebuilt image."""

    entries = list(_recipes(plan))

    def one(entry: tuple[str, Mapping[str, Any]]) -> tuple[str, str, str | None]:
        key, recipe = entry
        slug = str(recipe["slug"])
        try:
            digest = lookup(owner, package(slug), f"build-{key}")
        except OSError as error:
            print(f"{slug}: registry lookup failed: {error}", file=sys.stderr)
            digest = None
        return key, slug, digest

    with ThreadPoolExecutor(max_workers=8) as pool:
        found = list(pool.map(one, entries))
    images: dict[str, dict[str, str]] = {}
    missing: list[str] = []
    for (key, recipe), (_key, slug, digest) in zip(entries, found, strict=True):
        if digest is None:
            missing.append(slug)
            continue
        images[str(recipe["content_sha256"])] = {
            "reference": f"{repository(owner, slug)}@{digest}",
            "build_key": key,
        }
    return images, sorted(missing)


PLATFORM_WORKFLOW = Path(".github/workflows/publish.yml")
_PLATFORM_REF = re.compile(r"^\s*platform_ref:\s*([0-9a-f]{40})\s*$", re.MULTILINE)


def platform_ref(workflow: str) -> str | None:
    """The Vonk Forge commit a workflow pins as ``platform_ref``, if any."""

    found = _PLATFORM_REF.search(workflow)
    return found.group(1) if found else None


def candidate_slugs(requested: list[str]) -> set[str] | None:
    """Reconcile every current key, unless the run explicitly names recipes.

    A release tag is not evidence of image availability. In particular, a new
    contract version has no tag yet, and successful publication may advance a
    tag while builds are still pending.
    """

    return set(requested) if requested and requested != ["all"] else None


def changed_candidates(
    plan: Mapping[str, Any], base_plan: Mapping[str, Any]
) -> set[str]:
    """Compare executable identities, not paths or recipe document revisions.

    Evidence, Model metadata and recipe options that do not affect the build
    must not enqueue missing historical images. Shared contexts still enqueue
    every recipe using a new key, deduplicated by ``select``.
    """

    previous = {str(recipe["slug"]): key for key, recipe in _recipes(base_plan)}
    return {
        str(recipe["slug"])
        for key, recipe in _recipes(plan)
        if previous.get(str(recipe["slug"])) != key
    }


def missing_reasons(
    plan: Mapping[str, Any], missing: list[str], excluded: Mapping[str, str]
) -> dict[str, str]:
    """Why each recipe without a prebuilt image has none."""

    reasons = {
        str(item["slug"]): f"not planned: {item['reason']}"
        for item in plan.get("skipped", [])
    }
    for slug in missing:
        reasons[slug] = (
            f"declared unbuildable in CI: {excluded[slug]}"
            if slug in excluded
            else "no image in the registry for its build key: the build failed "
            "or has not run (see the Build jobs of the image workflow)"
        )
    return dict(sorted(reasons.items()))


def main() -> int:
    parser = argparse.ArgumentParser(description=(__doc__ or "").splitlines()[0])
    commands = parser.add_subparsers(dest="command", required=True)
    choose = commands.add_parser("select")
    choose.add_argument("--plan", type=Path, required=True)
    choose.add_argument("--owner", required=True)
    choose.add_argument(
        "--slugs",
        default="",
        help="space-separated recipe ids; defaults to every missing image",
    )
    choose.add_argument("--output", type=Path, required=True)
    choose.add_argument("--base-plan", type=Path)
    choose.add_argument("--reuse-only", action="store_true")
    pin = commands.add_parser("platform-ref")
    pin.add_argument("--workflow", type=Path, default=PLATFORM_WORKFLOW)
    look = commands.add_parser("resolve")
    look.add_argument("--plan", type=Path, required=True)
    look.add_argument("--owner", required=True)
    look.add_argument("--output", type=Path, required=True)
    arguments = parser.parse_args()
    if arguments.command == "platform-ref":
        ref = platform_ref(arguments.workflow.read_text(encoding="utf-8"))
        if ref is None:
            print(f"{arguments.workflow} pins no platform_ref", file=sys.stderr)
            return 1
        print(ref)
        return 0
    plan = json.loads(arguments.plan.read_text(encoding="utf-8"))
    if arguments.command == "select":
        if arguments.base_plan is not None:
            if plan.get("skipped"):
                raise SystemExit(f"PR image planner refused recipes: {plan['skipped']}")
            candidates = changed_candidates(
                plan, json.loads(arguments.base_plan.read_text(encoding="utf-8"))
            )
        else:
            candidates = without_excluded(
                plan,
                candidate_slugs(arguments.slugs.split()),
                read_exclusions(),
                requested=arguments.slugs.split(),
            )
        selection = select(plan, owner=arguments.owner, candidates=candidates)
        if arguments.base_plan is not None and selection["deferred"]:
            raise SystemExit("PR image matrix exceeds 256 keys; split the change")
        if arguments.reuse_only and (selection["builds"] or selection["deferred"]):
            keys = [row["build_key"] for row in selection["builds"]]
            raise SystemExit(
                f"Missing PR image proof for {keys + selection['deferred']}; "
                "publication never rebuilds. Complete candidate CI or the "
                "scheduled/manual image recovery workflow first."
            )
        arguments.output.write_text(json.dumps(selection, indent=2), encoding="utf-8")
        print(
            f"{len(selection['builds'])} image build(s), "
            f"{len(selection['copies'])} copy(ies), "
            f"{len(selection['deferred'])} deferred"
        )
        return 0
    images, missing = resolve(plan, owner=arguments.owner)
    arguments.output.write_text(
        json.dumps(images, indent=2, sort_keys=True), encoding="utf-8"
    )
    reasons = missing_reasons(plan, missing, read_exclusions())
    print(f"{len(images)} recipe(s) have a prebuilt image; {len(reasons)} do not")
    for slug, reason in reasons.items():
        print(f"  no prebuilt image: {slug}: {reason}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
