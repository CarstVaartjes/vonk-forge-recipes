#!/usr/bin/env python3
"""Submit a bounded evidence batch to the single rolling evidence PR."""

import argparse
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path[:0] = [str(ROOT), str(ROOT / "contracts/src")]

from spark_sweep.evidence_publisher import sync


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--history", type=Path, required=True)
    parser.add_argument("--work-dir", type=Path, required=True)
    parser.add_argument("--state", type=Path, default=None)
    parser.add_argument(
        "--final",
        action="store_true",
        help="bring an open evidence PR up to date instead of waiting for its merge",
    )
    args = parser.parse_args()
    raise SystemExit(sync(args.history, args.work_dir, args.state, args.final))


if __name__ == "__main__":
    main()
