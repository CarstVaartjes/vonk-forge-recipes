#!/usr/bin/env python3
"""Fail when a language Model's input modalities and capabilities disagree.

For a Model that generates text, ``image-understanding`` holds exactly when
``image`` is an input modality, ``audio-understanding`` exactly when ``audio``
is, and ``video-understanding`` exactly when ``video`` is. The Model records the
checkpoint's own ability (its config at the pinned revision); a launch that
switches a modality off is a Recipe fact, not a Model fact.

Only Models added or changed since the merge base with ``--base`` are checked;
with no ``--base`` the named slugs, or the whole library, are. There is no count
and no list of exempt Models.
"""

from __future__ import annotations

import argparse
import json
import subprocess
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
TEXT_CAPABILITIES = frozenset({"text-generation", "chat", "reasoning"})
PAIRS = (
    ("image-understanding", "image"),
    ("audio-understanding", "audio"),
    ("video-understanding", "video"),
)


def disagreements(document: dict[str, object]) -> list[str]:
    """One message per capability and modality that do not hold together."""

    capabilities = set(document.get("capabilities", []))  # type: ignore[call-overload]
    modalities = set(document.get("modalities", []))  # type: ignore[call-overload]
    if not capabilities & TEXT_CAPABILITIES:
        return []
    return [
        f"capability {capability!r} and modality {modality!r} must come together"
        for capability, modality in PAIRS
        if (capability in capabilities) != (modality in modalities)
    ]


def touched_models(root: Path, base: str) -> list[Path]:
    """Model files added, modified or renamed since the merge base."""

    def git(*args: str) -> list[str]:
        return subprocess.run(
            ["git", "-C", str(root), *args, "--", "models/*.json"],
            capture_output=True,
            text=True,
            check=True,
        ).stdout.splitlines()

    names = git("diff", "--name-only", "--diff-filter=AMR", "--merge-base", base)
    names += git("ls-files", "--others", "--exclude-standard")
    return sorted({root / name for name in names})


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("slugs", nargs="*", help="Model slugs; default: library")
    parser.add_argument("--base", help="check only Models changed since this revision")
    args = parser.parse_args()
    if args.base:
        paths = touched_models(ROOT, args.base)
    elif args.slugs:
        paths = [ROOT / "models" / f"{slug}.json" for slug in args.slugs]
    else:
        paths = sorted((ROOT / "models").glob("*.json"))
    failed = 0
    for path in paths:
        if not path.is_file():
            continue
        for message in disagreements(json.loads(path.read_text(encoding="utf-8"))):
            failed += 1
            print(f"{path.stem}: {message}")
    print(f"Checked {len(paths)} Model(s); {failed} disagreement(s).")
    return 1 if failed else 0


if __name__ == "__main__":
    raise SystemExit(main())
