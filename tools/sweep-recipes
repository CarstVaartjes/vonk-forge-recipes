#!/usr/bin/env python3
"""Qualify as many recipes as possible on the real Sparks, fast and unattended.

Drives the fleet only through ``vonkctl`` (JSON mode): prefetches models onto the
NAS while the Sparks test, runs each recipe's reviewed smoke cases, and keeps a
resumable state file, a results log and a live status page. See
docs/hardware-sweep.md. Start with ``tools/sweep-recipes plan``.
"""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from spark_sweep.cli import main

if __name__ == "__main__":
    raise SystemExit(main())
