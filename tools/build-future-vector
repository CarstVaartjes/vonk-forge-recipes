#!/usr/bin/env python3
"""Write the future vector: the real index as a newer minor release could publish it.

Starting from the built ``catalog-index.json`` and its generated schema, the vector holds
an unknown word at every site a consumer reader keeps, an unknown field on every closed
object, and one recipe entry whose serving kind a reader cannot execute (it is withheld;
the rest of the index applies). The release ships it as ``future-canary-index.json`` so a
pinned and a stable consumer both prove they survive a newer minor. The code lives in
``src/recipe_tooling/future_vector.py``; the vector is a reader test, never a catalog.
"""

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "contracts" / "src"))
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
from recipe_tooling.catalog_index import rendered_vector
from recipe_tooling.future_vector import build_future_vector


def main() -> int:
    parser = argparse.ArgumentParser(description=(__doc__ or "").splitlines()[0])
    parser.add_argument("--index", type=Path, required=True, help="catalog-index.json")
    parser.add_argument(
        "--schema", type=Path, required=True, help="catalog-index-v2.schema.json"
    )
    parser.add_argument(
        "--out", type=Path, required=True, help="future-canary-index.json"
    )
    arguments = parser.parse_args()
    result = build_future_vector(
        json.loads(arguments.index.read_text(encoding="utf-8")),
        json.loads(arguments.schema.read_text(encoding="utf-8")),
    )
    arguments.out.write_bytes(rendered_vector(result.document))
    print(
        f"wrote {arguments.out}: {len(result.tolerant)} tolerant word sites, "
        f"{len(result.intolerant)} left alone, entry {result.withheld} withheld"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
