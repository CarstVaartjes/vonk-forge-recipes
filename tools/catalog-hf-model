#!/usr/bin/env python3
"""Materialize an immutable Hugging Face ModelDefinition."""

from __future__ import annotations

import argparse
import hashlib
import json
import re
import sys
from pathlib import Path
from typing import Any
from urllib.error import HTTPError
from urllib.parse import quote
from urllib.request import Request, urlopen

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "contracts" / "src"))
from vonk_forge_contracts import ModelDefinition, document_sha256

MAX_INLINE_ARTIFACT_BYTES = 16 * 1024 * 1024


def _sha256(payload: bytes) -> str:
    return hashlib.sha256(payload).hexdigest()


def _get_json(url: str) -> object:
    request = Request(url, headers={"User-Agent": "vonk-forge-recipe-library/1"})
    with urlopen(request, timeout=60) as response:
        return json.load(response)


def _get_json_page(url: str) -> tuple[object, str | None]:
    request = Request(url, headers={"User-Agent": "vonk-forge-recipe-library/1"})
    with urlopen(request, timeout=60) as response:
        payload = json.load(response)
        link = response.headers.get("Link", "")
    match = re.search(r'<([^>]+)>;\s*rel="next"', link)
    return payload, None if match is None else match.group(1)


def _get_tree(url: str) -> list[object]:
    entries: list[object] = []
    next_url: str | None = url
    while next_url is not None:
        page, next_url = _get_json_page(next_url)
        if not isinstance(page, list):
            raise SystemExit("Hugging Face model tree page is not an array")
        entries.extend(page)
    return entries


def _get_bytes(url: str) -> bytes:
    request = Request(url, headers={"User-Agent": "vonk-forge-recipe-library/1"})
    with urlopen(request, timeout=120) as response:
        return response.read()


def _arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--root", type=Path, default=Path(__file__).resolve().parents[1]
    )
    parser.add_argument("--repository", required=True)
    parser.add_argument(
        "--revision", help="40-character commit; defaults to the repository head"
    )
    parser.add_argument("--publisher", required=True)
    parser.add_argument("--model-group-slug", required=True)
    parser.add_argument("--model-group-title", required=True)
    parser.add_argument("--model-group-description", required=True)
    parser.add_argument("--model-slug", required=True)
    parser.add_argument("--model-title", required=True)
    parser.add_argument("--model-description", required=True)
    parser.add_argument("--modality", default="language")
    parser.add_argument("--version-slug", required=True)
    parser.add_argument("--version", required=True)
    parser.add_argument("--precision", required=True)
    parser.add_argument("--quantization", required=True)
    parser.add_argument("--license-spdx", required=True)
    parser.add_argument("--license-url", required=True)
    parser.add_argument("--attribution", action="append", required=True)
    parser.add_argument(
        "--requires-token",
        action="store_true",
        help="the repository is gated: downloading needs a provider token",
    )
    parser.add_argument(
        "--capability",
        action="append",
        default=[],
        help="a capability name the model supports (repeatable)",
    )
    return parser.parse_args()


def _slug(value: str) -> str:
    if not value:
        return "metadata"
    slug = value.lower().replace("_", "-").replace(".", "-").replace("/", "-")
    return slug if slug[:1].isalpha() else f"file-{slug}"


def _roles(path: str) -> list[str]:
    lowered = path.lower()
    if lowered.endswith(".safetensors") or "model-" in lowered:
        return ["weights"]
    if "token" in lowered or "vocab" in lowered or lowered.endswith(".jinja"):
        return ["tokenizer"]
    if "config" in lowered or "generation" in lowered or lowered.endswith(".json"):
        return ["configuration"]
    if lowered.endswith(".py"):
        return ["runtime"]
    return ["metadata"]


def inventory(
    repository: str, revision: str, tree: list[object]
) -> list[dict[str, Any]]:
    """Artifacts (path, digest, size, roles) of one snapshot's file entries."""

    file_entries = [
        entry
        for entry in tree
        if isinstance(entry, dict) and entry.get("type") == "file"
    ]

    artifacts: list[dict[str, Any]] = []
    for entry in file_entries:
        path = entry.get("path")
        size = entry.get("size")
        if not isinstance(path, str) or not isinstance(size, int) or size < 0:
            continue
        lfs = entry.get("lfs")
        if isinstance(lfs, dict) and isinstance(lfs.get("oid"), str):
            sha256 = lfs["oid"]
        else:
            if size > MAX_INLINE_ARTIFACT_BYTES:
                raise SystemExit(
                    f"refusing to download non-LFS artifact larger than "
                    f"{MAX_INLINE_ARTIFACT_BYTES} bytes: {path} ({size} bytes)"
                )
            try:
                payload = _get_bytes(
                    f"https://huggingface.co/{repository}/resolve/{revision}/{quote(path, safe='/')}"
                )
            except HTTPError as error:
                raise SystemExit(
                    "cannot inventory exact non-LFS artifact without access: "
                    f"{path} (HTTP {error.code}); authenticate to Hugging Face "
                    "and rerun"
                ) from error
            if len(payload) != size:
                raise SystemExit(f"download size changed for {path}")
            sha256 = _sha256(payload)
        artifact_stem = _slug(path.rsplit("/", 1)[-1].rsplit(".", 1)[0])
        path_sha256 = _sha256(path.encode())
        artifacts.append(
            {
                # Basenames and even basename/content pairs are not globally
                # unique in a Hugging Face tree. Trace repositories commonly
                # repeat byte-identical result files in different directories,
                # so bind the readable id to both content and full-path digests.
                "id": f"{artifact_stem[:39]}-{sha256[:12]}-{path_sha256[:10]}",
                "path": path,
                "kind": "huggingface.file",
                "repository": f"https://huggingface.co/{repository}",
                "revision": revision,
                "sha256": sha256,
                "download_bytes": size,
                "installed_bytes": size,
                "roles": _roles(path),
            }
        )
    artifacts.sort(key=lambda item: str(item["path"]))
    if not artifacts:
        raise SystemExit("Hugging Face model has no file artifacts")
    return artifacts


def main() -> int:
    args = _arguments()
    root = args.root.resolve()
    api_base = f"https://huggingface.co/api/models/{quote(args.repository, safe='/')}"
    model_api = _get_json(api_base)
    if not isinstance(model_api, dict):
        raise SystemExit("Hugging Face model response is not an object")
    revision = args.revision or model_api.get("sha")
    if not isinstance(revision, str) or len(revision) != 40:
        raise SystemExit("a 40-character model revision is required")
    tree = _get_tree(f"{api_base}/tree/{revision}?recursive=true&expand=true&limit=100")
    if not tree:
        raise SystemExit("Hugging Face model tree is empty")

    artifacts = inventory(args.repository, revision, tree)
    total_bytes = sum(int(item["download_bytes"]) for item in artifacts)

    modality = {"language": "text", "multimodal": "text"}.get(
        args.modality, args.modality
    )
    if modality not in {"text", "image", "audio", "video", "3d", "embeddings"}:
        raise SystemExit(f"unsupported model modality: {args.modality}")
    document = {
        "kind": "model",
        "identity": {
            "publisher": args.publisher,
            "slug": args.version_slug,
            "family": {
                "publisher": args.publisher,
                "slug": args.model_group_slug,
                "title": args.model_group_title,
            },
            "model": {
                "publisher": args.publisher,
                "slug": args.model_slug,
                "title": args.model_title,
            },
            "version": args.version,
            "variant": args.version,
        },
        "metadata": {
            "description": args.model_description,
            "tags": list(
                dict.fromkeys(
                    [args.publisher, args.model_group_slug, args.modality, "candidate"]
                )
            ),
        },
        "requires_token": args.requires_token,
        "dependencies": [],
        "modalities": [modality],
        "source": {
            "repository": f"https://huggingface.co/{args.repository}",
            "revision": revision,
        },
        "format": {
            "precision": args.precision,
            "quantization": args.quantization,
        },
        "license": {
            "spdx": args.license_spdx,
            "url": args.license_url,
            "attribution": args.attribution,
        },
        "files": [
            {
                "id": item["id"],
                "path": item["path"],
                "sha256": item["sha256"],
                "size_bytes": item["installed_bytes"],
                "roles": item["roles"],
            }
            for item in artifacts
        ],
        "capabilities": sorted(set(args.capability)),
    }
    ModelDefinition.model_validate(document)
    model_path = root / "models" / f"{args.version_slug}.json"
    model_path.parent.mkdir(parents=True, exist_ok=True)
    model_path.write_text(
        json.dumps(document, ensure_ascii=False, indent=2, sort_keys=True) + "\n"
    )
    # Recipes reference this Model by the digest of the document as written.
    model_hash = document_sha256(document)
    print(
        json.dumps(
            {"revision": revision, "model_sha256": model_hash, "bytes": total_bytes},
            sort_keys=True,
        )
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
