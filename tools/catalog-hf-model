#!/usr/bin/env python3
"""Materialize an immutable Hugging Face model and model-version entity."""

from __future__ import annotations

import argparse
import hashlib
import json
import re
from pathlib import Path
from urllib.parse import quote
from urllib.request import Request, urlopen


def _sha256(payload: bytes) -> str:
    return hashlib.sha256(payload).hexdigest()


def _canonical(document: object) -> bytes:
    return json.dumps(document, sort_keys=True, separators=(",", ":")).encode()


def _get_json(url: str) -> object:
    request = Request(url, headers={"User-Agent": "vonk-forge-recipe-library/1"})
    with urlopen(request, timeout=60) as response:
        return json.load(response)


def _get_json_page(url: str) -> tuple[object, str | None]:
    request = Request(url, headers={"User-Agent": "vonk-forge-recipe-library/1"})
    with urlopen(request, timeout=60) as response:
        payload = json.load(response)
        link = response.headers.get("Link", "")
    match = re.search(r'<([^>]+)>;\s*rel="next"', link)
    return payload, None if match is None else match.group(1)


def _get_tree(url: str) -> list[object]:
    entries: list[object] = []
    next_url: str | None = url
    while next_url is not None:
        page, next_url = _get_json_page(next_url)
        if not isinstance(page, list):
            raise SystemExit("Hugging Face model tree page is not an array")
        entries.extend(page)
    return entries


def _get_bytes(url: str) -> bytes:
    request = Request(url, headers={"User-Agent": "vonk-forge-recipe-library/1"})
    with urlopen(request, timeout=120) as response:
        return response.read()


def _content_hash(path: Path) -> str:
    return _sha256(_canonical(json.loads(path.read_text())))


def _arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parents[1])
    parser.add_argument("--repository", required=True)
    parser.add_argument("--revision", help="40-character commit; defaults to the repository head")
    parser.add_argument("--publisher", required=True)
    parser.add_argument("--model-group-slug", required=True)
    parser.add_argument("--model-group-title", required=True)
    parser.add_argument("--model-group-description", required=True)
    parser.add_argument("--model-slug", required=True)
    parser.add_argument("--model-title", required=True)
    parser.add_argument("--model-description", required=True)
    parser.add_argument("--architecture", required=True)
    parser.add_argument("--modality", default="language")
    parser.add_argument("--version-slug", required=True)
    parser.add_argument("--version", required=True)
    parser.add_argument("--precision", required=True)
    parser.add_argument("--quantization", required=True)
    parser.add_argument("--parameters-total", type=int, required=True)
    parser.add_argument("--parameters-active", type=int, required=True)
    parser.add_argument("--context-tokens", type=int, required=True)
    parser.add_argument("--license-spdx", required=True)
    parser.add_argument("--license-url", required=True)
    parser.add_argument("--attribution", action="append", required=True)
    parser.add_argument("--operator-acceptance-required", action="store_true")
    return parser.parse_args()


def _slug(value: str) -> str:
    if not value:
        return "metadata"
    slug = value.lower().replace("_", "-").replace(".", "-").replace("/", "-")
    return slug if slug[:1].isalpha() else f"file-{slug}"


def _roles(path: str) -> list[str]:
    lowered = path.lower()
    if lowered.endswith(".safetensors") or "model-" in lowered:
        return ["weights"]
    if "token" in lowered or "vocab" in lowered or lowered.endswith(".jinja"):
        return ["tokenizer"]
    if "config" in lowered or "generation" in lowered or lowered.endswith(".json"):
        return ["configuration"]
    if lowered.endswith(".py"):
        return ["runtime"]
    return ["metadata"]


def main() -> int:
    args = _arguments()
    root = args.root.resolve()
    api_base = f"https://huggingface.co/api/models/{quote(args.repository, safe='/')}"
    model_api = _get_json(api_base)
    if not isinstance(model_api, dict):
        raise SystemExit("Hugging Face model response is not an object")
    revision = args.revision or model_api.get("sha")
    if not isinstance(revision, str) or len(revision) != 40:
        raise SystemExit("a 40-character model revision is required")
    tree = _get_tree(
        f"{api_base}/tree/{revision}?recursive=true&expand=true&limit=100"
    )
    if not tree:
        raise SystemExit("Hugging Face model tree is empty")

    artifacts: list[dict[str, object]] = []
    for entry in tree:
        if not isinstance(entry, dict) or entry.get("type") != "file":
            continue
        path = entry.get("path")
        size = entry.get("size")
        if not isinstance(path, str) or not isinstance(size, int) or size < 1:
            continue
        lfs = entry.get("lfs")
        if isinstance(lfs, dict) and isinstance(lfs.get("oid"), str):
            sha256 = lfs["oid"]
        else:
            payload = _get_bytes(
                f"https://huggingface.co/{args.repository}/resolve/{revision}/{quote(path, safe='/')}"
            )
            if len(payload) != size:
                raise SystemExit(f"download size changed for {path}")
            sha256 = _sha256(payload)
        artifact_stem = _slug(path.rsplit("/", 1)[-1].rsplit(".", 1)[0])
        artifacts.append(
            {
                # Basenames are not globally unique in a Hugging Face tree
                # (and dotfiles have an empty stem), so bind the readable id
                # to the frozen artifact digest as well.
                "id": f"{artifact_stem[:48]}-{sha256[:12]}",
                "path": path,
                "kind": "huggingface.file",
                "repository": f"https://huggingface.co/{args.repository}",
                "revision": revision,
                "sha256": sha256,
                "download_bytes": size,
                "installed_bytes": size,
                "roles": _roles(path),
            }
        )
    artifacts.sort(key=lambda item: str(item["path"]))
    if not artifacts:
        raise SystemExit("Hugging Face model has no file artifacts")
    total_bytes = sum(int(item["download_bytes"]) for item in artifacts)

    group_path = root / "model-groups" / f"{args.model_group_slug}.json"
    group_path.parent.mkdir(parents=True, exist_ok=True)
    if group_path.exists():
        group = json.loads(group_path.read_text())
    else:
        group = {
            "schema_version": 1,
            "kind": "model-group",
            "identity": {"publisher": args.publisher, "slug": args.model_group_slug},
            "metadata": {
                "title": args.model_group_title,
                "description": args.model_group_description,
            "tags": list(dict.fromkeys([args.publisher, args.model_group_slug, args.modality])),
            },
            "family": args.model_group_slug,
        }
        group_path.write_text(json.dumps(group, indent=2) + "\n")
    group_hash = _content_hash(group_path)

    model_path = root / "models" / f"{args.model_slug}.json"
    model_path.parent.mkdir(parents=True, exist_ok=True)
    model = {
        "schema_version": 1,
        "kind": "model",
        "identity": {"publisher": args.publisher, "slug": args.model_slug},
        "metadata": {
            "title": args.model_title,
            "description": args.model_description,
            "tags": list(dict.fromkeys([args.publisher, args.model_group_slug, args.modality])),
        },
        "model_group": {
            "kind": "model-group",
            "publisher": args.publisher,
            "slug": args.model_group_slug,
            "content_sha256": group_hash,
        },
        "architecture": args.architecture,
    }
    model_path.write_text(json.dumps(model, indent=2) + "\n")
    model_hash = _content_hash(model_path)

    version_path = root / "model-versions" / f"{args.version_slug}.json"
    version_path.parent.mkdir(parents=True, exist_ok=True)
    version = {
        "schema_version": 1,
        "kind": "model-version",
        "identity": {"publisher": args.publisher, "slug": args.version_slug},
        "metadata": {
            "title": args.version,
            "description": f"Exact public {args.version} checkpoint.",
            "tags": list(
                dict.fromkeys(
                    [args.publisher, args.model_group_slug, args.modality, "candidate"]
                )
            ),
        },
        "model": {
            "kind": "model",
            "publisher": args.publisher,
            "slug": args.model_slug,
            "content_sha256": model_hash,
        },
        "version": args.version,
        "source": {"repository": f"https://huggingface.co/{args.repository}", "revision": revision},
        "lineage": {
            "publisher": args.publisher,
            "relation": "official",
            "source_model": {
                "kind": "model",
                "publisher": args.publisher,
                "slug": args.model_slug,
                "content_sha256": model_hash,
            },
            "derivation": "Official upstream checkpoint at the pinned revision.",
        },
        "format": {"container": "safetensors", "precision": args.precision, "quantization": args.quantization},
        "parameters": {"total": args.parameters_total, "active": args.parameters_active},
        "limits": {"context_tokens": args.context_tokens},
        "sizes": {"download_bytes": total_bytes, "installed_bytes": total_bytes},
        "license": {
            "spdx": args.license_spdx,
            "url": args.license_url,
            "attribution": args.attribution,
            "operator_acceptance_required": args.operator_acceptance_required,
        },
        "access": {"visibility": "public", "gated": False, "authentication": "none"},
        "artifacts": artifacts,
        "dependencies": [],
        "availability": "active",
        "supersedes": None,
    }
    version_path.write_text(json.dumps(version, indent=2) + "\n")
    print(json.dumps({"revision": revision, "model_sha256": model_hash, "version_sha256": _content_hash(version_path), "bytes": total_bytes}, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
