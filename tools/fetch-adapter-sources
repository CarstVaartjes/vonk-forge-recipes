#!/usr/bin/env python3
"""Place every file adapter-sources.json declares, fetching missing blobs by digest."""

import argparse
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "contracts" / "src"))
sys.path.insert(0, str(ROOT / "src"))
from recipe_tooling.adapter_sources import AdapterSourceError, materialize

argparse.ArgumentParser(description=__doc__).parse_args()
try:
    count = materialize()
except AdapterSourceError as error:
    sys.exit(f"adapter sources: {error}")
print(f"placed {count} declared adapter source files")
