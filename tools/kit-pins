def declarations(manifest: dict[str, Any]) -> list[Declaration]:
    """The kit's declared dependencies from an adapter manifest (empty: not a kit adapter)."""
    block = manifest.get("kit")
    if block is None:
        return []
    found: list[Declaration] = []
    for name, entry in sorted(block.get("dependencies", {}).items()):
        required = {"datasource", "file", "pattern"}
        missing = required - set(entry)
        if missing:
            raise KitError(
                f"kit dependency '{name}' lacks {', '.join(sorted(missing))}"
            )
        if entry["datasource"] not in DATASOURCES:
            raise KitError(
                f"kit dependency '{name}': unknown datasource '{entry['datasource']}'"
            )
        override = entry.get("override")
        if override is not None and (
            not override.get("reason")
            or not any(override.get(key) for key in OVERRIDE_VALUES)
        ):
            raise KitError(
                f"kit dependency '{name}': an override needs a ref (or commit, revision, "
                "digest) and a reason"
            )
        try:
            compiled = re.compile(entry["pattern"], re.MULTILINE)
        except re.error as error:
            raise KitError(
                f"kit dependency '{name}': invalid pattern: {error}"
            ) from error
        if "version" not in compiled.groupindex:
            raise KitError(
                f"kit dependency '{name}': the pattern has no (?P<version>...) group"
            )
        # The repository is declared in exactly one place: the manifest, a repo_pattern,
        # or a repo group of the pattern itself.
        places = [
            place
            for place, given in (
                ("repo", "repo" in entry),
                ("repo_pattern", "repo_pattern" in entry),
                ("a (?P<repo>...) group in pattern", "repo" in compiled.groupindex),
            )
            if given
        ]
        if len(places) > 1:
            raise KitError(
                f"kit dependency '{name}': the repository is given by {' and '.join(places)}; "
                "give one"
            )
        if not places:
            raise KitError(
                f"kit dependency '{name}' lacks repo (or repo_pattern, or a "
                "(?P<repo>...) group in pattern)"
            )
        if "repo_pattern" in entry:
            try:
                repo_compiled = re.compile(entry["repo_pattern"], re.MULTILINE)
            except re.error as error:
                raise KitError(
                    f"kit dependency '{name}': invalid repo_pattern: {error}"
                ) from error
            if "repo" not in repo_compiled.groupindex:
                raise KitError(
                    f"kit dependency '{name}': the repo_pattern has no (?P<repo>...) group"
                )
        binds = entry.get("binds")
        if entry["datasource"] == "hf-revision" and not binds:
            raise KitError(
                f"kit dependency '{name}': an hf-revision names the recipe model it pins "
                "(binds: the models[].id)"
            )
        if binds and entry["datasource"] != "hf-revision":
            raise KitError(
                f"kit dependency '{name}': binds is for an hf-revision, not "
                f"{entry['datasource']}"
            )
        found.append(
            Declaration(
                name,
                entry.get("repo", ""),
                entry["datasource"],
                entry["file"],
                entry["pattern"],
                override,
                entry.get("repo_pattern"),
                binds,
            )
        )
    return found


def parse_pairs(text: str, declaration: Declaration) -> set[tuple[str | None, str]]:
    """Every distinct ``(repo or None, version)`` the pattern matches in the text."""
    return {
        (m.groupdict().get("repo"), m.group("version"))
        for m in re.finditer(declaration.pattern, text, re.MULTILINE)
    }


def parse_declared(text: str, declaration: Declaration) -> str:
    matches = {version for _, version in parse_pairs(text, declaration)}
    if not matches:
        raise KitError(
            f"kit dependency '{declaration.name}': nothing in {declaration.file} matches "
            "its pattern at the pinned kit commit"
        )
    if len(matches) > 1:
        raise KitError(
            f"kit dependency '{declaration.name}': {declaration.file} declares several "
            f"values ({', '.join(sorted(matches))}); narrow the pattern"
        )
    return next(iter(matches))


def parse_repo(text: str, declaration: Declaration) -> str:
    """The dependency's repository: the manifest's ``repo``, or what the kit declares."""
    if declaration.repo_in_pattern:
        repos = {repo for repo, _ in parse_pairs(text, declaration)}
    elif declaration.repo_pattern is not None:
        repos = {
            m.group("repo")
            for m in re.finditer(declaration.repo_pattern, text, re.MULTILINE)
        }
    else:
        return declaration.repo
    if not repos:
        raise KitError(
            f"kit dependency '{declaration.name}': nothing in {declaration.file} matches "
            "its repo_pattern at the pinned kit commit"
        )
    named = {_repository(declaration.datasource, str(repo)) for repo in repos}
    if len(named) > 1:
        raise KitError(
            f"kit dependency '{declaration.name}': {declaration.file} declares several "
            f"repositories ({', '.join(sorted(named))}); narrow the "
            f"{'pattern' if declaration.repo_in_pattern else 'repo_pattern'}"
        )
    return next(iter(named))


def _repository(datasource: str, value: str) -> str:
    """The canonical repository name of a declared value, for its datasource."""
    value = value.strip().rstrip("/")
    if datasource == "git-ref":
        return _owner_name(value)
    if datasource == "hf-revision":
        value = re.sub(r"^https?://huggingface\.co/", "", value)
        if not re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", value):
            raise KitError(f"'{value}' is not a Hugging Face repository (owner/name)")
        return value
    value = re.sub(r"^(?:docker://|https?://)", "", value)
    if not re.fullmatch(r"[a-z0-9][a-z0-9._:/-]*[a-z0-9]", value) or "@" in value:
        raise KitError(f"'{value}' is not an image repository (registry/name)")
    return value


def _owner_name(value: str) -> str:
    """``owner/name`` from a GitHub URL (``.git`` and trailing slash allowed) or itself."""
    value = value.strip().rstrip("/").removesuffix(".git")
    value = re.sub(r"^(?:https?://|git@)github\.com[/:]", "", value)
    if not re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", value):
        raise KitError(f"'{value}' is not a GitHub repository")
    return value


def read_declared(
    source: Upstream, kit_repo: str, kit_commit: str, declaration: Declaration
) -> tuple[str, str, str | None]:
    """``(repo, ref, override reason)`` the kit declares at ``kit_commit``."""
    text = source.github.read(kit_repo, kit_commit, declaration.file)
    override = declaration.override
    if override is not None:
        repo = override.get("repo")
        repo = (
            _repository(declaration.datasource, repo)
            if repo
            else parse_repo(text, declaration)
        )
        ref = next(override[key] for key in OVERRIDE_VALUES if override.get(key))
        return repo, ref, override["reason"]
    return parse_repo(text, declaration), parse_declared(text, declaration), None


def resolve(
    source: Upstream, declaration: Declaration, repo: str, ref: str
) -> tuple[str, str, str]:
    """``(immutable value, date, kind)`` of a declared ref, resolved once."""
    if declaration.datasource == "git-ref":
        commit, date = source.github.resolve(repo, ref)
        return commit, date, source.github.kind(repo, ref)
    if declaration.datasource == "hf-revision":
        hub = source.hf()
        revision, date = hub.resolve(repo, ref)
        return revision, date, hub.kind(repo, ref)
    registry = source.oci()
    return (
        registry.resolve(repo, ref),
        "",
        "digest" if IMAGE_DIGEST.match(ref) else "tag",
    )


def derive(
    kit_repo: str,
    kit_commit: str,
    wanted: Iterable[Declaration],
    source: Upstream,
) -> list[Pin]:
    """Resolve what the kit declares at ``kit_commit`` to immutable values."""
    pins: list[Pin] = []
    for declaration in wanted:
        repo, ref, reason = read_declared(source, kit_repo, kit_commit, declaration)
        immutable, date, kind = resolve(source, declaration, repo, ref)
        pins.append(
            Pin(
                declaration.name,
                repo,
                ref,
                immutable,
                date,
                kind,
                reason,
                declaration.datasource,
            )
        )
    return pins


def newest_release(source: GitHub, repo: str) -> str | None:
    """The repository's newest version tag, for information in issues only."""
    try:
        tags = source.api(f"repos/{repo}/tags?per_page=100")
    except (RuntimeError, KeyError):
        return None
    best: tuple[tuple[int, ...], str] | None = None
    for tag in tags:
        match = re.match(r"^v?(\d+(?:\.\d+)*)$", str(tag.get("name", "")))
        if match is None:
            continue
        key = tuple(int(part) for part in match.group(1).split("."))
        if best is None or key > best[0]:
            best = (key, tag["name"])
    return None if best is None else best[1]


def newest_information(source: Upstream, pin: Pin) -> str | None:
    """What the dependency's own channel offers now, for information only.

    The pin follows the kit's declaration: this is never a candidate.
    """
    if pin.datasource == "git-ref":
        newest = newest_release(source.github, pin.repo)
        return f"{pin.repo} newest release `{newest}`" if newest else None
    if pin.datasource == "hf-revision" and source.hub is not None:
        head = source.hub.head(pin.repo)
        return f"{pin.repo} newest revision `{head[:12]}`" if head else None
    return None


# ---------------------------------------------------------------------------
# The lock
# ---------------------------------------------------------------------------


def lock_document(
    kit_repo: str, kit_commit: str, pins: Iterable[Pin]
) -> dict[str, Any]:
    dependencies: dict[str, Any] = {}
    for pin in pins:
        entry: dict[str, Any] = {
            "datasource": pin.datasource,
            "repo": pin.repo,
            "ref": pin.ref,
            "kind": pin.kind,
            pin.key: pin.immutable,
        }
        if pin.overridden:
            entry["overridden"] = pin.overridden
        dependencies[pin.name] = entry
    return {
        "dependencies": dependencies,
        "kit": {"commit": kit_commit, "repo": kit_repo},
    }


def lock_text(document: dict[str, Any]) -> str:
    return json.dumps(document, indent=2, sort_keys=True, ensure_ascii=False) + "\n"


def read_lock(adapter: Path) -> dict[str, Any] | None:
    path = adapter / LOCK
    return json.loads(path.read_text(encoding="utf-8")) if path.is_file() else None


def locked_base(adapter: Path) -> tuple[str, str] | None:
    """``(repo, commit)`` of the lock's ``base`` dependency, for readers of the old ``source``."""
    lock = read_lock(adapter)
    entry = None if lock is None else lock.get("dependencies", {}).get("base")
    return None if entry is None else (entry["repo"], entry["commit"])


def kit_of(recipe: dict[str, Any]) -> tuple[str, str] | None:
    reference = recipe.get("provenance", {}).get("source_reference")
    match = GITHUB_REFERENCE.match(reference) if isinstance(reference, str) else None
    return None if match is None else (match.group(1), match.group(2))


def adapter_of(root: Path, recipe: dict[str, Any]) -> Path | None:
    path = recipe.get("execution", {}).get("build", {}).get("context", {}).get("path")
    return None if not path else root / path


def manifest_of(adapter: Path) -> dict[str, Any]:
    path = adapter / MANIFEST
    return json.loads(path.read_text(encoding="utf-8")) if path.is_file() else {}


# ---------------------------------------------------------------------------
# Consumers: what follows a pin
# ---------------------------------------------------------------------------

ARCHIVE_NAME = re.compile(r"^(?P<stem>.+)-(?P<commit>[0-9a-f]{40})\.tar\.gz$")
ARCHIVE_DIGEST = re.compile(
    r'echo "(?P<digest>[0-9a-f]{64})  [^"]+"\s*\|\s*sha256sum -c'
)
FROM_LINE = re.compile(
    r"^(?P<lead>[ \t]*FROM[ \t]+(?:--\S+[ \t]+)*)(?P<image>\S+)",
    re.MULTILINE | re.IGNORECASE,
)


def base_consumers(adapter: Path, pin: Pin) -> list[str]:
    """What the files that consume the base pin say; empty when they follow it."""
    problems: list[str] = []
    dockerfile = adapter / "Dockerfile"
    text = dockerfile.read_text(encoding="utf-8") if dockerfile.is_file() else ""
    archives = (
        sorted((adapter / "vendor").glob("*.tar.gz"))
        if (adapter / "vendor").is_dir()
        else []
    )
    if archives:
        named = [
            a
            for a in archives
            if (m := ARCHIVE_NAME.match(a.name)) and m["commit"] == pin.immutable
        ]
        if not named:
            problems.append(
                f"vendor/ holds {', '.join(a.name for a in archives)}, not an archive of the "
                f"locked {pin.repo} commit {pin.immutable}"
            )
        elif len(archives) > 1:
            problems.append(
                "vendor/ holds more than one archive; keep only the locked one"
            )
        else:
            digest = hashlib.sha256(named[0].read_bytes()).hexdigest()
            found = ARCHIVE_DIGEST.search(text)
            if found is None or found["digest"] != digest:
                problems.append(
                    f"Dockerfile does not verify {named[0].name} with its sha256 {digest}"
                )
            if f"vendor/{named[0].name}" not in text:
                problems.append(f"Dockerfile does not COPY vendor/{named[0].name}")
    revision = re.search(r'org\.opencontainers\.image\.revision="([^"]+)"', text)
    if revision is not None and revision.group(1) != pin.immutable:
        problems.append(
            f"Dockerfile's image revision label is {revision.group(1)}, not the locked "
            f"commit {pin.immutable}"
        )
    elif pin.immutable not in text:
        problems.append(f"Dockerfile does not name the locked commit {pin.immutable}")
    return problems


def _document(path: Path) -> dict[str, Any] | None:
    return json.loads(path.read_text(encoding="utf-8")) if path.is_file() else None


def bound_model(
    root: Path, recipe: dict[str, Any], model_id: str
) -> tuple[dict[str, Any], dict[str, Any]] | None:
    """``(the recipe's model reference, its catalogued Model document)`` for a ``models[].id``."""
    for reference in recipe.get("models", []):
        if reference.get("id") == model_id:
            document = _document(root / "models" / f"{reference['model']['slug']}.json")
            return None if document is None else (reference, document)
    return None


def model_matches(document: dict[str, Any], repo: str, revision: str) -> bool:
    source = document.get("source") or {}
    return (
        str(source.get("repository", "")).lower()
        == f"https://huggingface.co/{repo}".lower()
        and source.get("revision") == revision
    )


def model_consumers(
    root: Path, recipe: dict[str, Any], declaration: Declaration, pin: Pin
) -> list[str]:
    """Why the bound Model is not the repository and revision the kit locks."""
    assert declaration.binds is not None
    found = bound_model(root, recipe, declaration.binds)
    if found is None:
        return [
            (
                f"the recipe selects no Model '{declaration.binds}' (or it is not "
                f"catalogued) for the kit's {declaration.name} "
                f"({pin.repo}@{pin.immutable[:12]})"
            )
        ]
    reference, document = found
    if model_matches(document, pin.repo, pin.immutable):
        return []
    source = document.get("source") or {}
    was = str(source.get("repository", "?")).removeprefix("https://huggingface.co/")
    return [
        (
            f"the recipe's Model '{declaration.binds}' ({reference['model']['slug']}) is "
            f"{was}@{str(source.get('revision', '?'))[:12]}, but the kit locks "
            f"{pin.repo}@{pin.immutable[:12]}; catalogue that revision "
            f"(tools/catalog-hf-model --repository {pin.repo} --revision {pin.immutable}) "
            "and run tools/kit-pins lock"
        )
    ]


def split_image(image: str) -> tuple[str, str | None, str | None]:
    """``(repository, tag, digest)`` of an image reference."""
    name, _, digest = image.partition("@")
    colon, slash = name.rfind(":"), name.rfind("/")
    if colon > slash:
        return name[:colon], name[colon + 1 :], digest or None
    return name, None, digest or None


def image_reference(pin: Pin, written: str) -> str:
    """The image reference of a pin, in the form ``written`` has it.

    A reference that names a tag keeps naming it (the locked tag); a digest-only
    reference stays digest-only.
    """
    repo, tag, _ = split_image(written)
    if tag is not None and pin.kind == "tag":
        return f"{repo}:{pin.ref}@{pin.immutable}"
    return f"{repo}@{pin.immutable}"


def image_consumers(adapter: Path, recipe: dict[str, Any], pin: Pin) -> list[str]:
    """Why the Dockerfile and the recipe's base image are not the locked image."""
    problems: list[str] = []
    dockerfile = adapter / "Dockerfile"
    text = dockerfile.read_text(encoding="utf-8") if dockerfile.is_file() else ""
    named = [
        m["image"]
        for m in FROM_LINE.finditer(text)
        if "$" not in m["image"]
        and split_image(m["image"])[0].lower() == pin.repo.lower()
    ]
    if not named:
        problems.append(f"Dockerfile has no FROM of the kit's image {pin.repo}")
    for image in named:
        if image != image_reference(pin, image):
            problems.append(
                f"Dockerfile's FROM {image} is not the kit's locked image "
                f"{image_reference(pin, image)}"
            )
    base = recipe.get("execution", {}).get("build", {}).get("base_image") or {}
    if str(base.get("repository", "")).lower() == pin.repo.lower():
        locked = pin.immutable.removeprefix("sha256:")
        if base.get("digest") != locked:
            problems.append(
                f"the recipe's base_image digest is {base.get('digest')}, not the locked {locked}"
            )
    return problems


def consumers(
    root: Path,
    adapter: Path,
    recipe: dict[str, Any],
    declaration: Declaration,
    pin: Pin,
) -> list[str]:
    """What consumes a locked pin and does not follow it, for each datasource."""
    if pin.datasource == "hf-revision":
        return model_consumers(root, recipe, declaration, pin)
    if pin.datasource == "oci-image":
        return image_consumers(adapter, recipe, pin)
    return base_consumers(adapter, pin) if pin.name == "base" else []


# ---------------------------------------------------------------------------
# Check ("is the lock up to date")
# ---------------------------------------------------------------------------


def declares_base(wanted: Iterable[Declaration]) -> bool:
    """Whether the kit declares the base the adapter's vendored files come from."""
    return any(d.name == "base" and d.datasource == "git-ref" for d in wanted)


def lock_difference(lock: dict[str, Any], expected: dict[str, Any]) -> str:
    """What differs between a committed lock and the one its kit declaration yields."""
    parts: list[str] = []
    if lock.get("kit") != expected["kit"]:
        parts.append(
            f"the lock is for kit {lock.get('kit', {}).get('commit', '?')[:12]}"
        )
    old, new = lock.get("dependencies", {}), expected["dependencies"]
    for name in sorted(set(old) | set(new)):
        if old.get(name) == new.get(name):
            continue
        fields = sorted(
            key
            for key in set(old.get(name) or {}) | set(new.get(name) or {})
            if (old.get(name) or {}).get(key) != (new.get(name) or {}).get(key)
        )
        parts.append(f"'{name}' differs in {', '.join(fields) or 'its presence'}")
    return "which declares otherwise: " + "; ".join(parts)


def check_recipe(
    root: Path, recipe_id: str, recipe: dict[str, Any], source: Upstream
) -> list[str]:
    """Reasons the recipe's committed lock is not what its kit declares ([] when current)."""
    adapter = adapter_of(root, recipe)
    if adapter is None or not (adapter / MANIFEST).is_file():
        return []
    manifest = manifest_of(adapter)
    try:
        wanted = declarations(manifest)
    except KitError as error:
        return [f"{recipe_id}: {error}"]
    if not wanted:
        return []
    label = f"{recipe_id}"
    kit = kit_of(recipe)
    if kit is None:
        return [
            f"{label}: the recipe does not pin a kit commit (provenance.source_reference)"
        ]
    problems: list[str] = []
    if "source" in manifest and declares_base(wanted):
        problems.append(
            f"{label}: {MANIFEST} keeps a hand-authored 'source' pin beside the kit "
            "declaration; remove it (the lock derives it), or use an explicit override"
        )
    lock = read_lock(adapter)
    if lock is None:
        return problems + [f"{label}: no {LOCK}; run tools/kit-pins lock {recipe_id}"]
    try:
        # Offline in the resolving direction: the lock's own value is used for the pin, so
        # only the declaring file at the pinned kit commit is fetched.
        pins = []
        for declaration in wanted:
            locked = lock.get("dependencies", {}).get(declaration.name)
            if locked is None:
                problems.append(f"{label}: {LOCK} lacks '{declaration.name}'")
                continue
            repo, ref, reason = read_declared(source, kit[0], kit[1], declaration)
            pins.append(
                Pin(
                    declaration.name,
                    repo,
                    ref,
                    locked.get(IMMUTABLE_KEYS[declaration.datasource], ""),
                    "",
                    locked.get("kind", ""),
                    reason,
                    declaration.datasource,
                )
            )
        expected = lock_document(kit[0], kit[1], pins)
        if lock != expected:
            problems.append(
                f"{label}: {LOCK} is stale: the recipe pins kit {kit[0]}@{kit[1][:12]}, "
                f"{lock_difference(lock, expected)}; run tools/kit-pins lock {recipe_id}"
            )
    except KitError as error:
        problems.append(f"{label}: {error}")
        return problems
    by_name = {d.name: d for d in wanted}
    for pin in pins:
        problems.extend(
            f"{label}: {p}"
            for p in consumers(root, adapter, recipe, by_name[pin.name], pin)
        )
    return problems


# ---------------------------------------------------------------------------
# Lock (write)
# ---------------------------------------------------------------------------


def download_archive(repo: str, commit: str) -> bytes:
    url = f"https://codeload.github.com/{repo}/tar.gz/{commit}"
    request = urllib.request.Request(url, headers={"User-Agent": "vonk-forge-recipes"})
    try:
        with urllib.request.urlopen(request, timeout=120) as response:
            data = response.read(MAX_ARCHIVE_BYTES + 1)
    except (urllib.error.HTTPError, urllib.error.URLError) as error:
        raise KitError(f"cannot fetch {url}: {error}") from error
    if len(data) > MAX_ARCHIVE_BYTES:
        raise KitError(f"{url} is larger than {MAX_ARCHIVE_BYTES} bytes")
    return data


def recipe_text(recipe: dict[str, Any]) -> str:
    return json.dumps(recipe, indent=2, sort_keys=True, ensure_ascii=False) + "\n"


def apply_lock(
    root: Path,
    recipe_id: str,
    recipe: dict[str, Any],
    source: Upstream,
    fetch_archive: Callable[[str, str], bytes] = download_archive,
) -> list[str]:
    """Write ``kit-lock.json`` and move the consumers to it; returns what changed."""
    adapter = adapter_of(root, recipe)
    kit = kit_of(recipe)
    if adapter is None or kit is None:
        raise KitError(f"{recipe_id}: no adapter directory or kit commit")
    manifest = manifest_of(adapter)
    wanted = declarations(manifest)
    if not wanted:
        raise KitError(f"{recipe_id}: {MANIFEST} declares no kit dependencies")
    pins = derive(kit[0], kit[1], wanted, source)
    changed: list[str] = []
    previous = locked_base(adapter) or (
        (manifest["source"]["repo"], manifest["source"]["commit"])
        if "source" in manifest
        else None
    )
    new = lock_text(lock_document(kit[0], kit[1], pins))
    lock_path = adapter / LOCK
    if not lock_path.is_file() or lock_path.read_text(encoding="utf-8") != new:
        lock_path.write_text(new, encoding="utf-8")
        changed.append(LOCK)
    if "source" in manifest and declares_base(wanted):
        del manifest["source"]
        (adapter / MANIFEST).write_text(
            json.dumps(manifest, indent=2, sort_keys=True, ensure_ascii=False) + "\n",
            encoding="utf-8",
        )
        changed.append(f"{MANIFEST} (hand-authored source pin removed)")
    by_name = {d.name: d for d in wanted}
    current = recipe
    for pin in pins:
        if pin.datasource == "git-ref" and pin.name == "base":
            changed.extend(_move_consumers(adapter, previous, pin, kit, fetch_archive))
        elif pin.datasource == "hf-revision":
            current, moved = _rebind_model(
                root, current, by_name[pin.name], pin, source
            )
            changed.extend(moved)
        elif pin.datasource == "oci-image":
            current, moved = _move_image(adapter, current, pin)
            changed.extend(moved)
    if current != recipe:
        (root / "recipes" / f"{recipe_id}.json").write_text(
            recipe_text(current), encoding="utf-8"
        )
        changed.append(f"recipes/{recipe_id}.json")
    return changed


def _move_consumers(
    adapter: Path,
    previous: tuple[str, str] | None,
    base: Pin,
    kit: tuple[str, str],
    fetch_archive: Callable[[str, str], bytes],
) -> list[str]:
    changed: list[str] = []
    dockerfile = adapter / "Dockerfile"
    if not dockerfile.is_file():
        return changed
    text = dockerfile.read_text(encoding="utf-8")
    original = text
    vendor = adapter / "vendor"
    old_archives = sorted(vendor.glob("*.tar.gz")) if vendor.is_dir() else []
    if old_archives:
        named = next((a for a in old_archives if base.immutable in a.name), None)
        if named is None:
            template = ARCHIVE_NAME.match(old_archives[0].name)
            stem = template["stem"] if template else old_archives[0].name.split(".")[0]
            data = fetch_archive(base.repo, base.immutable)
            named = vendor / f"{stem}-{base.immutable}.tar.gz"
            named.write_bytes(data)
            changed.append(f"vendor/{named.name} (new base archive)")
        digest = hashlib.sha256(named.read_bytes()).hexdigest()
        for old in old_archives:
            if old == named:
                continue
            old_digest = hashlib.sha256(old.read_bytes()).hexdigest()
            old_commit = ARCHIVE_NAME.match(old.name)
            text = text.replace(old.name, named.name).replace(old_digest, digest)
            if old_commit:
                text = text.replace(old_commit["commit"], base.immutable)
            old.unlink()
            changed.append(f"vendor/{old.name} (removed)")
        found = ARCHIVE_DIGEST.search(text)
        if found and found["digest"] != digest:
            text = text.replace(found["digest"], digest)
    if previous is not None and previous[1] != base.immutable:
        text = text.replace(previous[1], base.immutable)
    # the kit's own commit, where the Dockerfile cites it (a recipe-patches source label)
    cited = re.search(
        rf"github\.com/{re.escape(kit[0])}/tree/(?P<commit>[0-9a-f]{{40}})", text
    )
    if cited and cited["commit"] != kit[1]:
        text = text.replace(cited["commit"], kit[1])
    if text != original:
        dockerfile.write_text(text, encoding="utf-8")
        changed.append(
            "Dockerfile (pins; review its header comment and licence labels)"
        )
    return changed


def file_id(path: str, sha256: str) -> str:
    """The id ``tools/catalog-hf-model`` gives a file: readable stem, content and path digests."""
    value = path.rsplit("/", 1)[-1].rsplit(".", 1)[0]
    stem = value.lower().replace("_", "-").replace(".", "-") if value else "metadata"
    if not stem[:1].isalpha():
        stem = f"file-{stem}"
    return f"{stem[:39]}-{sha256[:12]}-{hashlib.sha256(path.encode()).hexdigest()[:10]}"


def moved_model(
    old: dict[str, Any], inventory: list[dict[str, Any]], revision: str
) -> dict[str, Any]:
    """The Model document ``old`` moved to the snapshot ``inventory`` of ``revision``.

    The curation is kept: identity, licence, capabilities, and the files the document
    kept (a file the snapshot no longer has is dropped). A file the snapshot adds is
    catalogued unless it is metadata (a README), as the old document may have left such
    files out on purpose. The slug, version and variant follow the revision.
    """
    sys.path.insert(0, str(ROOT / "contracts" / "src"))
    from vonk_forge_contracts import ModelDefinition

    by_path = {f["path"]: f for f in inventory}
    document = json.loads(json.dumps(old))
    old_revision = old["source"]["revision"]
    document["source"]["revision"] = revision
    identity = document["identity"]
    slug = identity["slug"]
    if slug.endswith(old_revision[:8]):
        identity["slug"] = slug[: -len(old_revision[:8])] + revision[:8]
    elif not slug.endswith(revision[:8]):
        identity["slug"] = f"{slug}-{revision[:8]}"
    for key in ("version", "variant"):
        if isinstance(identity.get(key), str) and old_revision[:8] in identity[key]:
            identity[key] = identity[key].replace(old_revision[:8], revision[:8])
    known = {entry["path"] for entry in old["files"]}
    files = [dict(entry) for entry in old["files"] if entry["path"] in by_path]
    for path in sorted(set(by_path) - known):
        if by_path[path]["roles"] != ["metadata"]:
            files.append({"path": path, "roles": by_path[path]["roles"]})
    for entry in files:
        fresh = by_path[entry["path"]]
        entry["sha256"] = fresh["sha256"]
        entry["size_bytes"] = fresh["installed_bytes"]
        entry["id"] = file_id(entry["path"], fresh["sha256"])
    document["files"] = sorted(files, key=lambda entry: entry["path"])
    ModelDefinition.model_validate(document)
    return document


def catalogued_model(root: Path, repo: str, revision: str) -> dict[str, Any] | None:
    """The Model document of a Hugging Face repository at a revision, when catalogued."""
    for path in sorted((root / "models").glob("*.json")):
        document = json.loads(path.read_text(encoding="utf-8"))
        if model_matches(document, repo, revision):
            return document
    return None


def selection_id(model_id: str, example: dict[str, Any], file_id: str) -> str:
    """The id of a selected file, spelled as the recipe spells its other ones.

    A selected file's id is its file id behind a prefix (often the model's role), cut to
    the contract's bound; the example selected file shows the prefix.
    """
    old = example["file_id"]
    for length in range(len(old), 0, -1):
        if example["id"].endswith(old[:length]):
            prefix = example["id"][: len(example["id"]) - length]
            return (prefix + file_id)[:MAX_SELECTION_ID]
    return f"{model_id}-{file_id}"[:MAX_SELECTION_ID]


def rebind(
    recipe: dict[str, Any], model_id: str, old: dict[str, Any], new: dict[str, Any]
) -> dict[str, Any]:
    """The recipe with its Model ``model_id`` moved from the ``old`` document to ``new``.

    A recipe that mounts every file of the old Model mounts every file of the new one (a
    repository switch has no file in common); otherwise each selected file is followed by
    its path and one the new Model lacks is an error. The disk envelope follows the size
    of what is selected.
    """
    document = json.loads(json.dumps(recipe))
    reference = next(m for m in document["models"] if m["id"] == model_id)
    old_by_id = {f["id"]: f for f in old["files"]}
    chosen = [old_by_id[f["file_id"]] for f in reference["files"]]
    new_by_path = {f["path"]: f for f in new["files"]}
    if {f["id"] for f in chosen} == set(old_by_id):
        shapes = {
            json.dumps([f["mount"], f["roles"]], sort_keys=True)
            for f in reference["files"]
        }
        if len(shapes) != 1:
            raise KitError(
                f"Model '{model_id}' mounts every file, but not all the same way; "
                "rebind it by hand"
            )
        template = reference["files"][0]
        targets = list(new["files"])
    else:
        missing = [f["path"] for f in chosen if f["path"] not in new_by_path]
        if missing:
            raise KitError(
                f"the recipe selects files the new Model lacks: {', '.join(missing[:5])}"
            )
        template = None
        targets = [new_by_path[f["path"]] for f in chosen]
    selected = []
    for item in targets:
        if template is not None:
            entry = {
                "file_id": item["id"],
                "id": selection_id(model_id, template, item["id"]),
                "mount": template["mount"],
                "roles": template["roles"],
            }
        else:
            old_entry = next(
                e
                for e in reference["files"]
                if old_by_id[e["file_id"]]["path"] == item["path"]
            )
            entry = dict(
                old_entry,
                file_id=item["id"],
                id=selection_id(model_id, old_entry, item["id"]),
            )
        selected.append(entry)
    if len({e["id"] for e in selected}) != len(selected):
        raise KitError(
            f"Model '{model_id}': selected file ids collide once cut to 64 characters"
        )
    reference["files"] = selected
    reference["model"]["slug"] = new["identity"]["slug"]
    reference["model"]["content_sha256"] = model_digest(new)
    delta = sum(f["size_bytes"] for f in targets) - sum(f["size_bytes"] for f in chosen)
    for role in document["topology"]["roles"]:
        role["resources"]["disk"]["artifact_bytes"] += delta
    return document


def model_digest(document: dict[str, Any]) -> str:
    sys.path.insert(0, str(ROOT / "contracts" / "src"))
    from vonk_forge_contracts import document_sha256

    return document_sha256(document)


def _rebind_model(
    root: Path,
    recipe: dict[str, Any],
    declaration: Declaration,
    pin: Pin,
    source: Upstream,
) -> tuple[dict[str, Any], list[str]]:
    assert declaration.binds is not None
    found = bound_model(root, recipe, declaration.binds)
    if found is None:
        raise KitError(
            f"the recipe selects no catalogued Model '{declaration.binds}' for the kit's "
            f"{declaration.name}"
        )
    _, old = found
    if model_matches(old, pin.repo, pin.immutable):
        return recipe, []
    changed: list[str] = []
    new = catalogued_model(root, pin.repo, pin.immutable)
    if new is None:
        old_repo = str((old.get("source") or {}).get("repository", ""))
        if old_repo.lower() != f"https://huggingface.co/{pin.repo}".lower():
            raise KitError(
                f"the kit locks {pin.repo}@{pin.immutable}, another repository than the "
                f"recipe's Model: run tools/catalog-hf-model --repository {pin.repo} "
                f"--revision {pin.immutable} (with its identity, licence and capability "
                "flags), then lock again"
            )
        # another revision of the same repository: the old document's curation moves along
        new = moved_model(
            old, source.hf().inventory(pin.repo, pin.immutable), pin.immutable
        )
        path = root / "models" / f"{new['identity']['slug']}.json"
        path.write_text(
            json.dumps(new, indent=2, sort_keys=True, ensure_ascii=False) + "\n",
            encoding="utf-8",
        )
        changed.append(f"models/{new['identity']['slug']}.json (catalogued)")
    moved = rebind(recipe, declaration.binds, old, new)
    changed.append(f"Model '{declaration.binds}' -> {new['identity']['slug']}")
    slug = old["identity"]["slug"]
    if slug != new["identity"]["slug"] and not any(
        m["model"]["slug"] == slug
        for path in sorted((root / "recipes").glob("*.json"))
        for other in [json.loads(path.read_text(encoding="utf-8"))]
        if other["identity"]["slug"] != recipe["identity"]["slug"]
        for m in other["models"]
    ):
        (root / "models" / f"{slug}.json").unlink()
        changed.append(f"models/{slug}.json (removed: no recipe uses it)")
    return moved, changed


def _move_image(
    adapter: Path, recipe: dict[str, Any], pin: Pin
) -> tuple[dict[str, Any], list[str]]:
    changed: list[str] = []
    dockerfile = adapter / "Dockerfile"
    if dockerfile.is_file():
        text = dockerfile.read_text(encoding="utf-8")

        def move(match: re.Match[str]) -> str:
            image = match["image"]
            if "$" in image or split_image(image)[0].lower() != pin.repo.lower():
                return match[0]
            return match["lead"] + image_reference(pin, image)

        moved = FROM_LINE.sub(move, text)
        if moved != text:
            dockerfile.write_text(moved, encoding="utf-8")
            changed.append("Dockerfile (FROM digest)")
    document = json.loads(json.dumps(recipe))
    base = document.get("execution", {}).get("build", {}).get("base_image")
    if base and str(base.get("repository", "")).lower() == pin.repo.lower():
        base["digest"] = pin.immutable.removeprefix("sha256:")
    return document, changed


