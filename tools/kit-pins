#!/usr/bin/env python3
r"""Derive and check the pins a creator's kit declares (``kit-lock.json``).

A recipe built from a creator's kit (a patch stack, launch scripts, a configuration that
names the base engine version, the model it serves, the image it runs on) pins only the
kit: ``provenance.source_reference``. What the kit builds on is the kit's own statement
at that commit, so this repository does not author a second pin for it. The adapter's
``vendored-upstream.json`` says *where* the kit declares each dependency, in the shape of
a Renovate regex manager::

    "kit": {
      "dependencies": {
        "base": {
          "datasource": "git-ref",
          "repo": "ashhart/TensorFold",
          "file": "scripts/config.sh",
          "pattern": "^TF_VERSION=\"\\$\\{TF_VERSION:-(?P<version>[^}\"]+)\\}\"",
          "override": {"ref": "v0.6.1", "reason": "why this recipe deviates"}
        },
        "model": {
          "datasource": "hf-revision",
          "file": "scripts/config.sh",
          "pattern": "^\\s*(?P<repo>[\\w.-]+/[\\w.-]+)\\) _rev=(?P<version>[0-9a-f]{40}) ;;",
          "binds": "primary"
        }
      }
    }

* ``file`` and ``pattern`` locate the declared value (the named group ``version``) in the
  kit at the pinned commit; exactly one distinct value is required.
* ``datasource`` says what the value names, and is resolved to an immutable value once,
  here, never at build time:

  - ``git-ref``: a tag, branch or commit of a GitHub repository, locked as its commit. A
    declared *branch* is followed like a Nix branch input (``"kind": "branch"``): ``lock``
    resolves the head once; the build and ``check`` use only the locked commit, and the
    refresh scanner reports a moved head as a change of the kit's dependency (a review).
  - ``hf-revision``: a revision (a commit, or a branch or tag) of a Hugging Face model
    repository, locked as its commit. ``binds`` names the recipe model (``models[].id``)
    the kit's pin is for: that model's catalogued document must be this repository at this
    revision, so a model that is not the kit's is rejected. Resolving needs the revision
    to be anonymously readable.
  - ``oci-image``: a tag (or ``sha256:`` digest) of a container image repository, locked as
    the digest of its ``linux/arm64`` manifest (an index is followed to that entry; the
    platform builds and runs on arm64 only). The Dockerfile's ``FROM`` lines of that
    repository and the recipe's ``execution.build.base_image`` must carry the locked digest.
* ``repo`` names the repository the value is of. A kit that also declares *which*
  repository (a fork, a model id, an image) gives either ``repo_pattern`` (a regex with a
  ``(?P<repo>...)`` group, exactly one distinct match in the same file) instead of
  ``repo``, or a ``repo`` group in ``pattern`` itself when one line pairs the two (a shell
  ``case`` on the model id). The lock records the repository with the value, and a kit
  that moves to another repository is a review like a moved ref.
* ``override`` is the only way to deviate from the kit (a known-bad upstream, a security
  fix). It needs a reason, replaces the declaration (``ref``, ``revision`` or ``digest``,
  and ``repo`` when it is another repository); refresh reports it as overridden and
  proposes nothing.

``kit-lock.json`` is the derived, committed result::

    {"kit": {"repo": ..., "commit": ...},
     "dependencies": {"base": {"datasource": "git-ref", "repo": ..., "ref": ..., "kind": ...,
                               "commit": ...},
                      "model": {"datasource": "hf-revision", "repo": ..., "ref": ...,
                                "kind": ..., "revision": ...},
                      "image": {"datasource": "oci-image", "repo": ..., "ref": ..., "kind": ...,
                                "digest": ...}}}

``kind`` says what ``ref`` named when it was locked: ``tag``, ``branch`` or ``commit``
(``digest`` for an image declared by digest).

It is generated by ``tools/kit-pins lock`` and never edited by hand. ``tools/kit-pins
check`` is the "lock is up to date" gate: it re-derives the lock from the kit commit the
recipe pins (one fetch of that exact commit's declaring file; the locked values are not
looked up again) and fails when the committed lock differs, when the adapter keeps a second
hand-authored pin beside a declaration, or when what consumes a pin does not follow the
lock: the Dockerfile's labels and the vendored archive for a ``git-ref`` base, the bound
Model for an ``hf-revision``, the Dockerfile and ``base_image`` for an ``oci-image``.

A recipe may cite its kit with a ``blob`` URL of the declaring file (a playbook's README) as
well as a ``tree`` URL. A kit that is one directory of a creator's monorepo, of which the
recipe uses only the declared values, sets ``"whole": false`` on the ``kit`` block: the
refresh scanner then checks the declarations and judges the repository's other changes as it
does for any source (files the adapter names by URL and patches), not every changed file.

``tools/kit-pins lock <recipe>`` also moves the consumers: it vendors the base archive for
the locked commit and moves the Dockerfile's commit, archive file name and archive
digest; it rebinds the recipe to the catalogued Model of the locked revision (the Model
must be catalogued first, with ``tools/catalog-hf-model``); it moves the image digest in the
Dockerfile and the recipe. Prose in the Dockerfile (a header comment, licence labels) is
the author's to review.
"""

from __future__ import annotations

import base64
import hashlib
import json
import os
import re
import sys
import urllib.error
import urllib.parse
import urllib.request
from collections.abc import Callable, Iterable
from dataclasses import dataclass
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[1]
MANIFEST = "vendored-upstream.json"
LOCK = "kit-lock.json"
SHA = re.compile(r"^[0-9a-f]{40}$")
ABBREVIATED_SHA = re.compile(r"^[0-9a-f]{7,40}$")
IMAGE_DIGEST = re.compile(r"^sha256:[0-9a-f]{64}$")
KINDS = {"tag", "branch", "commit", "digest"}
# The immutable value each datasource resolves to, and the lock key that holds it.
IMMUTABLE_KEYS = {
    "git-ref": "commit",
    "hf-revision": "revision",
    "oci-image": "digest",
}
DATASOURCES = set(IMMUTABLE_KEYS)
GITHUB_REFERENCE = re.compile(
    r"^https://github\.com/([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)"
    r"/(?:tree|blob)/([0-9a-f]{40})(?:/.*)?$"
)
MAX_ARCHIVE_BYTES = 400_000_000
MAX_SELECTION_ID = 64  # the contract bounds a selected file's id
OVERRIDE_VALUES = ("ref", "commit", "revision", "digest")


class KitError(RuntimeError):
    """A declaration cannot be read or derived; the message names what to fix."""


@dataclass(frozen=True, slots=True)
class Declaration:
    name: str
    repo: str
    datasource: str
    file: str
    pattern: str
    override: dict[str, str] | None = None
    repo_pattern: str | None = None  # the repo is declared by the kit too
    binds: str | None = None  # hf-revision: the recipe model (``models[].id``) it pins

    @property
    def repo_in_pattern(self) -> bool:
        return "(?P<repo>" in self.pattern


@dataclass(frozen=True, slots=True)
class Pin:
    """One derived dependency, resolved to an immutable value."""

    name: str
    repo: str
    ref: str
    immutable: str  # a Git commit, a Hugging Face revision or an image digest
    date: str  # committer date of a commit or revision (YYYY-MM-DD); "" for an image
    kind: str = "tag"  # what ``ref`` names: tag, branch, commit or digest
    overridden: str | None = None  # the reason, when the pin is an override
    datasource: str = "git-ref"

    @property
    def version(self) -> str:
        return self.ref.removeprefix("v")

    @property
    def key(self) -> str:
        return IMMUTABLE_KEYS[self.datasource]


