#!/usr/bin/env python3
r"""Derive and check the base pins a creator's kit declares (``kit-lock.json``).

A recipe built from a creator's kit (a patch stack, launch scripts, a configuration that
names the base engine version) pins only the kit: ``provenance.source_reference``. What
the kit builds on is the kit's own statement at that commit, so this repository does not
author a second pin for it. The adapter's ``vendored-upstream.json`` says *where* the kit
declares each dependency, in the shape of a Renovate regex manager::

    "kit": {
      "dependencies": {
        "base": {
          "repo": "ashhart/TensorFold",
          "datasource": "git-ref",
          "file": "scripts/config.sh",
          "pattern": "^TF_VERSION=\"\\$\\{TF_VERSION:-(?P<version>[^}\"]+)\\}\"",
          "override": {"ref": "v0.6.1", "reason": "why this recipe deviates"}
        }
      }
    }

* ``file`` and ``pattern`` locate the declared version (the named group ``version``) in
  the kit at the pinned commit; exactly one match is required.
* ``datasource`` says what the version names. ``git-ref`` is a tag, branch or commit of
  ``repo``; it is resolved to an immutable commit once, here, never at build time.
* ``override`` is the only way to deviate from the kit (a known-bad upstream, a security
  fix). It needs a reason and replaces the declaration; refresh reports it as overridden
  and proposes nothing.

``kit-lock.json`` is the derived, committed result::

    {"kit": {"repo": ..., "commit": ...},
     "dependencies": {"base": {"repo": ..., "ref": ..., "commit": ...}}}

It is generated by ``tools/kit-pins lock`` and never edited by hand. ``tools/kit-pins
check`` is the "lock is up to date" gate: it re-derives the lock from the kit commit the
recipe pins (one fetch of that exact commit's declaring file, no tag lookups) and fails
when the committed lock differs, when the adapter keeps a second hand-authored pin
beside the declaration, or when the files that consume the pin (the Dockerfile's
labels, the vendored archive's name and digest) do not follow the lock.

``tools/kit-pins lock <recipe>`` also vendors the base archive for the locked commit
and moves the pin in the Dockerfile (commit, archive file name, archive digest). Prose in
the Dockerfile (a header comment, licence labels) is the author's to review.
"""

from __future__ import annotations

import base64
import hashlib
import json
import os
import re
import sys
import urllib.error
import urllib.request
from collections.abc import Callable, Iterable
from dataclasses import dataclass
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[1]
MANIFEST = "vendored-upstream.json"
LOCK = "kit-lock.json"
SHA = re.compile(r"^[0-9a-f]{40}$")
DATASOURCES = {"git-ref"}
GITHUB_REFERENCE = re.compile(
    r"^https://github\.com/([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)/tree/([0-9a-f]{40})/?$"
)
MAX_ARCHIVE_BYTES = 400_000_000


class KitError(RuntimeError):
    """A declaration cannot be read or derived; the message names what to fix."""


@dataclass(frozen=True, slots=True)
class Declaration:
    name: str
    repo: str
    datasource: str
    file: str
    pattern: str
    override: dict[str, str] | None = None


@dataclass(frozen=True, slots=True)
class Pin:
    """One derived dependency, resolved to an immutable commit."""

    name: str
    repo: str
    ref: str
    commit: str
    date: str  # committer date of ``commit`` (YYYY-MM-DD)
    overridden: str | None = None  # the reason, when the pin is an override

    @property
    def version(self) -> str:
        return self.ref.removeprefix("v")


# ---------------------------------------------------------------------------
# Upstream access
# ---------------------------------------------------------------------------


class GitHub:
    """Immutable-commit reads through a GitHub API callable (``path -> JSON``)."""

    def __init__(self, api: Callable[[str], Any]) -> None:
        self.api = api

    def read(self, repo: str, commit: str, path: str) -> str:
        try:
            document = self.api(f"repos/{repo}/contents/{path}?ref={commit}")
        except (RuntimeError, KeyError) as error:
            raise KitError(
                f"cannot read {repo}@{commit[:12]}:{path}: {error}"
            ) from error
        if document.get("encoding") != "base64":
            raise KitError(f"{repo}@{commit[:12]}:{path} is not a readable file")
        return base64.b64decode(document["content"]).decode("utf-8", "replace")

    def resolve(self, repo: str, ref: str) -> tuple[str, str]:
        """``(commit, date)`` of a tag, branch or commit (annotated tags dereferenced)."""
        try:
            document = self.api(f"repos/{repo}/commits/{ref}")
        except (RuntimeError, KeyError) as error:
            raise KitError(f"cannot resolve {repo}@{ref}: {error}") from error
        commit = document["sha"]
        if not SHA.match(commit):
            raise KitError(f"{repo}@{ref}: provider returned a non-Git revision")
        return commit, str(document["commit"]["committer"]["date"])[:10]


def cli_source() -> GitHub:
    sys.path.insert(0, str(ROOT / "tools"))
    import importlib.machinery
    import importlib.util

    loader = importlib.machinery.SourceFileLoader(
        "check_vendored_upstream", str(ROOT / "tools" / "check-vendored-upstream")
    )
    spec = importlib.util.spec_from_loader(loader.name, loader)
    assert spec is not None
    vendored = importlib.util.module_from_spec(spec)
    sys.modules[loader.name] = vendored
    loader.exec_module(vendored)
    token = vendored._token()
    cache = Path(
        os.environ.get(
            "VONK_UPSTREAM_CACHE", Path.home() / ".cache" / "vonk-forge-upstream"
        )
    )

    def api(path: str) -> Any:
        # Commits are immutable, so a fetch by commit sha is cached; refs are not.
        match = re.match(
            r"^repos/([^/]+/[^/]+)/contents/(.+)\?ref=([0-9a-f]{40})$", path
        )
        file = None
        if match:
            file = (
                cache
                / "kit"
                / f"{match.group(1).replace('/', '__')}@{match.group(3)}"
                / (match.group(2).replace("/", "__") + ".json")
            )
            if file.is_file():
                return json.loads(file.read_text())
        document = vendored._api(path, token)
        if file is not None:
            file.parent.mkdir(parents=True, exist_ok=True)
            file.write_text(json.dumps(document, sort_keys=True))
        return document

    return GitHub(api)


# ---------------------------------------------------------------------------
# Declarations
# ---------------------------------------------------------------------------


def declarations(manifest: dict[str, Any]) -> list[Declaration]:
    """The kit's declared dependencies from an adapter manifest (empty: not a kit adapter)."""
    block = manifest.get("kit")
    if block is None:
        return []
    found: list[Declaration] = []
    for name, entry in sorted(block.get("dependencies", {}).items()):
        missing = {"repo", "datasource", "file", "pattern"} - set(entry)
        if missing:
            raise KitError(
                f"kit dependency '{name}' lacks {', '.join(sorted(missing))}"
            )
        if entry["datasource"] not in DATASOURCES:
            raise KitError(
                f"kit dependency '{name}': unknown datasource '{entry['datasource']}'"
            )
        override = entry.get("override")
        if override is not None and (
            not override.get("reason")
            or not (override.get("ref") or override.get("commit"))
        ):
            raise KitError(
                f"kit dependency '{name}': an override needs a ref (or commit) and a reason"
            )
        try:
            compiled = re.compile(entry["pattern"], re.MULTILINE)
        except re.error as error:
            raise KitError(
                f"kit dependency '{name}': invalid pattern: {error}"
            ) from error
        if "version" not in compiled.groupindex:
            raise KitError(
                f"kit dependency '{name}': the pattern has no (?P<version>...) group"
            )
        found.append(
            Declaration(
                name,
                entry["repo"],
                entry["datasource"],
                entry["file"],
                entry["pattern"],
                override,
            )
        )
    return found


def parse_declared(text: str, declaration: Declaration) -> str:
    matches = [
        m.group("version") for m in re.finditer(declaration.pattern, text, re.MULTILINE)
    ]
    if not matches:
        raise KitError(
            f"kit dependency '{declaration.name}': nothing in {declaration.file} matches "
            "its pattern at the pinned kit commit"
        )
    if len(set(matches)) > 1:
        raise KitError(
            f"kit dependency '{declaration.name}': {declaration.file} declares several "
            f"values ({', '.join(sorted(set(matches)))}); narrow the pattern"
        )
    return matches[0]


def derive(
    kit_repo: str,
    kit_commit: str,
    wanted: Iterable[Declaration],
    source: GitHub,
) -> list[Pin]:
    """Resolve what the kit declares at ``kit_commit`` to immutable commits."""
    pins: list[Pin] = []
    for declaration in wanted:
        if declaration.override is not None:
            ref = declaration.override.get("ref") or declaration.override["commit"]
            reason: str | None = declaration.override["reason"]
        else:
            ref = parse_declared(
                source.read(kit_repo, kit_commit, declaration.file), declaration
            )
            reason = None
        commit, date = source.resolve(declaration.repo, ref)
        pins.append(Pin(declaration.name, declaration.repo, ref, commit, date, reason))
    return pins


def newest_release(source: GitHub, repo: str) -> str | None:
    """The repository's newest version tag, for information in issues only."""
    try:
        tags = source.api(f"repos/{repo}/tags?per_page=100")
    except (RuntimeError, KeyError):
        return None
    best: tuple[tuple[int, ...], str] | None = None
    for tag in tags:
        match = re.match(r"^v?(\d+(?:\.\d+)*)$", str(tag.get("name", "")))
        if match is None:
            continue
        key = tuple(int(part) for part in match.group(1).split("."))
        if best is None or key > best[0]:
            best = (key, tag["name"])
    return None if best is None else best[1]


# ---------------------------------------------------------------------------
# The lock
# ---------------------------------------------------------------------------


def lock_document(
    kit_repo: str, kit_commit: str, pins: Iterable[Pin]
) -> dict[str, Any]:
    dependencies: dict[str, Any] = {}
    for pin in pins:
        entry: dict[str, Any] = {"repo": pin.repo, "ref": pin.ref, "commit": pin.commit}
        if pin.overridden:
            entry["overridden"] = pin.overridden
        dependencies[pin.name] = entry
    return {
        "dependencies": dependencies,
        "kit": {"commit": kit_commit, "repo": kit_repo},
    }


def lock_text(document: dict[str, Any]) -> str:
    return json.dumps(document, indent=2, sort_keys=True) + "\n"


def read_lock(adapter: Path) -> dict[str, Any] | None:
    path = adapter / LOCK
    return json.loads(path.read_text(encoding="utf-8")) if path.is_file() else None


def locked_base(adapter: Path) -> tuple[str, str] | None:
    """``(repo, commit)`` of the lock's ``base`` dependency, for readers of the old ``source``."""
    lock = read_lock(adapter)
    entry = None if lock is None else lock.get("dependencies", {}).get("base")
    return None if entry is None else (entry["repo"], entry["commit"])


def kit_of(recipe: dict[str, Any]) -> tuple[str, str] | None:
    reference = recipe.get("provenance", {}).get("source_reference")
    match = GITHUB_REFERENCE.match(reference) if isinstance(reference, str) else None
    return None if match is None else (match.group(1), match.group(2))


def adapter_of(root: Path, recipe: dict[str, Any]) -> Path | None:
    path = recipe.get("execution", {}).get("build", {}).get("context", {}).get("path")
    return None if not path else root / path


def manifest_of(adapter: Path) -> dict[str, Any]:
    path = adapter / MANIFEST
    return json.loads(path.read_text(encoding="utf-8")) if path.is_file() else {}


# ---------------------------------------------------------------------------
# Check ("is the lock up to date")
# ---------------------------------------------------------------------------

ARCHIVE_NAME = re.compile(r"^(?P<stem>.+)-(?P<commit>[0-9a-f]{40})\.tar\.gz$")
ARCHIVE_DIGEST = re.compile(
    r'echo "(?P<digest>[0-9a-f]{64})  [^"]+"\s*\|\s*sha256sum -c'
)


def consumers(adapter: Path, pin: Pin) -> list[str]:
    """What the files that consume the base pin say; empty when they follow it."""
    problems: list[str] = []
    dockerfile = adapter / "Dockerfile"
    text = dockerfile.read_text(encoding="utf-8") if dockerfile.is_file() else ""
    archives = (
        sorted((adapter / "vendor").glob("*.tar.gz"))
        if (adapter / "vendor").is_dir()
        else []
    )
    if archives:
        named = [
            a
            for a in archives
            if (m := ARCHIVE_NAME.match(a.name)) and m["commit"] == pin.commit
        ]
        if not named:
            problems.append(
                f"vendor/ holds {', '.join(a.name for a in archives)}, not an archive of the "
                f"locked {pin.repo} commit {pin.commit}"
            )
        elif len(archives) > 1:
            problems.append(
                "vendor/ holds more than one archive; keep only the locked one"
            )
        else:
            digest = hashlib.sha256(named[0].read_bytes()).hexdigest()
            found = ARCHIVE_DIGEST.search(text)
            if found is None or found["digest"] != digest:
                problems.append(
                    f"Dockerfile does not verify {named[0].name} with its sha256 {digest}"
                )
            if f"vendor/{named[0].name}" not in text:
                problems.append(f"Dockerfile does not COPY vendor/{named[0].name}")
    revision = re.search(r'org\.opencontainers\.image\.revision="([^"]+)"', text)
    if revision is not None and revision.group(1) != pin.commit:
        problems.append(
            f"Dockerfile's image revision label is {revision.group(1)}, not the locked "
            f"commit {pin.commit}"
        )
    elif pin.commit not in text:
        problems.append(f"Dockerfile does not name the locked commit {pin.commit}")
    return problems


def check_recipe(
    root: Path, recipe_id: str, recipe: dict[str, Any], source: GitHub
) -> list[str]:
    """Reasons the recipe's committed lock is not what its kit declares ([] when current)."""
    adapter = adapter_of(root, recipe)
    if adapter is None or not (adapter / MANIFEST).is_file():
        return []
    manifest = manifest_of(adapter)
    try:
        wanted = declarations(manifest)
    except KitError as error:
        return [f"{recipe_id}: {error}"]
    if not wanted:
        return []
    label = f"{recipe_id}"
    kit = kit_of(recipe)
    if kit is None:
        return [
            f"{label}: the recipe does not pin a kit commit (provenance.source_reference)"
        ]
    problems: list[str] = []
    if "source" in manifest:
        problems.append(
            f"{label}: {MANIFEST} keeps a hand-authored 'source' pin beside the kit "
            "declaration; remove it (the lock derives it), or use an explicit override"
        )
    lock = read_lock(adapter)
    if lock is None:
        return problems + [f"{label}: no {LOCK}; run tools/kit-pins lock {recipe_id}"]
    try:
        # Offline in the tag direction: the lock's own ref is used for the commit, so only
        # the declaring file at the pinned kit commit is fetched.
        pins = []
        for declaration in wanted:
            locked = lock.get("dependencies", {}).get(declaration.name)
            if locked is None:
                problems.append(f"{label}: {LOCK} lacks '{declaration.name}'")
                continue
            if declaration.override is not None:
                ref = declaration.override.get("ref") or declaration.override["commit"]
                reason: str | None = declaration.override["reason"]
            else:
                ref = parse_declared(
                    source.read(kit[0], kit[1], declaration.file), declaration
                )
                reason = None
            pins.append(
                Pin(
                    declaration.name,
                    declaration.repo,
                    ref,
                    locked["commit"],
                    "",
                    reason,
                )
            )
        expected = lock_document(kit[0], kit[1], pins)
        if lock != expected:
            problems.append(
                f"{label}: {LOCK} is stale: the recipe pins kit {kit[0]}@{kit[1][:12]}, which "
                f"declares {json.dumps({p.name: p.ref for p in pins}, sort_keys=True)}, but "
                f"the lock says {json.dumps({k: v.get('ref') for k, v in lock.get('dependencies', {}).items()}, sort_keys=True)} "
                f"for kit {lock.get('kit', {}).get('commit', '?')[:12]}; run tools/kit-pins lock {recipe_id}"
            )
    except KitError as error:
        problems.append(f"{label}: {error}")
        return problems
    for pin in pins:
        if pin.name == "base":
            problems.extend(f"{label}: {p}" for p in consumers(adapter, pin))
    return problems


# ---------------------------------------------------------------------------
# Lock (write)
# ---------------------------------------------------------------------------


def download_archive(repo: str, commit: str) -> bytes:
    url = f"https://codeload.github.com/{repo}/tar.gz/{commit}"
    request = urllib.request.Request(url, headers={"User-Agent": "vonk-forge-recipes"})
    try:
        with urllib.request.urlopen(request, timeout=120) as response:
            data = response.read(MAX_ARCHIVE_BYTES + 1)
    except (urllib.error.HTTPError, urllib.error.URLError) as error:
        raise KitError(f"cannot fetch {url}: {error}") from error
    if len(data) > MAX_ARCHIVE_BYTES:
        raise KitError(f"{url} is larger than {MAX_ARCHIVE_BYTES} bytes")
    return data


def apply_lock(
    root: Path,
    recipe_id: str,
    recipe: dict[str, Any],
    source: GitHub,
    fetch_archive: Callable[[str, str], bytes] = download_archive,
) -> list[str]:
    """Write ``kit-lock.json`` and move the consumers to it; returns what changed."""
    adapter = adapter_of(root, recipe)
    kit = kit_of(recipe)
    if adapter is None or kit is None:
        raise KitError(f"{recipe_id}: no adapter directory or kit commit")
    manifest = manifest_of(adapter)
    wanted = declarations(manifest)
    if not wanted:
        raise KitError(f"{recipe_id}: {MANIFEST} declares no kit dependencies")
    pins = derive(kit[0], kit[1], wanted, source)
    changed: list[str] = []
    previous = locked_base(adapter) or (
        (manifest["source"]["repo"], manifest["source"]["commit"])
        if "source" in manifest
        else None
    )
    new = lock_text(lock_document(kit[0], kit[1], pins))
    lock_path = adapter / LOCK
    if not lock_path.is_file() or lock_path.read_text(encoding="utf-8") != new:
        lock_path.write_text(new, encoding="utf-8")
        changed.append(LOCK)
    if "source" in manifest:
        del manifest["source"]
        (adapter / MANIFEST).write_text(
            json.dumps(manifest, indent=2, sort_keys=True) + "\n", encoding="utf-8"
        )
        changed.append(f"{MANIFEST} (hand-authored source pin removed)")
    base = next((p for p in pins if p.name == "base"), None)
    if base is not None:
        changed.extend(_move_consumers(adapter, previous, base, kit, fetch_archive))
    return changed


def _move_consumers(
    adapter: Path,
    previous: tuple[str, str] | None,
    base: Pin,
    kit: tuple[str, str],
    fetch_archive: Callable[[str, str], bytes],
) -> list[str]:
    changed: list[str] = []
    dockerfile = adapter / "Dockerfile"
    if not dockerfile.is_file():
        return changed
    text = dockerfile.read_text(encoding="utf-8")
    original = text
    vendor = adapter / "vendor"
    old_archives = sorted(vendor.glob("*.tar.gz")) if vendor.is_dir() else []
    if old_archives:
        named = next((a for a in old_archives if base.commit in a.name), None)
        if named is None:
            template = ARCHIVE_NAME.match(old_archives[0].name)
            stem = template["stem"] if template else old_archives[0].name.split(".")[0]
            data = fetch_archive(base.repo, base.commit)
            named = vendor / f"{stem}-{base.commit}.tar.gz"
            named.write_bytes(data)
            changed.append(f"vendor/{named.name} (new base archive)")
        digest = hashlib.sha256(named.read_bytes()).hexdigest()
        for old in old_archives:
            if old == named:
                continue
            old_digest = hashlib.sha256(old.read_bytes()).hexdigest()
            old_commit = ARCHIVE_NAME.match(old.name)
            text = text.replace(old.name, named.name).replace(old_digest, digest)
            if old_commit:
                text = text.replace(old_commit["commit"], base.commit)
            old.unlink()
            changed.append(f"vendor/{old.name} (removed)")
        found = ARCHIVE_DIGEST.search(text)
        if found and found["digest"] != digest:
            text = text.replace(found["digest"], digest)
    if previous is not None and previous[1] != base.commit:
        text = text.replace(previous[1], base.commit)
    # the kit's own commit, where the Dockerfile cites it (a recipe-patches source label)
    cited = re.search(
        rf"github\.com/{re.escape(kit[0])}/tree/(?P<commit>[0-9a-f]{{40}})", text
    )
    if cited and cited["commit"] != kit[1]:
        text = text.replace(cited["commit"], kit[1])
    if text != original:
        dockerfile.write_text(text, encoding="utf-8")
        changed.append(
            "Dockerfile (pins; review its header comment and licence labels)"
        )
    return changed


# ---------------------------------------------------------------------------
# Command line
# ---------------------------------------------------------------------------


def load_recipes(root: Path) -> dict[str, dict[str, Any]]:
    return {
        json.loads(p.read_text(encoding="utf-8"))["identity"]["slug"]: json.loads(
            p.read_text(encoding="utf-8")
        )
        for p in sorted((root / "recipes").glob("*.json"))
    }


def kit_recipes(root: Path, recipes: dict[str, dict[str, Any]]) -> list[str]:
    found = []
    for recipe_id, recipe in recipes.items():
        adapter = adapter_of(root, recipe)
        if (
            adapter is not None
            and (adapter / MANIFEST).is_file()
            and "kit" in manifest_of(adapter)
        ):
            found.append(recipe_id)
    return found


def main(argv: list[str]) -> int:
    if not argv or argv[0] not in {"lock", "check"}:
        print(__doc__)
        return 2
    command, names = argv[0], argv[1:]
    recipes = load_recipes(ROOT)
    targets = kit_recipes(ROOT, recipes)
    if names and names != ["--all"]:
        unknown = [n for n in names if n not in recipes]
        if unknown:
            print(f"unknown recipe: {', '.join(unknown)}", file=sys.stderr)
            return 2
        targets = names
    elif command == "lock" and names != ["--all"]:
        print("name the recipe(s) to lock, or --all", file=sys.stderr)
        return 2
    source = cli_source()
    failed = 0
    for recipe_id in targets:
        try:
            if command == "lock":
                moved = apply_lock(ROOT, recipe_id, recipes[recipe_id], source)
                print(
                    f"{recipe_id}: "
                    + ("; ".join(moved) if moved else "lock is current")
                )
            else:
                for problem in check_recipe(
                    ROOT, recipe_id, recipes[recipe_id], source
                ):
                    print(problem, file=sys.stderr)
                    failed += 1
        except KitError as error:
            print(f"{recipe_id}: {error}", file=sys.stderr)
            failed += 1
    if command == "check":
        if failed:
            print(f"{failed} kit lock problem(s)", file=sys.stderr)
            return 1
        print(f"Kit locks are current ({len(targets)} recipes with a kit declaration)")
    return 1 if failed else 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
