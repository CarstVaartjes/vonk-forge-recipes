#!/usr/bin/env python3
"""Render or verify the reviewed protocol-wheel adapter inputs.

Rendering writes the Dockerfile templates and declares the one wheel for every
consumer path in adapter-sources.json (uploading it to the mirror; needs `gh`).
"""

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "contracts" / "src"))
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
from recipe_tooling.adapter_sources import AdapterSourceError
from recipe_tooling.adapter_sources import materialize as place_declared
from recipe_tooling.protocol_wheel import materialize

ROOT = Path(__file__).resolve().parents[1]

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--check", action="store_true")
args = parser.parse_args()
try:
    place_declared()  # the selected wheel is a declared path
    materialize(check=args.check)
except (AdapterSourceError, ValueError, OSError) as error:
    sys.exit(f"protocol wheel: {error}")
