#!/usr/bin/env python3
"""Create a conservative single-Spark vLLM recipe from exact references."""

from __future__ import annotations

import argparse
import json
from pathlib import Path


def args() -> argparse.Namespace:
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("--root", type=Path, default=Path(__file__).resolve().parents[1])
    p.add_argument("--slug", required=True)
    p.add_argument("--title", required=True)
    p.add_argument("--description", required=True)
    p.add_argument("--tags", required=True, help="comma-separated lower-case tags")
    p.add_argument("--publisher", required=True)
    p.add_argument("--model-version", required=True)
    p.add_argument("--model-version-sha", required=True)
    p.add_argument("--context-path", required=True)
    p.add_argument("--context-sha", required=True)
    p.add_argument("--context-bytes", type=int, required=True)
    p.add_argument("--runtime-slug", required=True)
    p.add_argument("--runtime-sha", required=True)
    p.add_argument("--model-repository", required=True)
    p.add_argument("--model-revision", required=True)
    p.add_argument("--model-bytes", type=int, required=True)
    p.add_argument("--served-name", required=True)
    p.add_argument("--max-model-len", type=int, required=True)
    p.add_argument("--max-num-seqs", type=int, required=True)
    p.add_argument("--startup-peak-bytes", type=int, required=True)
    p.add_argument("--steady-state-bytes", type=int, required=True)
    p.add_argument("--reasoning-parser")
    p.add_argument("--tool-call-parser")
    p.add_argument("--trust-remote-code", action="store_true")
    return p.parse_args()


def main() -> int:
    a = args()
    runtime_args: list[dict[str, object]] = [
        {"name": "served-model-name", "value": a.served_name},
        {"name": "max-model-len", "value": a.max_model_len},
        {"name": "max-num-seqs", "value": a.max_num_seqs},
        {"name": "gpu-memory-utilization", "value": "0.80"},
    ]
    if a.reasoning_parser:
        runtime_args.append({"name": "reasoning-parser", "value": a.reasoning_parser})
    if a.tool_call_parser:
        runtime_args.append({"name": "tool-call-parser", "value": a.tool_call_parser})
    if a.trust_remote_code:
        runtime_args.append({"name": "trust-remote-code", "value": True})
    if a.reasoning_parser or a.tool_call_parser:
        runtime_args.append({"name": "enable-auto-tool-choice", "value": True})
    document = {
        "schema_version": 1,
        "identity": {"publisher": "vonk-forge", "slug": a.slug},
        "metadata": {"title": a.title, "description": a.description, "tags": a.tags.split(",")},
        "model": {
            "kind": "model-version",
            "publisher": a.publisher,
            "slug": a.model_version,
            "content_sha256": a.model_version_sha,
        },
        "execution": {
            "harness": {
                "kind": "execution-harness",
                "publisher": "vonk-forge",
                "slug": "vllm",
                "content_sha256": "c0d297318f223378fe573964291bc90fc950242e0d16d1d301c7d3cb4251487d",
            },
            "patch_bundle": None,
        },
        "build": {
            "context": {
                "path": a.context_path,
                "sha256": a.context_sha,
                "expected_bytes": a.context_bytes,
                "media_type": "application/vnd.vonk-forge.source-bundle.v1+tar",
            },
            "dockerfile": "Dockerfile",
            "platform": "linux/arm64",
            "arguments": [],
            "network": {"mode": "none", "hosts": []},
            "resources": {
                "download_bytes": a.model_bytes + 10533135621,
                "temporary_bytes": max(a.model_bytes * 2, 32000000000),
                "memory_bytes": 8000000000,
                "timeout_seconds": 7200,
            },
        },
        "parameters": [],
        "artifacts": [{
            "id": "weights",
            "kind": "huggingface.snapshot",
            "repository": a.model_repository,
            "revision": a.model_revision,
            "download_bytes": a.model_bytes,
            "installed_bytes": a.model_bytes,
            "mount": {"target": "/models", "read_only": True},
            "roles": ["entrypoint"],
        }],
        "runtime": {
            "distribution": {
                "kind": "runtime-distribution",
                "publisher": "vllm",
                "slug": a.runtime_slug,
                "content_sha256": a.runtime_sha,
            },
            "entrypoint": ["/opt/vonk/bin/vllm", "serve", "/models"],
            "arguments": runtime_args,
            "environment": [
                {"name": "HF_HUB_OFFLINE", "value": "1"},
                {"name": "TRANSFORMERS_OFFLINE", "value": "1"},
                {"name": "VLLM_NO_USAGE_STATS", "value": "1"},
            ],
            "security": {
                "devices": ["nvidia.com/gpu=all"],
                "capabilities": [],
                "host_network": False,
                "privileged": False,
                "user": "10001:10001",
                "mounts": [
                    {"source": "model", "target": "/models", "read_only": True},
                    {"source": "outputs", "target": "/outputs", "read_only": False},
                ],
            },
            "lifecycle": {
                "pre_start": [],
                "post_stop": [],
                "stop_timeout_seconds": 120,
                "readiness": {"strategy": "endpoint-owner", "path": "/v1/models", "timeout_seconds": 1800},
                "failure": {"rank_loss": "not-applicable", "recovery": "restart-entrypoint"},
            },
        },
        "topology": {
            "name": "solo",
            "mode": "single",
            "node_count": 1,
            "roles": [{
                "name": "entrypoint",
                "count": 1,
                "endpoint_owner": True,
                "artifacts": ["weights"],
                "resources": {
                    "disk": {
                        "image_bytes": 12000000000,
                        "artifact_bytes": a.model_bytes,
                        "staging_bytes": max(a.model_bytes * 2, 32000000000),
                        "cache_bytes": 4000000000,
                        "rollback_bytes": 0,
                        "safety_margin_bytes": 12000000000,
                    },
                    "memory": {
                        "kind": "unified",
                        "startup_peak_bytes": a.startup_peak_bytes,
                        "steady_state_bytes": a.steady_state_bytes,
                        "runtime_growth_bytes": 4000000000,
                        "system_reserve_bytes": 8000000000,
                    },
                },
            }],
            "parallelism": {"world_size": 1, "tensor": 1, "pipeline": 1, "data": 1, "backend": "local"},
            "fabric": {"connectivity": "none", "minimum_bandwidth_mbps": 0},
            "start_order": ["entrypoint"],
            "stop_order": ["entrypoint"],
        },
        "interfaces": [{"adapter": "openai", "port": 8000, "model_aliases": [a.served_name], "health_path": "/v1/models"}],
        "validation": {
            "validators": [{"interface": "openai", "checks": ["endpoint.healthy", "chat.nonempty", "chat.max-output-64"]}],
            "benchmarks": [{"name": "bounded-chat", "framework": "openai", "configuration": {"max_output_tokens": 64, "requests": 1, "timeout_seconds": 600}}],
        },
        "provenance": {
            "source_kind": "global",
            "source_reference": f"https://huggingface.co/{a.model_repository}/tree/{a.model_revision}",
            "attribution": [a.publisher],
        },
    }
    output = a.root / "recipes" / f"{a.slug}.json"
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(json.dumps(document, indent=2) + "\n")
    print(output)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
