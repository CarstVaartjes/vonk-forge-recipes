#!/usr/bin/env python3
"""Convert the legacy recipe catalog into the v2 public contracts.

The converter is intentionally evidence preserving: every value in the output
comes from a model-version, recipe, runtime distribution, or recipe source
closure.  Missing evidence is reported and leaves that document unconverted.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import re
import shutil
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[1]
CONTRACTS = ROOT / "contracts" / "src"
import sys
sys.path.insert(0, str(CONTRACTS))

from vonk_forge_contracts import ModelDefinition, RecipeDefinition, content_sha256
from vonk_forge_contracts.resolver import validate_recipe_models

EVIDENCE = json.loads((ROOT / "docs/model-version-capability-evidence-2026-09-05.json").read_text())
EVIDENCE_DIGEST = EVIDENCE["capability_evidence_digest"]
CAPABILITY_TO_MODALITY = {
    "text-generation": "text", "text-understanding": "text", "chat": "text",
    "reasoning": "text", "tool-use": "text", "code-generation": "text",
    "ocr": "image", "image-generation": "image", "image-understanding": "image",
    "image-editing": "image", "video-generation": "video", "video-understanding": "video",
    "audio-generation": "audio", "audio-understanding": "audio", "embeddings": "embeddings",
    "3d-generation": "3d",
}
TAG_TO_MODALITY = {
    "language": "text", "text": "text", "image": "image", "video": "video",
    "audio": "audio", "embeddings": "embeddings", "three-d": "3d", "3d": "3d",
    "multimodal": None,
}
RESERVED_ENV = {
    "VLLM_NO_USAGE_STATS", "COMFYUI_DISABLE_TELEMETRY",
    "FLASHINFER_WORKSPACE_BASE", "TILELANG_CACHE_DIR", "TRITON_CACHE_DIR",
    "B12X_CUTE_COMPILE_CACHE_DIR", "TORCH_FR_DUMP_TEMP_FILE",
    "TORCH_NCCL_DEBUG_INFO_PIPE_FILE",
}
SAFE_NAME = re.compile(r"[^a-z0-9_-]+")


def read(path: Path) -> dict[str, Any]:
    return json.loads(path.read_text(encoding="utf-8"))


def dump(path: Path, document: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(document, ensure_ascii=False, sort_keys=True, indent=2) + "\n", encoding="utf-8")


def old_entities() -> tuple[dict[str, dict[str, Any]], dict[str, dict[str, Any]], dict[str, dict[str, Any]]]:
    groups = {p.stem: read(p) for p in (ROOT / "model-groups").glob("*.json")}
    models = {p.stem: read(p) for p in (ROOT / "models").glob("*.json")}
    versions = {p.stem: read(p) for p in (ROOT / "model-versions").glob("*.json")}
    return groups, models, versions


def modalities(version: dict[str, Any], model: dict[str, Any]) -> list[str]:
    result = {CAPABILITY_TO_MODALITY[f["capability"]] for f in version.get("capabilities", {}).get("facts", [])
              if f.get("support") == "supported" and CAPABILITY_TO_MODALITY.get(f.get("capability"))}
    if not result:
        for tag in version.get("metadata", {}).get("tags", []) + model.get("metadata", {}).get("tags", []):
            mapped = TAG_TO_MODALITY.get(str(tag).lower())
            if mapped:
                result.add(mapped)
    return sorted(result)


def model_document(version: dict[str, Any], model: dict[str, Any], group: dict[str, Any]) -> dict[str, Any]:
    source = version["source"]
    capabilities = version.get("capabilities")
    if capabilities is None:
        capabilities = {
            "schema_version": 2,
            "facts": [],
            "provenance": {
                "source_url": "https://github.com/CarstVaartjes/vonk-forge-recipes",
                "source_revision": EVIDENCE["authority"]["source_commit"],
                "evidence_digest": EVIDENCE_DIGEST,
            },
        }
    logical = model["identity"]
    group_identity = group["identity"]
    artifacts = []
    for artifact in version.get("artifacts", []):
        path = artifact.get("path") or artifact["id"]
        artifacts.append({
            "id": artifact["id"], "path": path,
            "sha256": artifact["sha256"],
            "size_bytes": int(artifact.get("installed_bytes", artifact.get("download_bytes", 0))),
            "roles": artifact.get("roles", ["runtime"]),
        })
    return {
        "schema_version": 2, "kind": "model",
        "identity": {
            "publisher": version["identity"]["publisher"],
            "slug": version["identity"]["slug"],
            "family": {"publisher": group_identity["publisher"], "slug": group_identity["slug"], "title": group["metadata"]["title"]},
            "model": {"publisher": logical["publisher"], "slug": logical["slug"], "title": model["metadata"]["title"], "architecture": model["architecture"]},
            "version": version["version"], "variant": version["metadata"]["title"],
        },
        "metadata": {"description": version["metadata"]["description"], "tags": version["metadata"].get("tags", [])[:20]},
        "modalities": modalities(version, model),
        "source": {"repository": source["repository"], "revision": source["revision"]},
        "format": {"container": version["format"]["container"], "precision": version["format"]["precision"], "quantization": version["format"]["quantization"]},
        "parameters": version.get("parameters", {"total": None, "active": None}),
        "limits": {key: version.get("limits", {}).get(key) for key in ("context_tokens", "resolution_pixels", "frames", "sample_rate_hz")},
        "license": {"spdx": version["license"]["spdx"], "url": version["license"]["url"], "attribution": version["license"].get("attribution", []), "operator_acceptance_required": version["license"].get("operator_acceptance_required", False)}, "files": artifacts,
        "capabilities": capabilities,
        "provenance": {
            "source_url": source["repository"], "source_revision": source["revision"],
            "evidence_digest": capabilities["provenance"]["evidence_digest"],
            "attribution": version["license"].get("attribution", []),
        },
    }


def scalar(value: Any) -> bool:
    return value is None or isinstance(value, (str, int, bool)) and not isinstance(value, float)


def setting_value(args: dict[str, Any], names: tuple[str, ...]) -> int | None:
    for name in names:
        value = args.get(name)
        if type(value) is int and value >= 1:
            return value
    return None


def concurrency_evidence(old: dict[str, Any]) -> dict[str, Any]:
    args = {item["name"]: item.get("value") for item in old.get("runtime", {}).get("arguments", []) if isinstance(item, dict)}
    configured = setting_value(args, ("max-num-seqs", "max-running-requests"))
    if configured is not None:
        return {"value": configured, "source": "runtime.arguments", "argument": next(name for name in ("max-num-seqs", "max-running-requests") if args.get(name) == configured)}
    slug = old.get("identity", {}).get("slug")
    if slug == "deepseek-v4-flash-0731-ds4-single" and args.get("batch-size") == 2:
        return {"value": 2, "source": "runtime.arguments.batch-size", "detail": "pinned DS4 harness maps batch-size=2 to batched-session concurrency"}
    if slug == "deepseek-v4-flash-0731-ds4-dspark-latency-single":
        return {"value": 1, "source": "pinned DS4 vendor README", "detail": "single mutable KV session without --batched-session"}
    context = old.get("build", {}).get("context", {}).get("path")
    if isinstance(context, str):
        root = ROOT / context
        for path in sorted(root.rglob("*")) if root.is_dir() else ():
            if not path.is_file() or path.suffix in {".pyc", ".json"}:
                continue
            try:
                text = path.read_text(encoding="utf-8")
            except (OSError, UnicodeDecodeError):
                continue
            match = re.search(r"max_requests\s*=\s*[\"'](\d+)[\"']", text)
            if match is None:
                match = re.search(r"[\"']--max-running-requests[\"']\s*,\s*[\"'](\d+)[\"']", text)
            if match:
                return {"value": int(match.group(1)), "source": path.relative_to(ROOT).as_posix(), "detail": "pinned wrapper appends max-running-requests"}
    return {"value": None, "source": "runtime default", "detail": "engine scheduler limit is automatic/unspecified"}


def model_refs(recipe: dict[str, Any]) -> list[tuple[str, str]]:
    result = [(recipe["model"]["publisher"], recipe["model"]["slug"])]
    result.extend((d["publisher"], d["slug"]) for d in recipe.get("dependencies", []) if d.get("kind") in {"model", "model-version"})
    return result


def matching_artifacts(old: dict[str, Any], manifest: dict[str, Any], version: dict[str, Any]) -> list[str]:
    if old.get("kind", "").endswith("snapshot"):
        revision = old.get("revision")
        if revision == version.get("source", {}).get("revision"):
            return [item["id"] for item in manifest.get("artifacts", [])]
        matches = [item["id"] for item in manifest.get("artifacts", []) if item.get("revision") == revision]
        if matches:
            return matches
    result: list[str] = []
    for item in manifest.get("artifacts", []):
        if item.get("id") == old.get("id"):
            result.append(item["id"])
            return result
    old_repo, old_rev = old.get("repository"), old.get("revision")
    for item in manifest.get("artifacts", []):
        if old.get("sha256") and old.get("sha256") == item.get("sha256"):
            result.append(item["id"])
            return result
        if old_repo == item.get("repository") and old_rev in {
            item.get("revision"), "sha256:" + item.get("sha256", "")
        }:
            result.append(item["id"])
            return result
    old_path = str(old_repo or "").rsplit("/", 1)[-1]
    for item in manifest.get("artifacts", []):
        if old_path and old_path == str(item.get("path", "")).rsplit("/", 1)[-1]:
            result.append(item["id"])
            return result
    return result


def recipe_serving(recipe: dict[str, Any], interface: dict[str, Any]) -> tuple[dict[str, Any], list[str]]:
    adapter = interface["adapter"]
    if adapter == "openai":
        vision = "vision" in str(recipe.get("identity", {}).get("slug", "")) or any("vision" in alias for alias in interface.get("model_aliases", []))
        health = {
            "name": "health", "kind": "openai.health",
            "request": {"transport": "http", "method": "GET", "path": interface["health_path"]},
            "assertions": ["endpoint.healthy"],
        }
        messages = [{"role": "user", "content": [{"type": "text", "text": "describe this image"}, {"type": "image_url", "image_url": {"url": "data:image/png;base64,AA=="}}]}] if vision else [{"role": "user", "content": "hello"}]
        body = {"model": interface["model_aliases"][0], "messages": messages, "max_tokens": 64}
        check = {"name": "bounded-vision" if vision else "bounded-chat", "kind": "openai.vision" if vision else "openai.chat", "request": {"transport": "http", "method": "POST", "path": "/v1/chat/completions", "body": body}, "assertions": ["chat.nonempty", "chat.output-cap"]}
        return {"interface": "openai", "checks": [health, check]}, []
    output_slot = interface["output"]["slots"][0]["id"]
    input_slots: dict[str, str] = {}
    fixture = "qualification/fixtures/prompt.txt"
    for slot in interface.get("input", {}).get("slots", []) if interface.get("input") else []:
        if slot["min_files"] == 0:
            continue
        media = set(slot.get("media_types", []))
        if "text/plain" in media:
            path = "qualification/fixtures/prompt.txt"
        elif any(item.startswith("image/") for item in media):
            path = "qualification/fixtures/tiny.png"
        elif any(item.startswith("video/") for item in media):
            path = "qualification/fixtures/foley-video-1s.mp4"
        elif any(item.startswith("audio/") for item in media):
            path = "qualification/fixtures/music-1s.wav"
        elif "model/gltf-binary" in media:
            path = "qualification/fixtures/tiny.glb"
        elif "application/json" in media and slot["id"] == "session":
            path = "qualification/fixtures/moss-session.json"
        else:
            path = "qualification/fixtures/prompt.txt"
        input_slots[slot["id"]] = path
        fixture = path
    request: dict[str, Any] = {"transport": "job", "fixture": fixture, "output_path": "/outputs", "output_slot": output_slot}
    if interface.get("input"):
        request["input_path"] = "/inputs"
        request["input_slots"] = input_slots
    return {"interface": adapter, "checks": [{"name": "job-output", "kind": f"{adapter}.output", "request": request, "assertions": ["inference.completed", "artifact.output"]}]}, [*input_slots.values()]


def recipe_document(old: dict[str, Any], versions: dict[str, dict[str, Any]], models: dict[str, dict[str, Any]], groups: dict[str, dict[str, Any]]) -> tuple[dict[str, Any] | None, list[str]]:
    blockers: list[str] = []
    refs = model_refs(old)
    selections: list[dict[str, Any]] = []
    role_names = {role["name"] for role in old["topology"]["roles"]}
    used_selector_ids: set[str] = set()
    for index, (publisher, slug) in enumerate(refs):
        version = versions.get(slug)
        if version is None:
            blockers.append(f"missing model-version {publisher}/{slug}")
            continue
        logical = version["model"]["slug"]
        model = models.get(logical)
        if model is None:
            blockers.append(f"missing model {logical}")
            continue
        group_slug = model["model_group"]["slug"]
        group = groups.get(group_slug)
        if group is None:
            blockers.append(f"missing model-group {group_slug}")
            continue
        model_doc = model_document(version, model, group)
        try:
            model_digest = content_sha256(ModelDefinition.model_validate(model_doc))
        except Exception as error:
            blockers.append(f"model snapshot {slug} is not contract-valid: {error}")
            continue
        selection_id = "primary" if index == 0 else f"dependency-{SAFE_NAME.sub('-', slug)}"
        selection_id = selection_id[:64]
        files: list[dict[str, Any]] = []
        for artifact in old.get("artifacts", []):
            if artifact.get("repository") is None:
                continue
            file_ids = matching_artifacts(artifact, version, version)
            if not file_ids:
                continue
            roles = [role for role in artifact.get("roles", []) if role in role_names]
            if not roles:
                blockers.append(f"artifact {artifact['id']} has no topology role")
                continue
            for file_id in file_ids:
                selector_id = SAFE_NAME.sub("-", f"{selection_id}-{file_id}").strip("-")[:64]
                if not selector_id or not selector_id[0].isalpha():
                    selector_id = "file-" + selector_id
                base_selector_id = selector_id
                suffix = 2
                while selector_id in used_selector_ids:
                    suffix_text = f"-{suffix}"
                    selector_id = base_selector_id[: 64 - len(suffix_text)] + suffix_text
                    suffix += 1
                used_selector_ids.add(selector_id)
                files.append({"id": selector_id, "file_id": file_id, "roles": roles, "mount": {"target": artifact["mount"]["target"], "read_only": True}})
        if not files:
            blockers.append(f"no exact files selected for {publisher}/{slug}")
        selections.append({"id": selection_id, "model": {"kind": "model", "publisher": version["identity"]["publisher"], "slug": version["identity"]["slug"], "content_sha256": model_digest}, "files": files})
    if blockers:
        return None, blockers
    runtime_old = old["runtime"]
    args = {item["name"]: item.get("value") for item in runtime_old.get("arguments", [])}
    interface = old["interfaces"][0]
    adapter = interface["adapter"]
    context = setting_value(args, ("max-model-len", "context-length", "ctx-size"))
    if context is None:
        for selection in selections:
            version = versions[selection["model"]["slug"]]
            context = version.get("limits", {}).get("context_tokens")
            if context:
                break
    concurrency = concurrency_evidence(old)["value"]
    if adapter == "openai" and context is None:
        if context is None: blockers.append("settings.generation.context_tokens has no evidence")
        return None, blockers
    environment = [{k: v for k, v in item.items() if k in {"name", "value", "secret"}} for item in runtime_old.get("environment", []) if item.get("name") not in RESERVED_ENV]
    runtime = {"engine": old["execution"]["harness"]["slug"], "entrypoint": runtime_old["entrypoint"], "arguments": [], "environment": environment, "lifecycle": {k: runtime_old["lifecycle"][k] for k in ("pre_start", "post_stop", "stop_timeout_seconds", "failure")}}
    for item in runtime_old.get("arguments", []):
        value = item.get("value")
        if not scalar(value):
            blockers.append(f"runtime argument {item['name']} is not a contract scalar")
        else:
            setting = None
            if adapter == "openai" and item["name"] in {"max-model-len", "context-length", "ctx-size"} and value == context:
                setting = "context_tokens"
            elif adapter == "openai" and item["name"] in {"max-num-seqs", "max-running-requests", "batch-size"} and value == concurrency:
                setting = "concurrency"
            runtime["arguments"].append(
                {"name": item["name"], "setting": setting}
                if setting is not None
                else {"name": item["name"], "value": value}
            )
    wrapper_evidence = concurrency_evidence(old)
    if adapter == "openai" and wrapper_evidence["value"] is not None and wrapper_evidence.get("source", "").endswith("sglang-serve") and not any(item["name"] == "max-running-requests" for item in runtime["arguments"]):
        runtime["arguments"].append({"name": "max-running-requests", "setting": "concurrency"})
    dist = read(ROOT / "runtime-distributions" / f"{old['runtime']['distribution']['slug']}.json")
    image = dist.get("image", "")
    repository, digest = (image.split("@", 1) + [""])[:2] if "@" in image else ("", "")
    if ":" in repository.rsplit("/", 1)[-1]:
        repository = repository.rsplit(":", 1)[0]
    if not repository or not digest.startswith("sha256:"):
        blockers.append("runtime distribution does not provide a pinned OCI image for build base")
        return None, blockers
    build_old = old["build"]
    build = {"base_image": {"repository": repository, "digest": digest.removeprefix("sha256:"), "platform": "linux/arm64"}, "context": {"path": build_old["context"]["path"]}, "dockerfile": f"{build_old['context']['path']}/{build_old['dockerfile']}", "patches": [], "target": None, "arguments": [{"name": item["name"], "value": item["value"]} for item in build_old.get("arguments", []) if scalar(item.get("value"))], "network": build_old["network"]}
    context_root = ROOT / build_old["context"]["path"]
    for patch_file in sorted(context_root.rglob("*")):
        if patch_file.is_file() and ("patch" in patch_file.parts or patch_file.name.startswith("patch-")):
            build["patches"].append({"path": patch_file.relative_to(ROOT).as_posix()})
    topology = {k: old["topology"][k] for k in ("name", "mode", "node_count", "roles", "parallelism", "fabric", "start_order", "stop_order")}
    for role in topology["roles"]:
        role.pop("artifacts", None)
    serving, fixture_paths = recipe_serving(old, interface)
    benchmarks = [{"name": b["name"], "framework": b["framework"], "configuration": {k: v for k, v in b.get("configuration", {}).items() if scalar(v)}} for b in old.get("validation", {}).get("benchmarks", [])]
    settings: dict[str, Any]
    if adapter == "openai":
        settings = {"kind": "generation", "context_tokens": {"value": context, "change_effect": "restart"}, "concurrency": {"value": concurrency, "change_effect": "restart"} if concurrency is not None else None, "max_batch_tokens": None, "knobs": {}}
    elif adapter in {"image-job", "audio-job", "video-job", "mesh-job", "artifact-job"}:
        settings = {"kind": "job", "concurrency": None, "knobs": {}}
    else:
        blockers.append(f"unsupported serving interface adapter: {adapter}")
        return None, blockers
    document = {"schema_version": 2, "kind": "recipe", "identity": old["identity"], "metadata": {k: old["metadata"][k] for k in ("title", "description", "tags", "alignment")}, "models": selections, "execution": {"mode": "build", "build": build}, "runtime": runtime, "topology": topology, "interfaces": [interface], "validation": {"benchmarks": benchmarks, "serving": serving}, "provenance": old["provenance"], "settings": settings}
    return document, fixture_paths


def convert(apply: bool = False) -> dict[str, Any]:
    groups, models, versions = old_entities()
    report: dict[str, Any] = {"models_total": len(versions), "models_converted": 0, "recipes_total": 0, "recipes_converted": 0, "blockers": {}, "settings_provenance": {}}
    candidate_models: dict[str, dict[str, Any]] = {}
    for slug, version in sorted(versions.items()):
        logical = version["model"]["slug"]
        model = models[logical]
        group = groups[model["model_group"]["slug"]]
        try:
            candidate = model_document(version, model, group)
            ModelDefinition.model_validate(candidate)
            candidate_models[slug] = candidate
            report["models_converted"] += 1
        except Exception as error:
            report["blockers"][f"model:{slug}"] = str(error)
    recipes = []
    for path in sorted((ROOT / "recipes").glob("*.json")):
        report["recipes_total"] += 1
        old = read(path)
        document, extra = recipe_document(old, versions, models, groups)
        if document is None:
            report["blockers"][f"recipe:{path.stem}"] = extra
            continue
        try:
            validated = RecipeDefinition.model_validate(document)
            validate_recipe_models(validated, [ModelDefinition.model_validate(candidate_models[s.model.slug]) for s in validated.models])
            recipes.append((path, document, extra))
            report["recipes_converted"] += 1
            report["settings_provenance"][path.stem] = concurrency_evidence(old)
        except Exception as error:
            report["blockers"][f"recipe:{path.stem}"] = str(error)
    report["recipe_blocker_count"] = report["recipes_total"] - report["recipes_converted"]
    if apply:
        for path in (ROOT / "models").glob("*.json"):
            path.unlink()
        for slug, document in candidate_models.items():
            dump(ROOT / "models" / f"{slug}.json", document)
        for path, document, _ in recipes:
            dump(path, document)
        (ROOT / "conversion-report.json").write_text(json.dumps(report, sort_keys=True, indent=2) + "\n")
    return report


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--apply", action="store_true")
    parser.add_argument("--report", type=Path)
    args = parser.parse_args()
    report = convert(args.apply)
    output = json.dumps(report, sort_keys=True, indent=2)
    print(output)
    if args.report:
        args.report.write_text(output + "\n")
    return 0 if not report["blockers"] else 2


if __name__ == "__main__":
    raise SystemExit(main())
