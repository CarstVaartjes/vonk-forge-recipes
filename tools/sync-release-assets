#!/usr/bin/env python3
"""Publish the release's one asset, ``recipe-library.tar``, and prove GitHub holds exactly it.

The release carries a single asset: the signed bundle (SHA256SUMS, its Sigstore
bundle and every listed file, as members). ``gh release upload --clobber``
replaces an asset non-atomically, so this tool makes publication converge: it
compares the release's assets (REST ``digest`` and ``size``) with the bundle,
uploads it when missing or different, then deletes every other asset (the
per-file assets earlier releases carried), and repeats until the release
matches. If it cannot converge it exits non-zero and says what differs.
Uploading first means a consumer reading the bundle never waits on the cleanup.

``publish`` expects the bundle file. ``check`` answers whether the published
release already carries exactly the bundle for a given SHA256SUMS (the bundle is
the only asset and its ``SHA256SUMS`` member equals the local one, and every
member matches it), and is how the workflow decides that an identical release
needs no republication.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import subprocess
import sys
import tarfile
import tempfile
import time
from collections.abc import Callable, Mapping, Sequence
from dataclasses import dataclass
from pathlib import Path

REPOSITORY = "CarstVaartjes/vonk-forge-recipes"
CHECKSUMS = "SHA256SUMS"
ATTESTATION = "SHA256SUMS.sigstore.json"
BUNDLE = "recipe-library.tar"
MAX_REPAIRS = 3
RETRY_DELAY_SECONDS = 10

Gh = Callable[[Sequence[str]], str]


@dataclass(frozen=True)
class Expected:
    """What one release asset must be. ``None`` leaves that property unchecked."""

    sha256: str | None = None
    size: int | None = None


@dataclass(frozen=True)
class Difference:
    missing: tuple[str, ...]
    mismatched: tuple[str, ...]
    extra: tuple[str, ...]

    @property
    def clean(self) -> bool:
        return not (self.missing or self.mismatched or self.extra)

    def describe(self) -> str:
        return (
            f"missing {list(self.missing)}, differing {list(self.mismatched)}, "
            f"unexpected {list(self.extra)}"
        )


def run_gh(arguments: Sequence[str]) -> str:
    completed = subprocess.run(
        ["gh", *arguments],
        capture_output=True,
        text=True,
        check=False,
    )
    if completed.returncode != 0:
        raise RuntimeError(
            f"gh {' '.join(arguments[:3])} failed ({completed.returncode}): "
            f"{completed.stderr.strip()[-500:]}"
        )
    return completed.stdout


def file_digest(path: Path) -> str:
    with path.open("rb") as handle:
        return hashlib.file_digest(handle, "sha256").hexdigest()


def expected_from_bundle(bundle: Path) -> dict[str, Expected]:
    """The only asset to publish, with its exact digest and size."""

    return {bundle.name: Expected(file_digest(bundle), bundle.stat().st_size)}


def bundle_matches_manifest(bundle: Path, manifest: Path) -> bool:
    """Whether the tar carries this SHA256SUMS and every member matches it."""

    wanted: dict[str, str] = {}
    for line in manifest.read_text("utf-8").splitlines():
        digest, _, name = line.partition("  ")
        if len(digest) != 64 or not name:
            return False
        wanted[name] = digest
    seen: dict[str, str] = {}
    with tarfile.open(bundle, "r:") as archive:
        for member in archive:
            handle = archive.extractfile(member)
            if not member.isreg() or handle is None or member.name in seen:
                return False
            seen[member.name] = hashlib.sha256(handle.read()).hexdigest()
    return (
        seen.get(CHECKSUMS) == file_digest(manifest)
        and ATTESTATION in seen
        and {name: seen.get(name) for name in wanted} == wanted
        and set(seen) == {*wanted, CHECKSUMS, ATTESTATION}
    )


def published_assets(gh: Gh, repository: str, tag: str) -> dict[str, dict[str, object]]:
    """The release's uploaded assets by name, read through the REST API."""

    release = json.loads(gh(["api", f"repos/{repository}/releases/tags/{tag}"]))
    assets: dict[str, dict[str, object]] = {}
    page = 1
    while True:
        batch = json.loads(
            gh(
                [
                    "api",
                    (
                        f"repos/{repository}/releases/{release['id']}/assets"
                        f"?per_page=100&page={page}"
                    ),
                ]
            )
        )
        for asset in batch:
            assets[str(asset["name"])] = asset
        if len(batch) < 100:
            return assets
        page += 1


def compare(
    expected: Mapping[str, Expected], assets: Mapping[str, Mapping[str, object]]
) -> Difference:
    missing: list[str] = []
    mismatched: list[str] = []
    for name, want in sorted(expected.items()):
        asset = assets.get(name)
        if asset is None:
            missing.append(name)
            continue
        if asset.get("state") != "uploaded":
            mismatched.append(name)
            continue
        digest = asset.get("digest")
        if want.sha256 is not None:
            if digest is not None:
                if digest != f"sha256:{want.sha256}":
                    mismatched.append(name)
                    continue
            elif want.size is None or asset.get("size") != want.size:
                # No digest reported: fall back to the size, never to "matches".
                mismatched.append(name)
                continue
        if want.size is not None and asset.get("size") != want.size:
            mismatched.append(name)
    extra = sorted(set(assets) - set(expected))
    return Difference(tuple(missing), tuple(mismatched), tuple(extra))


def repair(
    gh: Gh,
    repository: str,
    tag: str,
    sources: Mapping[str, Path],
    difference: Difference,
) -> None:
    """One round: upload the bundle if wrong, then drop every other asset."""

    wrong = sorted({*difference.missing, *difference.mismatched})
    if wrong:
        gh(
            [
                "release",
                "upload",
                tag,
                "--repo",
                repository,
                "--clobber",
                *(str(sources[name]) for name in wrong),
            ]
        )
    for name in difference.extra:
        gh(["release", "delete-asset", tag, name, "--repo", repository, "--yes"])


def converge(
    gh: Gh,
    repository: str,
    tag: str,
    expected: Mapping[str, Expected],
    sources: Mapping[str, Path],
    sleep: Callable[[float], None] = time.sleep,
) -> bool:
    """Repair the release until it matches ``expected``; False if it cannot."""

    difference = Difference((), (), ())
    outcome = ""
    for round_number in range(MAX_REPAIRS + 1):
        readable = True
        try:
            difference = compare(expected, published_assets(gh, repository, tag))
        except RuntimeError as error:
            readable = False
            outcome = f"release unreadable: {error}"
            print(f"could not read release {tag}: {error}", file=sys.stderr)
        else:
            if difference.clean:
                print(
                    f"release {tag} holds exactly the {len(expected)} expected assets"
                )
                return True
            outcome = difference.describe()
            print(f"release {tag} differs: {outcome}", file=sys.stderr)
        if round_number == MAX_REPAIRS:
            break
        if round_number:
            sleep(RETRY_DELAY_SECONDS * round_number)
        if not readable:
            continue
        try:
            repair(gh, repository, tag, sources, difference)
        except RuntimeError as error:
            print(f"repair round {round_number + 1} failed: {error}", file=sys.stderr)
    print(
        f"::error::release {tag} did not converge to the signed asset set "
        f"after {MAX_REPAIRS} repair rounds: {outcome}",
        file=sys.stderr,
    )
    return False


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--tag", required=True)
    parser.add_argument(
        "--repo", default=os.environ.get("GITHUB_REPOSITORY", REPOSITORY)
    )
    commands = parser.add_subparsers(dest="command", required=True)
    publish = commands.add_parser("publish", help="make the release match")
    publish.add_argument("--bundle", type=Path, required=True)
    check = commands.add_parser("check", help="exit 0 if the release is complete")
    check.add_argument("--sums", type=Path, required=True, help="new SHA256SUMS")
    arguments = parser.parse_args()

    if arguments.command == "check":
        difference = compare(
            {BUNDLE: Expected()},
            published_assets(run_gh, arguments.repo, arguments.tag),
        )
        if not difference.clean:
            print(f"release {arguments.tag} is incomplete: {difference.describe()}")
            return 1
        with tempfile.TemporaryDirectory() as directory:
            run_gh(
                [
                    "release",
                    "download",
                    arguments.tag,
                    "--repo",
                    arguments.repo,
                    "--pattern",
                    BUNDLE,
                    "--dir",
                    directory,
                ]
            )
            if not bundle_matches_manifest(Path(directory) / BUNDLE, arguments.sums):
                print(f"release {arguments.tag} bundle differs from {arguments.sums}")
                return 1
        return 0

    if arguments.bundle.name != BUNDLE:
        raise SystemExit(f"the bundle asset must be named {BUNDLE}")
    expected = expected_from_bundle(arguments.bundle)
    sources = {arguments.bundle.name: arguments.bundle}
    converged = converge(run_gh, arguments.repo, arguments.tag, expected, sources)
    return 0 if converged else 1


if __name__ == "__main__":
    raise SystemExit(main())
