#!/usr/bin/env python3
"""Fail when a recipe references a Model document this library does not hold.

Every Model a recipe selects (targets, drafts, companion and Engram models,
option-specific models) must exist in ``models/`` with the pinned content
digest, and every file the recipe selects must exist in that Model. The check
reads only this checkout, so a broken reference fails the recipe's own pull
request instead of surfacing later in the platform.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import sys
from collections.abc import Iterator
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]


def document_sha256(document: object) -> str:
    """Hash a document like ``vonk_forge_contracts.document_sha256``."""
    canonical = json.dumps(
        document,
        sort_keys=True,
        separators=(",", ":"),
        ensure_ascii=False,
        allow_nan=False,
    ).encode("utf-8")
    return hashlib.sha256(canonical).hexdigest()


def _references(node: object) -> Iterator[dict[str, object]]:
    """Yield every Model reference object, wherever the recipe nests it."""
    if isinstance(node, dict):
        if (
            node.get("kind") == "model"
            and "publisher" in node
            and "slug" in node
            and "content_sha256" in node
        ):
            yield node
        for value in node.values():
            yield from _references(value)
    elif isinstance(node, list):
        for value in node:
            yield from _references(value)


def _selected_files(node: object) -> Iterator[tuple[dict[str, object], str]]:
    """Yield (model reference, file id) for each selection with files."""
    if isinstance(node, dict):
        model = node.get("model")
        files = node.get("files")
        if isinstance(model, dict) and isinstance(files, list):
            for entry in files:
                if isinstance(entry, dict) and isinstance(entry.get("file_id"), str):
                    yield model, str(entry["file_id"])
        for value in node.values():
            yield from _selected_files(value)
    elif isinstance(node, list):
        for value in node:
            yield from _selected_files(value)


def check(root: Path) -> list[str]:
    """Return one message per broken model reference in the library."""
    models: dict[tuple[str, str, str], set[str]] = {}
    slugs: dict[tuple[str, str], list[str]] = {}
    for path in sorted((root / "models").glob("*.json")):
        document = json.loads(path.read_text(encoding="utf-8"))
        identity = document.get("identity", {})
        publisher, slug = identity.get("publisher"), identity.get("slug")
        digest = document_sha256(document)
        models[(str(publisher), str(slug), digest)] = {
            str(entry.get("id")) for entry in document.get("files", [])
        }
        slugs.setdefault((str(publisher), str(slug)), []).append(digest)
    problems: list[str] = []
    for path in sorted((root / "recipes").glob("*.json")):
        document = json.loads(path.read_text(encoding="utf-8"))
        seen: set[tuple[str, str, str]] = set()
        for reference in _references(document):
            key = (
                str(reference["publisher"]),
                str(reference["slug"]),
                str(reference["content_sha256"]),
            )
            if key in seen:
                continue
            seen.add(key)
            if key in models:
                continue
            name = f"{key[0]}/{key[1]}"
            if (key[0], key[1]) in slugs:
                problems.append(
                    f"{path.name}: model {name} is pinned at {key[2]} but "
                    f"models/ holds {', '.join(slugs[(key[0], key[1])])}"
                )
            else:
                problems.append(f"{path.name}: model {name} has no document in models/")
        for reference, file_id in _selected_files(document):
            key = (
                str(reference.get("publisher")),
                str(reference.get("slug")),
                str(reference.get("content_sha256")),
            )
            if key in models and file_id not in models[key]:
                problems.append(
                    f"{path.name}: model {key[0]}/{key[1]} has no file {file_id}"
                )
    return problems


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", type=Path, default=ROOT)
    arguments = parser.parse_args(argv)
    problems = check(arguments.root)
    for problem in problems:
        print(problem, file=sys.stderr)
    return 1 if problems else 0


if __name__ == "__main__":
    raise SystemExit(main())
