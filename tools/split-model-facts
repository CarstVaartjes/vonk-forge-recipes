#!/usr/bin/env python3
"""One-time migration: Model facts leave the hashed Model document (contracts 4.0.0).

    tools/split-model-facts [--base REV]            rewrite this checkout from REV
    tools/split-model-facts --check --base REV      require this checkout to equal that result

REV is the last revision before the split (contracts 3.x). ``capabilities``,
``modalities`` and ``license`` are declared facts a person or a filter reads; no
code selects, mounts, launches or admits by them. They move into the Model's
display (``display/models/<slug>.json``), so ``document_sha256`` covers
execution data only and correcting a fact never re-runs a proven Recipe. The
tool is deleted once the split has landed and the platform pins moved on.

Phase A runs under REV's own contract (``uv run --with-editable`` a ``git
archive`` of REV): every document is parsed strictly and must round-trip; it
yields the moved facts and the stripped execution document through typed
attributes and typed exclusion, and the published status of every recipe key
before the move. Phase B runs under this checkout's contract: the display with
its facts and the stripped document are validated strictly, Model references
are mapped old to new digest (Models leaves first, then Recipes) with
``model_copy``, and everything is written with ``published_json``.

Per document the tool proves that only the three fields were removed (new
document equals the old one minus them, Model references mapped), and per Recipe
that only its Model pins changed, so the execution bytes are identical and the
evidence of the old digest is the evidence of the new one. Only then are evidence
twins appended (never a rewrite: the sweep backfills its history into evidence
on every publish, so a rewrite would be undone), with the note
``CARRIED_MODEL_FACTS``. The memory ledger keeps its old-digest entry at the same
position with the new digest; fixtures carrying a digest are mapped.

The gate: every proven recipe must have a resolved hardware pass on its current
digest, and every key with evidence must derive the same published status
before and after, under every runtime identity its records name.

When REV is already split the tool exits 0 and changes nothing.
"""

from __future__ import annotations

import argparse
import copy
import hashlib
import importlib
import json
import re
import runpy
import subprocess
import sys
import tempfile
from collections.abc import Iterable
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[1]

CANARY = "tests/fixtures/canonical-synthetic-canary"
FAILURES = "tests/fixtures/single-spark-memory-failures"
DIGEST_FIXTURES = (
    "tests/fixtures/sweep-projected-library-2026-10-21.json",
    "tests/fixtures/sweep-verdicts/controller-waits-2026-10-23.json",
)
PROVEN_BYTES = "tests/fixtures/proven-recipe-bytes.json"
# Holds the raw file sha256 of reviewed recipe documents.
NAMED_BY_DIGEST_TESTS = ("tests/test_absolute_kv_capacity.py",)
RAW_BYTES_TESTS = ("tests/test_qualification_case_assertions.py",)
LEDGER = "qualification/memory-inputs.json"
ENVELOPE_EXCEPTIONS = "memory-envelope-exceptions.json"
ARCHIVE_PATHS = (
    "recipes",
    "models",
    "display/models",
    "contracts",
    "qualification/evidence",
    LEDGER,
    ENVELOPE_EXCEPTIONS,
    FAILURES,
    CANARY,
    PROVEN_BYTES,
    *DIGEST_FIXTURES,
    *RAW_BYTES_TESTS,
    *NAMED_BY_DIGEST_TESTS,
)

# The one field list: what leaves a Model document and joins its display.
MOVED = ("modalities", "capabilities", "license")
EXCLUDE: dict[str, Any] = dict.fromkeys(MOVED, True)


def dump(document: object, *, sort: bool = True) -> bytes:
    return (
        json.dumps(document, indent=2, sort_keys=sort, ensure_ascii=False) + "\n"
    ).encode()


# ---------------------------------------------------------------------------
# Phase A: under the base contract
# ---------------------------------------------------------------------------


def _documents(tree: Path) -> list[tuple[str, str]]:
    found = [("recipe", p) for p in sorted((tree / "recipes").glob("*.json"))]
    found += [("model", p) for p in sorted((tree / "models").glob("*.json"))]
    found += [("recipe", p) for p in sorted((tree / FAILURES).glob("*.json"))]
    found += [("model", tree / CANARY / "model.json")]
    found += [("recipe", tree / CANARY / "recipe.json")]
    return [(kind, p.relative_to(tree).as_posix()) for kind, p in found]


def _identity_combinations(evidence: Any, old: str, base: Any) -> list[Any]:
    """Every (source bundle, runtime image) a record on the current digest names, plus none."""

    seen: dict[str, tuple[Any, Any]] = {"none": (None, None)}
    for record in evidence.records:
        if record.identity.content_sha256 == old:
            image = record.identity.runtime_image
            bundle = record.identity.source_bundle_sha256
            seen[f"{bundle}|{image.model_dump_json() if image else ''}"] = (
                bundle,
                image,
            )
    return list(seen.values())


def _view(base: Any, evidence: Any, identity: Any) -> dict[str, Any]:
    """The published status, reduced to what must not move (not the record bytes)."""

    view = base.published_status(evidence, identity)
    return {
        "status": view.status.value,
        "changed": [change.value for change in view.changed],
        "reason": view.reason.value if view.reason else None,
        "required_sparks": view.required_sparks,
        "last_pass": view.last_pass.tested_at.isoformat() if view.last_pass else None,
        "last_failure": (
            view.last_failure.tested_at.isoformat() if view.last_failure else None
        ),
    }


def phase_a(tree: Path, output: Path) -> int:
    base: Any = importlib.import_module("vonk_forge_contracts")
    ModelDefinition, RecipeDefinition = base.ModelDefinition, base.RecipeDefinition
    document_sha256, published_json = base.document_sha256, base.published_json
    Identity, Evidence = base.QualificationIdentity, base.RecipeQualificationEvidence

    result: dict[str, dict[str, Any]] = {}
    for kind, relative in _documents(tree):
        raw = json.loads((tree / relative).read_text(encoding="utf-8"))
        item: dict[str, Any] = {"kind": kind, "old_sha256": document_sha256(raw)}
        if kind == "recipe":
            parsed: Any = RecipeDefinition.model_validate(raw)
            item["stripped"] = parsed.model_dump(mode="json", exclude_unset=True)
            if relative.startswith("recipes/"):
                key = f"{parsed.identity.publisher}/{parsed.identity.slug}"
                path = tree / "qualification/evidence" / f"{key}.json"
                if path.is_file():
                    evidence = Evidence.model_validate_json(path.read_text())
                    old = item["old_sha256"]
                    models = tuple(
                        sorted({s.model.content_sha256 for s in parsed.models})
                    )
                    item["before"] = []
                    for bundle, image in _identity_combinations(evidence, old, base):
                        identity = Identity(
                            content_sha256=old,
                            source_bundle_sha256=bundle,
                            runtime_image=image,
                            model_digests=models,
                            required_sparks=parsed.topology.node_count,
                        )
                        item["before"].append(
                            {
                                "bundle": bundle,
                                "image": image.model_dump(mode="json")
                                if image
                                else None,
                                "view": _view(base, evidence, identity),
                            }
                        )
        else:
            parsed = ModelDefinition.model_validate(raw)
            item["stripped"] = parsed.model_dump(
                mode="json", exclude_unset=True, exclude=EXCLUDE
            )
            item["facts"] = json.loads(
                parsed.model_dump_json(include=set(MOVED), exclude_unset=True)
            )
        if published_json(parsed) != raw:
            raise SystemExit(f"{relative}: the contract does not round-trip it")
        if kind == "model":
            if relative.startswith("models/"):
                display = json.loads(
                    (tree / "display/models" / Path(relative).name).read_text(
                        encoding="utf-8"
                    )
                )
                item["display"] = published_json(
                    base.ModelDisplay.model_validate(display)
                )
            else:
                index = json.loads((tree / CANARY / "index.json").read_text())
                item["display"] = index["catalog_entities"][0]["display"]
        result[relative] = item
    output.write_text(json.dumps(result), encoding="utf-8")
    return 0


# ---------------------------------------------------------------------------
# Phase B: under this checkout's contract
# ---------------------------------------------------------------------------


def _reduced(raw: Any, kind: str, mapping: dict[str, str]) -> Any:
    """The independent proof: the old document minus the moved fields, references mapped."""

    document = copy.deepcopy(raw)
    if kind == "model":
        for name in MOVED:
            document.pop(name)

    def walk(node: Any) -> None:
        if isinstance(node, dict):
            if node.get("kind") == "model" and "content_sha256" in node:
                node["content_sha256"] = mapping[node["content_sha256"]]
            for value in node.values():
                walk(value)
        elif isinstance(node, list):
            for value in node:
                walk(value)

    walk(document)
    return document


def _map_digests(text: str, mapping: dict[str, str]) -> str:
    return re.sub(r'"([0-9a-f]{64})"', lambda m: f'"{mapping.get(m[1], m[1])}"', text)


def compute(tree: Path, phase_a_output: dict[str, dict[str, Any]]) -> dict[str, bytes]:
    """Every managed file of the split result, from the base tree's bytes."""

    import vonk_forge_contracts as contracts
    from vonk_forge_contracts import (
        ModelDefinition,
        ModelDisplay,
        QualificationQualityNote,
        RecipeDefinition,
        RecipeDisplay,
        document_sha256,
        published_json,
    )
    from vonk_forge_contracts.resolver import (
        validate_library,
        validate_model_references,
    )

    from qualification.memory_need import MemoryInputs
    from spark_sweep.qualification import merge_evidence, read_evidence

    expected: dict[str, bytes] = {}
    removed: list[str] = []
    items = phase_a_output
    old_to_model_path = {
        item["old_sha256"]: path
        for path, item in items.items()
        if item["kind"] == "model"
    }
    new_model: dict[str, Any] = {}  # path -> ModelDefinition (4.0, mapped)
    new_display: dict[str, Any] = {}  # path -> ModelDisplay with the moved facts
    mapping: dict[str, str] = {}  # old document digest -> new document digest

    def map_model(path: str) -> None:
        if path in new_model:
            return
        item = items[path]
        model = ModelDefinition.model_validate(item["stripped"])
        references = []
        for reference in model.dependencies:
            map_model(old_to_model_path[reference.content_sha256])
            references.append(
                reference.model_copy(
                    update={"content_sha256": mapping[reference.content_sha256]}
                )
            )
        model = model.model_copy(update={"dependencies": references})
        new_model[path] = model
        mapping[item["old_sha256"]] = document_sha256(published_json(model))
        new_display[path] = ModelDisplay.model_validate(
            {**item["display"], **item["facts"]}
        )

    for path, item in items.items():
        if item["kind"] == "model":
            map_model(path)

    new_recipe: dict[str, Any] = {}
    for path, item in items.items():
        if item["kind"] != "recipe":
            continue
        recipe = RecipeDefinition.model_validate(item["stripped"])
        selections = [
            selection.model_copy(
                update={
                    "model": selection.model.model_copy(
                        update={
                            "content_sha256": mapping[selection.model.content_sha256]
                        }
                    )
                }
            )
            for selection in recipe.models
        ]
        recipe = recipe.model_copy(update={"models": selections})
        new_recipe[path] = recipe
        mapping[item["old_sha256"]] = document_sha256(published_json(recipe))

    _prove_only_moved(new_model, new_recipe, new_display, items, tree, mapping)

    # Library files and the displays that travel with them.
    recipe_displays: dict[str, RecipeDisplay] = {}
    model_displays: dict[str, ModelDisplay] = {}
    library_recipes: list[RecipeDefinition] = []
    library_models: dict[str, ModelDefinition] = {}
    for path, item in items.items():
        if not path.startswith(("recipes/", "models/")):
            continue
        slug = Path(path).stem
        if item["kind"] == "recipe":
            library_recipes.append(new_recipe[path])
            expected[path] = dump(published_json(new_recipe[path]))
            # Recipe displays are untouched by this split.
            recipe_displays[slug] = RecipeDisplay.model_validate_json(
                (ROOT / "display/recipes" / f"{slug}.json").read_text()
            )
        else:
            model_displays[slug] = new_display[path]
            library_models[document_sha256(published_json(new_model[path]))] = (
                new_model[path]
            )
            expected[path] = dump(published_json(new_model[path]))
            expected[f"display/models/{slug}.json"] = dump(
                published_json(new_display[path])
            )
    validate_model_references(library_models)
    validate_library(
        library_recipes, library_models.values(), recipe_displays, model_displays
    )

    # Evidence: base plus twins of every record on a key's old current digest.
    for path in sorted((tree / "qualification/evidence").rglob("*.json")):
        expected[path.relative_to(tree).as_posix()] = path.read_bytes()
    old_digests = {
        f"{r.identity.publisher}/{r.identity.slug}": items[p]["old_sha256"]
        for p, r in new_recipe.items()
        if p.startswith("recipes/")
    }
    twin_count = 0
    twinned: dict[str, Any] = {}
    for key, old in old_digests.items():
        evidence = read_evidence(tree, key)
        current = [r for r in evidence.records if r.identity.content_sha256 == old]
        measured = [m for m in evidence.measured_memory if m.content_sha256 == old]
        if not current and not measured:
            continue
        twins = []
        for record in current:
            models = tuple(sorted({mapping[d] for d in record.identity.model_digests}))
            identity = record.identity.model_copy(
                update={"content_sha256": mapping[old], "model_digests": models}
            )
            twins.append(
                record.model_copy(
                    update={
                        "identity": identity,
                        "quality_notes": (
                            *record.quality_notes,
                            QualificationQualityNote.CARRIED_MODEL_FACTS,
                        ),
                    }
                )
            )
        twin_count += len(twins)
        rows = tuple(
            sorted(
                (
                    m.model_copy(update={"content_sha256": mapping[old]})
                    for m in measured
                ),
                key=lambda m: m.key,
            )
        )
        merged = merge_evidence(
            evidence,
            evidence.model_copy(
                update={"records": tuple(twins), "measured_memory": rows}
            ),
        )
        twinned[key] = merged
        expected[f"qualification/evidence/{key}.json"] = (
            merged.model_dump_json(indent=2, exclude_none=True) + "\n"
        ).encode()

    gate = _status_gate(
        contracts, tree, items, new_recipe, old_digests, mapping, twinned
    )

    # Ledger: the old current digest becomes the new one, at the same position.
    ledger = json.loads((tree / LEDGER).read_text(encoding="utf-8"))
    ledger_edits = 0
    for key, digests in ledger["historical_documents"].items():
        old = old_digests.get(key)
        if old is not None and old in digests:
            digests[digests.index(old)] = mapping[old]
            ledger_edits += 1
    MemoryInputs.model_validate(ledger)
    expected[LEDGER] = dump(ledger, sort=False)

    # Owner-approved envelope exceptions are bound to one exact recipe digest:
    # an entry on a document the split proved unchanged moves to its new digest.
    exceptions = json.loads((tree / ENVELOPE_EXCEPTIONS).read_text(encoding="utf-8"))
    envelope_edits = 0
    for entry in exceptions.values():
        if entry["content_sha256"] in mapping:
            entry["content_sha256"] = mapping[entry["content_sha256"]]
            envelope_edits += 1
    expected[ENVELOPE_EXCEPTIONS] = dump(exceptions)

    # Fixtures that name a digest.
    for relative in DIGEST_FIXTURES:
        text = (tree / relative).read_text(encoding="utf-8")
        expected[relative] = _map_digests(text, mapping).encode()
    # A recorded failure is named by the digest prefix of its document: it moves
    # with the digest, and the test that lists the names follows.
    renamed: dict[str, str] = {}
    for path, recipe in new_recipe.items():
        if path.startswith(FAILURES + "/"):
            old8, new8 = (
                items[path]["old_sha256"][:8],
                mapping[items[path]["old_sha256"]][:8],
            )
            if not path.endswith(f"-{old8}.json"):
                raise SystemExit(f"{path}: not named by its document digest")
            target = path[: -len(f"{old8}.json")] + f"{new8}.json"
            expected[target] = dump(published_json(recipe))
            renamed[old8] = new8
            removed.append(path)
    for relative in NAMED_BY_DIGEST_TESTS:
        text = (tree / relative).read_text(encoding="utf-8")
        for old8, new8 in renamed.items():
            text = text.replace(f'-{old8}"', f'-{new8}"')
        expected[relative] = text.encode()
    raw_bytes = {
        hashlib.sha256((tree / path).read_bytes()).hexdigest(): hashlib.sha256(
            payload
        ).hexdigest()
        for path, payload in expected.items()
        if path.startswith(("recipes/", "models/"))
    }
    for relative in RAW_BYTES_TESTS:
        text = (tree / relative).read_text(encoding="utf-8")
        expected[relative] = _map_digests(text, raw_bytes).encode()
    proven = json.loads((tree / PROVEN_BYTES).read_text(encoding="utf-8"))
    for key in proven:
        proven[key] = hashlib.sha256(
            expected[f"recipes/{key.split('/', 1)[1]}.json"]
        ).hexdigest()
    expected[PROVEN_BYTES] = dump(proven)

    # The canary: documents, its package and the index that names them.
    expected.update(_canary(tree, items, new_model, new_display, new_recipe, mapping))

    expected["__removed__"] = json.dumps(removed).encode()
    expected["__counts__"] = json.dumps(
        {
            "recipes": len(library_recipes),
            "models": len(library_models),
            "twins": twin_count,
            "ledger_edits": ledger_edits,
            "envelope_exception_edits": envelope_edits,
            **gate,
        }
    ).encode()
    return expected


def _prove_only_moved(
    new_model: dict[str, Any],
    new_recipe: dict[str, Any],
    new_display: dict[str, Any],
    items: dict[str, dict[str, Any]],
    tree: Path,
    mapping: dict[str, str],
) -> None:
    """Only the moved fields left a Model, only the pins of a Recipe changed, and
    every moved fact reached its display unchanged."""

    from vonk_forge_contracts import published_json

    for path, document in {**new_model, **new_recipe}.items():
        item = items[path]
        raw = json.loads((tree / path).read_text(encoding="utf-8"))
        if published_json(document) != _reduced(raw, item["kind"], mapping):
            raise SystemExit(f"{path}: more than the moved fields changed")
    for path, display in new_display.items():
        item = items[path]
        moved = published_json(display)
        if {k: v for k, v in moved.items() if k not in MOVED} != item["display"]:
            raise SystemExit(f"{path}: the display changed beyond the moved fields")
        if {name: moved[name] for name in MOVED} != item["facts"]:
            raise SystemExit(f"{path}: a moved fact was not carried unchanged")


def _status_gate(
    contracts: Any,
    tree: Path,
    items: dict[str, dict[str, Any]],
    new_recipe: dict[str, Any],
    old_digests: dict[str, str],
    mapping: dict[str, str],
    twinned: dict[str, Any],
) -> dict[str, int]:
    """Every proven recipe has a resolved pass; every status survives the move."""

    from spark_sweep.qualification import read_evidence

    proven = json.loads((tree / PROVEN_BYTES).read_text(encoding="utf-8"))
    lacking = []
    for key in sorted(proven):
        old = old_digests.get(key)
        records = read_evidence(tree, key).records
        if old is None or not any(
            r.identity.content_sha256 == old
            and r.outcome == contracts.QualificationOutcome.PASSED
            and r.identity.resolved
            and r.platform.resolved
            for r in records
        ):
            lacking.append(key)
    if lacking:
        raise SystemExit(
            f"{len(lacking)} proven recipes lack a resolved pass on their current "
            f"digest (carry nothing blind): {', '.join(lacking[:5])}"
        )

    compared = working = 0
    proven_working: set[str] = set()
    for path, recipe in new_recipe.items():
        if not path.startswith("recipes/") or "before" not in items[path]:
            continue
        key = f"{recipe.identity.publisher}/{recipe.identity.slug}"
        evidence = twinned.get(key) or read_evidence(tree, key)
        models = tuple(sorted({s.model.content_sha256 for s in recipe.models}))
        for before in items[path]["before"]:
            image = (
                contracts.QualificationRuntimeImage.model_validate(before["image"])
                if before["image"]
                else None
            )
            identity = contracts.QualificationIdentity(
                content_sha256=mapping[items[path]["old_sha256"]],
                source_bundle_sha256=before["bundle"],
                runtime_image=image,
                model_digests=models,
                required_sparks=recipe.topology.node_count,
            )
            view = contracts.published_status(evidence, identity)
            after = {
                "status": view.status.value,
                "changed": [c.value for c in view.changed],
                "reason": view.reason.value if view.reason else None,
                "required_sparks": view.required_sparks,
                "last_pass": view.last_pass.tested_at.isoformat()
                if view.last_pass
                else None,
                "last_failure": view.last_failure.tested_at.isoformat()
                if view.last_failure
                else None,
            }
            if after != before["view"]:
                raise SystemExit(
                    f"{key}: published status moved with the split: "
                    f"{before['view']} -> {after}"
                )
            compared += 1
            if after["status"] == contracts.QualificationStatus.WORKING.value:
                working += 1
                proven_working.add(key)
    if unproven := sorted(set(proven) - proven_working):
        raise SystemExit(
            f"{len(unproven)} proven recipes are not Working after the split: "
            f"{', '.join(unproven[:5])}"
        )
    return {
        "statuses_compared": compared,
        "statuses_working": working,
        "proven_working": len(proven_working & set(proven)),
    }


def _canary(
    tree: Path,
    items: dict[str, dict[str, Any]],
    new_model: dict[str, Any],
    new_display: dict[str, Any],
    new_recipe: dict[str, Any],
    mapping: dict[str, str],
) -> dict[str, bytes]:
    from vonk_forge_contracts import CONTRACT_VERSION, document_sha256, published_json

    model_path, recipe_path = f"{CANARY}/model.json", f"{CANARY}/recipe.json"
    model: dict[str, Any] = published_json(new_model[model_path])
    recipe: dict[str, Any] = published_json(new_recipe[recipe_path])
    tool = runpy.run_path(str(ROOT / "tools/build-catalog-index"))
    key = f"{model['identity']['publisher']}/{model['identity']['slug']}"
    payload, metadata = tool["recipe_package"](
        recipe, recipe_path=ROOT / recipe_path, entity_documents={key: model}
    )
    index = json.loads((tree / CANARY / "index.json").read_text(encoding="utf-8"))
    entry, entity = index["recipes"][0], index["catalog_entities"][0]
    index["contract_version"] = CONTRACT_VERSION
    entry.update(
        document=recipe,
        content_sha256=document_sha256(recipe),
        package={**metadata, "path": entry["package"]["path"]},
    )
    entity.update(
        document=model,
        content_sha256=document_sha256(model),
        display=published_json(new_display[model_path]),
    )
    return {
        model_path: dump(model, sort=False),
        recipe_path: dump(recipe, sort=False),
        f"{CANARY}/index.json": (
            json.dumps(index, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
            + "\n"
        ).encode(),
        entry["package"]["path"]: payload,
    }


# ---------------------------------------------------------------------------
# Driver
# ---------------------------------------------------------------------------


def _git(*args: str) -> bytes:
    return subprocess.run(
        ["git", *args], cwd=ROOT, check=True, capture_output=True
    ).stdout


def _already_split(revision: str) -> bool:
    name = _git("ls-tree", "--name-only", revision, "models/").decode().split()[0]
    return b'"capabilities"' not in _git("show", f"{revision}:{name}")


def _managed_actual() -> Iterable[str]:
    for pattern in (
        "recipes/*.json",
        "models/*.json",
        "display/models/*.json",
        "qualification/evidence/**/*.json",
    ):
        for path in ROOT.glob(pattern):
            yield path.relative_to(ROOT).as_posix()


def main() -> int:
    parser = argparse.ArgumentParser(description=(__doc__ or "").splitlines()[0])
    parser.add_argument("--base", default="origin/main")
    parser.add_argument("--check", action="store_true")
    parser.add_argument(
        "--base-is-split",
        action="store_true",
        help="exit 0 when --base already holds the split, 1 when it does not",
    )
    parser.add_argument("--phase-a", nargs=2, metavar=("TREE", "OUTPUT"))
    arguments = parser.parse_args()
    if arguments.phase_a:
        # Phase A must see only the base contract the caller installed.
        return phase_a(Path(arguments.phase_a[0]), Path(arguments.phase_a[1]))
    sys.path[:0] = [str(ROOT / "contracts" / "src"), str(ROOT)]
    revision = (
        _git("rev-parse", "--verify", f"{arguments.base}^{{commit}}").decode().strip()
    )
    if arguments.base_is_split:
        return 0 if _already_split(revision) else 1
    if _already_split(revision):
        print("base already split; nothing to check")
        return 0
    with tempfile.TemporaryDirectory(prefix="split-model-facts-") as scratch:
        tree = Path(scratch) / "base"
        tree.mkdir()
        archive = subprocess.run(
            ["git", "archive", revision, *ARCHIVE_PATHS],
            cwd=ROOT,
            check=True,
            capture_output=True,
        ).stdout
        subprocess.run(["tar", "-x", "-C", str(tree)], input=archive, check=True)
        output = Path(scratch) / "phase-a.json"
        subprocess.run(
            [
                "uv",
                "run",
                "--no-project",
                "--quiet",
                "--python",
                "3.14",
                "--with-editable",
                str(tree / "contracts"),
                "python",
                str(Path(__file__).resolve()),
                "--phase-a",
                str(tree),
                str(output),
            ],
            check=True,
        )
        expected = compute(tree, json.loads(output.read_text(encoding="utf-8")))
    counts = json.loads(expected.pop("__counts__"))
    removed = json.loads(expected.pop("__removed__"))
    managed = {
        path
        for path in expected
        if path.startswith(
            ("recipes/", "models/", "display/", "qualification/evidence/")
        )
    }
    if arguments.check:
        leftover = [path for path in removed if (ROOT / path).exists()]
        if leftover:
            print(
                f"split-model-facts: not part of the split result: {leftover[0]}",
                file=sys.stderr,
            )
            return 1
        extra = sorted(set(_managed_actual()) - managed)
        if extra:
            print(
                f"split-model-facts: not part of the split result: {extra[0]}",
                file=sys.stderr,
            )
            return 1
        for path, payload in sorted(expected.items()):
            target = ROOT / path
            if not target.is_file() or target.read_bytes() != payload:
                print(
                    f"split-model-facts: differs from the split result: {path}",
                    file=sys.stderr,
                )
                return 1
        print(
            f"split-model-facts: the checkout equals the split of {revision[:12]} {counts}"
        )
        return 0
    for path, payload in sorted(expected.items()):
        target = ROOT / path
        target.parent.mkdir(parents=True, exist_ok=True)
        if not target.is_file() or target.read_bytes() != payload:
            target.write_bytes(payload)
    for path in removed:
        (ROOT / path).unlink(missing_ok=True)
    print(f"split-model-facts: wrote the split of {revision[:12]} {counts}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
