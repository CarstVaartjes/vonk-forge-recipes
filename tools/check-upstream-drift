ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "contracts" / "src"))
from vonk_forge_contracts import ModelDefinition, RecipeDefinition

DEFAULT_MANIFEST = ROOT / "upstream-watch.json"
SHA = re.compile(r"^[0-9a-f]{40}$")
REPOSITORY_PART = re.compile(r"^[A-Za-z0-9_.-]+$")
ENTITY_DIRECTORIES = {
    "models": "model",
}
POLICIES = {"default-branch", "latest-release", "manual"}
MAX_RESPONSE_BYTES = 4 * 1024 * 1024


class DriftInputError(RuntimeError):
    """The local watch configuration or a catalog source is invalid."""


class RemoteNotFound(RuntimeError):
    """The provider reports that a repository, revision, or release is absent."""


@dataclass(frozen=True, slots=True)
class SourceLocation:
    provider: str
    repository: str
    embedded_revision: str | None = None


@dataclass(frozen=True, slots=True)
class Watch:
    entity: str
    source_path: str
    provider: str
    repository: str
    pinned_revision: str
    pinned_version: str | None
    policy: str
    ref: str | None


@dataclass(frozen=True, slots=True)
class Observation:
    entity: str
    source_path: str
    provider: str
    repository: str
    policy: str
    ref: str | None
    pinned_revision: str
    pinned_version: str | None
    observed_revision: str | None
    observed_version: str | None
    observed_at: str | None
    upstream_url: str | None
    status: str
    detail: str | None


def _repository_parts(path: str) -> tuple[str, str] | None:
    parts = [part for part in path.split("/") if part]
    if len(parts) < 2:
        return None
    owner, repository = parts[:2]
    repository = repository.removesuffix(".git")
    if not REPOSITORY_PART.fullmatch(owner) or not REPOSITORY_PART.fullmatch(
        repository
    ):
        return None
    return owner, repository


def parse_source(value: str) -> SourceLocation:
    """Normalize the GitHub and Hugging Face forms present in catalog metadata."""

    if re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", value):
        return SourceLocation("huggingface", value)
    parsed = urlsplit(value)
    if parsed.scheme != "https" or parsed.username or parsed.password:
        raise DriftInputError(f"source must be a public HTTPS URL: {value}")
    if parsed.query or parsed.fragment:
        raise DriftInputError(
            f"source URL must not contain a query or fragment: {value}"
        )
    host = (parsed.hostname or "").lower()
    parts = [part for part in parsed.path.split("/") if part]
    if host == "github.com":
        supported_length = len(parts) in {2, 4} or (
            len(parts) >= 5 and parts[2] == "blob"
        )
        if not supported_length or not REPOSITORY_PART.fullmatch(parts[0]):
            raise DriftInputError(f"GitHub source repository is invalid: {value}")
        owner, repository = parts[:2]
        repository = repository.removesuffix(".git")
        embedded: str | None = None
        legacy = re.fullmatch(r"(.+)@([0-9a-f]{40})", repository)
        if legacy is not None:
            repository, embedded = legacy.groups()
            repository = repository.removesuffix(".git")
        elif (
            len(parts) == 4
            and parts[2] in {"tree", "commit"}
            and SHA.fullmatch(parts[3])
        ) or (len(parts) >= 5 and parts[2] == "blob" and SHA.fullmatch(parts[3])):
            embedded = parts[3]
        elif len(parts) != 2:
            raise DriftInputError(f"GitHub source URL form is unsupported: {value}")
        if not REPOSITORY_PART.fullmatch(repository):
            raise DriftInputError(f"GitHub source repository is invalid: {value}")
        return SourceLocation("github", f"{owner}/{repository}", embedded)
    if host == "huggingface.co":
        repository_parts = _repository_parts(parsed.path)
        if repository_parts is None:
            raise DriftInputError(f"Hugging Face source repository is invalid: {value}")
        owner, repository = repository_parts
        embedded = None
        tree_revision = (
            len(parts) == 4 and parts[2] == "tree" and SHA.fullmatch(parts[3])
        )
        resolved_file = (
            len(parts) >= 5 and parts[2] == "resolve" and SHA.fullmatch(parts[3])
        )
        if tree_revision or resolved_file:
            embedded = parts[3]
        elif len(parts) != 2:
            raise DriftInputError(
                f"Hugging Face source URL form is unsupported: {value}"
            )
        return SourceLocation("huggingface", f"{owner}/{repository}", embedded)
    return SourceLocation(host or "unsupported", value)


def _identity(document: object, path: Path, expected_kind: str) -> tuple[str, str]:
    if not isinstance(document, dict):
        raise DriftInputError(f"catalog kind is invalid: {path}")
    actual_kind = document.get("kind")
    if actual_kind != expected_kind:
        raise DriftInputError(f"catalog kind is invalid: {path}")
    identity = document.get("identity")
    if not isinstance(identity, dict):
        raise DriftInputError(f"catalog identity is missing: {path}")
    publisher, slug = identity.get("publisher"), identity.get("slug")
    if not isinstance(publisher, str) or not isinstance(slug, str):
        raise DriftInputError(f"catalog identity is invalid: {path}")
    return publisher, slug


def load_manifest(path: Path) -> tuple[dict[str, str], dict[str, dict[str, str]]]:
    try:
        document = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise DriftInputError(
            f"cannot read upstream watch manifest: {path}: {error}"
        ) from error
    if not isinstance(document, dict) or set(document) != {
        "schema_version",
        "defaults",
        "overrides",
    }:
        raise DriftInputError("upstream watch manifest has unexpected fields")
    defaults, overrides = document.get("defaults"), document.get("overrides")
    if (
        document.get("schema_version") != 1
        or not isinstance(defaults, dict)
        or not isinstance(overrides, dict)
    ):
        raise DriftInputError("upstream watch manifest is invalid")
    clean_defaults: dict[str, str] = {}
    for provider, policy in defaults.items():
        if not isinstance(provider, str) or policy not in POLICIES:
            raise DriftInputError(f"invalid default watch policy for {provider}")
        clean_defaults[provider] = policy
    clean_overrides: dict[str, dict[str, str]] = {}
    for entity, override in overrides.items():
        if not isinstance(entity, str) or not isinstance(override, dict):
            raise DriftInputError("upstream watch override is invalid")
        if set(override) - {"policy", "ref"}:
            raise DriftInputError(
                f"upstream watch override has unexpected fields: {entity}"
            )
        policy, ref = override.get("policy"), override.get("ref")
        if policy not in POLICIES or (ref is not None and not isinstance(ref, str)):
            raise DriftInputError(f"upstream watch override is invalid: {entity}")
        if policy == "latest-release" and ref is not None:
            raise DriftInputError(
                f"latest-release override cannot select a ref: {entity}"
            )
        clean_overrides[entity] = {
            "policy": policy,
            **({"ref": ref} if ref is not None else {}),
        }
    return clean_defaults, clean_overrides


def _watch(
    *,
    entity: str,
    source_path: Path,
    source_value: str,
    revision: str,
    version: str | None,
    root: Path,
    defaults: dict[str, str],
    overrides: dict[str, dict[str, str]],
) -> Watch:
    if not SHA.fullmatch(revision):
        raise DriftInputError(
            f"source revision is not an immutable Git commit: {source_path}"
        )
    location = parse_source(source_value)
    if (
        location.embedded_revision is not None
        and location.embedded_revision != revision
    ):
        raise DriftInputError(f"source URL and revision disagree: {source_path}")
    override = overrides.get(entity, {})
    policy = override.get("policy", defaults.get(location.provider, "manual"))
    ref = override.get("ref")
    if policy == "latest-release" and location.provider != "github":
        raise DriftInputError(f"latest-release is only supported for GitHub: {entity}")
    return Watch(
        entity=entity,
        source_path=source_path.relative_to(root).as_posix(),
        provider=location.provider,
        repository=location.repository,
        pinned_revision=revision,
        pinned_version=version,
        policy=policy,
        ref=ref,
    )


def discover_watches(
    root: Path,
    defaults: dict[str, str],
    overrides: dict[str, dict[str, str]],
) -> list[Watch]:
    watches: list[Watch] = []
    discovered_entities: set[str] = set()
    for directory, expected_kind in ENTITY_DIRECTORIES.items():
        for path in sorted((root / directory).glob("*.json")):
            document = json.loads(path.read_text(encoding="utf-8"))
            try:
                if expected_kind == "model":
                    document = ModelDefinition.model_validate(document).model_dump(
                        mode="json"
                    )
                else:
                    document = RecipeDefinition.model_validate(document).model_dump(
                        mode="json"
                    )
            except Exception as error:
                raise DriftInputError(
                    f"catalog contract is invalid: {path}: {error}"
                ) from error
            publisher, slug = _identity(document, path, expected_kind)
            entity = f"{expected_kind}/{publisher}/{slug}"
            discovered_entities.add(entity)
            source = document.get("source")
            if not isinstance(source, dict):
                continue
            repository, revision = source.get("repository"), source.get("revision")
            if not isinstance(repository, str) or not isinstance(revision, str):
                raise DriftInputError(f"catalog source is incomplete: {path}")
            location = parse_source(repository)
            watches.append(
                _watch(
                    entity=entity,
                    source_path=path,
                    source_value=repository,
                    revision=revision,
                    version=None,
                    root=root,
                    defaults=defaults,
                    overrides=overrides,
                )
            )
    for path in sorted((root / "recipes").glob("*.json")):
        document = json.loads(path.read_text(encoding="utf-8"))
        try:
            document = RecipeDefinition.model_validate(document).model_dump(mode="json")
        except Exception as error:
            raise DriftInputError(
                f"catalog contract is invalid: {path}: {error}"
            ) from error
        publisher, slug = _identity(document, path, "recipe")
        entity = f"recipe/{publisher}/{slug}"
        discovered_entities.add(entity)
        provenance = document.get("provenance")
        reference = (
            provenance.get("source_reference") if isinstance(provenance, dict) else None
        )
        if not isinstance(reference, str):
            continue
        location = parse_source(reference)
        if location.embedded_revision is None:
            raise DriftInputError(
                f"recipe provenance does not pin a Git revision: {path}"
            )
        watches.append(
            _watch(
                entity=entity,
                source_path=path,
                source_value=reference,
                revision=location.embedded_revision,
                version=None,
                root=root,
                defaults=defaults,
                overrides=overrides,
            )
        )
    unknown_overrides = sorted(set(overrides) - discovered_entities)
    if unknown_overrides:
        raise DriftInputError(
            f"watch override names unknown entity: {unknown_overrides[0]}"
        )
    return sorted(watches, key=lambda watch: (watch.entity, watch.repository))


class ProviderClient:
    def __init__(
        self,
        *,
        github_token: str | None = None,
        huggingface_token: str | None = None,
        opener: Callable[..., AbstractContextManager[Any]] = urlopen,
    ) -> None:
        self.github_token = github_token
        self.huggingface_token = huggingface_token
        self.opener = opener
        self.cache: dict[str, object] = {}

    def json(self, url: str, provider: str) -> object:
        cached = self.cache.get(url)
        if cached is not None:
            return cached
        headers = {
            "Accept": "application/vnd.github+json"
            if provider == "github"
            else "application/json",
            "User-Agent": "vonk-forge-upstream-drift/1",
        }
        token = self.github_token if provider == "github" else self.huggingface_token
        if token:
            headers["Authorization"] = f"Bearer {token}"
        if provider == "github":
            headers["X-GitHub-Api-Version"] = "2022-11-28"
        request = Request(url, headers=headers)
        for attempt in range(3):
            try:
                with self.opener(request, timeout=20) as response:
                    payload = response.read(MAX_RESPONSE_BYTES + 1)
                if len(payload) > MAX_RESPONSE_BYTES:
                    raise RuntimeError(
                        f"provider response exceeds {MAX_RESPONSE_BYTES} bytes"
                    )
                value = json.loads(payload)
                self.cache[url] = value
                return value
            except HTTPError as error:
                if error.code == 404:
                    raise RemoteNotFound(url) from error
                if error.code not in {429, 500, 502, 503, 504} or attempt == 2:
                    raise RuntimeError(
                        f"provider returned HTTP {error.code}"
                    ) from error
                retry_after = error.headers.get("Retry-After")
                time.sleep(min(float(retry_after or attempt + 1), 5.0))
            except (URLError, TimeoutError, json.JSONDecodeError) as error:
                if attempt == 2:
                    raise RuntimeError(f"provider request failed: {error}") from error
                time.sleep(attempt + 1)
        raise RuntimeError("provider request failed")


def _required_string(document: object, key: str, context: str) -> str:
    value = document.get(key) if isinstance(document, dict) else None
    if not isinstance(value, str) or not value:
        raise RuntimeError(f"provider response is missing {context}.{key}")
    return value


def _github_commit(
    client: ProviderClient, repository: str, ref: str
) -> tuple[str, str | None, str]:
    encoded = quote(ref, safe="")
    document = client.json(
        f"https://api.github.com/repos/{repository}/commits/{encoded}", "github"
    )
    revision = _required_string(document, "sha", "commit")
    url = _required_string(document, "html_url", "commit")
    commit = document.get("commit") if isinstance(document, dict) else None
    committer = commit.get("committer") if isinstance(commit, dict) else None
    observed_at = committer.get("date") if isinstance(committer, dict) else None
    return revision, observed_at if isinstance(observed_at, str) else None, url


def _pinned_exists(client: ProviderClient, watch: Watch) -> bool:
    try:
        if watch.provider == "github":
            _github_commit(client, watch.repository, watch.pinned_revision)
        elif watch.provider == "huggingface":
            repository = quote(watch.repository, safe="/")
            client.json(
                f"https://huggingface.co/api/models/{repository}/revision/{watch.pinned_revision}",
                "huggingface",
            )
        else:
            return True
    except RemoteNotFound:
        return False
    return True


def observe(watch: Watch, client: ProviderClient) -> Observation:
    common = {
        "entity": watch.entity,
        "source_path": watch.source_path,
        "provider": watch.provider,
        "repository": watch.repository,
        "policy": watch.policy,
        "ref": watch.ref,
        "pinned_revision": watch.pinned_revision,
        "pinned_version": watch.pinned_version,
    }
    if watch.policy == "manual" or watch.provider not in {"github", "huggingface"}:
        return Observation(
            **common,
            observed_revision=None,
            observed_version=None,
            observed_at=None,
            upstream_url=None,
            status="untracked",
            detail="no automated upstream policy",
        )
    try:
        observed_version: str | None = None
        if watch.provider == "github":
            if watch.policy == "latest-release":
                release = client.json(
                    f"https://api.github.com/repos/{watch.repository}/releases/latest",
                    "github",
                )
                ref = _required_string(release, "tag_name", "release")
                observed_version = ref
                revision, observed_at, upstream_url = _github_commit(
                    client, watch.repository, ref
                )
            else:
                ref = watch.ref
                if ref is None:
                    repository = client.json(
                        f"https://api.github.com/repos/{watch.repository}", "github"
                    )
                    ref = _required_string(repository, "default_branch", "repository")
                revision, observed_at, upstream_url = _github_commit(
                    client, watch.repository, ref
                )
        else:
            repository = quote(watch.repository, safe="/")
            suffix = f"/revision/{quote(watch.ref, safe='')}" if watch.ref else ""
            document = client.json(
                f"https://huggingface.co/api/models/{repository}{suffix}",
                "huggingface",
            )
            revision = _required_string(document, "sha", "model")
            observed_at_value = (
                document.get("lastModified") if isinstance(document, dict) else None
            )
            observed_at = (
                observed_at_value if isinstance(observed_at_value, str) else None
            )
            upstream_url = f"https://huggingface.co/{watch.repository}/tree/{revision}"
        if not SHA.fullmatch(revision):
            raise RuntimeError("provider returned a non-Git revision")
        status = "current" if revision == watch.pinned_revision else "advanced"
        detail = None
        if status == "advanced" and not _pinned_exists(client, watch):
            status = "missing"
            detail = "pinned revision is no longer resolvable"
        return Observation(
            **common,
            observed_revision=revision,
            observed_version=observed_version,
            observed_at=observed_at,
            upstream_url=upstream_url,
            status=status,
            detail=detail,
        )
    except RemoteNotFound:
        return Observation(
            **common,
            observed_revision=None,
            observed_version=None,
            observed_at=None,
            upstream_url=None,
            status="missing",
            detail="upstream repository, release, or revision was not found",
        )
    except RuntimeError as error:
        return Observation(
            **common,
            observed_revision=None,
            observed_version=None,
            observed_at=None,
            upstream_url=None,
            status="error",
            detail=str(error)[:256],
        )


def report(
    observations: list[Observation],
    checked_at: str,
    embedded: dict[str, object] | None = None,
) -> dict[str, object]:
    counts = Counter(observation.status for observation in observations)
    return {
        "schema_version": 2,
        "checked_at": checked_at,
        "counts": {
            status: counts.get(status, 0)
            for status in ("current", "advanced", "missing", "untracked", "error")
        },
        "observations": [asdict(observation) for observation in observations],
        "embedded_inputs": embedded
        or {"coverage": {"scope": "not collected"}, "recipes": []},
    }


def _logical_dockerfile_lines(text: str) -> list[tuple[int, str]]:
    """Join Dockerfile continuations while retaining their first source line."""
    result: list[tuple[int, str]] = []
    start = 0
    current = ""
    for number, raw in enumerate(text.splitlines(), 1):
        line = raw.strip()
        if not current:
            start = number
        current += (" " if current else "") + line.rstrip("\\").strip()
        if line.endswith("\\"):
            continue
        if current:
            result.append((start, current))
        current = ""
    if current:
        result.append((start, current))
    return result


def embedded_inventory(root: Path, watches: list[Watch]) -> dict[str, object]:
    """Inventory recipe inputs that the upstream-ref watch cannot resolve.

    This is deliberately evidence-only: digest pins and embedded Git commits
    have no implied "latest" channel. A source with no configured watch is
    reported with a reason instead of being counted as current.
    """
    watch_entities = {watch.entity for watch in watches if watch.policy != "manual"}
    recipes: list[dict[str, object]] = []
    counts: Counter[str] = Counter()

    def add(inputs: list[dict[str, object]], item: dict[str, object]) -> None:
        inputs.append(item)
        counts[str(item["status"])] += 1

    for path in sorted((root / "recipes").glob("*.json")):
        try:
            document = RecipeDefinition.model_validate(
                json.loads(path.read_text(encoding="utf-8"))
            ).model_dump(mode="json")
        except Exception as error:
            raise DriftInputError(
                f"catalog contract is invalid: {path}: {error}"
            ) from error
        publisher, slug = _identity(document, path, "recipe")
        entity = f"recipe/{publisher}/{slug}"
        inputs: list[dict[str, object]] = []
        build = document.get("execution", {}).get("build", {})
        dockerfile_value = build.get("dockerfile") if isinstance(build, dict) else None
        dockerfile = (
            root / dockerfile_value if isinstance(dockerfile_value, str) else None
        )
        if dockerfile is None or not dockerfile.is_file():
            add(
                inputs,
                {
                    "kind": "dockerfile",
                    "path": dockerfile_value,
                    "status": "unknown",
                    "reason": "the recipe's build Dockerfile is unavailable for local inspection",
                },
            )
        else:
            dockerfile_rel = dockerfile.relative_to(root).as_posix()
            args: dict[str, str] = {}
            stages: set[str] = set()
            from_count = 0
            saw_from = False
            for line_number, line in _logical_dockerfile_lines(
                dockerfile.read_text(encoding="utf-8")
            ):
                arg = re.match(
                    r"^ARG\s+([A-Za-z_][A-Za-z0-9_]*)(?:=(.*))?$", line, re.IGNORECASE
                )
                if arg:
                    if not saw_from:
                        args.setdefault(arg.group(1), (arg.group(2) or "").strip())
                    continue
                if not re.match(r"^FROM\s+", line, re.IGNORECASE):
                    continue
                from_count += 1
                saw_from = True
                try:
                    tokens = shlex.split(line, comments=True)
                except ValueError:
                    tokens = []
                image_index = 1
                while image_index < len(tokens) and tokens[image_index].startswith(
                    "--"
                ):
                    image_index += 1
                raw_image = tokens[image_index] if image_index < len(tokens) else ""
                image = re.sub(
                    r"\$\{?([A-Za-z_][A-Za-z0-9_]*)\}?",
                    lambda match, mapping=args: mapping.get(
                        match.group(1), match.group(0)
                    ),
                    raw_image,
                )
                alias = None
                if "AS" in [token.upper() for token in tokens]:
                    as_index = [token.upper() for token in tokens].index("AS")
                    if as_index + 1 < len(tokens):
                        alias = tokens[as_index + 1].lower()
                if raw_image.lower() in stages:
                    stages.add(alias.lower() if alias else raw_image.lower())
                    continue
                if raw_image.lower() == "scratch":
                    status = "builtin"
                    reason = "Docker's built-in scratch stage has no external registry source"
                elif "$" in image:
                    status = "unknown"
                    reason = "FROM uses an ARG without a locally resolvable default"
                elif "@sha256:" in image:
                    status = "pin_only"
                    reason = "immutable OCI digest has no configured moving channel; availability is not drift"
                else:
                    status = "mutable"
                    reason = "FROM is not resolved to an immutable digest"
                add(
                    inputs,
                    {
                        "kind": "docker-image",
                        "path": dockerfile_rel,
                        "line": line_number,
                        "reference": image or raw_image,
                        "status": status,
                        "reason": reason,
                    },
                )
                if alias:
                    stages.add(alias.lower())
            if from_count == 0:
                add(
                    inputs,
                    {
                        "kind": "dockerfile",
                        "path": dockerfile_rel,
                        "status": "unknown",
                        "reason": "no FROM instruction was recognized by the inventory parser",
                    },
                )

            for line_number, line in _logical_dockerfile_lines(
                dockerfile.read_text(encoding="utf-8")
            ):
                if re.match(r"^ARG\s+", line, re.IGNORECASE):
                    match = re.match(
                        r"^ARG\s+([A-Za-z_][A-Za-z0-9_]*)(?:=(.*))?$",
                        line,
                        re.IGNORECASE,
                    )
                    if match and re.search(
                        r"(?:COMMIT|REVISION|REF|VERSION|SHA256)$",
                        match.group(1),
                        re.IGNORECASE,
                    ):
                        value = (match.group(2) or "").strip()
                        status = "pinned_untracked" if value else "unknown"
                        add(
                            inputs,
                            {
                                "kind": "docker-arg",
                                "path": dockerfile_rel,
                                "line": line_number,
                                "name": match.group(1),
                                "value": value or None,
                                "status": status,
                                "reason": "build ARG is embedded in the Dockerfile and has no independent watch policy",
                            },
                        )
                if re.search(
                    r"\b(?:apt(?:-get)?\s+install|pip(?:3)?\s+install|uv\s+pip\s+install|git\s+clone)\b",
                    line,
                    re.IGNORECASE,
                ):
                    kind = (
                        "git-source"
                        if re.search(r"\bgit\s+clone\b", line, re.IGNORECASE)
                        else "native-or-python-package"
                    )
                    add(
                        inputs,
                        {
                            "kind": kind,
                            "path": dockerfile_rel,
                            "line": line_number,
                            "command_sha256": hashlib.sha256(line.encode()).hexdigest(),
                            "status": "unknown",
                            "reason": "the command's resolved source/version closure is not derived from recipe provenance",
                        },
                    )
                if re.search(r"\b(?:curl|wget|git\s+clone)\b", line, re.IGNORECASE):
                    urls = re.findall(r"https?://[^\s\"'<>]+", line)
                    for url in urls:
                        parsed_url = urlsplit(url)
                        safe_url = (
                            f"{parsed_url.scheme}://{parsed_url.hostname or ''}"
                            f"{parsed_url.path}"
                        )
                        resolved = re.sub(
                            r"\$\{?([A-Za-z_][A-Za-z0-9_]*)\}?",
                            lambda match, mapping=args: mapping.get(
                                match.group(1), match.group(0)
                            ),
                            safe_url,
                        )
                        pinned_commit = bool(
                            re.search(r"[0-9a-f]{40}", resolved, re.IGNORECASE)
                        )
                        source_parts = [
                            part for part in parsed_url.path.split("/") if part
                        ]
                        embedded_repository = None
                        embedded_revision = None
                        if (parsed_url.hostname or "").lower() in {
                            "codeload.github.com",
                            "github.com",
                        } and len(source_parts) >= 3:
                            embedded_repository = "/".join(
                                source_parts[:2]
                            ).removesuffix(".git")
                            revision_match = re.search(
                                r"[0-9a-f]{40}", resolved, re.IGNORECASE
                            )
                            if revision_match:
                                embedded_revision = revision_match.group(0).lower()
                            if embedded_revision is None:
                                for variable in re.findall(
                                    r"\$\{?([A-Za-z_][A-Za-z0-9_]*)\}?", line
                                ):
                                    candidate = args.get(variable, "")
                                    if SHA.fullmatch(candidate):
                                        embedded_revision = candidate
                                        break
                        add(
                            inputs,
                            {
                                "kind": (
                                    "git-source"
                                    if re.search(
                                        r"\bgit\s+clone\b", line, re.IGNORECASE
                                    )
                                    else "download-source"
                                ),
                                "path": dockerfile_rel,
                                "line": line_number,
                                "url": resolved,
                                "repository": embedded_repository,
                                "revision": embedded_revision,
                                "status": "pinned_untracked"
                                if pinned_commit
                                else "unknown",
                                "reason": (
                                    "URL resolves to an embedded Git commit but has no independent watch policy"
                                    if pinned_commit
                                    else "download URL does not resolve to an immutable source revision"
                                ),
                            },
                        )

        runtime = document.get("runtime")
        options = document.get("options", [])
        for label, value in (
            ("launch-defaults", runtime),
            ("runtime-options", options),
        ):
            if value:
                digest = hashlib.sha256(
                    json.dumps(value, sort_keys=True, separators=(",", ":")).encode()
                ).hexdigest()
                add(
                    inputs,
                    {
                        "kind": label,
                        "path": path.relative_to(root).as_posix(),
                        "sha256": digest,
                        "status": "catalogued",
                        "reason": "recipe-owned launch inputs are preserved as evidence; upstream mapping is not inferred",
                    },
                )
        patches = build.get("patches", []) if isinstance(build, dict) else []
        for patch in patches if isinstance(patches, list) else []:
            patch_path = patch.get("path") if isinstance(patch, dict) else None
            context_path = build.get("context", {}).get("path", "")
            patch_file = (
                root / context_path / patch_path
                if isinstance(patch_path, str)
                else None
            )
            if patch_file is not None and patch_file.is_file():
                patch_display_path = patch_file.relative_to(root).as_posix()
                patch_digest = hashlib.sha256(patch_file.read_bytes()).hexdigest()
                patch_status = "catalogued"
                patch_reason = "local patch bytes are inventoried, but no upstream mapping is inferred"
            else:
                patch_display_path = patch_path
                patch_digest = None
                patch_status = "unknown"
                patch_reason = (
                    "declared patch file is not present under the build context"
                )
            add(
                inputs,
                {
                    "kind": "build-patch",
                    "path": patch_display_path,
                    "sha256": patch_digest,
                    "status": patch_status,
                    "reason": patch_reason,
                },
            )
        model_entities: set[str] = set()
        for selection in document.get("models", []):
            model = selection.get("model", {}) if isinstance(selection, dict) else {}
            model_slug = model.get("slug") if isinstance(model, dict) else None
            if not isinstance(model_slug, str):
                continue
            model_path = root / "models" / f"{model_slug}.json"
            if not model_path.is_file():
                add(
                    inputs,
                    {
                        "kind": "companion-model",
                        "slug": model_slug,
                        "status": "unknown",
                        "reason": "selected Model document is unavailable locally",
                    },
                )
                continue
            try:
                model_document = ModelDefinition.model_validate(
                    json.loads(model_path.read_text(encoding="utf-8"))
                ).model_dump(mode="json")
            except Exception as error:
                raise DriftInputError(
                    f"catalog contract is invalid: {model_path}: {error}"
                ) from error
            identity = model_document.get("identity", {})
            model_entity = f"model/{identity.get('publisher')}/{identity.get('slug')}"
            model_entities.add(model_entity)
            source = model_document.get("source")
            tracked = model_entity in watch_entities
            add(
                inputs,
                {
                    "kind": "companion-model",
                    "slug": model_slug,
                    "source": source,
                    "status": "watched" if tracked else "untracked",
                    "reason": None
                    if tracked
                    else "Model has no automated source watch policy",
                },
            )
        recipes.append({"entity": entity, "recipe_id": slug, "inputs": inputs})
    return {
        "coverage": {
            "scope": "derived local inventory; not a claim that every transitive dependency has a resolvable upstream channel",
            "count_semantics": "records are per-recipe references; a shared image, Model, or Dockerfile can appear in multiple recipes",
            "counts_by_status": dict(sorted(counts.items())),
            "counts_by_candidate_status": {},
            "recipe_count": len(recipes),
        },
        "recipes": recipes,
    }


def observe_embedded_heads(
    inventory: dict[str, object], client: ProviderClient
) -> None:
    """Attach advertised GitHub default-branch candidates without retargeting pins."""
    head_client = (
        ProviderClient(opener=client.opener)
        if isinstance(client, ProviderClient)
        else client
    )
    records = inventory.get("recipes", [])
    if not isinstance(records, list):
        return
    memo: dict[str, tuple[str | None, str | None, str | None, str | None]] = {}
    candidate_counts: Counter[str] = Counter()
    for recipe in records:
        if not isinstance(recipe, dict) or not isinstance(recipe.get("inputs"), list):
            continue
        for item in recipe["inputs"]:
            if not isinstance(item, dict) or not isinstance(
                item.get("repository"), str
            ):
                continue
            repository = item["repository"]
            if repository not in memo:
                try:
                    repo = head_client.json(
                        f"https://api.github.com/repos/{repository}", "github"
                    )
                    branch = _required_string(repo, "default_branch", "repository")
                    revision, observed_at, url = _github_commit(
                        head_client, repository, branch
                    )
                    memo[repository] = (revision, observed_at, url, None)
                except (RemoteNotFound, RuntimeError, KeyError, TypeError) as error:
                    memo[repository] = (None, None, None, str(error)[:256])
            observed, observed_at, url, error_text = memo[repository]
            item["candidate_channel"] = "advertised-default-branch"
            item["candidate_revision"] = observed
            item["candidate_observed_at"] = observed_at
            item["candidate_url"] = url
            pinned = item.get("revision")
            if error_text:
                item["candidate_status"] = "unknown"
                item["candidate_reason"] = (
                    "default-branch observation failed; retained the embedded pin: "
                    + error_text
                )
            elif observed is None:
                item["candidate_status"] = "unknown"
                item["candidate_reason"] = "provider returned no advertised head"
            elif not isinstance(pinned, str):
                item["candidate_status"] = "no-immutable-pin"
                item["candidate_reason"] = (
                    "default-branch head is review evidence; the Dockerfile source has no recognized immutable commit"
                )
            elif observed == pinned:
                item["candidate_status"] = "same"
                item["candidate_reason"] = (
                    "advertised default branch is at the embedded commit"
                )
            else:
                item["candidate_status"] = "advanced"
                item["candidate_reason"] = (
                    "default branch advanced; candidate is review evidence only. Retain specialized behavior until compatibility is established; no embedded pin was changed"
                )
            candidate_counts[str(item["candidate_status"])] += 1
    coverage = inventory.get("coverage")
    if isinstance(coverage, dict):
        coverage["counts_by_candidate_status"] = dict(sorted(candidate_counts.items()))


def render_table(observations: list[Observation]) -> str:
    rows = [("STATUS", "ENTITY", "PINNED", "OBSERVED", "POLICY")]
    for observation in observations:
        observed = observation.observed_version or observation.observed_revision or "-"
        rows.append(
            (
                observation.status.upper(),
                observation.entity,
                observation.pinned_revision[:10],
                observed if len(observed) <= 18 else observed[:10],
                observation.policy,
            )
        )
    widths = [max(len(row[index]) for row in rows) for index in range(len(rows[0]))]
    return "\n".join(
        "  ".join(
            value.ljust(widths[index]) for index, value in enumerate(row)
        ).rstrip()
        for row in rows
    )


def _arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", type=Path, default=ROOT)
    parser.add_argument("--manifest", type=Path)
    parser.add_argument("--format", choices=("table", "json"), default="table")
    parser.add_argument(
        "--output", type=Path, help="also write the complete JSON report"
    )
    parser.add_argument(
        "--fail-on-drift",
        action="store_true",
        help="exit 2 when any watched source has advanced",
    )
    return parser.parse_args()


def main() -> int:
    arguments = _arguments()
    root = arguments.root.resolve()
    manifest = (arguments.manifest or root / DEFAULT_MANIFEST.name).resolve()
    try:
        defaults, overrides = load_manifest(manifest)
        watches = discover_watches(root, defaults, overrides)
    except (DriftInputError, OSError, json.JSONDecodeError) as error:
        print(f"upstream drift input error: {error}", file=sys.stderr)
        return 1
    client = ProviderClient(
        github_token=os.environ.get("GITHUB_TOKEN"),
        huggingface_token=os.environ.get("HF_TOKEN"),
    )
    observations = [observe(watch, client) for watch in watches]
    checked_at = datetime.now(UTC).isoformat().replace("+00:00", "Z")
    try:
        embedded = embedded_inventory(root, watches)
        observe_embedded_heads(embedded, client)
    except (DriftInputError, OSError, json.JSONDecodeError) as error:
        print(f"embedded source inventory error: {error}", file=sys.stderr)
        return 1
    document = report(observations, checked_at, embedded)
    rendered_json = json.dumps(document, indent=2, sort_keys=True) + "\n"
    if arguments.output:
        arguments.output.write_text(rendered_json, encoding="utf-8")
    print(
        rendered_json if arguments.format == "json" else render_table(observations),
        end="",
    )
    if any(observation.status in {"missing", "error"} for observation in observations):
        return 1
    if arguments.fail_on_drift and any(
        observation.status == "advanced" for observation in observations
    ):
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
