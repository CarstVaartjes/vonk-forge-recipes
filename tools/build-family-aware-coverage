#!/usr/bin/env python3
"""Derive the family-aware qualification coverage matrix from exact catalog identities.

The qualification design asks for one complete stack/family matrix with
representative selection, paired single-Spark batches and a recovery-coverage
mapping.  Every field here is derived from documents this repository already
owns:

* ``catalog-index.json`` - the generated producer index and its content/package
  digests (``tools/build-catalog-index`` writes it; it is not committed);
* ``recipes/*.json`` and ``models/*.json`` - the authored contract documents;
* ``packages/*.tar.gz`` - the current generated packages and their build closures;
* the qualification authority, derived in memory from the same catalog by
  ``tools/build-qualification-authority`` (never committed): the paired
  schedule, per-row gates and smoke/fixture references.

Stack identities are hashed from the current packages only; nothing is
downloaded.

The matrix records structure only.  Cache readiness, structural qualification,
Controller deployment and physical Spark acceptance are separate evidence
boundaries and are deliberately not decided here; the rendered report names what
it does not claim.
"""

from __future__ import annotations

import argparse
import hashlib
import importlib.machinery
import importlib.util
import json
import sys
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
sys.path.insert(0, str(ROOT / "contracts" / "src"))
from vonk_forge_contracts import (
    GitHubReleaseSource,
    ModelDefinition,
    RecipeDefinition,
    document_sha256,
)
from vonk_forge_contracts.qualification_authority import QualificationAuthority
from vonk_forge_contracts.recipe import RecipeBuildDefinition

from qualification.catalog_source import current_catalog_package_tree
from qualification.coverage_identity import execution_stack_identity

RECIPE_DIRECTORY = ROOT / "recipes"
MODEL_DIRECTORY = ROOT / "models"
OUTPUT_DIRECTORY = ROOT / "qualification/coverage"
MATRIX_NAME = "family-aware-coverage-2026-09-24.json"
REPORT_NAME = "family-aware-coverage-2026-09-24.md"

IN_SCOPE_MAXIMUM_NODE_COUNT = 2

# A recipe's primary coverage group follows its execution engine and workflow.
# Sharing the label "vllm" is not evidence equivalence: exact identity stays in
# ``stack_id`` and ``specialized_forks`` below.
COVERAGE_GROUPS = (
    "vllm",
    "sglang",
    "specialized-fork-engines",
    "image-video-workflows",
    "three-d-pipelines",
    "audio-multimodal-pipelines",
)
_SPECIALIZED = "specialized-fork-engines"
_IMAGE_VIDEO = "image-video-workflows"
_THREE_D = "three-d-pipelines"
_AUDIO_MULTIMODAL = "audio-multimodal-pipelines"

# The stock upstream image per engine.  Any other image is a declared fork for
# that engine and cannot be qualified by generic engine evidence.
_STOCK_ENGINE_IMAGES = {
    "vllm": "docker.io/vllm/vllm-openai",
    "sglang": "docker.io/lmsysorg/sglang",
}
# Declared fork markers, matched against the recipe slug and the build context.
_FORK_MARKERS = ("dflash", "dspark", "exl3", "sparkinfer")
_VIDEO_IMAGE_INTERFACES = frozenset({"image-job", "video-job"})
_JOB_INTERFACES = frozenset(
    {"image-job", "audio-job", "video-job", "mesh-job", "artifact-job"}
)


def _json_document(path: Path) -> Any:
    return json.loads(path.read_text(encoding="utf-8"))


def _canonical_digest(value: Any) -> str:
    payload = json.dumps(
        value, sort_keys=True, separators=(",", ":"), ensure_ascii=False
    ).encode("utf-8")
    return hashlib.sha256(payload).hexdigest()


def _short_digest(value: Any) -> str:
    return _canonical_digest(value)[:16]


def _recipe_key(recipe: RecipeDefinition) -> str:
    return f"{recipe.identity.publisher}/{recipe.identity.slug}"


def _model_key(model: ModelDefinition) -> str:
    return f"{model.identity.publisher}/{model.identity.slug}"


def _model_source_projection(model: ModelDefinition) -> tuple[str, str]:
    """Project exact source identity without presenting a release as a commit."""

    source = model.source
    if isinstance(source, GitHubReleaseSource):
        return source.repository, f"github-release:{source.release_id}"
    return source.repository, source.revision


def _require_object(value: Any, description: str) -> dict[str, Any]:
    if not isinstance(value, dict):
        raise TypeError(f"{description} must contain a JSON object")
    return value


def _indexed_recipes(catalog_root: Path) -> dict[str, dict[str, Any]]:
    """Validate every indexed recipe and prove the index matches the tree."""

    catalog = _require_object(
        _json_document(catalog_root / "catalog-index.json"), "catalog-index.json"
    )
    entries = catalog.get("recipes")
    if not isinstance(entries, list):
        raise TypeError("catalog-index.json recipes must be an array")
    indexed: dict[str, dict[str, Any]] = {}
    for entry in entries:
        document = _require_object(entry, "catalog recipe entry")
        embedded = _require_object(document.get("document"), "catalog recipe document")
        recipe = RecipeDefinition.model_validate(embedded)
        key = _recipe_key(recipe)
        if key in indexed:
            raise ValueError(f"catalog contains duplicate recipe key: {key}")
        digest = document_sha256(embedded)
        if digest != document.get("content_sha256"):
            raise ValueError(f"catalog content digest is not canonical: {key}")
        package = _require_object(document.get("package"), f"package: {key}")
        tree_path = RECIPE_DIRECTORY / f"{recipe.identity.slug}.json"
        if document_sha256(_json_document(tree_path)) != digest:
            raise ValueError(
                f"authored recipe document disagrees with catalog index: {key}"
            )
        indexed[key] = {
            "recipe": recipe,
            "content_sha256": digest,
            "package": package,
            "package_path": package.get("path"),
            "package_sha256": package.get("sha256"),
        }
    return indexed


def _indexed_models(catalog_root: Path) -> dict[str, ModelDefinition]:
    """Validate every canonical Model document referenced by the catalog."""

    catalog = _require_object(
        _json_document(catalog_root / "catalog-index.json"), "catalog-index.json"
    )
    entities = catalog.get("catalog_entities")
    if not isinstance(entities, list):
        raise TypeError("catalog-index.json catalog_entities must be an array")
    indexed: dict[str, ModelDefinition] = {}
    for entity in entities:
        document = _require_object(entity, "catalog entity")
        embedded = _require_object(document.get("document"), "catalog entity document")
        if embedded.get("kind") != "model":
            continue
        model = ModelDefinition.model_validate(embedded)
        key = _model_key(model)
        if key in indexed:
            raise ValueError(f"catalog contains duplicate Model key: {key}")
        digest = document_sha256(embedded)
        if digest != document.get("content_sha256"):
            raise ValueError(f"catalog Model content digest is not canonical: {key}")
        tree_path = MODEL_DIRECTORY / f"{model.identity.slug}.json"
        if document_sha256(_json_document(tree_path)) != digest:
            raise ValueError(
                f"authored Model document disagrees with catalog index: {key}"
            )
        indexed[key] = model
    return indexed


def _derived_authority(catalog_root: Path) -> dict[str, Any]:
    loader = importlib.machinery.SourceFileLoader(
        "build_qualification_authority",
        str(ROOT / "tools/build-qualification-authority"),
    )
    spec = importlib.util.spec_from_loader(loader.name, loader)
    assert spec is not None
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    outputs = module.build(catalog_root)
    return json.loads(outputs[f"authorities/{module.AUTHORITY_ID}.json"])


def _authority(recipe_keys: set[str], catalog_root: Path) -> dict[str, Any]:
    document = QualificationAuthority.model_validate(
        _derived_authority(catalog_root)
    ).model_dump(mode="json", exclude_none=True)
    rows = {row["key"]: row for row in document["recipes"]}
    excluded = document["scope"]["excluded_topology_recipe_keys"]
    if set(rows) | set(excluded) != recipe_keys:
        raise ValueError(
            "authority and exclusions must partition the catalog exactly once"
        )
    if set(rows) & set(excluded):
        raise ValueError("an excluded recipe cannot also be an authority row")
    return {
        "authority_id": document.get("authority_id"),
        "catalog": document["catalog"],
        "maximum_node_count": document["scope"]["maximum_node_count"],
        "rows": rows,
        "excluded": excluded,
        "batches": document["batches"],
        "recovery_coverage": document["recovery_coverage"],
    }


def _fork_signals(
    recipe: RecipeDefinition, build: RecipeBuildDefinition, engine: str
) -> list[str]:
    signals: set[str] = set()
    stock = _STOCK_ENGINE_IMAGES.get(engine)
    if stock is not None and build.base_image.repository != stock:
        signals.add(f"image:{build.base_image.repository}")
    haystack = f"{recipe.identity.slug} {build.context.path}".lower()
    for marker in _FORK_MARKERS:
        if marker in haystack:
            signals.add(f"marker:{marker}")
    for patch in build.patches:
        signals.add(f"patch:{patch.path}")
    return sorted(signals)


def _coverage_group(engine: str, interface: str, signals: list[str]) -> str:
    declared_fork = any(signal.startswith(("image:", "marker:")) for signal in signals)
    if engine == "sglang":
        if any(signal.startswith("image:") for signal in signals):
            return _SPECIALIZED
        return "sglang"
    if engine == "vllm":
        return _SPECIALIZED if declared_fork else "vllm"
    if engine in {"ds4", "tensorfold"}:
        return _SPECIALIZED
    if engine in {"diffusers", "comfyui"}:
        return _IMAGE_VIDEO
    if engine == "pytorch-pipeline":
        if declared_fork:
            return _SPECIALIZED
        if interface in _VIDEO_IMAGE_INTERFACES:
            return _IMAGE_VIDEO
        if interface == "mesh-job":
            return _THREE_D
        if interface in {"audio-job", "artifact-job"}:
            return _AUDIO_MULTIMODAL
    raise ValueError(f"no coverage group for engine {engine!r} interface {interface!r}")


def _stack(recipe: RecipeDefinition, build: RecipeBuildDefinition) -> dict[str, Any]:
    return {
        "engine": recipe.runtime.engine,
        "entrypoint": list(recipe.runtime.entrypoint),
        "base_image": {
            "repository": build.base_image.repository,
            "digest": build.base_image.digest,
        },
        "build_context": build.context.path,
        "dockerfile": build.dockerfile,
        "patches": [patch.path for patch in build.patches],
    }


def _declared_artifact_bytes(recipe: RecipeDefinition) -> int:
    return max(role.resources.disk.artifact_bytes for role in recipe.topology.roles)


def _declared_peak_memory_bytes(recipe: RecipeDefinition) -> int:
    return max(role.resources.memory.peak_bytes for role in recipe.topology.roles)


def _review_gate_kinds(authority_row: dict[str, Any]) -> set[str]:
    kinds: set[str] = set()
    for gate in authority_row.get("review_gates") or []:
        if isinstance(gate, dict) and isinstance(gate.get("kind"), str):
            kinds.add(gate["kind"])
    return kinds


def _row(
    recipe: RecipeDefinition,
    indexed: dict[str, Any],
    models: dict[str, ModelDefinition],
    authority: dict[str, Any],
    stack_identity: dict[str, Any],
    batch_by_recipe: dict[str, tuple[str, int, str]],
    recovery_by_recipe: dict[str, list[dict[str, Any]]],
) -> dict[str, Any]:
    key = _recipe_key(recipe)
    build = recipe.execution.build
    interface_document = recipe.validation.serving.interface
    interface = (
        "openai-service" if interface_document == "openai" else interface_document
    )
    engine = recipe.runtime.engine
    signals = _fork_signals(recipe, build, engine)
    stack = _stack(recipe, build)
    stack.update(stack_identity)
    metadata = _require_object(indexed[key], key)
    selections = []
    for selection in recipe.models:
        reference = selection.model
        model_key = f"{reference.publisher}/{reference.slug}"
        model = models.get(model_key)
        if model is None:
            raise ValueError(f"recipe references an undocumented Model: {model_key}")
        source_repository, source_revision = _model_source_projection(model)
        selections.append(
            {
                "key": model_key,
                "selection": selection.id,
                "family": model.identity.family.slug,
                "family_title": model.identity.family.title,
                "model": model.identity.model.slug,
                "variant": model.identity.variant,
                "precision": model.format.precision,
                "quantization": model.format.quantization,
                "modalities": list(model.modalities),
                "requires_token": model.requires_token,
                "license_spdx": model.license.spdx,
                "source_repository": source_repository,
                "source_revision": source_revision,
            }
        )
    node_count = recipe.topology.node_count
    in_scope = node_count <= IN_SCOPE_MAXIMUM_NODE_COUNT
    authority_row = authority["rows"].get(key)
    row: dict[str, Any] = {
        "key": key,
        "recipe_version": recipe.release.version,
        "content_sha256": metadata["content_sha256"],
        "package": {
            "path": metadata["package_path"],
            "sha256": metadata["package_sha256"],
        },
        "in_scope": in_scope,
        "node_count": node_count,
        "interface": interface,
        "check_kind": "service" if interface_document == "openai" else "job",
        "coverage_group": _coverage_group(engine, interface_document, signals),
        "specialized_forks": signals,
        "distributed_evidence_required": node_count > 1,
        "engine": engine,
        "stack": stack,
        "stack_id": stack_identity["runtime_stack_sha256"][:16],
        "runtime_stack_sha256": stack_identity["runtime_stack_sha256"],
        "topology_sha256": stack_identity["topology_sha256"],
        "build_source_sha256": stack_identity["build_source_sha256"],
        "build_source_file_count": stack_identity["build_source_file_count"],
        "stack_matches_authority": None,
        "topology": {
            "mode": recipe.topology.mode,
            "name": recipe.topology.name,
            "node_count": node_count,
            "parallelism": recipe.topology.parallelism.model_dump(mode="json"),
            "fabric_connectivity": recipe.topology.fabric_connectivity,
        },
        "families": sorted({item["family"] for item in selections}),
        "quantizations": sorted({item["quantization"] for item in selections}),
        "precisions": sorted({item["precision"] for item in selections}),
        "modalities": sorted({m for item in selections for m in item["modalities"]}),
        "declared_artifact_bytes": _declared_artifact_bytes(recipe),
        "declared_peak_memory_bytes": _declared_peak_memory_bytes(recipe),
        "models": selections,
        "authority": None,
        "authority_divergence": None,
        "representative": False,
        "representative_for": None,
        "schedule": None,
        "recovery_coverage_refs": recovery_by_recipe.get(key, []),
    }
    row["risk_group_id"] = _short_digest(
        {
            "stack_id": row["stack_id"],
            "coverage_group": row["coverage_group"],
            "families": row["families"],
            "quantizations": row["quantizations"],
            "node_count": node_count,
        }
    )
    if authority_row is None:
        row["schedule"] = {
            "kind": "excluded",
            "reason": "topology exceeds the available two-Spark fleet",
        }
        return row
    batch = batch_by_recipe.get(key)
    if batch is None:
        raise ValueError(f"authority row has no execution batch: {key}")
    batch_id, lane, batch_mode = batch
    binding = {
        "authority_id": authority["authority_id"],
        "sequence": authority_row.get("sequence"),
        "recipe_version": authority_row.get("recipe_version"),
        "content_sha256": authority_row.get("content_sha256"),
        "package_sha256": (authority_row.get("package") or {}).get("sha256"),
        "disposition": authority_row.get("disposition"),
        "review_gate_kinds": sorted(_review_gate_kinds(authority_row)),
        "smoke_cases": list(authority_row.get("smoke_cases") or []),
        "qualification_inputs": list(authority_row.get("qualification_inputs") or []),
        "runtime_stack_sha256": authority_row.get("runtime_stack_sha256"),
        "topology_sha256": authority_row.get("topology_sha256"),
        "batch_id": batch_id,
        "lane": lane,
        "batch_mode": batch_mode,
        "recovery_coverage_refs": list(
            authority_row.get("recovery_coverage_refs") or []
        ),
    }
    row["authority"] = binding
    row["stack_matches_authority"] = (
        binding["runtime_stack_sha256"] == row["runtime_stack_sha256"]
    )
    divergences: list[str] = []
    if binding["content_sha256"] != row["content_sha256"]:
        divergences.append("recipe content")
    if binding["package_sha256"] != row["package"]["sha256"]:
        divergences.append("recipe package")
    if binding["recipe_version"] != row["recipe_version"]:
        divergences.append("recipe version")
    if not row["stack_matches_authority"]:
        divergences.append("runtime stack")
    if binding["topology_sha256"] != row["topology_sha256"]:
        divergences.append("topology")
    if recipe.topology.node_count != authority_row["node_count"]:
        divergences.append("topology node count")
    if divergences:
        row["authority_divergence"] = {
            "bound_recipe_version": binding["recipe_version"],
            "bound_content_sha256": binding["content_sha256"],
            "bound_package_sha256": binding["package_sha256"],
            "bound_runtime_stack_sha256": binding["runtime_stack_sha256"],
            "current_runtime_stack_sha256": row["runtime_stack_sha256"],
            "reason": "current indexed recipe differs from the authority in: "
            + ", ".join(divergences),
        }
    return row


def _assign_representatives(rows: list[dict[str, Any]]) -> list[dict[str, Any]]:
    groups: dict[str, list[dict[str, Any]]] = {}
    for row in rows:
        if row["in_scope"]:
            groups.setdefault(row["risk_group_id"], []).append(row)
    representatives: list[dict[str, Any]] = []
    for risk_group_id, members in sorted(groups.items()):
        ordered = sorted(
            members, key=lambda item: (item["declared_artifact_bytes"], item["key"])
        )
        chosen = ordered[0]
        chosen["representative"] = True
        for member in ordered[1:]:
            member["representative_for"] = chosen["key"]
        representatives.append(
            {
                "risk_group_id": risk_group_id,
                "representative": chosen["key"],
                "coverage_group": chosen["coverage_group"],
                "stack_id": chosen["stack_id"],
                "families": chosen["families"],
                "quantizations": chosen["quantizations"],
                "node_count": chosen["node_count"],
                "declared_artifact_bytes": chosen["declared_artifact_bytes"],
                "members": [member["key"] for member in ordered],
            }
        )
    return representatives


def _authority_batches(
    rows: list[dict[str, Any]], authority: dict[str, Any]
) -> tuple[list[dict[str, Any]], dict[str, tuple[str, int, str]]]:
    """Render the canonical authority batches and retain exact lane identity."""

    rows_by_key = {row["key"]: row for row in rows}
    batch_by_recipe: dict[str, tuple[str, int, str]] = {}
    rendered: list[dict[str, Any]] = []
    for batch in authority["batches"]:
        assignments = []
        for assignment in batch["assignments"]:
            recipe_key = assignment["recipe"]
            row = rows_by_key.get(recipe_key)
            if row is None or row["node_count"] != assignment["node_count"]:
                raise ValueError(
                    f"batch assignment differs from catalog row: {recipe_key}"
                )
            lane = assignment["lane"]
            row["schedule"] = {
                "kind": batch["mode"],
                "batch_id": batch["id"],
                "lane": lane,
            }
            batch_by_recipe[recipe_key] = (batch["id"], lane, batch["mode"])
            assignments.append(
                {
                    "lane": lane,
                    "recipe": recipe_key,
                    "node_count": row["node_count"],
                    "coverage_group": row["coverage_group"],
                    "stack_id": row["stack_id"],
                    "representative": row["representative"],
                    "declared_artifact_bytes": row["declared_artifact_bytes"],
                }
            )
        model_sets = [
            {item["key"] for item in rows_by_key[item["recipe"]]["models"]}
            for item in assignments
        ]
        rendered.append(
            {
                "sequence": batch["sequence"],
                "id": batch["id"],
                "mode": batch["mode"],
                "assignments": assignments,
                "shared_stack_id": len({item["stack_id"] for item in assignments}) == 1,
                "shared_model_identity": (
                    len(model_sets) == 2 and bool(model_sets[0] & model_sets[1])
                ),
                "combined_declared_artifact_bytes": sum(
                    item["declared_artifact_bytes"] for item in assignments
                ),
                "admission": (
                    [
                        "one-whole-fleet-profile-and-apply",
                        "fresh-whole-fleet-preview-per-lane-must-prove-fit",
                        "both-Sparks-healthy-and-idle-for-inference",
                    ]
                    if batch["mode"] == "paired-single"
                    else ["whole-fleet-preview-must-prove-fit"]
                ),
                "barrier": (
                    "retain-independent-lane-smoke-and-recovery-results; reconcile-cleanup-before-next-batch"
                    if batch["mode"] == "paired-single"
                    else "retain-exact-recipe-recovery-and-smoke-results; reconcile-cleanup-before-next-batch"
                ),
            }
        )
    expected = {row["key"] for row in rows if row["in_scope"]}
    if set(batch_by_recipe) != expected:
        raise ValueError("authority batches must schedule every in-scope recipe once")
    if len(batch_by_recipe) != sum(
        len(batch["assignments"]) for batch in authority["batches"]
    ):
        raise ValueError("authority batches repeat a recipe assignment")
    return rendered, batch_by_recipe


def _excluded_schedule(rows: list[dict[str, Any]]) -> list[dict[str, Any]]:
    excluded: list[dict[str, Any]] = []
    for row in sorted(
        (item for item in rows if not item["in_scope"]),
        key=lambda item: (item["node_count"], item["key"]),
    ):
        excluded.append(
            {
                "kind": "outside-available-capacity",
                "recipe": row["key"],
                "node_count": row["node_count"],
                "coverage_group": row["coverage_group"],
                "reason": "requires more than two Sparks; catalog audit only",
            }
        )
    return excluded


def _recovery_coverage(
    rows: list[dict[str, Any]], authority: dict[str, Any]
) -> tuple[dict[str, Any], dict[str, list[dict[str, Any]]]]:
    rows_by_key = {row["key"]: row for row in rows}
    refs_by_recipe: dict[str, list[dict[str, Any]]] = {
        row["key"]: [] for row in rows if row["in_scope"]
    }
    entries: list[dict[str, Any]] = []
    for definition in authority["recovery_coverage"]:
        members = definition["members"]
        member_keys = [member["recipe"] for member in members]
        for member_key in member_keys:
            if member_key not in rows_by_key:
                raise ValueError(
                    f"recovery coverage references an absent row: {member_key}"
                )
        member_rows = [rows_by_key[key] for key in member_keys]
        representative = definition["representative_recipe"]
        entries.append(
            {
                **definition,
                "recipes": member_keys,
                "families": sorted(
                    {family for row in member_rows for family in row["families"]}
                ),
                "quantizations": sorted(
                    {quant for row in member_rows for quant in row["quantizations"]}
                ),
                "model_specific_review_required": len(
                    {tuple(member["model_content_sha256s"]) for member in members}
                )
                > 1,
            }
        )
        for member in members:
            refs = refs_by_recipe[member["recipe"]]
            match = next(
                (
                    ref
                    for ref in rows_by_key[member["recipe"]]["recovery_coverage_refs"]
                    if ref["coverage_id"] == definition["coverage_id"]
                ),
                None,
            )
            if match is None or match["representative_recipe"] != representative:
                raise ValueError(
                    f"recovery coverage reference is missing or stale: {member['recipe']}"
                )
            refs.append(match)
    return (
        {
            "definitions": entries,
        },
        refs_by_recipe,
    )


def _build(catalog_root: Path) -> dict[str, bytes]:
    indexed = _indexed_recipes(catalog_root)
    models = _indexed_models(catalog_root)
    authority = _authority(set(indexed), catalog_root)
    if authority["maximum_node_count"] != IN_SCOPE_MAXIMUM_NODE_COUNT:
        raise ValueError("authority scope does not match the in-scope node bound")

    ordered_metadata = sorted(indexed.items(), key=lambda item: item[0])
    stack_identities: dict[str, dict[str, Any]] = {}
    for key, metadata in ordered_metadata:
        recipe = metadata["recipe"]
        package = metadata["package"]
        if not isinstance(package, dict):
            raise TypeError(f"current indexed package is malformed: {key}")
        with current_catalog_package_tree(
            catalog_root, package, recipe, metadata["content_sha256"]
        ) as tree:
            stack_identities[key] = execution_stack_identity(
                tree, recipe, recipe.execution.build
            )

    batch_lookup: dict[str, tuple[str, int, str]] = {}
    for batch in authority["batches"]:
        for assignment in batch["assignments"]:
            if assignment["recipe"] in batch_lookup:
                raise ValueError(
                    f"authority repeats an execution batch row: {assignment['recipe']}"
                )
            batch_lookup[assignment["recipe"]] = (
                batch["id"],
                assignment["lane"],
                batch["mode"],
            )
    recovery_lookup = {
        row["key"]: row["recovery_coverage_refs"] for row in authority["rows"].values()
    }
    rows = [
        _row(
            metadata["recipe"],
            indexed,
            models,
            authority,
            stack_identities[key],
            batch_lookup,
            recovery_lookup,
        )
        for key, metadata in ordered_metadata
    ]
    in_scope = [row for row in rows if row["in_scope"]]
    if len(in_scope) != len(authority["rows"]):
        raise ValueError("in-scope row count disagrees with the authority")

    representatives = _assign_representatives(rows)
    batches, _ = _authority_batches(rows, authority)
    excluded = _excluded_schedule(rows)
    recovery, recovery_by_recipe = _recovery_coverage(rows, authority)
    if any(
        row["recovery_coverage_refs"] != recovery_by_recipe.get(row["key"], [])
        for row in in_scope
    ):
        raise ValueError("matrix recovery references disagree with typed authority")

    ordered = sorted(
        rows,
        key=lambda item: (
            item["authority"]["sequence"] if item["authority"] else 10_000,
            item["node_count"],
            item["key"],
        ),
    )
    for position, row in enumerate(ordered, start=1):
        row["matrix_row"] = position

    scheduled = [row for row in in_scope if row["schedule"] is None]
    if scheduled:
        raise ValueError(
            f"in-scope rows without a schedule: {[r['key'] for r in scheduled]}"
        )
    assignment_rows = [
        assignment["recipe"] for batch in batches for assignment in batch["assignments"]
    ]
    if sorted(assignment_rows) != sorted(row["key"] for row in in_scope):
        raise ValueError("batches must cover every in-scope recipe exactly once")
    if len(assignment_rows) != len(set(assignment_rows)):
        raise ValueError("batches must not assign one recipe more than once")
    for entry in representatives:
        if entry["representative"] not in entry["members"]:
            raise ValueError("a representative must belong to its risk group")

    catalog_index_sha256 = hashlib.sha256(
        (catalog_root / "catalog-index.json").read_bytes()
    ).hexdigest()
    bound_catalog_index_sha256 = authority["catalog"].get("catalog_index_sha256")
    bound_recipe_count = authority["catalog"].get("recipe_count")
    if bound_recipe_count != len(rows):
        raise ValueError("authority catalog binding disagrees with the catalog size")

    matrix = {
        "schema_version": 1,
        "matrix_id": "family-aware-coverage-2026-09-24",
        "catalog": {
            "repository": "CarstVaartjes/vonk-forge-recipes",
            "recipe_count": len(rows),
            "in_scope_recipe_count": len(in_scope),
            "out_of_scope_recipe_count": len(rows) - len(in_scope),
            "in_scope_maximum_node_count": IN_SCOPE_MAXIMUM_NODE_COUNT,
            "authority_id": authority["authority_id"],
            "catalog_index_sha256": catalog_index_sha256,
            "bound_catalog_index_sha256": bound_catalog_index_sha256,
            "bound_release_tag": authority["catalog"].get("release_tag"),
            "bound_catalog_commit": authority["catalog"].get("commit"),
            "catalog_binding_current": catalog_index_sha256
            == bound_catalog_index_sha256,
        },
        "coverage_group_order": list(COVERAGE_GROUPS),
        "rows": ordered,
        "representatives": representatives,
        "batches": batches,
        "excluded_schedule": excluded,
        "recovery_coverage": recovery,
        "reuse_rules": [
            "runtime_stack_sha256 hashes the runtime, build settings and every declared build-source file byte",
            "shared model or image reuse requires an identical stack_id and model identity",
            "each recipe still needs its own physical inference and declared assertions",
            "distributed evidence is independent of single-Spark evidence",
            "shared recovery evidence covers only members with an identical stack and topology",
        ],
    }
    return {
        MATRIX_NAME: (json.dumps(matrix, ensure_ascii=False, indent=2) + "\n").encode(
            "utf-8"
        ),
        REPORT_NAME: _render_report(matrix).encode("utf-8"),
    }


def _gib(value: int) -> str:
    return f"{value / 1024**3:.1f} GiB"


def _yes_no(value: bool | None) -> str:
    return "—" if value is None else "yes" if value else "no"


def _rows_label(count: int) -> str:
    return f"{count} row" if count == 1 else f"{count} rows"


def _row_group(row: dict[str, Any]) -> str:
    return ", ".join(row["families"]) if row["families"] else "-"


def _render_report(matrix: dict[str, Any]) -> str:
    rows: list[dict[str, Any]] = matrix["rows"]
    lines = [
        "# Family-aware qualification coverage matrix — 2026-09-24",
        "",
        "Derived from exact catalog identities by `tools/build-family-aware-coverage`.",
        "",
        (
            "This artifact records catalog structure, byte-bound execution stacks, "
            "batch assignments and typed recovery references. It does not claim cache "
            "readiness, structural qualification, Controller deployment or physical "
            "Spark acceptance."
        ),
        "",
        "## Sources",
        "",
        "| Input | Identity |",
        "|---|---|",
        (
            f"| Catalog | {matrix['catalog']['repository']} — "
            f"{matrix['catalog']['recipe_count']} recipe documents |"
        ),
        f"| Catalog release | {matrix['catalog']['bound_release_tag']} at `{matrix['catalog']['bound_catalog_commit']}` |",
        f"| Qualification authority | `{matrix['catalog']['authority_id']}` |",
        (
            f"| Scope | {matrix['catalog']['in_scope_recipe_count']} recipes within "
            f"{matrix['catalog']['in_scope_maximum_node_count']} Sparks; "
            f"{matrix['catalog']['out_of_scope_recipe_count']} larger topologies listed "
            "for audit only |"
        ),
        "",
        "## Derivation",
        "",
        (
            "Every recipe and Model document is validated through the canonical "
            "contract; its content digest must match both the producer index and the "
            "authored tree document. The current indexed package is checked against "
            "its declared size and SHA-256, then validated through the canonical "
            "package validator. The index and packages are generated from the "
            "authored tree by `tools/build-catalog-index`."
        ),
        (
            "`runtime_stack_sha256` binds the full runtime/build contract and the "
            "bytes/modes of every selected regular file in the digest-verified recipe "
            "package of the current catalog."
        ),
        (
            "Stack identities use the local package after its size and digest "
            "validate, and are compared with the identity the authority recorded."
        ),
        (
            "Specialized forks stay distinct from generic engine evidence. Every "
            "recipe retains its own inference and declared assertion checks."
        ),
        (
            "Paired single-node batches use two distinct lanes under one whole-fleet "
            "profile/apply and preserve independent smoke and recovery results. "
            "Dual-node rows have exclusive batches."
        ),
        (
            "Recovery references bind explicit members and exact stack/topology "
            "identities; one representative run covers a failure mode for its group."
        ),
        "",
        "## Coverage groups",
        "",
        "| Coverage group | In-scope rows | Specialized forks | Dual-node rows |",
        "|---|---:|---:|---:|",
    ]
    group_rows: dict[str, list[dict[str, Any]]] = {
        group: [] for group in COVERAGE_GROUPS
    }
    for row in rows:
        if row["in_scope"]:
            group_rows[row["coverage_group"]].append(row)
    for group in COVERAGE_GROUPS:
        members = group_rows[group]
        forked = sum(bool(row["specialized_forks"]) for row in members)
        dual = sum(row["node_count"] == 2 for row in members)
        lines.append(f"| `{group}` | {len(members)} | {forked} | {dual} |")

    lines.extend(
        [
            "",
            "## Stack and family matrix",
            "",
            (
                "One row per catalog recipe. In-scope rows show their authority "
                "sequence and batch lane; wider topologies remain visible for audit. "
                "`stack` is the short prefix of the full source-byte-bound runtime "
                "identity."
            ),
            "",
            "| Seq | Recipe | Nodes | Group | Engine | Base image | Build context | Families | Quantization | Artifacts | Rep | Batch/lane | Stack matches authority |",
            "|---:|---|---:|---|---|---|---|---|---|---:|---|---|---|",
        ]
    )
    for row in rows:
        sequence = str(row["authority"]["sequence"]) if row["authority"] else "—"
        image = row["stack"]["base_image"]
        image_label = f"`{image['repository']}@{image['digest'][:12]}`"
        representative = row["representative_for"] or (
            "—" if not row["representative"] else "yes"
        )
        schedule = row["schedule"] or {}
        if schedule.get("kind") == "paired-single":
            batch_label = f"{schedule['batch_id']}/L{schedule['lane']}"
        elif schedule.get("kind") == "single":
            batch_label = f"{schedule['batch_id']}/L{schedule['lane']} (single)"
        elif schedule.get("kind") == "exclusive-dual":
            batch_label = f"{schedule['batch_id']} (exclusive dual)"
        else:
            batch_label = "—"
        lines.append(
            f"| {sequence} | `{row['key']}` | {row['node_count']} | "
            f"`{row['coverage_group']}` | `{row['engine']}` | {image_label} | "
            f"`{row['stack']['build_context']}` | {_row_group(row)} | "
            f"{', '.join(row['quantizations'])} | {_gib(row['declared_artifact_bytes'])} | "
            f"{representative} | {batch_label} | "
            f"{_yes_no(row['stack_matches_authority'])} |"
        )

    lines.extend(
        [
            "",
            "## Representative selection",
            "",
            (
                "Each risk group combines exact runtime stack, model family, "
                "quantization and node count. Its representative has the smallest "
                "declared artifact footprint; every recipe still needs its own "
                "inference and assertions."
            ),
            "",
            "| Risk group | Group | Representative | Members | Artifacts |",
            "|---|---|---|---:|---:|",
        ]
    )
    for entry in matrix["representatives"]:
        lines.append(
            f"| `{entry['risk_group_id']}` | `{entry['coverage_group']}` | "
            f"`{entry['representative']}` | {len(entry['members'])} | "
            f"{_gib(entry['declared_artifact_bytes'])} |"
        )

    lines.extend(
        [
            "",
            "## Executable batches",
            "",
            (
                "The authority owns exact recipe/lane assignments. Paired singles "
                "share one whole-fleet profile and apply, smoke in separate lanes, "
                "then wait at a cleanup/reconciliation barrier before the next "
                "batch. Dual-node assignments reserve both Sparks exclusively."
            ),
            "",
            "| Batch | Mode | Lane 1 | Lane 2 | Shared stack | Shared Models | Combined artifacts |",
            "|---|---|---|---|---|---|---:|",
        ]
    )
    for batch in matrix["batches"]:
        labels = [
            f"`{item['recipe']}`" + (" (rep)" if item["representative"] else "")
            for item in batch["assignments"]
        ]
        while len(labels) < 2:
            labels.append("—")
        lines.append(
            f"| `{batch['id']}` | `{batch['mode']}` | {labels[0]} | {labels[1]} | "
            f"{'yes' if batch['shared_stack_id'] else 'no'} | "
            f"{'yes' if batch['shared_model_identity'] else 'no'} | "
            f"{_gib(batch['combined_declared_artifact_bytes'])} |"
        )
    lines.extend(
        [
            "",
            "## Outside available capacity",
            "",
            "These recipes require more than two Sparks and remain visible for catalog audit.",
            "",
            "| Recipe | Nodes | Group | Reason |",
            "|---|---:|---|---|",
        ]
    )
    for entry in matrix["excluded_schedule"]:
        lines.append(
            f"| `{entry['recipe']}` | {entry['node_count']} | "
            f"`{entry['coverage_group']}` | {entry['reason']} |"
        )

    lines.extend(
        [
            "",
            "## Typed recovery coverage",
            "",
            (
                "These definitions are validated against the current Pydantic "
                "authority contract. A group shares one representative recovery run "
                "because its members have identical stack and topology identities."
            ),
            "",
            "| Coverage ID | Failure mode | Representative | Members | Shared | Model review |",
            "|---|---|---|---:|---|---|",
        ]
    )
    for entry in matrix["recovery_coverage"]["definitions"]:
        lines.append(
            f"| `{entry['coverage_id'][:16]}` | `{entry['failure_mode']}` | "
            f"`{entry['representative_recipe']}` | {len(entry['members'])} | "
            f"{'yes' if entry['shared'] else 'no'} | "
            f"{'required' if entry['model_specific_review_required'] else 'n/a'} |"
        )

    divergences = [row for row in rows if row["authority_divergence"]]
    lines.extend(["", "## Indexed package comparison", ""])
    catalog_binding = matrix["catalog"]
    if catalog_binding["catalog_binding_current"]:
        lines.append("The working catalog index matches the accepted release index.")
    else:
        lines.append(
            f"The accepted release binds catalog index "
            f"`{catalog_binding['bound_catalog_index_sha256'][:16]}` "
            f"({catalog_binding['bound_release_tag']}); the working index is "
            f"`{catalog_binding['catalog_index_sha256'][:16]}`. Refresh the authority "
            "after the changed catalog has been accepted."
        )
    lines.append("")
    if divergences:
        lines.extend(
            [
                "The following rows differ from the identity the authority recorded.",
                "",
                "| Recipe | Difference | Authority stack | Current package stack |",
                "|---|---|---|---|",
            ]
        )
        for row in divergences:
            divergence = row["authority_divergence"]
            bound = divergence["bound_runtime_stack_sha256"] or ""
            lines.append(
                f"| `{row['key']}` | {divergence['reason']} | "
                f"`{bound[:16]}` | `{row['runtime_stack_sha256'][:16]}` |"
            )
    else:
        lines.append(
            "Every current indexed package build stack matches its authority runtime-stack identity."
        )

    lines.extend(
        [
            "",
            "## Evidence boundaries",
            "",
            "- Cache readiness remains owned by the live Controller cache surface.",
            "- Structural validity does not prove an image build or runtime acceptance.",
            "- Controller and runner deployment require separate live evidence.",
            "- Physical inference and declared assertions remain recipe-specific evidence.",
            "- Declared footprints do not replace a fresh whole-fleet admission preview.",
            "",
        ]
    )
    return "\n".join(lines)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--catalog-root",
        type=Path,
        default=ROOT,
        help="directory holding the generated catalog-index.json and packages/ "
        "(default: this checkout; run tools/build-catalog-index first)",
    )
    parser.add_argument(
        "--output-dir",
        type=Path,
        default=OUTPUT_DIRECTORY,
        help="write the coverage matrix and report here "
        "(default: qualification/coverage, ignored by Git)",
    )
    args = parser.parse_args()
    try:
        outputs = _build(args.catalog_root)
        args.output_dir.mkdir(parents=True, exist_ok=True)
        for name, content in outputs.items():
            (args.output_dir / name).write_bytes(content)
        print(f"wrote family-aware coverage matrix and report to {args.output_dir}")
        return 0
    except (OSError, TypeError, ValueError, json.JSONDecodeError) as error:
        print(f"build-family-aware-coverage: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
