#!/usr/bin/env -S uv run --no-project --python 3.14 --with-editable contracts python
"""Report where declared memory disagrees with the estimate; warnings only, exit 0.

The recipes are estimates until the hardware try measures them. Findings go to
stdout and the step summary; ``--report FILE`` writes them as an issue body.
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from vonk_forge_contracts import (
    ModelDefinition,
    QualificationOutcome,
    RecipeDefinition,
    document_sha256,
)

from qualification.memory_need import (
    hardware_proven,
    load_inputs,
    memory_estimate_warnings,
    memory_notes,
    memory_variants,
    per_rank_need,
    unchanged_recipe,
)
from spark_sweep.qualification import read_evidence


def touched_recipes(root: Path, base: str) -> list[Path]:
    """Recipe files added or modified since the merge base, including untracked."""

    def git(*args: str) -> list[str]:
        return subprocess.run(
            ["git", "-C", str(root), *args, "--", "recipes/*.json"],
            capture_output=True,
            text=True,
            check=True,
        ).stdout.splitlines()

    names = git("diff", "--name-only", "--diff-filter=AMR", "--merge-base", base)
    names += git("ls-files", "--others", "--exclude-standard")
    return sorted({root / name for name in names})


def report_markdown(mismatches: list[str]) -> str:
    if not mismatches:
        return ""
    return (
        "The recipes are estimates until the hardware try measures them. These "
        "declared memory values disagree with the estimate; none fails a check.\n\n"
        + "\n".join(f"- {item}" for item in mismatches)
        + "\n"
    )


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("recipes", nargs="*", help="recipe slugs; default: catalog")
    parser.add_argument(
        "--base",
        help="check only recipes touched since the merge base with this revision",
    )
    parser.add_argument(
        "--calibrate", action="store_true", help="audit hardware passes"
    )
    parser.add_argument(
        "--report",
        type=Path,
        help="write the estimate mismatches as a markdown issue body to this file",
    )
    args = parser.parse_args()
    models: dict[str, ModelDefinition] = {}
    for path in sorted((ROOT / "models").glob("*.json")):
        document = json.loads(path.read_text())
        models[document_sha256(document)] = ModelDefinition.model_validate(document)
    inputs = load_inputs()
    flagged = proven_count = applicable = 0
    mismatches: list[str] = []
    paths = (
        touched_recipes(ROOT, args.base)
        if args.base
        else [ROOT / "recipes" / f"{slug}.json" for slug in args.recipes]
        if args.recipes
        else sorted((ROOT / "recipes").glob("*.json"))
    )
    for path in paths:
        document = json.loads(path.read_text())
        recipe = RecipeDefinition.model_validate(document)
        key = f"{recipe.identity.publisher}/{recipe.identity.slug}"
        digest = document_sha256(document)
        if args.calibrate:
            evidence = read_evidence(ROOT, key)
            if not any(
                r.outcome == QualificationOutcome.PASSED for r in evidence.records
            ):
                continue
            proven_count += 1
            if recipe.runtime.engine not in {"vllm", "sglang"}:
                print(f"{key}: engine outside estimator scope")
                continue
            applicable += 1
            # No evidence-based exemption here: run every applicable variant.
            needs = [per_rank_need(v, models, inputs) for v in memory_variants(recipe)]
            if any(not n.fits for n in needs):
                flagged += 1
            print(
                f"{key}: maximum loading floor {max(n.peak_bytes for n in needs)} bytes/rank"
            )
            continue
        found = memory_estimate_warnings(
            recipe, models, inputs, document_digest=digest, touched=bool(args.base)
        )
        mismatches += found
        for warning in found:
            print(f"WARNING {warning}")
        if recipe.runtime.engine in {"vllm", "sglang"}:
            unchanged = unchanged_recipe(recipe, digest, inputs)
            print(
                f"{key}: hardware-proven={hardware_proven(recipe, digest)}; unchanged={unchanged}"
            )
        for note in memory_notes(recipe, models, inputs):
            print(note)
    if args.calibrate:
        print(
            f"Calibration: {proven_count} hardware-pass recipes; {applicable} applicable; {proven_count - applicable} other engines; {flagged} falsely flagged"
        )
    mismatches = list(dict.fromkeys(mismatches))
    if mismatches:
        print(f"{len(mismatches)} memory estimate mismatch(es); none fails this check")
    summary = os.environ.get("GITHUB_STEP_SUMMARY")
    if summary and mismatches:
        with open(summary, "a", encoding="utf-8") as stream:
            stream.write(report_markdown(mismatches))
    if args.report:
        args.report.write_text(report_markdown(mismatches), encoding="utf-8")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
