#!/usr/bin/env -S uv run --no-project --python 3.14 --with-editable contracts python
"""Enforce changed documents; report existing estimates as warnings only."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from vonk_forge_contracts import (
    ModelDefinition,
    QualificationOutcome,
    RecipeDefinition,
    document_sha256,
)

from qualification.memory_need import (
    hardware_proven,
    load_inputs,
    memory_variants,
    memory_warnings,
    per_rank_need,
    require_admissible_declaration,
    require_memory_need,
    unchanged_recipe,
)
from spark_sweep.qualification import read_evidence


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("recipes", nargs="*", help="recipe slugs; default: catalog")
    parser.add_argument(
        "--calibrate", action="store_true", help="audit hardware passes"
    )
    args = parser.parse_args()
    models: dict[str, ModelDefinition] = {}
    for path in sorted((ROOT / "models").glob("*.json")):
        document = json.loads(path.read_text())
        models[document_sha256(document)] = ModelDefinition.model_validate(document)
    inputs = load_inputs()
    failed = flagged = proven_count = applicable = 0
    paths = (
        [ROOT / "recipes" / f"{slug}.json" for slug in args.recipes]
        if args.recipes
        else sorted((ROOT / "recipes").glob("*.json"))
    )
    for path in paths:
        document = json.loads(path.read_text())
        recipe = RecipeDefinition.model_validate(document)
        key = f"{recipe.identity.publisher}/{recipe.identity.slug}"
        digest = document_sha256(document)
        try:
            require_admissible_declaration(recipe)
        except ValueError as error:
            failed += 1
            print(str(error), file=sys.stderr)
        if args.calibrate:
            evidence = read_evidence(ROOT, key)
            if not any(
                r.outcome == QualificationOutcome.PASSED for r in evidence.records
            ):
                continue
            proven_count += 1
            if recipe.runtime.engine not in {"vllm", "sglang"}:
                print(f"{key}: engine outside estimator scope")
                continue
            applicable += 1
            # No evidence-based exemption here: run every applicable variant.
            needs = [per_rank_need(v, models) for v in memory_variants(recipe)]
            if any(not n.fits for n in needs):
                flagged += 1
            print(
                f"{key}: maximum loading floor {max(n.peak_bytes for n in needs)} bytes/rank"
            )
            continue
        if recipe.runtime.engine not in {"vllm", "sglang"}:
            continue
        unchanged = unchanged_recipe(recipe, digest, inputs)
        try:
            require_memory_need(recipe, models, inputs, document_digest=digest)
            proof = hardware_proven(recipe, digest)
            print(f"{key}: hardware-proven={proof}; unchanged={unchanged}")
            for warning in memory_warnings(recipe, models, inputs):
                print(warning)
        except (ValueError, TypeError) as error:
            failed += 1
            print(str(error), file=sys.stderr)
    if args.calibrate:
        print(
            f"Calibration: {proven_count} hardware-pass recipes; {applicable} applicable; {proven_count - applicable} other engines; {flagged} falsely flagged"
        )
    return int(bool(failed or flagged))


if __name__ == "__main__":
    raise SystemExit(main())
