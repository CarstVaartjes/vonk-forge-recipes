#!/usr/bin/env -S uv run --no-project --python 3.14 --with-editable contracts python
"""Enforce changed documents; report existing estimates as warnings only."""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from vonk_forge_contracts import (
    ModelDefinition,
    QualificationOutcome,
    RecipeDefinition,
    document_sha256,
)

from qualification.memory_need import (
    hardware_proven,
    load_inputs,
    memory_variants,
    memory_warnings,
    per_rank_need,
    require_admissible_declaration,
    require_memory_need,
    unchanged_recipe,
)
from qualification.model_index import ModelIndex, model_index
from spark_sweep.qualification import read_evidence


def _git(root: Path, *args: str, stdin: bytes | None = None) -> bytes:
    return subprocess.run(
        ["git", "-C", str(root), *args],
        input=stdin,
        capture_output=True,
        check=True,
    ).stdout


def _base_documents(root: Path, revision: str, directory: str) -> dict[str, dict]:
    """The JSON documents under ``directory`` at ``revision``, by repository path."""
    names = _git(root, "ls-tree", "-r", "--name-only", revision, "--", directory)
    paths = [n for n in names.decode().splitlines() if n.endswith(".json")]
    if not paths:
        return {}
    # One process for every blob; an unreadable one is simply absent.
    out = _git(
        root,
        "cat-file",
        "--batch",
        stdin="".join(f"{revision}:{path}\n" for path in paths).encode(),
    )
    documents: dict[str, dict] = {}
    position = 0
    for path in paths:
        end = out.index(b"\n", position)
        header = out[position:end].split()
        if len(header) != 3:
            position = end + 1
            continue
        size = int(header[2])
        try:
            documents[path] = json.loads(out[end + 1 : end + 1 + size])
        except ValueError:
            pass
        position = end + 1 + size + 1
    return documents


def touched_recipes(root: Path, base: str) -> list[Path]:
    """Recipes whose execution differs from the merge base, including untracked.

    An edit that only changes authored display fields (the lists in
    ``vonk_forge_contracts.canonical``) leaves the recipe untouched.
    """

    def git(*args: str) -> list[str]:
        return _git(root, *args, "--", "recipes/*.json").decode().splitlines()

    names = git("diff", "--name-only", "--diff-filter=AMR", "--merge-base", base)
    names += git("ls-files", "--others", "--exclude-standard")
    names = sorted(set(names))
    if not names:
        return []
    revision = _git(root, "merge-base", base, "HEAD").decode().strip()
    base_index = ModelIndex.from_documents(
        _base_documents(root, revision, "models").values()
    )
    base_recipes = _base_documents(root, revision, "recipes")
    current_index = model_index(root)
    touched = []
    for name in names:
        before = base_recipes.get(name)
        fingerprint = current_index.fingerprint(json.loads((root / name).read_text()))
        if (
            before is None
            or fingerprint is None
            or base_index.fingerprint(before) != fingerprint
        ):
            touched.append(root / name)
    return touched


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("recipes", nargs="*", help="recipe slugs; default: catalog")
    parser.add_argument(
        "--base",
        help="check only recipes touched since the merge base with this revision",
    )
    parser.add_argument(
        "--calibrate", action="store_true", help="audit hardware passes"
    )
    args = parser.parse_args()
    models = {
        digest: ModelDefinition.model_validate(document)
        for digest, document in model_index(ROOT).documents.items()
    }
    inputs = load_inputs()
    failed = flagged = proven_count = applicable = 0
    paths = (
        touched_recipes(ROOT, args.base)
        if args.base
        else [ROOT / "recipes" / f"{slug}.json" for slug in args.recipes]
        if args.recipes
        else sorted((ROOT / "recipes").glob("*.json"))
    )
    for path in paths:
        document = json.loads(path.read_text())
        recipe = RecipeDefinition.model_validate(document)
        key = f"{recipe.identity.publisher}/{recipe.identity.slug}"
        digest = document_sha256(document)
        try:
            require_admissible_declaration(recipe)
        except ValueError as error:
            failed += 1
            print(str(error), file=sys.stderr)
        if args.calibrate:
            evidence = read_evidence(ROOT, key)
            if not any(
                r.outcome == QualificationOutcome.PASSED for r in evidence.records
            ):
                continue
            proven_count += 1
            if recipe.runtime.engine not in {"vllm", "sglang"}:
                print(f"{key}: engine outside estimator scope")
                continue
            applicable += 1
            # No evidence-based exemption here: run every applicable variant.
            needs = [per_rank_need(v, models, inputs) for v in memory_variants(recipe)]
            if any(not n.fits for n in needs):
                flagged += 1
            print(
                f"{key}: maximum loading floor {max(n.peak_bytes for n in needs)} bytes/rank"
            )
            continue
        if recipe.runtime.engine not in {"vllm", "sglang"}:
            continue
        unchanged = unchanged_recipe(recipe, digest, inputs)
        try:
            require_memory_need(
                recipe,
                models,
                inputs,
                document_digest=digest,
                touched=bool(args.base),
            )
            proof = hardware_proven(recipe, digest)
            print(f"{key}: hardware-proven={proof}; unchanged={unchanged}")
            for warning in memory_warnings(recipe, models, inputs):
                print(warning)
        except (ValueError, TypeError) as error:
            failed += 1
            print(str(error), file=sys.stderr)
    if args.calibrate:
        print(
            f"Calibration: {proven_count} hardware-pass recipes; {applicable} applicable; {proven_count - applicable} other engines; {flagged} falsely flagged"
        )
    return int(bool(failed or flagged))


if __name__ == "__main__":
    raise SystemExit(main())
