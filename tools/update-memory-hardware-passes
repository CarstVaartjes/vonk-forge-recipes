#!/usr/bin/env -S uv run --no-project --python 3.14 --with-editable contracts python
"""Generate the sole memory exemption set from read-only sweep result histories."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from vonk_forge_contracts import document_sha256

from qualification.memory_need import HardwarePass, MemoryInputs
from spark_sweep.removal_contract import RecipeVerdict


def generate(paths: list[Path], root: Path = ROOT) -> dict[str, HardwarePass]:
    passes: dict[str, HardwarePass] = {}
    for path in sorted(paths):
        with path.open() as history:
            for line in history:
                row = json.loads(line)
                if row.get("status") != RecipeVerdict.PASSED:
                    continue
                key = row["recipe"]
                publisher, slug = key.split("/")
                document = root / "recipes" / f"{slug}.json"
                if not document.is_file():
                    continue
                catalog = json.loads(document.read_text())
                if catalog["identity"]["publisher"] != publisher:
                    raise ValueError(f"{path}: publisher mismatch for {key}")
                observed = HardwarePass(
                    recorded_at=row["recorded_at"],
                    content_sha256=row["content_sha256"],
                    catalog_content_sha256=document_sha256(catalog),
                    library_commit=row["library_commit"],
                    recipe_revision_id=row["recipe_revision_id"],
                )
                previous = passes.get(key)
                if previous is None or observed.recorded_at > previous.recorded_at:
                    passes[key] = observed
    return passes


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("histories", nargs="+", type=Path)
    args = parser.parse_args()
    path = ROOT / "qualification/memory-inputs.json"
    inputs = MemoryInputs.model_validate_json(path.read_text())
    inputs.hardware_passes = generate(args.histories)
    path.write_text(
        json.dumps(
            inputs.model_dump(mode="json", exclude_defaults=True),
            indent=2,
            sort_keys=True,
        )
        + "\n"
    )


if __name__ == "__main__":
    main()
