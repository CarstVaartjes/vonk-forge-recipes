            "format": {"container": "safetensors", "precision": "bf16", "quantization": "none"},
            "parameters": {"total": None, "active": None},
            "limits": {"context_tokens": None},
            "sizes": {"download_bytes": total, "installed_bytes": total},
            "license": {"spdx": "Apache-2.0", "url": f"https://huggingface.co/{repo}/blob/{revision}/LICENSE", "attribution": [publisher], "operator_acceptance_required": True},
            "access": {"visibility": "public", "gated": False, "authentication": "none"},
            "artifacts": [{"id": "snapshot", "path": "snapshot", "kind": "huggingface.file", "repository": f"https://huggingface.co/{repo}", "revision": revision, "sha256": hashlib.sha256(inventory).hexdigest(), "download_bytes": total, "installed_bytes": total, "roles": ["entrypoint"]}],
            "dependencies": [], "availability": "active", "supersedes": None,
        }
        version_path.write_text(json.dumps(version, indent=2) + "\n")
        version_hash = digest(version)
        if recipe_slug not in recipe_refs:
            is_3d = modality == "three-d"
            harness = "pytorch-pipeline" if is_3d else "diffusers"
            runtime_slug = "pytorch-2-8-cuda13-arm64" if is_3d else "diffusers-0-39-0-cuda13-arm64"
            runtime_hash_ref = runtime_hash if is_3d else diffusers_runtime_hash
            output_mime = "model/gltf-binary" if is_3d else ("video/mp4" if modality == "video" else ("audio/wav" if modality == "audio" else "image/png"))
            interface = "mesh-job" if is_3d else f"{modality}-job"
            checks = [f"artifact.mime.{output_mime.replace('/', '-')}"]
            arguments = ([{"name": "entrypoint", "value": "/opt/vonk/source/run.py"}] if is_3d else []) + [{"name": "output-mime", "value": output_mime}]
            if is_3d:
                arguments += [{"name": "timeout-seconds", "value": 3600}]
            arguments += [{"name": "seed", "value": 0}]
            if not is_3d:
                arguments.insert(1, {"name": "pipeline", "value": "text-to-video" if modality == "video" else ("text-to-audio" if modality == "audio" else "text-to-image")})
                arguments += [{"name": "num-inference-steps", "value": 4}, {"name": "guidance-scale", "value": "4"}]
                if modality == "image": arguments += [{"name": "width", "value": 512}, {"name": "height", "value": 512}]
            recipe = {
                "schema_version": 1,
                "identity": {"publisher": "vonk-forge", "slug": recipe_slug},
                "metadata": {"title": f"{version_title} {harness} single Spark", "description": "Candidate public model binding through the standard ARM64 media harness; physical Spark acceptance is required.", "tags": ["candidate", modality, harness, "single", "spark"]},
                "model": {"kind": "model-version", "publisher": publisher, "slug": version_slug, "content_sha256": version_hash},
                "execution": {"harness": {"kind": "execution-harness", "publisher": "vonk-forge", "slug": harness, "content_sha256": harness_hashes[harness]}, "patch_bundle": None},
                "build": {"context": {"path": "adapters/media/upstream-native", "sha256": bundle.sha256, "expected_bytes": len(bundle.archive), "media_type": "application/vnd.vonk-forge.source-bundle.v1+tar"}, "dockerfile": "Dockerfile", "platform": "linux/arm64", "arguments": [], "network": {"mode": "public", "hosts": ["download.pytorch.org", "pypi.org", "files.pythonhosted.org", "archive.ubuntu.com", "ports.ubuntu.com"]}, "resources": {"download_bytes": total + 2000000000, "temporary_bytes": max(total * 2, 16000000000), "memory_bytes": 8000000000, "timeout_seconds": 14400}},
                "parameters": [], "artifacts": [{"id": "weights", "kind": "huggingface.snapshot", "repository": repo, "revision": revision, "download_bytes": total, "installed_bytes": total, "mount": {"target": "/models", "read_only": True}, "roles": ["entrypoint"]}],
                "runtime": {"distribution": {"kind": "runtime-distribution", "publisher": "pytorch" if is_3d else "huggingface", "slug": runtime_slug, "content_sha256": runtime_hash_ref}, "entrypoint": [f"/opt/vonk/bin/{'pytorch-pipeline' if is_3d else 'diffusers-job'}"], "arguments": arguments, "environment": [{"name": "HF_HUB_OFFLINE", "value": "1"}, {"name": "TRANSFORMERS_OFFLINE", "value": "1"}] if not is_3d else [{"name": "HF_HUB_OFFLINE", "value": "1"}], "security": {"devices": ["nvidia.com/gpu=all"], "capabilities": [], "host_network": False, "privileged": False, "user": "10001:10001", "mounts": [{"source": "model", "target": "/models", "read_only": True}, {"source": "outputs", "target": "/outputs", "read_only": False}]}, "lifecycle": {"pre_start": [], "post_stop": [], "stop_timeout_seconds": 120, "readiness": {"strategy": "endpoint-owner", "path": "/outputs", "timeout_seconds": 3600}, "failure": {"rank_loss": "not-applicable", "recovery": "restart-entrypoint"}}},
                "topology": {"name": "solo", "mode": "single", "node_count": 1, "roles": [{"name": "entrypoint", "count": 1, "endpoint_owner": True, "artifacts": ["weights"], "resources": {"disk": {"image_bytes": 2000000000, "artifact_bytes": total, "staging_bytes": max(total * 2, 16000000000), "cache_bytes": 8000000000, "rollback_bytes": 0, "safety_margin_bytes": 12000000000}, "memory": {"kind": "unified", "startup_peak_bytes": min(120000000000, max(32000000000, total // 2)), "steady_state_bytes": min(110000000000, max(24000000000, total // 3)), "runtime_growth_bytes": 8000000000, "system_reserve_bytes": 8000000000}}}], "parallelism": {"world_size": 1, "tensor": 1, "pipeline": 1, "data": 1, "backend": "local"}, "fabric": {"connectivity": "none", "minimum_bandwidth_mbps": 0}, "start_order": ["entrypoint"], "stop_order": ["entrypoint"]},
                "interfaces": [{"adapter": interface, "path": "/outputs"}], "validation": {"validators": [{"interface": interface, "checks": checks}], "benchmarks": [{"name": "bounded-startup", "framework": harness, "configuration": {"timeout_seconds": 14400}}]}, "provenance": {"source_kind": "global", "source_reference": f"https://huggingface.co/{repo}/tree/{revision}", "attribution": [publisher]},
            }
            (root / "recipes" / f"{recipe_slug}.json").write_text(json.dumps(recipe, indent=2) + "\n")
            recipe_refs[recipe_slug] = (version_slug, version_hash)
        target_path = root / "model-targets" / f"{file_name}.json"
        target = json.loads(target_path.read_text())
        target["targets"][index]["recipe_slugs"] = [recipe_slug]
        target["targets"][index]["catalog_model_version"] = version_slug
        target["targets"][index]["notes"] = "Standard ARM64 recipe is cataloged; physical Spark acceptance remains required."
        target_path.write_text(json.dumps(target, indent=2) + "\n")
    print(json.dumps({"recipes": len(recipe_refs), "context_sha256": bundle.sha256, "context_bytes": len(bundle.archive)}, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
