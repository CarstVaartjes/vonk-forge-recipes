def canonical(value: object) -> bytes:
    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode()


def api_json(url: str) -> object:
    request = urllib.request.Request(url, headers={"User-Agent": "vonk-forge-recipe-library/1"})
    with urllib.request.urlopen(request, timeout=90) as response:
        return json.load(response)


def digest(document: object) -> str:
    return hashlib.sha256(canonical(document)).hexdigest()


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parents[1])
    parser.add_argument("--platform-root", type=Path, required=True)
    args = parser.parse_args()
    root = args.root.resolve()
    sys.path.insert(0, str(args.platform_root.resolve() / "control/src"))
    from vonk_control.source_bundles import generate_source_bundle

    context_files = {
        path.relative_to(root / "adapters/media/upstream-native").as_posix(): path.read_bytes()
        for path in (root / "adapters/media/upstream-native").rglob("*")
        if path.is_file()
    }
    bundle = generate_source_bundle(context_files)
    runtime = json.loads((root / "runtime-distributions/pytorch-2-8-cuda13-arm64.json").read_text())
    runtime_hash = digest(runtime)
    diffusers_runtime = json.loads((root / "runtime-distributions/diffusers-0-39-0-cuda13-arm64.json").read_text())
    diffusers_runtime_hash = digest(diffusers_runtime)
    harness_hashes = {
        "pytorch-pipeline": "29977e349e97f34a2f4f7d6a033abcc9383b0763278192c05e148b2a09cdf01c",
        "diffusers": "9776b37f1bf4596bf4a0c75c3e9fd6da8b25050aa2cefded2ffd5e35baa583b2",
    }
    recipe_refs: dict[str, tuple[str, str]] = {}
    for file_name, index, recipe_slug, modality, group_slug, model_slug, version_title, publisher, repo, revision in TARGETS:
        model_path = root / "models" / f"{model_slug}.json"
        group_path = root / "model-groups" / f"{group_slug}.json"
        if group_path.exists():
            group = json.loads(group_path.read_text())
        else:
            group_publisher, title, description = GROUPS[group_slug]
            group = {
                "schema_version": 1,
                "kind": "model-group",
                "identity": {"publisher": group_publisher, "slug": group_slug},
                "metadata": {"title": title, "description": description, "tags": [group_publisher, group_slug, modality]},
                "family": group_slug,
            }
            group_path.write_text(json.dumps(group, indent=2) + "\n")
        group_ref = {"kind": "model-group", **group["identity"], "content_sha256": digest(group)}
        if model_path.exists():
            model = json.loads(model_path.read_text())
        else:
            model = {
                "schema_version": 1,
                "kind": "model",
                "identity": {"publisher": publisher, "slug": model_slug},
                "metadata": {"title": version_title.rsplit(" ", 1)[0], "description": f"{version_title} model family.", "tags": [publisher, modality, "generation"]},
                "model_group": group_ref,
                "architecture": "upstream-native generation pipeline",
            }
            model_path.write_text(json.dumps(model, indent=2) + "\n")
        model_hash = digest(model)
        tree = api_json(f"https://huggingface.co/api/models/{repo}/tree/{revision}?recursive=true&expand=true")
        files = [item for item in tree if isinstance(item, dict) and item.get("type") == "file" and isinstance(item.get("size"), int) and item["size"] > 0]
        total = sum(int(item["size"]) for item in files)
        inventory = "\n".join(f"{item['path']}\0{item['size']}\0{item.get('lfs', {}).get('oid', '')}" for item in sorted(files, key=lambda x: x["path"])).encode()
        version_slug = recipe_slug.removesuffix("-diffusers-single").removesuffix("-pytorch-single")
        version_path = root / "model-versions" / f"{version_slug}.json"
        version = {
            "schema_version": 1,
            "kind": "model-version",
            "identity": {"publisher": publisher, "slug": version_slug},
            "metadata": {"title": version_title, "description": f"Immutable public snapshot at {revision[:8]}.", "tags": list(dict.fromkeys([publisher, modality, "candidate"]))},
