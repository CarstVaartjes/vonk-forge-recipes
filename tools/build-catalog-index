REPOSITORY = "CarstVaartjes/vonk-forge-recipes"
ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "contracts" / "src"))
OUTPUT = ROOT / "catalog-index.json"
QUALIFICATION_ROOT = ROOT / "qualification"
QUALIFICATION_DEFINITIONS = QUALIFICATION_ROOT / "definitions.json"
QUALIFICATION_OUTPUT = QUALIFICATION_ROOT / "qualification-index.json"
# Control planes fetch oversized Contents API entries by immutable Git blob SHA.
# Keep the generated index within the same bounded raw-blob envelope as source files.
MAX_INDEX_BYTES = 12 * 1024 * 1024
MAX_SOURCE_FILE_BYTES = 12 * 1024 * 1024
MAX_RELEASE_BYTES = 64 * 1024
MAX_RELEASE_HISTORY = 32
MAX_RELEASE_CHANGES = 16
MAX_RELEASE_REFERENCES = 8
SEMVER = re.compile(
    r"^(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)"
    r"(?:-[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?$"
)
SHA256 = re.compile(r"^[0-9a-f]{64}$")
RELEASE_CHANGE_KINDS = {
    "initial",
    "model",
    "runtime",
    "performance",
    "fix",
    "security",
    "compatibility",
    "breaking",
    "metadata",
}
UPGRADE_EFFECTS = {"metadata-only", "restart", "reinstall", "rebuild"}
ENTITY_DIRECTORIES = {
    "models": "model",
}
PACKAGE_SCHEMA_VERSION = 2
PACKAGE_MEDIA_TYPE = "application/vnd.vonk-forge.recipe-package.v2+tar+gzip"
FROM_LINE = re.compile(r"^FROM(?:\s+--platform=(\S+))?\s+(\S+)(?:\s+AS\s+(\S+))?\s*$", re.IGNORECASE)


def canonical(document: object) -> bytes:
    return json.dumps(
        document,
        ensure_ascii=False,
        allow_nan=False,
        sort_keys=True,
        separators=(",", ":"),
    ).encode("utf-8")


def _release_error(path: Path, detail: str) -> SystemExit:
    return SystemExit(f"recipe release is invalid ({path.relative_to(ROOT)}): {detail}")


def _bounded_string(
    value: object,
    *,
    path: Path,
    field: str,
    maximum: int,
) -> str:
    if not isinstance(value, str) or not value.strip() or len(value) > maximum:
        raise _release_error(path, f"{field} must contain 1..{maximum} characters")
    return value


def _release_date(value: object, *, path: Path, field: str) -> str:
    text = _bounded_string(value, path=path, field=field, maximum=10)
    try:
        parsed = dt.date.fromisoformat(text)
    except ValueError as error:
        raise _release_error(
            path, f"{field} must be an ISO 8601 calendar date"
        ) from error
    if parsed.isoformat() != text:
        raise _release_error(path, f"{field} must use YYYY-MM-DD form")
    return text


def _semver_is_older(older: str, newer: str) -> bool:
    def parts(value: str) -> tuple[tuple[int, int, int], tuple[str, ...]]:
        core, separator, prerelease = value.partition("-")
        return (
            tuple(int(item) for item in core.split(".")),  # type: ignore[return-value]
            tuple(prerelease.split(".")) if separator else (),
        )

    older_core, older_prerelease = parts(older)
    newer_core, newer_prerelease = parts(newer)
    if older_core != newer_core:
        return older_core < newer_core
    if not older_prerelease:
        return False
    if not newer_prerelease:
        return True
    for older_item, newer_item in zip(older_prerelease, newer_prerelease, strict=False):
        if older_item == newer_item:
            continue
        older_numeric = older_item.isdigit()
        newer_numeric = newer_item.isdigit()
        if older_numeric and newer_numeric:
            return int(older_item) < int(newer_item)
        if older_numeric != newer_numeric:
            return older_numeric
        return older_item < newer_item
    return len(older_prerelease) < len(newer_prerelease)


def recipe_release(
    path: Path,
    *,
    publisher: str,
    slug: str,
    recipe_digest: str,
) -> dict[str, object]:
    raw = path.read_bytes()
    if not raw or len(raw) > MAX_RELEASE_BYTES:
        raise _release_error(
            path, f"document must contain 1..{MAX_RELEASE_BYTES} bytes"
        )
    try:
        document = json.loads(raw)
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise _release_error(path, "document must be UTF-8 JSON") from error
    if not isinstance(document, dict) or set(document) != {
        "schema_version",
        "recipe",
        "version",
        "released_at",
        "history",
    }:
        raise _release_error(path, "top-level shape is not recipe-release v1")
    if document["schema_version"] != 1:
        raise _release_error(path, "schema_version must be 1")
    identity = document["recipe"]
    if not isinstance(identity, dict) or set(identity) != {"publisher", "slug"}:
        raise _release_error(
            path, "recipe identity must contain exactly publisher and slug"
        )
    if identity != {"publisher": publisher, "slug": slug}:
        raise _release_error(
            path, "recipe identity does not match the executable recipe"
        )
    version = _bounded_string(
        document["version"], path=path, field="version", maximum=64
    )
    if SEMVER.fullmatch(version) is None:
        raise _release_error(path, "version must be semantic MAJOR.MINOR.PATCH")
    released_at = _release_date(document["released_at"], path=path, field="released_at")
    history = document["history"]
    if not isinstance(history, list) or not 1 <= len(history) <= MAX_RELEASE_HISTORY:
        raise _release_error(
            path, f"history must contain 1..{MAX_RELEASE_HISTORY} releases"
        )
    clean_history: list[dict[str, object]] = []
    versions: set[str] = set()
    digests: set[str] = set()
    previous_version: str | None = None
    previous_date: str | None = None
    for history_index, item in enumerate(history):
        prefix = f"history[{history_index}]"
        if not isinstance(item, dict) or set(item) != {
            "version",
            "released_at",
            "recipe_content_sha256",
            "upgrade_effect",
            "changes",
        }:
            raise _release_error(path, f"{prefix} has an invalid shape")
        item_version = _bounded_string(
            item["version"], path=path, field=f"{prefix}.version", maximum=64
        )
        if SEMVER.fullmatch(item_version) is None or item_version in versions:
            raise _release_error(
                path, f"{prefix}.version must be a unique semantic version"
            )
        if previous_version is not None and not _semver_is_older(
            item_version, previous_version
        ):
            raise _release_error(
                path, "history must be newest-first by semantic version"
            )
        versions.add(item_version)
        previous_version = item_version
        item_date = _release_date(
            item["released_at"], path=path, field=f"{prefix}.released_at"
        )
        if previous_date is not None and item_date > previous_date:
            raise _release_error(path, "history must be newest-first by released_at")
        previous_date = item_date
        digest = item["recipe_content_sha256"]
        if (
            not isinstance(digest, str)
            or SHA256.fullmatch(digest) is None
            or digest in digests
        ):
            raise _release_error(
                path, f"{prefix}.recipe_content_sha256 must be a unique digest"
            )
        digests.add(digest)
        effect = item["upgrade_effect"]
        if effect not in UPGRADE_EFFECTS:
            raise _release_error(path, f"{prefix}.upgrade_effect is unsupported")
        changes = item["changes"]
        if (
            not isinstance(changes, list)
            or not 1 <= len(changes) <= MAX_RELEASE_CHANGES
        ):
            raise _release_error(
                path, f"{prefix}.changes must contain 1..{MAX_RELEASE_CHANGES} entries"
            )
        clean_changes: list[dict[str, object]] = []
        for change_index, change in enumerate(changes):
            change_prefix = f"{prefix}.changes[{change_index}]"
            if (
                not isinstance(change, dict)
                or not {"kind", "summary"} <= set(change)
                or not set(change) <= {"kind", "summary", "details", "references"}
            ):
                raise _release_error(path, f"{change_prefix} has an invalid shape")
            kind = change["kind"]
            if kind not in RELEASE_CHANGE_KINDS:
                raise _release_error(path, f"{change_prefix}.kind is unsupported")
            clean_change: dict[str, object] = {
                "kind": kind,
                "summary": _bounded_string(
                    change["summary"],
                    path=path,
                    field=f"{change_prefix}.summary",
                    maximum=160,
                ),
            }
            if "details" in change:
                clean_change["details"] = _bounded_string(
                    change["details"],
                    path=path,
                    field=f"{change_prefix}.details",
                    maximum=1000,
                )
            if "references" in change:
                references = change["references"]
                if (
                    not isinstance(references, list)
                    or not 1 <= len(references) <= MAX_RELEASE_REFERENCES
                    or not all(isinstance(reference, str) for reference in references)
                    or len(set(references)) != len(references)
                ):
                    raise _release_error(
                        path,
                        f"{change_prefix}.references must contain "
                        f"1..{MAX_RELEASE_REFERENCES} unique URLs",
                    )
                clean_references: list[str] = []
                for reference_index, reference in enumerate(references):
                    reference = _bounded_string(
                        reference,
                        path=path,
                        field=f"{change_prefix}.references[{reference_index}]",
                        maximum=500,
                    )
                    parsed = urlsplit(reference)
                    if (
                        parsed.scheme != "https"
                        or not parsed.hostname
                        or parsed.username
                        or parsed.password
                    ):
                        raise _release_error(
                            path,
                            f"{change_prefix}.references must use public HTTPS URLs",
                        )
                    clean_references.append(reference)
                clean_change["references"] = clean_references
            clean_changes.append(clean_change)
        clean_history.append(
            {
                "version": item_version,
                "released_at": item_date,
                "recipe_content_sha256": digest,
                "upgrade_effect": effect,
                "changes": clean_changes,
            }
        )
    latest = clean_history[0]
    if (
        latest["version"] != version
        or latest["released_at"] != released_at
        or latest["recipe_content_sha256"] != recipe_digest
    ):
        raise _release_error(
            path,
            "version, released_at, and current recipe digest must match history[0]",
        )
    return {
        "version": version,
        "released_at": released_at,
        "history": clean_history,
    }


def source_bundle(context: Path) -> tuple[bytes, list[dict[str, object]], str]:
    files: list[tuple[str, bytes]] = []
    for path in sorted(
        context.rglob("*"),
        key=lambda item: item.relative_to(context).as_posix().encode(),
    ):
        relative = path.relative_to(context).as_posix()
        if path.is_symlink():
            raise SystemExit(
                f"unsafe source bundle entry: {context.relative_to(ROOT)}/{relative}"
            )
        if path.is_dir():
            continue
        if not path.is_file() or "__pycache__" in path.parts or path.suffix == ".pyc":
            raise SystemExit(
                f"unsafe source bundle entry: {context.relative_to(ROOT)}/{relative}"
            )
        content = path.read_bytes()
        if len(content) > MAX_SOURCE_FILE_BYTES:
            raise SystemExit(
                "source bundle file exceeds the Git blob hydration limit: "
                f"{context.relative_to(ROOT)}/{relative}"
            )
        files.append((relative, content))
    if not files:
        raise SystemExit(f"source bundle is empty: {context.relative_to(ROOT)}")
    stream = io.BytesIO()
    with tarfile.open(fileobj=stream, mode="w", format=tarfile.PAX_FORMAT) as bundle:
        for relative, content in files:
            member = tarfile.TarInfo(relative)
            member.size = len(content)
            member.mode = 0o644
            member.uid = member.gid = 0
            member.uname = member.gname = ""
            member.mtime = 0
            bundle.addfile(member, io.BytesIO(content))
    metadata = [
        {
            "path": relative,
            "size": len(content),
            "blob_sha": hashlib.sha1(
                f"blob {len(content)}\0".encode() + content,
                usedforsecurity=False,
            ).hexdigest(),
        }
        for relative, content in files
    ]
    manifest = {
        "schema_version": 1,
        "files": [
            {
                "path": relative,
                "mode": 0o644,
                "size": len(content),
                "sha256": hashlib.sha256(content).hexdigest(),
            }
            for relative, content in files
        ],
        "total_bytes": sum(len(content) for _, content in files),
    }
    return stream.getvalue(), metadata, hashlib.sha256(canonical(manifest)).hexdigest()


def catalog_entities() -> list[dict[str, object]]:
    entries: list[dict[str, object]] = []
    identities: set[tuple[str, str, str]] = set()
    for directory, expected_kind in ENTITY_DIRECTORIES.items():
        for path in sorted((ROOT / directory).glob("*.json")):
            document = json.loads(path.read_text(encoding="utf-8"))
            identity = document.get("identity")
            if document.get("kind") != expected_kind or not isinstance(identity, dict):
                raise SystemExit(
                    f"catalog entity identity is invalid: {path.relative_to(ROOT)}"
                )
            key = (expected_kind, identity.get("publisher"), identity.get("slug"))
            if not all(isinstance(value, str) for value in key):
                raise SystemExit(
                    f"catalog entity identity is invalid: {path.relative_to(ROOT)}"
                )
            if key in identities:
                raise SystemExit(f"duplicate catalog entity identity: {'/'.join(key)}")
            identities.add(key)
            entries.append(
                {
                    "source_path": path.relative_to(ROOT).as_posix(),
                    "content_sha256": hashlib.sha256(canonical(document)).hexdigest(),
                    "document": document,
                }
            )
    return sorted(entries, key=lambda entry: str(entry["source_path"]))


def build() -> dict[str, object]:
    recipes: list[dict[str, object]] = []
    contexts: dict[str, dict[str, object]] = {}
    identities: set[tuple[str, str]] = set()
    for path in sorted((ROOT / "recipes").glob("*.json")):
        document = json.loads(path.read_text(encoding="utf-8"))
        identity = document.get("identity")
        if not isinstance(identity, dict):
            raise SystemExit(f"recipe identity is missing: {path.relative_to(ROOT)}")
        key = (identity.get("publisher"), identity.get("slug"))
        if not all(isinstance(value, str) for value in key):
            raise SystemExit(f"recipe identity is invalid: {path.relative_to(ROOT)}")
        if key in identities:
            raise SystemExit(f"duplicate recipe identity: {key[0]}/{key[1]}")
        identities.add(key)
        source_path = path.relative_to(ROOT).as_posix()
        if source_path != f"recipes/{key[1]}.json":
            raise SystemExit(f"recipe path does not match its slug: {source_path}")
        recipe_digest = hashlib.sha256(canonical(document)).hexdigest()
        release_path = ROOT / "recipe-releases" / f"{key[1]}.json"
        if not release_path.is_file():
            raise SystemExit(
                f"recipe release is missing: {release_path.relative_to(ROOT)}"
            )
        recipes.append(
            {
                "source_path": source_path,
                "content_sha256": recipe_digest,
                "document": document,
                "release": recipe_release(
                    release_path,
                    publisher=key[0],
                    slug=key[1],
                    recipe_digest=recipe_digest,
                ),
            }
        )
        build = document.get("build")
        context = build.get("context") if isinstance(build, dict) else None
        context_path = context.get("path") if isinstance(context, dict) else None
        expected_digest = context.get("sha256") if isinstance(context, dict) else None
        expected_bytes = (
            context.get("expected_bytes") if isinstance(context, dict) else None
        )
        if (
            not isinstance(context_path, str)
            or not isinstance(expected_digest, str)
            or not isinstance(expected_bytes, int)
        ):
            raise SystemExit(f"recipe source bundle identity is invalid: {source_path}")
        archive, files, actual_digest = source_bundle(ROOT / context_path)
        if actual_digest != expected_digest or len(archive) != expected_bytes:
            raise SystemExit(
                f"recipe source bundle does not match its contract: {source_path}"
            )
        previous = contexts.get(expected_digest)
        entry = {
            "context_path": context_path,
            "content_sha256": actual_digest,
            "expected_bytes": len(archive),
            "files": files,
        }
        if previous is not None and previous != entry:
            raise SystemExit(f"source bundle digest collision: {expected_digest}")
        contexts[expected_digest] = entry
    release_paths = sorted((ROOT / "recipe-releases").glob("*.json"))
    expected_release_paths = {
        ROOT / "recipe-releases" / f"{slug}.json" for _, slug in identities
    }
    unexpected_releases = set(release_paths) - expected_release_paths
    if unexpected_releases:
        path = min(unexpected_releases)
        raise SystemExit(f"orphan recipe release: {path.relative_to(ROOT)}")
    return {
        "schema_version": 2,
        "repository": REPOSITORY,
        "catalog_entities": catalog_entities(),
        "source_contexts": sorted(
            contexts.values(), key=lambda entry: str(entry["content_sha256"])
        ),
        "recipes": recipes,
    }


def qualification_index(catalog: dict[str, object]) -> dict[str, object]:
    try:
        definitions = json.loads(QUALIFICATION_DEFINITIONS.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as error:
        raise SystemExit("qualification definitions are unreadable") from error
    if not isinstance(definitions, dict) or definitions.get("schema_version") != 2:
        raise SystemExit("qualification definitions must use schema_version 2")
    recipes = catalog.get("recipes")
    if not isinstance(recipes, list):
        raise SystemExit("catalog recipes are unavailable for qualification generation")
    bindings: dict[str, tuple[str, int]] = {}
    for entry in recipes:
        if not isinstance(entry, dict):
            raise SystemExit("catalog recipe entry is invalid")
        document = entry.get("document")
        identity = document.get("identity") if isinstance(document, dict) else None
        topology = document.get("topology") if isinstance(document, dict) else None
        publisher = identity.get("publisher") if isinstance(identity, dict) else None
        slug = identity.get("slug") if isinstance(identity, dict) else None
        node_count = topology.get("node_count") if isinstance(topology, dict) else None
        digest = entry.get("content_sha256")
        if (
            not isinstance(publisher, str)
            or not isinstance(slug, str)
            or not isinstance(node_count, int)
            or isinstance(node_count, bool)
            or not isinstance(digest, str)
            or SHA256.fullmatch(digest) is None
        ):
            raise SystemExit("catalog recipe identity is invalid for qualification")
        bindings[f"{publisher}/{slug}"] = (digest, node_count)

    binding_fields = ("recipes", "service_recipes", "special_fixtures")
    actual: set[str] = set()
    for field in binding_fields:
        values = definitions.get(field, {})
        if not isinstance(values, dict):
            raise SystemExit(f"qualification definitions {field} must be an object")
        overlap = actual & set(values)
        if overlap:
            raise SystemExit(
                f"qualification recipe is defined more than once: {min(overlap)}"
            )
        actual.update(values)
        for key, value in values.items():
            if not isinstance(value, dict):
                raise SystemExit(f"qualification definition is invalid: {key}")
            if "content_sha256" in value:
                raise SystemExit(
                    f"qualification source must not contain a recipe digest: {key}"
                )

    expected = {key for key, (_digest, nodes) in bindings.items() if nodes <= 2}
    missing = sorted(expected - actual)
    unexpected = sorted(actual - expected)
    if missing:
        raise SystemExit(f"qualification definition is missing for recipe {missing[0]}")
    if unexpected:
        raise SystemExit(
            f"qualification definition references unavailable recipe {unexpected[0]}"
        )

    fixture_rows = definitions.get("fixtures")
    if not isinstance(fixture_rows, dict):
        raise SystemExit("qualification definitions fixtures must be an object")
    for fixture_id, value in fixture_rows.items():
        if not isinstance(value, dict):
            raise SystemExit(f"qualification fixture is invalid: {fixture_id}")
        relative = value.get("path")
        size = value.get("size_bytes")
        digest = value.get("sha256")
        if (
            not isinstance(relative, str)
            or not isinstance(size, int)
            or isinstance(size, bool)
            or not isinstance(digest, str)
            or SHA256.fullmatch(digest) is None
        ):
            raise SystemExit(f"qualification fixture identity is invalid: {fixture_id}")
        path = (QUALIFICATION_ROOT / relative).resolve()
        try:
            path.relative_to(QUALIFICATION_ROOT.resolve())
            content = path.read_bytes()
        except (OSError, ValueError) as error:
            raise SystemExit(
                f"qualification fixture is unavailable: {fixture_id}"
            ) from error
        if value.get("encoding") == "base64":
            try:
                content = base64.b64decode(b"".join(content.split()), validate=True)
            except ValueError as error:
                raise SystemExit(
                    f"qualification fixture base64 is invalid: {fixture_id}"
                ) from error
        if len(content) != size or hashlib.sha256(content).hexdigest() != digest:
            raise SystemExit(f"qualification fixture digest is stale: {fixture_id}")

    generated = json.loads(json.dumps(definitions))
    for field in binding_fields:
        for key, value in generated.get(field, {}).items():
            value["content_sha256"] = bindings[key][0]
    return generated


def rendered(document: dict[str, object]) -> str:
    # The GitHub Contents API rejects large payloads. Keep the generated index
    # deterministic but compact so full artifact inventories remain available
    # for very large, heavily sharded checkpoints.
    return (
        json.dumps(
            document,
            ensure_ascii=False,
            allow_nan=False,
            sort_keys=True,
            separators=(",", ":"),
        )
        + "\n"
    )


def _git_revision(cwd: Path) -> str:
    try:
        value = subprocess.run(["git", "rev-parse", "HEAD"], cwd=cwd, check=True, capture_output=True, text=True).stdout.strip()
    except (OSError, subprocess.CalledProcessError) as error:
        raise SystemExit("unable to determine the immutable recipe source commit") from error
    if not re.fullmatch(r"[0-9a-f]{40}", value):
        raise SystemExit("source commit must be a full SHA-1")
    return value


def _recorded_source_commit() -> str:
    try:
        value = json.loads(OUTPUT.read_text(encoding="utf-8")).get("source_commit")
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        value = None
    if not isinstance(value, str) or not re.fullmatch(r"[0-9a-f]{40}", value):
        raise SystemExit("catalog-index.json does not record a full source commit")
    try:
        result = subprocess.run(["git", "merge-base", "--is-ancestor", value, "HEAD"], cwd=ROOT)
    except (OSError, subprocess.CalledProcessError) as error:
        raise SystemExit("catalog source commit is not an ancestor of the current checkout") from error
    if result.returncode != 0:
        raise SystemExit("catalog source commit is not an ancestor of the current checkout")
    return value


# v2 package producer.  This deliberately replaces the historical six-entity
# producer above; it remains in the file only so old release validation helpers
# can be reused while branches transition.
def _catalog_entity_documents() -> dict[str, dict[str, object]]:
    result: dict[str, dict[str, object]] = {}
    from vonk_forge_contracts import ModelDefinition
    for path in sorted((ROOT / "models").glob("*.json")):
        document = ModelDefinition.model_validate(json.loads(path.read_text(encoding="utf-8"))).model_dump(mode="json", exclude_unset=False, exclude_none=False)
        identity = document.get("identity", {})
        if document.get("kind") != "model":
            raise SystemExit(f"model document is not kind=model: {path.relative_to(ROOT)}")
        key = f"{identity.get('publisher')}/{identity.get('slug')}"
        result[key] = document
    return result


def _platform_harness_documents(_platform_root: Path) -> dict[str, dict[str, object]]:
    # Runtime distributions and harness documents are platform-owned.  They
    # are intentionally resolved into recipe execution fields and never copied
    # into an author package.
    return {}


def _safe_file(path: Path) -> bool:
    return path.is_file() and not path.is_symlink() and "__pycache__" not in path.parts and path.suffix != ".pyc"


def _recipe_closure(recipe: dict[str, object], recipe_path: Path, entities: dict[str, dict[str, object]]) -> list[tuple[str, bytes]]:
    files: dict[str, bytes] = {"recipe.json": canonical(recipe)}
    pending = [selection["model"] for selection in recipe["models"]]  # type: ignore[index]
    seen_models: set[str] = set()
    while pending:
        reference = pending.pop(0)
        key = f"{reference['publisher']}/{reference['slug']}"
        if key in seen_models:
            continue
        model = entities.get(key)
        if model is None:
            raise SystemExit(f"package model snapshot is missing: {key}")
        seen_models.add(key)
        files[f"models/{reference['slug']}.json"] = canonical(model)
        pending.extend(model.get("dependencies", []))
        if model.get("supersedes") is not None:
            pending.append(model["supersedes"])
    execution = recipe["execution"]  # type: ignore[index]
    if execution["mode"] == "build":  # type: ignore[index]
        build = execution["build"]  # type: ignore[index]
        context = ROOT / build["context"]["path"]  # type: ignore[index]
        if not context.is_dir():
            raise SystemExit(f"package source context is missing: {context.relative_to(ROOT)}")
        for path in sorted(context.rglob("*"), key=lambda item: item.relative_to(ROOT).as_posix()):
            if _safe_file(path):
                files[path.relative_to(ROOT).as_posix()] = path.read_bytes()
        for name in (build["dockerfile"], *(patch["path"] for patch in build["patches"])):  # type: ignore[index]
            source = ROOT / name
            if not _safe_file(source):
                raise SystemExit(f"package source file is missing: {name}")
            files[name] = source.read_bytes()
    for check in recipe["validation"]["serving"]["checks"]:  # type: ignore[index]
        request = check["request"]  # type: ignore[index]
        if request.get("transport") != "job":
            continue
        required = [request["fixture"], *request.get("input_slots", {}).values()]
        for name in required:
            source = ROOT / name
            if not _safe_file(source):
                raise SystemExit(f"package serving fixture is missing: {name}")
            files[name] = source.read_bytes()
    return sorted(files.items())


def _archive(files: list[tuple[str, bytes]]) -> bytes:
    stream = io.BytesIO()
    with gzip.GzipFile(fileobj=stream, mode="wb", mtime=0) as compressed:
        with tarfile.open(fileobj=compressed, mode="w", format=tarfile.PAX_FORMAT) as archive:
            for name, payload in files:
                member = tarfile.TarInfo(name)
                member.size = len(payload)
                member.mode = 0o644
                member.uid = member.gid = 0
                member.uname = member.gname = ""
                member.mtime = 0
                archive.addfile(member, io.BytesIO(payload))
    return stream.getvalue()


def _dockerfile_build_inputs(content: bytes, *, label: str) -> list[dict[str, str]]:
    try:
        text = content.decode("utf-8")
    except UnicodeDecodeError as error:
        raise SystemExit(f"Dockerfile is not UTF-8: {label}") from error
    inputs: list[dict[str, str]] = []
    aliases: set[str] = set()
    seen: set[tuple[str, str]] = set()
    for raw_line in text.splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        if not line.upper().startswith("FROM"):
            continue
        match = FROM_LINE.fullmatch(line)
        if match is None:
            raise SystemExit(f"Dockerfile FROM syntax is invalid: {label}: {line}")
        platform, reference, alias = match.groups()
        platform = platform or "linux/arm64"
        if platform not in {"linux/arm64", "linux/arm64/v8"}:
            raise SystemExit(f"Dockerfile FROM platform is not ARM64: {label}: {platform}")
        if reference.lower() in {item.lower() for item in aliases}:
            if alias:
                aliases.add(alias)
            continue
        if reference.startswith("$") or "@sha256:" not in reference:
            raise SystemExit(f"Dockerfile FROM image is not digest pinned: {label}: {reference}")
        repository, digest = reference.rsplit("@sha256:", 1)
        if not repository or not SHA256.fullmatch(digest):
            raise SystemExit(f"Dockerfile FROM image digest is invalid: {label}: {reference}")
        key = (reference, platform)
        if key not in seen:
            inputs.append({"kind": "oci-image", "reference": reference, "platform": platform})
            seen.add(key)
        if alias:
            aliases.add(alias)
    if not inputs:
        raise SystemExit(f"Dockerfile has no FROM image: {label}")
    return inputs


def validate_recipe_archive(payload: bytes, recipe: dict[str, object], entities: dict[str, dict[str, object]] | None = None) -> None:
    """Validate the physical immutable archive closure, including entrypoints."""
    entities = entities or _catalog_entity_documents()
    from vonk_forge_contracts import ModelDefinition, RecipeDefinition, content_sha256
    from vonk_forge_contracts.resolver import validate_model_references
    expected_recipe = RecipeDefinition.model_validate(recipe)
    validate_model_references([ModelDefinition.model_validate(document) for document in entities.values()])
    expected_recipe_document = expected_recipe.model_dump(mode="json", exclude_unset=False, exclude_none=False)
    with tarfile.open(fileobj=io.BytesIO(payload), mode="r:gz") as archive:
        members = archive.getmembers()
        names = [member.name for member in members]
        if len(names) != len(set(names)):
            raise SystemExit("recipe package contains duplicate paths")
        if any(not member.isreg() for member in members):
            raise SystemExit("recipe package contains a non-regular archive member")
        for name in names:
            path = PurePosixPath(name)
            if path.is_absolute() or any(part in {"", ".", ".."} for part in path.parts):
                raise SystemExit(f"recipe package contains unsafe path: {name}")
            if name.startswith(("image/", "oci/", "weights/", "runtime-distributions/", "patch-bundles/", "execution-harnesses/")) or name.endswith((".safetensors", ".bin", ".pt", ".pth", ".ckpt", ".onnx")):
                raise SystemExit(f"recipe package contains model or OCI payload: {name}")
        recipe_entries = [name for name in names if PurePosixPath(name).name == "recipe.json"]
        if recipe_entries != ["recipe.json"]:
            raise SystemExit("recipe package must contain exactly one recipe.json entrypoint")
        try:
            manifest_member = archive.extractfile("manifest.json")
        except KeyError:
            manifest_member = None
        if manifest_member is None:
            raise SystemExit("recipe package manifest is missing")
        manifest = json.load(manifest_member)
        if manifest.get("kind") != "recipe-package" or manifest.get("package_type") != "recipe":
            raise SystemExit("recipe package manifest kind is invalid")
        manifest_entries = manifest.get("files")
        if not isinstance(manifest_entries, list):
            raise SystemExit("recipe package manifest files are invalid")
        declared: dict[str, dict[str, object]] = {}
        for entry in manifest_entries:
            if not isinstance(entry, dict) or not isinstance(entry.get("path"), str) or entry["path"] in declared:
                raise SystemExit("recipe package manifest contains duplicate or invalid paths")
            if not isinstance(entry.get("size"), int) or isinstance(entry["size"], bool) or entry["size"] < 0:
                raise SystemExit("recipe package manifest file size is invalid")
            if not isinstance(entry.get("sha256"), str) or SHA256.fullmatch(entry["sha256"]) is None:
                raise SystemExit("recipe package manifest file digest is invalid")
            declared[entry["path"]] = entry
        actual_payload_names = set(names) - {"manifest.json"}
        if set(declared) != actual_payload_names:
            raise SystemExit("recipe package manifest does not exactly describe archive payloads")
        for name, entry in declared.items():
            member = archive.extractfile(name)
            content = member.read() if member is not None else None
            if content is None or len(content) != entry["size"] or hashlib.sha256(content).hexdigest() != entry["sha256"]:
                raise SystemExit(f"recipe package manifest digest is stale: {name}")
        recipe_member = archive.extractfile("recipe.json")
        if recipe_member is None:
            raise SystemExit("recipe package recipe entrypoint is missing")
        try:
            actual_recipe = RecipeDefinition.model_validate(json.load(recipe_member))
        except Exception as error:
            raise SystemExit(f"recipe package recipe.json is invalid: {error}") from error
        recipe_digest = content_sha256(actual_recipe)
        if actual_recipe.model_dump(mode="json", exclude_unset=False, exclude_none=False) != expected_recipe_document:
            raise SystemExit("recipe package recipe does not match the requested Recipe")
        if manifest.get("recipe_content_sha256") != recipe_digest:
            raise SystemExit("recipe package recipe digest is stale")
        pending_models = [selection.model for selection in expected_recipe.models]
        seen_model_keys: set[tuple[str, str]] = set()
        while pending_models:
            reference = pending_models.pop(0)
            model_key = (reference.publisher, reference.slug)
            if model_key in seen_model_keys:
                continue
            seen_model_keys.add(model_key)
            model_path = f"models/{reference.slug}.json"
            if model_path not in names:
                raise SystemExit(f"recipe package exact Model snapshot is missing: {model_path}")
            model_member = archive.extractfile(model_path)
            try:
                model = ModelDefinition.model_validate(json.load(model_member)) if model_member else None
            except Exception as error:
                raise SystemExit(f"recipe package Model snapshot is invalid: {model_path}") from error
            if model is None or content_sha256(model) != reference.content_sha256:
                raise SystemExit(f"recipe package Model snapshot digest is stale: {model_path}")
            pending_models.extend(model.dependencies)
            if model.supersedes is not None:
                pending_models.append(model.supersedes)
        paths = set(names)
        execution = expected_recipe_document["execution"]
        if execution["mode"] == "build":  # type: ignore[index]
            build = execution["build"]  # type: ignore[index]
            context = build["context"]["path"]  # type: ignore[index]
            if not any(name.startswith(context + "/") for name in paths):
                raise SystemExit(f"recipe package build context is missing: {context}")
            required = [build["dockerfile"], *(patch["path"] for patch in build["patches"])]  # type: ignore[index]
            missing = sorted(name for name in required if name not in paths)
            if missing:
                raise SystemExit(f"recipe package source closure is missing: {', '.join(missing)}")
            dockerfile_member = archive.extractfile(build["dockerfile"])  # type: ignore[index]
            if dockerfile_member is None:
                raise SystemExit("recipe package Dockerfile is missing")
            inputs = _dockerfile_build_inputs(dockerfile_member.read(), label=build["dockerfile"])  # type: ignore[index]
            manifest_inputs = manifest.get("build_inputs")
            if manifest_inputs != inputs:
                raise SystemExit("recipe package build inputs are stale")
            base = build["base_image"]  # type: ignore[index]
            base_digest = base["digest"]  # type: ignore[index]
            base_repository = base["repository"]  # type: ignore[index]
            base_platform = base["platform"]  # type: ignore[index]
            def matches_base(item: dict[str, str]) -> bool:
                repository, digest = item["reference"].rsplit("@sha256:", 1)
                parent, leaf = repository.rsplit("/", 1) if "/" in repository else ("", repository)
                base_parent, base_leaf = base_repository.rsplit("/", 1) if "/" in base_repository else ("", base_repository)
                repository = f"{parent}/{leaf.split(':', 1)[0]}" if parent else leaf.split(":", 1)[0]
                expected_repository = f"{base_parent}/{base_leaf.split(':', 1)[0]}" if base_parent else base_leaf.split(":", 1)[0]
                return repository == expected_repository and digest == base_digest and item["platform"] == base_platform
            if not any(matches_base(item) for item in inputs):
                raise SystemExit("recipe package base image is absent from Dockerfile build inputs")
        for check in expected_recipe_document["validation"]["serving"]["checks"]:  # type: ignore[index]
            request = check["request"]  # type: ignore[index]
            if request.get("transport") == "job":
                required = [request["fixture"], *request.get("input_slots", {}).values()]
                missing = sorted(name for name in required if name not in paths)
                if missing:
                    raise SystemExit(f"recipe package serving closure is missing: {', '.join(missing)}")


def recipe_package(document: dict[str, object], release: dict[str, object] | None = None, *, recipe_path: Path | None = None, entity_documents: dict[str, dict[str, object]] | None = None, qualification_definitions: dict[str, object] | None = None) -> tuple[bytes, dict[str, object]]:
    del release, qualification_definitions
    from vonk_forge_contracts import RecipeDefinition, content_sha256
    validated = RecipeDefinition.model_validate(document)
    document = validated.model_dump(mode="json", exclude_unset=False, exclude_none=False)
    recipe_digest = content_sha256(validated)
    recipe_path = recipe_path or ROOT / "recipes" / f"{document['identity']['slug']}.json"  # type: ignore[index]
    entities = entity_documents or _catalog_entity_documents()
    files = _recipe_closure(document, recipe_path, entities)
    manifest_files = [{"path": name, "size": len(payload), "sha256": hashlib.sha256(payload).hexdigest()} for name, payload in files]
    manifest = {"schema_version": PACKAGE_SCHEMA_VERSION, "kind": "recipe-package", "package_type": "recipe", "recipe_content_sha256": recipe_digest, "files": manifest_files}
    execution = document["execution"]
    if execution["mode"] == "build":  # type: ignore[index]
        dockerfile_path = execution["build"]["dockerfile"]  # type: ignore[index]
        dockerfile_payload = dict(files)[dockerfile_path]
        manifest["build_inputs"] = _dockerfile_build_inputs(dockerfile_payload, label=dockerfile_path)
    archive_files = [("manifest.json", canonical(manifest)), *files]
    payload = _archive(archive_files)
    validate_recipe_archive(payload, document, entities)
    metadata = {"media_type": PACKAGE_MEDIA_TYPE, "sha256": hashlib.sha256(payload).hexdigest(), "expected_bytes": len(payload), "path": f"packages/{document['identity']['slug']}.tar.gz", "recipe_content_sha256": recipe_digest, "minimum_consumer_schema": 2}  # type: ignore[index]
    return payload, metadata


def build(*, package_dir: Path | None = None, platform_root: Path | None = None, source_commit: str | None = None) -> dict[str, object]:
    package_dir = package_dir or ROOT / "packages"
    package_dir.mkdir(parents=True, exist_ok=True)
    entities = _catalog_entity_documents()
    recipes: list[dict[str, object]] = []
    for path in sorted((ROOT / "recipes").glob("*.json")):
        document = json.loads(path.read_text(encoding="utf-8"))
        from vonk_forge_contracts import RecipeDefinition, content_sha256
        try:
            validated = RecipeDefinition.model_validate(document)
        except Exception as error:
            raise SystemExit(f"recipe contract validation failed ({path.relative_to(ROOT)}): {error}") from error
        document = validated.model_dump(mode="json", exclude_unset=False, exclude_none=False)
        payload, metadata = recipe_package(document, recipe_path=path, entity_documents=entities)
        filename = Path(str(metadata["path"])).name
        (package_dir / filename).write_bytes(payload)
        release_path = ROOT / "recipe-releases" / f"{document['identity']['slug']}.json"
        recipe_digest = content_sha256(validated)
        if not release_path.is_file():
            raise SystemExit(f"recipe release is missing: {release_path.relative_to(ROOT)}")
        release = recipe_release(release_path, publisher=document["identity"]["publisher"], slug=document["identity"]["slug"], recipe_digest=recipe_digest)
        recipes.append({"source_path": path.relative_to(ROOT).as_posix(), "content_sha256": recipe_digest, "document": document, "package": metadata, "release": release})
    from vonk_forge_contracts import ModelDefinition, content_sha256
    catalog_entities = []
    for document in sorted(entities.values(), key=lambda item: str(item["identity"]["slug"])):
        model = ModelDefinition.model_validate(document)
        catalog_entities.append({"source_path": f"models/{document['identity']['slug']}.json", "content_sha256": content_sha256(model), "document": model.model_dump(mode="json", exclude_unset=False, exclude_none=False)})
    expected_names = {Path(str(row["package"]["path"])).name for row in recipes}
    if package_dir.resolve() == (ROOT / "packages").resolve():
        for stale in package_dir.glob("*.tar.gz"):
            if stale.name not in expected_names:
                stale.unlink()
    platform_commit = ""
    if platform_root is not None:
        platform_commit = _git_revision(Path(platform_root))
    source_value = source_commit or _git_revision(ROOT)
    if not re.fullmatch(r"[0-9a-f]{40}", source_value):
        raise SystemExit("source commit must be a full SHA-1")
    return {"schema_version": 2, "kind": "recipe-library-index", "repository": REPOSITORY, "source_commit": source_value, "platform_commit": platform_commit, "package_contract": {"schema_version": PACKAGE_SCHEMA_VERSION, "media_type": PACKAGE_MEDIA_TYPE, "path_prefix": "packages/", "metadata_fields": ["path", "media_type", "sha256", "expected_bytes", "recipe_content_sha256", "minimum_consumer_schema"]}, "catalog_entities": catalog_entities, "recipes": recipes}


def qualification_index(catalog: dict[str, object]) -> dict[str, object]:
    """Bind only structurally converted recipes into qualification transport data."""
    definitions = json.loads(QUALIFICATION_DEFINITIONS.read_text(encoding="utf-8"))
    available = {
        f"{entry['document']['identity']['publisher']}/{entry['document']['identity']['slug']}": entry["content_sha256"]
        for entry in catalog.get("recipes", [])
    }
    generated = json.loads(json.dumps(definitions))
    for field in ("recipes", "service_recipes", "special_fixtures"):
        generated[field] = {
            key: {**value, "content_sha256": available[key]}
            for key, value in definitions.get(field, {}).items()
            if key in available
        }
    return generated


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--check",
        action="store_true",
        help="fail when catalog-index.json is missing or stale",
    )
    parser.add_argument("--source-commit", help="immutable recipe source commit recorded in the generated index")
    arguments = parser.parse_args()
    if arguments.check:
        with tempfile.TemporaryDirectory(prefix="vonk-forge-catalog-check-") as directory:
            package_dir = Path(directory)
            document = build(package_dir=package_dir, source_commit=_recorded_source_commit())
            expected_names = {Path(str(row["package"]["path"])).name for row in document["recipes"]}
            actual_dir = ROOT / "packages"
            actual_names = {path.name for path in actual_dir.glob("*.tar.gz")} if actual_dir.is_dir() else set()
            if actual_names != expected_names:
                print("recipe package set is stale; run tools/build-catalog-index")
                return 1
            for row in document["recipes"]:
                name = Path(str(row["package"]["path"])).name
                if (actual_dir / name).read_bytes() != (package_dir / name).read_bytes():
                    print(f"recipe package is stale: packages/{name}")
                    return 1
    else:
        document = build(source_commit=arguments.source_commit or _git_revision(ROOT))
    qualification = qualification_index(document)
    expected = rendered(document)
    expected_qualification = rendered(qualification)
    if len(expected.encode("utf-8")) > MAX_INDEX_BYTES:
        print("catalog-index.json exceeds the Git blob safety limit")
        return 1
    recipe_count = len(document["recipes"])
    if arguments.check:
        if not OUTPUT.is_file() or OUTPUT.read_text(encoding="utf-8") != expected:
            print("catalog-index.json is stale; run tools/build-catalog-index")
            return 1
        if (
            not QUALIFICATION_OUTPUT.is_file()
            or QUALIFICATION_OUTPUT.read_text(encoding="utf-8")
            != expected_qualification
        ):
            print(
                "qualification/qualification-index.json is stale; "
                "run tools/build-catalog-index"
            )
            return 1
        print(f"catalog and qualification indexes are current ({recipe_count} recipes)")
        return 0
    OUTPUT.write_text(expected, encoding="utf-8")
    QUALIFICATION_OUTPUT.write_text(expected_qualification, encoding="utf-8")
    print(
        f"wrote {OUTPUT.relative_to(ROOT)} and "
        f"{QUALIFICATION_OUTPUT.relative_to(ROOT)} ({recipe_count} recipes)"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
