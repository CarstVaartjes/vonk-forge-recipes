#!/usr/bin/env python3
"""Reject new eager or device-pinned model construction in adapter Python.

On GB10, CPU and CUDA share one physical memory pool. Building a full model as
real tensors on CPU (DiffSynth ``init_weights_on_device(device=torch.device("cpu"))``,
diffusers/transformers ``low_cpu_mem_usage=False``) adds a whole FP32 copy of the
model beside its state dict, and pinning ``device="cuda"`` inside a model
constructor makes construction the process's first CUDA use. Wan-Dancer native
ran out of memory exactly there on 2026-10-25. Build on meta and let the loader
place the loaded model.

Only lines added against ``--base`` are checked, in adapter-authored Python and
in the replacement text that adapter patch scripts insert into upstream source.
Vendored archives and the text a patch removes are not checked.
"""

from __future__ import annotations

import argparse
import ast
import os
import re
import subprocess
import sys
from collections.abc import Iterator
from dataclasses import dataclass
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
ADAPTERS = "adapters"
REPLACEMENT_CALLS = {"replace_once": 1, "replace_all": 1}
HUNK = re.compile(r"^@@ -\d+(?:,\d+)? \+(\d+)(?:,(\d+))? @@")
PATTERNS = {
    "CPU model construction": re.compile(
        r"init_weights_on_device\(\s*device\s*=\s*torch\.device\(\s*[\"']cpu[\"']"
    ),
    "eager full-model construction": re.compile(r"low_cpu_mem_usage\s*=\s*False"),
}
CUDA_PLACEMENT = "CUDA placement in a model constructor"
CUDA_KEYWORD = re.compile(r"\bdevice\s*=\s*[\"']cuda(?::\d+)?[\"']")
MODEL_BASE = re.compile(r"Module|Model")
CUDA_DEVICE = re.compile(r"cuda(?::\d+)?")
ADVICE = (
    "build on meta and assign the checkpoint (fail on any parameter left on meta), "
    "then let the loader move the loaded model to its device; see "
    "docs/recipe-authoring.md (Memory)."
)


class DiffError(RuntimeError):
    """The base revision could not be compared."""


@dataclass(frozen=True)
class Finding:
    path: str
    line: int
    kind: str

    def message(self) -> str:
        return f"{self.path}:{self.line}: new {self.kind}; {ADVICE}"


def added_lines(root: Path, base: str) -> dict[str, set[int]]:
    """Adapter Python path -> line numbers added against ``base`` (HEAD side)."""
    completed = subprocess.run(
        [
            "git",
            "-C",
            str(root),
            "diff",
            "--unified=0",
            "--no-color",
            "--diff-filter=AMR",
            f"{base}...HEAD",
            "--",
            ADAPTERS,
        ],
        capture_output=True,
        text=True,
        check=False,
    )
    if completed.returncode != 0:
        raise DiffError(completed.stderr.strip())
    result: dict[str, set[int]] = {}
    path: str | None = None
    for line in completed.stdout.splitlines():
        if line.startswith("+++ "):
            name = line[4:].removeprefix("b/")
            path = name if _is_adapter_python(root, name) else None
        elif path is not None and (match := HUNK.match(line)):
            start, count = int(match[1]), int(match[2] or "1")
            result.setdefault(path, set()).update(range(start, start + count))
    return result


def _is_adapter_python(root: Path, name: str) -> bool:
    if "/vendor/" in name or not name.startswith(f"{ADAPTERS}/"):
        return False
    if name.endswith(".py"):
        return True
    try:
        with (root / name).open("rb") as handle:
            first = handle.readline()
    except OSError:
        return False
    return first.startswith(b"#!") and b"python" in first


def _string(node: ast.expr) -> str | None:
    if isinstance(node, ast.Constant) and isinstance(node.value, str):
        return node.value
    if isinstance(node, ast.BinOp) and isinstance(node.op, ast.Add):
        left, right = _string(node.left), _string(node.right)
        if left is not None and right is not None:
            return left + right
    return None


def _replacement(call: ast.Call) -> tuple[ast.expr, ast.expr] | None:
    """(removed text, inserted text) of a patch-script replacement call."""
    func = call.func
    if isinstance(func, ast.Name) and func.id in REPLACEMENT_CALLS:
        index = REPLACEMENT_CALLS[func.id]
        if len(call.args) > index + 1:
            return call.args[index], call.args[index + 1]
    if isinstance(func, ast.Attribute) and func.attr == "replace":
        if len(call.args) >= 2:
            return call.args[0], call.args[1]
    return None


def _spans(node: ast.AST) -> range:
    end = getattr(node, "end_lineno", None) or getattr(node, "lineno", 0)
    return range(getattr(node, "lineno", 0), end + 1)


def findings(path: str, source: str, added: set[int]) -> Iterator[Finding]:
    lines = source.splitlines()
    try:
        tree = ast.parse(source, filename=path)
    except SyntaxError:
        # Not parseable here: still check every added line's own text.
        tree = ast.Module(body=[], type_ignores=[])
    removed: set[int] = set()
    inserted: set[int] = set()
    for node in ast.walk(tree):
        if not isinstance(node, ast.Call) or (pair := _replacement(node)) is None:
            continue
        old, new = pair
        removed.update(_spans(old))
        old_text, new_text = _string(old), _string(new)
        if old_text is None or new_text is None or not added & set(_spans(new)):
            continue
        inserted.update(_spans(new))
        for kind, pattern in {**PATTERNS, CUDA_PLACEMENT: CUDA_KEYWORD}.items():
            if len(pattern.findall(new_text)) > len(pattern.findall(old_text)):
                yield Finding(path, new.lineno, kind)
    checked = added - removed - inserted
    for number in sorted(checked):
        if number <= len(lines):
            for kind, pattern in PATTERNS.items():
                if pattern.search(lines[number - 1]):
                    yield Finding(path, number, kind)
    for number in sorted(_model_constructor_cuda_keywords(tree) & checked):
        yield Finding(path, number, CUDA_PLACEMENT)


def _model_constructor_cuda_keywords(tree: ast.AST) -> set[int]:
    """Lines of ``device="cuda"`` keywords inside a model class's ``__init__``."""
    result: set[int] = set()
    for owner in ast.walk(tree):
        if not isinstance(owner, ast.ClassDef) or not any(
            MODEL_BASE.search(ast.unparse(base)) for base in owner.bases
        ):
            continue
        for init in owner.body:
            if not isinstance(init, ast.FunctionDef) or init.name != "__init__":
                continue
            for node in ast.walk(init):
                if isinstance(node, ast.keyword) and node.arg == "device":
                    value = node.value
                    if (
                        isinstance(value, ast.Constant)
                        and isinstance(value.value, str)
                        and CUDA_DEVICE.fullmatch(value.value)
                    ):
                        result.add(node.lineno)
    return result


def violations(root: Path, base: str) -> list[Finding]:
    result: list[Finding] = []
    for path, added in sorted(added_lines(root, base).items()):
        source = (root / path).read_text(encoding="utf-8")
        result.extend(findings(path, source, added))
    return result


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", type=Path, default=ROOT)
    parser.add_argument("--base", default="origin/main")
    arguments = parser.parse_args(argv)
    try:
        problems = violations(arguments.root, arguments.base)
    except DiffError as error:
        print(f"Cannot compare with {arguments.base}: {error}", file=sys.stderr)
        return 2
    in_actions = os.environ.get("GITHUB_ACTIONS") == "true"
    for problem in problems:
        text = problem.message()
        print(f"::error::{text}" if in_actions else text, file=sys.stderr)
    if problems:
        return 1
    print(f"No new eager or CUDA-pinned model construction against {arguments.base}.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
