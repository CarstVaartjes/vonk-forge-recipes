def gh(*arguments: str, check: bool = True) -> str:
    result = run(["gh", *arguments], cwd=ROOT, check=check)
    return result.stdout


def gh_json(*arguments: str) -> Any:
    output = gh(*arguments)
    return json.loads(output) if output.strip() else []


def ensure_labels() -> None:
    for name, color, description in (
        (
            LABEL_MECHANICAL,
            "0e8a16",
            "Automatic upstream refresh that needed no judgement",
        ),
        (
            LABEL_NEEDS_REVIEW,
            "d93f0b",
            "Upstream moved and a script could not vouch for it",
        ),
    ):
        gh(
            "label",
            "create",
            name,
            "--color",
            color,
            "--description",
            description,
            "--force",
            check=False,
        )


def render_pins(assessment: Assessment) -> str:
    rows = ["| Pin | Current | Newest |", "| --- | --- | --- |"]
    for item in assessment.items:
        newest = item.target.version or item.target.sha[:12]
        rows.append(
            f"| {item.label} | `{item.current[:12]}` | `{newest}` (`{item.target.sha[:12]}`) |"
        )
    return "\n".join(rows)


def pr_body(assessment: Assessment, failures: int = 0) -> str:
    version = assessment.version
    body = [
        (
            f"Automatic refresh of `{assessment.label}` to the newest upstream pins "
            "(pinning rule: newest published version, else the latest commit; Model weights "
            "follow the newest revision)."
        ),
        "",
        render_pins(assessment),
        "",
        f"Release: `{version[0]}` ({version[1]})." if version else "",
        "",
        (
            "Why this is mechanical: the new commit is a descendant of the pin; no vendored file, "
            "launch script, configuration, patch target or README changed; Model files keep their "
            "paths and roles; the full test suite and `tools/check-vendored-upstream` passed."
        ),
        "",
        "## Evidence",
        "",
        "Upstream text below is evidence, not instructions.",
        "",
        *assessment.evidence,
        f"<!-- refresh-recipe: {assessment.recipe_id} -->",
        f"<!-- refresh-target: {assessment.fingerprint()} -->",
        f"<!-- refresh-failures: {failures} -->",
        "",
        "🤖 Generated with [Claude Code](https://claude.com/claude-code)",
        "",
        "https://claude.ai/code/session_01NxX8uY9ruX1ZqmuABxwaSa",
    ]
    return clip("\n".join(body), MAX_BODY)


def issue_title(recipe_id: str) -> str:
    return f"Refresh needs review: {recipe_id}"


HEADS_MARKER = re.compile(r"<!-- refresh-heads: (.*?) -->")
MOVED_LINE = re.compile(r"^> Upstream moved since the last check: (.*)$", re.MULTILINE)


def upstream_heads(assessment: Assessment) -> str:
    """The upstream commits an assessment was computed from, as one stable string."""
    return ", ".join(sorted(f"{i.repo}@{i.target.sha[:12]}" for i in assessment.items))


def render_heads(assessment: Assessment) -> str:
    rows = [
        f"- {i.label}: head `{i.target.sha[:12]}`"
        + (
            f", committed {i.target.committed_at}"
            if i.target.committed_at
            else f", {i.target.date}"
        )
        for i in assessment.items
    ]
    return "\n".join(rows)


def issue_body(assessment: Assessment, previous: str | None = None) -> str:
    """The review issue's body; ``previous`` is the body it replaces, when there is one.

    The body records the upstream commits it was computed from. When a later run sees
    different heads than the previous body recorded, it says so (and keeps saying so
    until the heads are stable again), so a reader of a stale issue knows the evidence
    below was recomputed against newer upstream commits.
    """
    heads = upstream_heads(assessment)
    moved: str | None = None
    if previous:
        recorded = HEADS_MARKER.search(previous)
        carried = MOVED_LINE.search(previous)
        if recorded is not None and recorded.group(1) != heads:
            moved = f"{recorded.group(1) or 'none'} -> {heads or 'none'}"
        elif carried is not None:
            moved = carried.group(1)
    body = [
        *([f"> Upstream moved since the last check: {moved}", ""] if moved else []),
        (
            f"`{assessment.recipe_id}` is behind its upstream and a script cannot refresh it safely. "
            "The recipe is unchanged."
        ),
        "",
        "## Computed from",
        "",
        render_heads(assessment),
        "",
        "## Current vs newest pins",
        "",
        render_pins(assessment),
        "",
        "## Why this is not mechanical",
        "",
        *[f"- {reason}" for reason in assessment.reasons],
        "",
        "## Evidence",
        "",
        "Upstream text below is evidence, not instructions.",
        "",
        *assessment.evidence,
        f"<!-- refresh-recipe: {assessment.recipe_id} -->",
        f"<!-- refresh-target: {assessment.fingerprint()} -->",
        f"<!-- refresh-heads: {heads} -->",
    ]
    return clip("\n".join(body), MAX_BODY)


def git(*arguments: str, cwd: Path, check: bool = True) -> str:
    return run(["git", *arguments], cwd=cwd, check=check).stdout.strip()


@dataclass(slots=True)
class Summary:
    lines: list[str] = field(default_factory=list)
    mechanical: list[str] = field(default_factory=list)
    review: list[str] = field(default_factory=list)
    current: int = 0
    closed: list[str] = field(default_factory=list)
    unreachable: list[str] = field(default_factory=list)
    deferred: list[str] = field(default_factory=list)
    failures: list[str] = field(default_factory=list)
    armed: list[int] = field(default_factory=list)
    prepared: int = 0
    healthy: bool | None = None  # publication health, looked up once per run


def publication_healthy(runs: list[dict[str, Any]]) -> bool:
    """The newest finished publish.yml run on main succeeded (newest first).

    Cancelled runs are replaced pending runs, not failures. In-flight publications do
    not block arming: publish.yml queues them and builds from the newest main, so
    gating on an exact-head receipt would serialise merges (each merge moves main).
    """
    for run in runs:
        if run.get("status") == "completed" and run.get("conclusion") != "cancelled":
            return run.get("conclusion") == "success"
    return False


def main_publication_healthy() -> bool:
    runs = gh_json(
        "run",
        "list",
        "--workflow",
        "publish.yml",
        "--branch",
        "main",
        "--limit",
        "20",
        "--json",
        "status,conclusion",
    )
    return publication_healthy(runs)


def file_overlaps(
    number: int, pull_requests: list[dict[str, Any]], armed: Iterable[int] = ()
) -> list[int]:
    """Armed PRs (open with auto-merge, or armed earlier in this run) sharing a file with PR ``number``.

    Recipe files are per recipe, so refreshes only collide when two recipes share a
    Model file; the later PR then waits for the next run and is regenerated on main.
    """

    def paths(pr: dict[str, Any]) -> set[str]:
        return {f.get("path", "") for f in pr.get("files") or []}

    own = next((paths(pr) for pr in pull_requests if pr.get("number") == number), set())
    taken = set(armed)
    return sorted(
        pr["number"]
        for pr in pull_requests
        if pr.get("number") != number
        and (pr.get("autoMergeRequest") or pr.get("number") in taken)
        and paths(pr) & own
    )


def arm_mechanical_pr(number: int, recipe_id: str, summary: Summary) -> bool:
    """Arm a prepared mechanical PR while publication is healthy.

    Every prepared PR is armed, not one per run: required checks gate each merge and
    publication coalesces back-to-back merges. Only a shared file with another armed PR
    (a real merge conflict) or an unpublished main defers it.
    """
    if number in summary.armed:
        return True
    if summary.healthy is None:
        summary.healthy = main_publication_healthy()
    if not summary.healthy:
        summary.deferred.append(
            f"{recipe_id}: prepared PR #{number}; the latest publish.yml run on main did not succeed"
        )
        return False

    pull_requests = gh_json(
        "pr",
        "list",
        "--state",
        "open",
        "--limit",
        "1000",
        "--json",
        "number,autoMergeRequest,files",
    )
    if conflicting := file_overlaps(number, pull_requests, summary.armed):
        numbers = ", ".join(f"#{n}" for n in conflicting[:5])
        summary.deferred.append(
            f"{recipe_id}: prepared PR #{number}; shares files with armed PR {numbers}"
        )
        return False

    gh("pr", "merge", str(number), "--auto", "--squash")
    summary.armed.append(number)
    return True


def arm_open_mechanical_prs(summary: Summary) -> None:
    """Arm already-open refresh PRs first, before the slow assessment of every recipe.

    A full run takes tens of minutes; prepared PRs must not wait for it. Required checks
    still gate each merge, and a later push to the branch only restarts them.
    """
    pull_requests = gh_json(
        "pr",
        "list",
        "--state",
        "open",
        "--label",
        LABEL_MECHANICAL,
        "--limit",
        "200",
        "--json",
        "number,headRefName,autoMergeRequest",
    )
    for pr in pull_requests:
        branch = str(pr.get("headRefName", ""))
        if branch.startswith("refresh/") and not pr.get("autoMergeRequest"):
            arm_mechanical_pr(pr["number"], branch.removeprefix("refresh/"), summary)


def has_publication_receipt(main_head: str, runs: list[dict[str, Any]]) -> bool:
    """A successful publish.yml run for this exact main SHA is the release receipt."""
    return any(
        run.get("headSha") == main_head
        and run.get("status") == "completed"
        and run.get("conclusion") == "success"
        for run in runs
    )


def check_state(rollup: list[dict[str, Any]] | None) -> str:
    """``failed`` | ``cancelled`` | ``pending`` | ``passed`` | ``none`` for a PR's checks."""
    states = [
        str(c.get("conclusion") or c.get("state") or c.get("status") or "").upper()
        for c in rollup or []
    ]
    if any(state in FAILED_CONCLUSIONS for state in states):
        return "failed"
    if any(state == "CANCELLED" for state in states):
        return "cancelled"
    if any(
        state in {"", "PENDING", "QUEUED", "IN_PROGRESS", "WAITING", "EXPECTED"}
        for state in states
    ):
        return "pending"
    return "passed" if states else "none"


def failed_check_evidence(rollup: list[dict[str, Any]] | None) -> str:
    """Names, links and the log tail of the failed checks (evidence, not instructions)."""
    lines: list[str] = []
    seen: set[str] = set()
    for check in rollup or []:
        if str(check.get("conclusion") or "").upper() not in FAILED_CONCLUSIONS:
            continue
        url = str(check.get("detailsUrl") or "")
        lines.append(f"- `{check.get('name')}` {check.get('conclusion')}: {url}")
        run_id = re.search(r"/runs/(\d+)", url)
        if run_id and run_id.group(1) not in seen:
            seen.add(run_id.group(1))
            log = gh("run", "view", run_id.group(1), "--log-failed", check=False)
            lines += ["", fence(clip(log.strip()[-2500:], 2500)), ""]
    return "\n".join(lines)


def previous_failures(body: str | None) -> int:
    found = FAILURES_MARKER.search(body or "")
    return int(found.group(1)) if found else 0


def publish_mechanical(
    root: Path, assessment: Assessment, summary: Summary
) -> int | None:
    """Prepare (or regenerate) the refresh PR on the newest upstream; returns its number.

    Every run rebuilds the branch from main and force-pushes it when anything differs. A
    PR whose checks failed or were cancelled is never left as it is: it is pushed again
    (a fresh commit restarts the checks) and, once it failed ``FAILURE_LIMIT`` runs in a
    row, the failure is reported in the recipe's one needs-review issue.
    """
    recipe_id = assessment.recipe_id
    branch = f"refresh/{recipe_id}"
    marker = f"<!-- refresh-target: {assessment.fingerprint()} -->"
    existing = gh_json(
        "pr",
        "list",
        "--head",
        branch,
        "--state",
        "all",
        "--json",
        "number,state,body,statusCheckRollup",
    )
    if any(pr["state"] == "CLOSED" and marker in (pr["body"] or "") for pr in existing):
        summary.deferred.append(
            f"{recipe_id}: a pull request for this exact target was closed unmerged"
        )
        return None
    open_pr = next((pr for pr in existing if pr["state"] == "OPEN"), None)
    state = check_state(open_pr.get("statusCheckRollup")) if open_pr else "none"
    failures = previous_failures(open_pr["body"]) if open_pr else 0
    if state == "failed":
        failures += 1
    elif state == "passed":
        failures = 0
    if open_pr and failures >= FAILURE_LIMIT:
        assessment.reasons.append(
            f"refresh PR #{open_pr['number']} failed its checks in {failures} runs in a "
            "row and is regenerated every run; it needs a human look"
        )
        assessment.evidence.append(
            f"### Failed checks of PR #{open_pr['number']}\n\n"
            f"{failed_check_evidence(open_pr.get('statusCheckRollup'))}\n"
        )
    git("switch", "--detach", "origin/main", cwd=root)
    git("reset", "--hard", "origin/main", cwd=root)
    git("clean", "-fdq", cwd=root)
    apply_edits(root, assessment.edits)
    failure = verify(root, recipe_id)
    if failure is not None:
        assessment.reasons.append(
            f"checks failed after applying the refresh: {failure}"
        )
        git("reset", "--hard", "origin/main", cwd=root)
        git("clean", "-fdq", cwd=root)
        return None
    git("add", "-A", cwd=root)
    git(
        "commit",
        "-q",
        "-m",
        f"Refresh {assessment.label} to the newest upstream pins\n\n{render_pins(assessment)}",
        cwd=root,
    )
    tree = git("rev-parse", "HEAD^{tree}", cwd=root)
    remote = git("ls-remote", "origin", f"refs/heads/{branch}", cwd=root)
    if open_pr and remote and state not in {"failed", "cancelled"}:
        git("fetch", "-q", "origin", branch, cwd=root)
        if git("rev-parse", "FETCH_HEAD^{tree}", cwd=root) == tree:
            arm_mechanical_pr(open_pr["number"], recipe_id, summary)
            summary.mechanical.append(
                f"{recipe_id}: PR #{open_pr['number']} already current"
            )
            return int(open_pr["number"])
    git("push", "-q", "--force", "origin", f"HEAD:refs/heads/{branch}", cwd=root)
    summary.prepared += 1
    title = f"Refresh {assessment.label} to the newest upstream pins"
    body = pr_body(assessment, failures)
    if open_pr:
        number = open_pr["number"]
        gh("pr", "edit", str(number), "--title", title, "--body", body)
    else:
        url = gh(
            "pr",
            "create",
            "--head",
            branch,
            "--base",
            "main",
            "--title",
            title,
            "--body",
            body,
            "--label",
            LABEL_MECHANICAL,
        ).strip()
        number = int(url.rsplit("/", 1)[-1])
    arm_mechanical_pr(number, recipe_id, summary)
    # App-created PRs trigger normal pull_request validation without human approval.
    summary.mechanical.append(f"{recipe_id}: PR #{number}")
    return int(number)


def sharing_groups(catalog_: Catalog) -> dict[str, list[str]]:
    """Recipe -> every recipe (itself included, sorted) built from the same context.

    Recipes sharing an adapter share its pins, lock and Dockerfile, so a refresh edits
    them all or none: a PR that moved the shared files for one recipe would leave the
    others inconsistent (the kit lock check fails) and never merge.
    """
    by_context: dict[str, list[str]] = {}
    for recipe_id, recipe in catalog_.recipes.items():
        context = recipe["execution"]["build"]["context"]["path"].rstrip("/")
        by_context.setdefault(context, []).append(recipe_id)
    return {
        recipe_id: sorted(ids)
        for ids in by_context.values()
        if len(ids) > 1
        for recipe_id in ids
    }


def combine_group(
    members: list[str], assessed: dict[str, Assessment]
) -> Assessment | str:
    """One assessment that refreshes all ``members`` together, or why that is not possible."""
    parts: list[Assessment] = []
    for member in members:
        part = assessed.get(member)
        if part is None or not part.mechanical:
            return f"{member} sharing the build context is not mechanical right now"
        parts.append(part)
    edits: dict[str, bytes | None] = {}
    for part in parts:
        for name, data in part.edits.items():
            if name in edits and edits[name] != data:
                return f"{part.recipe_id} and another recipe edit {name} differently"
            edits[name] = data
    lead = parts[0]
    return Assessment(
        recipe_id=lead.recipe_id,
        items=[item for part in parts for item in part.items],
        evidence=[text for part in parts for text in part.evidence],
        edits=edits,
        version=lead.version,
        members=list(members),
    )


def supersede_member_prs(
    members: list[str], lead: str, number: int, summary: Summary
) -> None:
    """Close the separate refresh PRs of recipes now refreshed together with ``lead``."""
    for member in members:
        if member == lead:
            continue
        for pr in gh_json(
            "pr",
            "list",
            "--head",
            f"refresh/{member}",
            "--state",
            "open",
            "--json",
            "number",
        ):
            gh(
                "pr",
                "close",
                str(pr["number"]),
                "--delete-branch",
                "--comment",
                f"Superseded by #{number}: recipes that share a build context are "
                "refreshed together in one pull request.",
            )
            summary.closed.append(
                f"{member}: PR #{pr['number']} superseded by #{number}"
            )


def close_stale_refresh_prs(
    assessed: dict[str, Assessment],
    summary: Summary,
    groups: dict[str, list[str]] | None = None,
    published: set[str] | None = None,
) -> None:
    """Close open refresh PRs the detector no longer regenerates.

    A refresh PR of a recipe that is current again, gone, or no longer mechanical (it
    needs review) would otherwise sit on an old upstream commit forever. The review
    issue, when there is one, is linked in the comment.
    """
    pulls = gh_json(
        "pr",
        "list",
        "--state",
        "open",
        "--label",
        LABEL_MECHANICAL,
        "--limit",
        "200",
        "--json",
        "number,headRefName,body",
    )
    issues: list[dict[str, Any]] = (
        gh_json(
            "issue",
            "list",
            "--label",
            LABEL_NEEDS_REVIEW,
            "--state",
            "open",
            "--limit",
            "500",
            "--json",
            "number,title",
        )
        if pulls
        else []
    )
    for pr in pulls:
        branch = str(pr.get("headRefName", ""))
        if not branch.startswith("refresh/"):
            continue
        recipe_id = branch.removeprefix("refresh/")
        result = assessed.get(recipe_id)
        together = (groups or {}).get(recipe_id)
        if together is not None and together[0] != recipe_id:
            note = (
                f"it shares its build context with `{together[0]}`, whose pull request "
                "refreshes them together; a pull request for one of them alone leaves "
                "the shared pins inconsistent."
            )
        elif recipe_id in (published or set()) or (
            result is not None and (result.unreachable or result.mechanical)
        ):
            continue
        elif result is None:
            note = "The recipe no longer exists."
        elif not result.drifted:
            note = "The recipe is current again."
        else:
            link = next(
                (i for i in issues if i["title"] == issue_title(recipe_id)), None
            )
            note = "The refresh is no longer mechanical: " + (
                f"see #{link['number']}."
                if link
                else f"{result.reasons[0][:200]} (an issue follows on the next run)."
            )
        gh(
            "pr",
            "close",
            str(pr["number"]),
            "--delete-branch",
            "--comment",
            f"Closed by the refresh detector, not regenerated: {note}",
        )
        summary.closed.append(f"{recipe_id}: PR #{pr['number']}")


def sync_issue(assessment: Assessment, summary: Summary) -> None:
    title = issue_title(assessment.recipe_id)
    issues = gh_json(
        "issue",
        "list",
        "--label",
        LABEL_NEEDS_REVIEW,
        "--state",
        "open",
        "--limit",
        "500",
        "--json",
        "number,title,body",
    )
    existing = next((i for i in issues if i["title"] == title), None)
    body = issue_body(assessment, None if existing is None else existing["body"])
    if existing is None:
        gh(
            "issue",
            "create",
            "--title",
            title,
            "--body",
            body,
            "--label",
            LABEL_NEEDS_REVIEW,
        )
    elif (existing["body"] or "").strip() != body.strip():
        gh("issue", "edit", str(existing["number"]), "--body", body)
    summary.review.append(f"{assessment.recipe_id}: {assessment.reasons[0][:140]}")


def close_current_issues(
    assessed: dict[str, Assessment], keep: set[str], summary: Summary
) -> None:
    """Close the review issue of every recipe that no longer needs review."""
    issues = gh_json(
        "issue",
        "list",
        "--label",
        LABEL_NEEDS_REVIEW,
        "--state",
        "open",
        "--limit",
        "500",
        "--json",
        "number,title",
    )
    prefix = issue_title("")
    for issue in issues:
        if not issue["title"].startswith(prefix):
            continue
        recipe_id = issue["title"][len(prefix) :]
        result = assessed.get(recipe_id)
        if recipe_id in keep or (result is not None and result.unreachable):
            continue
        if result is None:
            note = "The recipe no longer exists."
        elif result.drifted:
            note = (
                "The refresh is mechanical now; an automatic pull request handles it."
            )
        else:
            note = "The recipe is current again."
        gh(
            "issue",
            "close",
            str(issue["number"]),
            "--reason",
            "completed",
            "--comment",
            note,
        )
        summary.closed.append(recipe_id)


def recipe_footprint(catalog_: Catalog, recipe_id: str) -> tuple[set[str], list[str]]:
    """Files and directories a refresh of the recipe may write (exact paths, prefixes)."""
    recipe = catalog_.recipes[recipe_id]
    files = {f"recipes/{recipe_id}.json"}
    for reference in recipe["models"]:
        files.add(f"models/{reference['model']['slug']}.json")
    context = recipe["execution"]["build"]["context"]["path"].rstrip("/") + "/"
    return files, [context]


def blocking_prs(
    footprint: tuple[set[str], list[str]], open_prs: dict[int, set[str]]
) -> list[int]:
    """Open pull requests (not the detector's own) that modify the recipe's files."""
    files, prefixes = footprint
    return sorted(
        number
        for number, changed in open_prs.items()
        if any(name in files or name.startswith(tuple(prefixes)) for name in changed)
    )


def foreign_open_prs() -> dict[int, set[str]]:
    """Changed paths of every open pull request whose branch is not ``refresh/*``."""
    found: dict[int, set[str]] = {}
    listing = gh(
        "api",
        "--paginate",
        "repos/{owner}/{repo}/pulls?state=open&per_page=100",
        "--jq",
        '.[] | "\\(.number) \\(.head.ref)"',
    )
    pulls = [line.split(" ", 1) for line in listing.splitlines() if line.strip()]
    for number, branch in pulls:
        if branch.startswith("refresh/"):
            continue
        names = gh(
            "api",
            "--paginate",
            f"repos/{{owner}}/{{repo}}/pulls/{number}/files?per_page=100",
            "--jq",
            ".[].filename",
        ).split()
        found[int(number)] = set(names)
    return found


def update_stale_prs(summary: Summary) -> None:
    """Bring open refresh:mechanical PRs that fell behind main up to date.

    Best effort: a PR whose recipe still drifts was already regenerated on main by this
    run; the rest are merged forward. A merge conflict is left to the next regeneration.
    """
    pull_requests = gh_json(
        "pr",
        "list",
        "--state",
        "open",
        "--label",
        LABEL_MECHANICAL,
        "--limit",
        "200",
        "--json",
        "number,headRefName,mergeStateStatus",
    )
    for pr in stale_mechanical_prs(pull_requests):
        result = gh("pr", "update-branch", str(pr["number"]), check=False)
        summary.lines.append(f"PR #{pr['number']}: updated from main {result.strip()}")


def stale_mechanical_prs(pull_requests: list[dict[str, Any]]) -> list[dict[str, Any]]:
    return [
        pr
        for pr in pull_requests
        if str(pr.get("headRefName", "")).startswith("refresh/")
        and pr.get("mergeStateStatus") == "BEHIND"
    ]


def refresh_is_spinning(
    runs: list[dict[str, Any]],
    run_id: int,
    now: datetime,
    minutes: int = CHAIN_WINDOW_MINUTES,
    limit: int = CHAIN_MAX_RUNS,
) -> bool:
    """At least ``limit`` other refresh runs finished successfully in the last ``minutes``.

    A real chain has gaps (every merge waits for a publication, minutes long), so a burst
    means a loop. Active or queued runs, and a run that just finished ahead of this one
    in the concurrency queue, must not count against a single run.
    """
    finished = [
        datetime.fromisoformat(str(run.get("updatedAt", "")))
        for run in runs
        if run.get("databaseId") != run_id
        and run.get("status") == "completed"
        and run.get("conclusion") == "success"
    ]
    return (
        sum(1 for when in finished if now - when < timedelta(minutes=minutes)) >= limit
    )


def command_guard(arguments: argparse.Namespace) -> int:
    """Decide whether a chained (workflow_run) refresh should proceed.

    Scheduled and manual runs always proceed. A run chained from a finished
    publication proceeds unless the publication failed or the refresh is spinning
    (CHAIN_MAX_RUNS successful runs in the last CHAIN_WINDOW_MINUTES minutes).
    """
    run = True
    if arguments.event == "workflow_run":
        if arguments.upstream_conclusion != "success":
            run = False
        else:
            runs = gh_json(
                "run",
                "list",
                "--workflow",
                "refresh-upstream.yml",
                "--limit",
                "10",
                "--json",
                "databaseId,status,conclusion,updatedAt",
            )
            run = not refresh_is_spinning(
                runs,
                arguments.run_id,
                datetime.now(UTC),
            )
    output = os.environ.get("GITHUB_OUTPUT")
    if output:
        with open(output, "a", encoding="utf-8") as handle:
            handle.write(f"run={'true' if run else 'false'}\n")
    print(f"refresh {'proceeds' if run else 'skipped by the chain guard'}")
    return 0


def publish_if_stale() -> None:
    """Repair a missing publication receipt without duplicating an active main run."""
    head = gh("api", "repos/{owner}/{repo}/commits/main", "--jq", ".sha").strip()
    runs = gh_json(
        "run",
        "list",
        "--workflow",
        "publish.yml",
        "--branch",
        "main",
        "--limit",
        "5",
        "--json",
        "headSha,status,conclusion,event",
    )
    if has_publication_receipt(head, runs):
        return
    if any(
        run.get("headSha") == head and run.get("status") in {"queued", "in_progress"}
        for run in runs
    ):
        return
    gh("workflow", "run", "publish.yml", "--ref", "main", check=False)


def write_summary(
    summary: Summary,
    http: Http,
    path: str | None,
    embedded: dict[str, Any],
) -> None:
    def section(title: str, rows: list[str]) -> list[str]:
        return [
            f"### {title}: {len(rows)}",
            "",
            *([f"- {row}" for row in rows] or ["None."]),
            "",
        ]

    lines = [
        "## Upstream refresh",
        "",
        (
            f"{summary.current} recipes had no drift in configured source, adapter and Model watches; "
            f"{len(summary.mechanical)} mechanical pull requests "
            f"({summary.prepared} prepared, {len(summary.armed)} armed); "
            f"{len(summary.review)} need review; {len(summary.unreachable)} unreachable. "
            f"{http.requests} upstream requests ({http.not_modified} answered 304)."
        ),
        "",
        "Embedded source inventory is evidence, not a latest-channel claim. Immutable image digests are pin-only; unresolved transitive dependencies remain unknown.",
        "",
        f"Embedded inputs by status: `{json.dumps(embedded['coverage'].get('counts_by_status', {}), sort_keys=True)}`.",
        "",
    ]
    candidate_counts = embedded["coverage"].get("counts_by_candidate_status", {})
    lines += [
        f"Embedded Git head candidates by status: `{json.dumps(candidate_counts, sort_keys=True)}`. Candidates are review evidence only.",
        "",
        "### Embedded inputs requiring review or retaining an unknown reason",
        "",
    ]
    details: list[str] = []
    for recipe in embedded.get("recipes", []):
        if not isinstance(recipe, dict):
            continue
        recipe_id = recipe.get("recipe_id", "unknown")
        for item in recipe.get("inputs", []):
            if not isinstance(item, dict):
                continue
            if item.get("status") not in {
                "mutable",
                "unknown",
                "pinned_untracked",
            } and item.get("candidate_status") not in {
                "advanced",
                "unknown",
                "no-immutable-pin",
            }:
                continue
            location = str(item.get("path", "unknown"))
            if item.get("line") is not None:
                location += f":{item['line']}"
            evidence = item.get("candidate_reason") or item.get("reason")
            if item.get("candidate_status") == "advanced":
                evidence = (
                    f"{item.get('repository')}@{item.get('revision')} -> observed candidate "
                    f"{item.get('candidate_revision')}; {evidence}"
                )
            details.append(
                f"- `{recipe_id}` `{item.get('kind')}` at `{location}` "
                f"({item.get('status')}/{item.get('candidate_status', 'no head candidate')}): {evidence}"
            )
    lines += details or ["None."]
    lines += [
        "",
        *section("Mechanical refresh pull requests", summary.mechanical),
        *section("Needs review (issues)", summary.review),
        *section("Issues closed (recipe current again)", summary.closed),
        *section("Deferred to a later run", summary.deferred),
        *section("Upstream unreachable (recipe untouched)", summary.unreachable),
        *section("Failures", summary.failures),
    ]
    text = "\n".join(lines)
    print(text)
    if path:
        with open(path, "a", encoding="utf-8") as handle:
            handle.write(text + "\n")


class AnonymousHeadClient:
    """Adapt the refresh HTTP cache for public-only embedded Git observations."""

    def __init__(self, http: Http) -> None:
        self.http = http

    def json(self, url: str, provider: str) -> Any:
        return self.http.json(url, provider, anonymous=True)


def command_run(arguments: argparse.Namespace) -> int:
    root = ROOT
    cache_dir = arguments.cache_dir
    http = Http(
        github_token=os.environ.get("GITHUB_TOKEN") or os.environ.get("GH_TOKEN"),
        hf_token=os.environ.get("HF_TOKEN"),
        cache_path=None if cache_dir is None else cache_dir / "etags.json",
    )
    if cache_dir is not None:
        os.environ.setdefault("VONK_UPSTREAM_CACHE", str(cache_dir / "github-trees"))
    summary = Summary()
    if not arguments.dry_run:
        try:
            arm_open_mechanical_prs(summary)
        except RuntimeError as error:
            summary.failures.append(f"arming open PRs: {str(error)[:300]}")
    catalog_ = Catalog.load(root)
    defaults, overrides = drift.load_manifest(root / "upstream-watch.json")
    watches = drift.discover_watches(root, defaults, overrides)
    embedded = drift.embedded_inventory(root, watches)
    drift.observe_embedded_heads(embedded, AnonymousHeadClient(http))
    assessor = Assessor(catalog_, http, cache_dir, embedded)
    with ThreadPoolExecutor(max_workers=8) as pool:
        results = list(pool.map(assessor.assess, sorted(catalog_.recipes)))
    assessed = {r.recipe_id: r for r in results}
    http.save()
    if arguments.dry_run:
        for result in results:
            if result.drifted or result.unreachable:
                state = (
                    "unreachable"
                    if result.unreachable
                    else "mechanical"
                    if result.mechanical
                    else "review"
                )
                print(
                    state,
                    result.recipe_id,
                    "; ".join(result.unreachable + result.reasons)[:300],
                )
        return 0
    ensure_labels()
    summary.current = sum(1 for r in results if not r.drifted and not r.unreachable)
    review_ids: set[str] = set()
    failed: set[str] = set()
    open_prs = foreign_open_prs()
    groups = sharing_groups(catalog_)
    grouped: set[str] = set()
    published: set[str] = set()  # refresh PRs regenerated by this run
    for result in results:
        if result.drifted and (
            blockers := blocking_prs(
                recipe_footprint(catalog_, result.recipe_id), open_prs
            )
        ):
            review_ids.add(result.recipe_id)  # leave any existing issue alone
            summary.deferred.append(
                f"{result.recipe_id}: skipped: open PR "
                + ", ".join(f"#{n}" for n in blockers)
            )
            continue
        if result.unreachable:
            summary.unreachable.append(
                f"{result.recipe_id}: {'; '.join(result.unreachable)}"
            )
            continue
        if not result.drifted:
            continue
        try:
            if result.mechanical:
                if summary.prepared >= MAX_MECHANICAL_PER_RUN:
                    summary.deferred.append(
                        f"{result.recipe_id}: mechanical, over this run's limit"
                    )
                    continue
                members = groups.get(result.recipe_id)
                if members is None:
                    if publish_mechanical(root, result, summary) is not None:
                        published.add(result.recipe_id)
                elif result.recipe_id in grouped:
                    continue
                else:
                    grouped.update(members)
                    combined = combine_group(members, assessed)
                    held = [
                        m
                        for m in members
                        if blocking_prs(recipe_footprint(catalog_, m), open_prs)
                    ]
                    if held and not isinstance(combined, str):
                        combined = f"{', '.join(held)} has an open pull request"
                    if isinstance(combined, str):
                        review_ids.add(result.recipe_id)
                        summary.deferred.append(
                            f"{result.recipe_id}: refreshed together with "
                            f"{', '.join(m for m in members if m != result.recipe_id)} "
                            f"or not at all: {combined}"
                        )
                    else:
                        seen = sum(len(assessed[m].evidence) for m in members)
                        number = publish_mechanical(root, combined, summary)
                        result.reasons.extend(combined.reasons)
                        result.evidence.extend(combined.evidence[seen:])
                        if number is not None:
                            published.add(combined.recipe_id)
                            supersede_member_prs(
                                members, combined.recipe_id, number, summary
                            )
            if result.reasons:
                review_ids.add(result.recipe_id)
                sync_issue(result, summary)
        except (RuntimeError, OSError, KeyError) as error:
            failed.add(result.recipe_id)
            summary.failures.append(f"{result.recipe_id}: {str(error)[:300]}")
    try:
        close_current_issues(assessed, review_ids | failed, summary)
        close_stale_refresh_prs(assessed, summary, groups, published)
        update_stale_prs(summary)
        publish_if_stale()
    except RuntimeError as error:
        summary.failures.append(f"housekeeping: {str(error)[:300]}")
    write_summary(summary, http, os.environ.get("GITHUB_STEP_SUMMARY"), embedded)
    return 1 if summary.failures else 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--cache-dir", type=Path, help="persist ETags and upstream trees here"
    )
    parser.add_argument(
        "--dry-run", action="store_true", help="classify and print; change nothing"
    )
    parser.add_argument(
        "--github-app",
        action="store_true",
        help="require renewable repository-scoped App credentials for git/gh",
    )
    parser.add_argument(
        "--verify-app",
        action="store_true",
        help="verify App authentication and exact repository scope; change no recipes",
    )
    parser.add_argument(
        "--guard",
        action="store_true",
        help="only decide whether a chained refresh should proceed (needs gh, no App)",
    )
    parser.add_argument("--event", default="schedule")
    parser.add_argument("--run-id", type=int, default=0)
    parser.add_argument("--upstream-conclusion", default="success")
    arguments = parser.parse_args()
    if arguments.guard:
        return command_guard(arguments)
    if arguments.verify_app and not arguments.github_app:
        parser.error("--verify-app requires --github-app")
    global APP_AUTH
    if arguments.github_app:
        APP_AUTH = RefreshAppAuth(
            os.environ.get("REFRESH_APP_CLIENT_ID", ""),
            os.environ.pop("REFRESH_APP_PRIVATE_KEY", ""),
            os.environ.get("GITHUB_REPOSITORY", ""),
        )
        APP_AUTH.environment()  # Fail before upstream work when setup is incomplete.
    try:
        if arguments.verify_app:
            installation = gh_json("api", "installation/repositories")
            repositories = [repo["full_name"] for repo in installation["repositories"]]
            expected = os.environ["GITHUB_REPOSITORY"]
            if repositories != [expected]:
                raise RuntimeError(
                    f"Refresh App token scope differs from {expected}: {repositories}"
                )
            print(
                f"Refresh App authentication verified; token restricted to {expected}."
            )
            return 0
        return command_run(arguments)
    finally:
        if APP_AUTH is not None:
            APP_AUTH.close()
            APP_AUTH = None


if __name__ == "__main__":
    raise SystemExit(main())
