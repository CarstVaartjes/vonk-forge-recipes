@dataclass(slots=True)
class Item:
    kind: str  # source | adapter | model
    provider: str
    repo: str
    current: str
    target: Target
    model_slug: str | None = None
    comparison: Comparison | None = None  # pin -> newest, GitHub items only

    @property
    def label(self) -> str:
        return f"{self.kind} {self.provider}:{self.repo}"


@dataclass(slots=True)
class Assessment:
    recipe_id: str
    items: list[Item] = field(default_factory=list)
    unreachable: list[str] = field(default_factory=list)
    reasons: list[str] = field(default_factory=list)
    evidence: list[str] = field(default_factory=list)
    edits: dict[str, bytes | None] = field(default_factory=dict)
    version: tuple[str, str] | None = None  # (version, released_at) after refresh

    @property
    def drifted(self) -> bool:
        return bool(self.items or self.reasons)

    @property
    def mechanical(self) -> bool:
        return self.drifted and not self.reasons and not self.unreachable

    def fingerprint(self) -> str:
        text = "|".join(sorted(f"{i.kind}:{i.repo}:{i.target.sha}" for i in self.items))
        return hashlib.sha256(text.encode()).hexdigest()[:16]


def collect_items(
    catalog_: Catalog, recipe_id: str, http: Http, targets: Callable[[str, str], Target]
) -> Assessment:
    """Compare every pin a recipe carries with what the pinning rule selects."""
    recipe = catalog_.recipes[recipe_id]
    result = Assessment(recipe_id)
    seen: set[tuple[str, str]] = set()

    def consider(
        kind: str, provider: str, repo: str, current: str, slug: str | None = None
    ) -> None:
        key = (provider, repo.lower())
        if (kind != "model" and key in seen) or not SHA.match(current):
            return
        seen.add(key) if kind != "model" else None
        try:
            target = targets(provider, repo)
        except NotFound:
            model = catalog_.models.get(slug or "", {})
            if kind == "model" and model.get("requires_token") is False:
                result.reasons.append(
                    f"model {repo} is no longer anonymously resolvable; review or withdraw this public Model rather than replacing it automatically."
                )
                return
            result.unreachable.append(f"{provider}:{repo} was not found upstream")
            return
        except AccessRestricted as error:
            model = catalog_.models.get(slug or "", {})
            if kind == "model" and model.get("requires_token") is False:
                result.reasons.append(
                    f"model {repo} provider now requires access ({error!s}); review or withdraw this public Model. The updater will not retrieve credentials or author a replacement."
                )
            else:
                result.evidence.append(
                    f"### Model access status: {repo}\n\nAnonymous check was restricted ({error!s}); the authored requires_token flag is not provider evidence.\n"
                )
                result.unreachable.append(
                    f"{provider}:{repo}: anonymous access status could not be verified ({error!s}); no credentials were requested"
                )
            return
        except (RuntimeError, KeyError, TypeError) as error:
            result.unreachable.append(f"{provider}:{repo}: {str(error)[:200]}")
            return
        if kind == "model" and target.access_status is not None:
            model = catalog_.models.get(slug or "", {})
            token_required = model.get("requires_token") is True
            if target.access_status in {"private", "disabled"}:
                result.reasons.append(
                    f"model {repo} provider access is {target.access_status}; review or withdraw this Model. The updater will not retrieve access credentials or author a replacement."
                )
            elif target.access_status == "gated" and not token_required:
                result.reasons.append(
                    f"model {repo} provider access changed to {target.access_status}; the catalog declares anonymous access. Review or withdraw this Model; do not replace it automatically."
                )
            elif target.access_status == "public" and token_required:
                result.reasons.append(
                    f"model {repo} is publicly accessible but the catalog requires a token; review the access declaration before changing it."
                )
            elif target.access_status == "unknown":
                result.evidence.append(
                    f"### Model access status: {repo}\n\nProvider gating/private status was not explicit in the anonymous metadata response; the authored requires_token flag is not treated as provider evidence.\n"
                )
                result.unreachable.append(
                    f"{provider}:{repo}: provider access status is unknown from anonymous metadata; no credentials were requested"
                )
        if target.sha == current:
            return
        compared: Comparison | None = None
        if provider == "github":
            try:
                compared = compare_commits(http, repo, current, target.sha)
            except (RuntimeError, KeyError, TypeError):
                compared = None  # assessed (and reported) later
            if compared is not None and pin_is_current(compared):
                return  # never downgrade: the pin is at or ahead of the newest
        result.items.append(Item(kind, provider, repo, current, target, slug, compared))

    source = source_pin(recipe)
    if source is not None:
        consider("source", *source)
    pin = adapter_pin(catalog_.root, recipe)
    if pin is not None:
        consider("adapter", "github", pin.repo, pin.commit)
    for reference in recipe["models"]:
        slug = reference["model"]["slug"]
        document = catalog_.models.get(slug)
        model_source = (document or {}).get("source")
        if not model_source:
            continue
        location = drift.parse_source(model_source["repository"])
        if location.provider == "huggingface":
            consider(
                "model",
                "huggingface",
                location.repository,
                model_source["revision"],
                slug,
            )
    return result


# ---------------------------------------------------------------------------
# Classification
# ---------------------------------------------------------------------------


@dataclass(frozen=True, slots=True)
class Comparison:
    status: str
    commits: list[dict[str, Any]]
    files: list[dict[str, Any]]
    truncated: bool
    url: str


def compare_commits(http: Http, repo: str, old: str, new: str) -> Comparison:
    commits: list[dict[str, Any]] = []
    files: list[dict[str, Any]] = []
    status = "unknown"
    url = f"https://github.com/{repo}/compare/{old[:12]}...{new[:12]}"
    truncated = False
    for page in range(1, 4):
        document = http.github(
            f"repos/{repo}/compare/{old}...{new}?per_page=100&page={page}"
        )
        status = document.get("status", status)
        commits.extend(document.get("commits", []))
        files.extend(document.get("files", []))
        url = document.get("html_url", url)
        if (
            len(document.get("commits", [])) < 100
            and len(document.get("files", [])) < 100
        ):
            break
    else:
        truncated = True
    return Comparison(status, commits, files, truncated, url)


def pin_is_current(comparison: Comparison) -> bool:
    """The pin is the newest release/head or already ahead of it (never downgrade)."""
    return comparison.status in {"behind", "identical"}


def patch_targets(adapter: Path) -> set[str]:
    """Paths named by ``+++ b/<path>`` in the adapter's ``*.patch`` and ``*.diff`` files."""
    targets: set[str] = set()
    for path in sorted(adapter.rglob("*")):
        if path.suffix not in {".patch", ".diff"} or not path.is_file():
            continue
        for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
            if line.startswith("+++ ") and not line.startswith("+++ /dev/null"):
                name = line[4:].split("\t")[0].strip()
                targets.add(re.sub(r"^[ab]/", "", name))
    return targets


def classify_changes(
    comparison: Comparison,
    *,
    patched: set[str],
    vendor_problems: list[str],
) -> list[str]:
    """Why a GitHub pin move is not mechanical; empty means it is."""
    reasons: list[str] = []
    if comparison.status == "behind":
        reasons.append(
            "the pin is newer than the version the pinning rule selects; "
            "moving to it would be a downgrade"
        )  # unreachable through assess(): such pins are current
    elif comparison.status == "diverged":
        reasons.append("the selected version is not a descendant of the pinned commit")
    elif comparison.status not in {"ahead", "identical"}:
        reasons.append(f"upstream comparison reported '{comparison.status}'")
    if comparison.truncated:
        reasons.append("too many upstream changes to inspect (300+ files or commits)")
    changed = {f["filename"] for f in comparison.files}
    changed |= {
        f["previous_filename"] for f in comparison.files if "previous_filename" in f
    }
    blocking = sorted(name for name in changed if is_blocking(name))
    if blocking:
        reasons.append(
            "launch scripts, configuration, patches or the README changed: "
            + ", ".join(f"`{name}`" for name in blocking[:20])
            + (f" and {len(blocking) - 20} more" if len(blocking) > 20 else "")
        )
    hit = sorted(patched & changed)
    if hit:
        reasons.append(
            "a patch's target file changed upstream, so it may no longer apply: "
            + ", ".join(f"`{name}`" for name in hit)
        )
    reasons.extend(vendor_problems)
    return reasons


def model_shape_problems(
    old: dict[str, Any], new_files: list[dict[str, Any]]
) -> list[str]:
    """Why a Model's new snapshot does not keep the old file set's shape."""
    problems: list[str] = []
    by_path = {f["path"]: f for f in new_files}
    old_paths = {f["path"] for f in old["files"]}
    for removed in sorted(old_paths - set(by_path)):
        problems.append(f"file removed or renamed upstream: `{removed}`")
    for added in sorted(set(by_path) - old_paths):
        roles = by_path[added]["roles"]
        if roles != ["metadata"]:
            problems.append(f"new {'/'.join(roles)} file: `{added}`")
    for entry in old["files"]:
        expected = file_id(entry["path"], entry["sha256"])
        if entry["id"] != expected:
            problems.append(f"non-standard file id for `{entry['path']}`")
    return problems


def file_id(path: str, sha256: str) -> str:
    stem = catalog._slug(path.rsplit("/", 1)[-1].rsplit(".", 1)[0])
    return f"{stem[:39]}-{sha256[:12]}-{hashlib.sha256(path.encode()).hexdigest()[:10]}"


def refreshed_model(
    old: dict[str, Any], new_files: list[dict[str, Any]], target: Target
) -> dict[str, Any]:
    """The old Model document moved to the new snapshot, keeping its curation."""
    old_revision = old["source"]["revision"]
    new_revision = target.sha
    by_path = {f["path"]: f for f in new_files}
    document = json.loads(json.dumps(old))
    document["source"]["revision"] = new_revision
    identity = document["identity"]
    slug = identity["slug"]
    if slug.endswith(old_revision[:8]):
        identity["slug"] = slug[: -len(old_revision[:8])] + new_revision[:8]
    else:
        identity["slug"] = f"{slug}-{new_revision[:8]}"
    for key in ("version", "variant"):
        if isinstance(identity.get(key), str) and old_revision[:8] in identity[key]:
            identity[key] = identity[key].replace(old_revision[:8], new_revision[:8])
    for entry in document["files"]:
        fresh = by_path[entry["path"]]
        entry["sha256"] = fresh["sha256"]
        entry["size_bytes"] = fresh["installed_bytes"]
        entry["id"] = file_id(entry["path"], fresh["sha256"])
    document["files"].sort(key=lambda entry: entry["path"])
    ModelDefinition.model_validate(document)
    return document


def released(recipe: dict[str, Any], items: list[Item]) -> tuple[str, str]:
    """``(version, released_at)`` for a refreshed recipe (docs/recipe-authoring.md section 4)."""
    current = recipe["release"]["version"]
    published = next(
        (i for i in items if i.kind in {"source", "adapter"} and i.target.version), None
    )
    newest = max(items, key=lambda i: i.target.date)
    date = published.target.date if published else newest.target.date
    if published is not None:
        try:
            RecipeRelease.model_validate(
                {"version": published.target.version, "released_at": date}
            )
            return str(published.target.version), date
        except ValueError:
            pass
    match = OWN_VERSION.match(current)
    if match is None:
        return current, max(date, recipe["release"]["released_at"])
    major, minor, patch = (int(part) for part in match.groups())
    return f"{major}.{minor}.{patch + 1}", max(date, recipe["release"]["released_at"])


# ---------------------------------------------------------------------------
# Evidence for people (and the later AI step) reading an issue or pull request
# ---------------------------------------------------------------------------


def fence(text: str, language: str = "") -> str:
    ticks = "````"
    while ticks in text:
        ticks += "`"
    return f"{ticks}{language}\n{text.rstrip()}\n{ticks}"


def clip(text: str, limit: int) -> str:
    return text if len(text) <= limit else text[:limit] + "\n... (truncated)"


def github_evidence(item: Item, comparison: Comparison, patched: set[str]) -> str:
    lines = [
        f"### {item.label}",
        "",
        f"- pinned: `{item.current}`",
        f"- newest: `{item.target.sha}` "
        + (
            f"(release `{item.target.ref}`)"
            if item.target.ref
            else "(latest commit, no published version)"
        )
        + f", {item.target.date} - {item.target.url}",
        (
            f"- comparison: {comparison.url} ({comparison.status}, "
            f"{len(comparison.commits)} commits, {len(comparison.files)} files)"
        ),
        "",
    ]
    if item.target.notes:
        lines += [
            "Release notes (upstream text, evidence only):",
            "",
            fence(clip(item.target.notes, 3000), "text"),
            "",
        ]
    if comparison.commits:
        subjects = [
            f"{c['sha'][:10]} {c['commit']['message'].splitlines()[0][:120]}"
            for c in comparison.commits[-30:]
        ]
        lines += [
            f"Commits (newest {len(subjects)}, upstream text, evidence only):",
            "",
            fence("\n".join(subjects), "text"),
            "",
        ]
    if comparison.files:
        listing = [
            f"{'!' if is_blocking(f['filename']) else ' '} {f['status']:<9} {f['filename']}"
            for f in comparison.files[:80]
        ]
        lines += [
            "Changed files (`!` marks launch/config/patch/README files):",
            "",
            fence("\n".join(listing), "text"),
            "",
        ]
    budget = 18000
    for f in comparison.files:
        if not is_blocking(f["filename"]) and f["filename"] not in patched:
            continue
        patch = f.get("patch")
        if not patch or budget <= 0:
            continue
        excerpt = clip(patch, min(3000, budget))
        budget -= len(excerpt)
        lines += [f"Diff of `{f['filename']}`:", "", fence(excerpt, "diff"), ""]
    return "\n".join(lines)


def model_evidence(
    item: Item, old: dict[str, Any], new_files: list[dict[str, Any]] | None
) -> str:
    lines = [
        f"### {item.label}",
        "",
        f"- catalogued revision: `{item.current}`",
        f"- newest revision: `{item.target.sha}` ({item.target.date}) - {item.target.url}",
        "",
    ]
    if new_files is not None:
        old_by = {f["path"]: f for f in old["files"]}
        new_by = {f["path"]: f for f in new_files}
        changes = (
            [f"removed  {p}" for p in sorted(set(old_by) - set(new_by))]
            + [
                f"added    {p} ({new_by[p]['roles'][0]})"
                for p in sorted(set(new_by) - set(old_by))
            ]
            + [
                f"changed  {p} ({old_by[p]['size_bytes']} -> {new_by[p]['installed_bytes']} bytes)"
                for p in sorted(set(old_by) & set(new_by))
                if old_by[p]["sha256"] != new_by[p]["sha256"]
            ]
        )
        lines += [
            "Model file changes:",
            "",
            fence("\n".join(changes[:120]) or "none", "text"),
            "",
        ]
    return "\n".join(lines)


# ---------------------------------------------------------------------------
# Assessment: decide, and prepare the edits for a mechanical refresh
# ---------------------------------------------------------------------------


class Assessor:
    def __init__(
        self,
        catalog_: Catalog,
        http: Http,
        cache_dir: Path | None,
        embedded: dict[str, Any],
    ) -> None:
        self.catalog = catalog_
        self.http = http
        self.cache_dir = cache_dir
        self.targets: dict[tuple[str, str], Target] = {}
        self.target_lock = threading.Lock()
        self.embedded_candidates: dict[str, list[dict[str, Any]]] = {}
        for record in embedded.get("recipes", []):
            if not isinstance(record, dict) or not isinstance(
                record.get("recipe_id"), str
            ):
                continue
            for item in record.get("inputs", []):
                if (
                    isinstance(item, dict)
                    and item.get("candidate_status") == "advanced"
                ):
                    self.embedded_candidates.setdefault(record["recipe_id"], []).append(
                        item
                    )

    def target(self, provider: str, repo: str) -> Target:
        key = (provider, repo.lower())
        with self.target_lock:
            found = self.targets.get(key)
        if found is None:
            found = resolve(self.http, provider, repo)
            with self.target_lock:
                self.targets[key] = found
        return found

    def assess(self, recipe_id: str) -> Assessment:
        result = collect_items(self.catalog, recipe_id, self.http, self.target)
        for item in self.embedded_candidates.get(recipe_id, []):
            repository = item.get("repository")
            pinned = item.get("revision")
            candidate = item.get("candidate_revision")
            candidate_url = item.get("candidate_url")
            result.evidence.append(
                f"### Embedded Git source candidate: {repository}\n\n"
                f"- embedded commit: `{pinned}`\n"
                f"- advertised default-branch candidate: `{candidate}` - {candidate_url}\n"
                f"- candidate observed at: {item.get('candidate_observed_at')}\n"
                "- this is review evidence, not a configured upgrade channel or compatibility recommendation; no pin was changed.\n"
            )
        if not result.drifted or result.unreachable:
            return result
        if result.reasons:
            for item in result.items:
                result.evidence.append(
                    f"### Held source candidate: {item.label}\n\n"
                    f"- current pin: `{item.current}`\n"
                    f"- proposed upstream pin: `{item.target.sha}` - {item.target.url}\n"
                    "- no automatic retarget was prepared because this recipe has another review blocker.\n"
                )
            return result
        recipe = self.catalog.recipes[recipe_id]
        edits: dict[str, bytes | None] = {}
        new_recipe = json.loads(json.dumps(recipe))
        for item in result.items:
            try:
                if item.kind == "model":
                    self._model(item, recipe, new_recipe, result, edits)
                elif item.provider == "github":
                    self._github(item, recipe, new_recipe, result, edits)
                else:
                    result.evidence.append(
                        f"### {item.label}\n\n- pinned `{item.current}`\n- newest `{item.target.sha}`"
                        f" ({item.target.date}) - {item.target.url}\n"
                    )
                    self._retarget_reference(new_recipe, item)
            except (RuntimeError, SystemExit, KeyError, ValueError, OSError) as error:
                result.reasons.append(
                    f"{item.label}: could not be assessed: {str(error)[:300]}"
                )
        if result.mechanical:
            version, date = released(recipe, result.items)
            new_recipe["release"] = {"version": version, "released_at": date}
            result.version = (version, date)
            edits[f"recipes/{recipe_id}.json"] = canonical(new_recipe)
            result.edits = edits
        return result

    # A source_reference names "<repo>/tree/<sha>"; move only the commit.
    @staticmethod
    def _retarget_reference(new_recipe: dict[str, Any], item: Item) -> None:
        provenance = new_recipe["provenance"]
        reference = provenance.get("source_reference")
        if isinstance(reference, str) and item.current in reference:
            provenance["source_reference"] = reference.replace(
                item.current, item.target.sha
            )

    def _github(
        self,
        item: Item,
        recipe: dict[str, Any],
        new_recipe: dict[str, Any],
        result: Assessment,
        edits: dict[str, bytes | None],
    ) -> None:
        comparison = item.comparison or compare_commits(
            self.http, item.repo, item.current, item.target.sha
        )
        pin = adapter_pin(self.catalog.root, recipe)
        owns_adapter = pin is not None and pin.repo.lower() == item.repo.lower()
        patched: set[str] = set()
        problems: list[str] = []
        if owns_adapter:
            assert pin is not None
            patched = patch_targets(pin.directory)
            tree = vendored.fetch_tree(item.repo, item.target.sha)
            report = vendored.check_adapter(
                pin.directory, self.catalog.root, lambda _repo, _commit: tree
            )
            problems = [
                f"vendored file check at the new commit: {p}" for p in report.problems
            ]
        result.reasons.extend(
            classify_changes(comparison, patched=patched, vendor_problems=problems)
        )
        result.evidence.append(github_evidence(item, comparison, patched))
        self._retarget_reference(new_recipe, item)
        if owns_adapter:
            assert pin is not None
            self._retarget_adapter(pin, item, edits)

    def _retarget_adapter(
        self, pin: AdapterPin, item: Item, edits: dict[str, bytes | None]
    ) -> None:
        root = self.catalog.root
        for name in (vendored.MANIFEST, "Dockerfile", "NOTICE"):
            path = pin.directory / name
            if not path.is_file():
                continue
            text = path.read_text(encoding="utf-8")
            if item.current in text:
                edits[path.relative_to(root).as_posix()] = text.replace(
                    item.current, item.target.sha
                ).encode()

    def _model(
        self,
        item: Item,
        recipe: dict[str, Any],
        new_recipe: dict[str, Any],
        result: Assessment,
        edits: dict[str, bytes | None],
    ) -> None:
        old = self.catalog.models[str(item.model_slug)]
        fresh = self.catalog.catalogued(item.repo, item.target.sha)
        new_files: list[dict[str, Any]] | None = None
        if fresh is None:
            new_files = self._inventory(item.repo, item.target.sha)
            problems = model_shape_problems(old, new_files)
            result.reasons.extend(f"{item.label}: {p}" for p in problems)
            result.evidence.append(model_evidence(item, old, new_files))
            if problems:
                return
            fresh = refreshed_model(old, new_files, item.target)
            edits[f"models/{fresh['identity']['slug']}.json"] = canonical(fresh)
        else:
            result.evidence.append(
                model_evidence(item, old, None)
                + "\nThe newest revision is already catalogued; reusing it.\n"
            )
            if {f["path"] for f in old["files"]} - {f["path"] for f in fresh["files"]}:
                result.reasons.append(
                    f"{item.label}: the catalogued newest revision lacks files"
                )
                return
        self._retarget_model(recipe, new_recipe, old, fresh, result)
        remaining = [
            rid
            for rid in self.catalog.model_references(old["identity"]["slug"])
            if rid != recipe["identity"]["slug"]
        ]
        if not remaining:
            edits[f"models/{old['identity']['slug']}.json"] = None

    def _inventory(self, repo: str, revision: str) -> list[dict[str, Any]]:
        cache = (
            None
            if self.cache_dir is None
            else self.cache_dir / "hf" / f"{repo.replace('/', '__')}@{revision}.json"
        )
        if cache is not None and cache.is_file():
            return json.loads(cache.read_text(encoding="utf-8"))
        base = f"https://huggingface.co/api/models/{quote(repo, safe='/')}"
        tree = catalog._get_tree(
            f"{base}/tree/{revision}?recursive=true&expand=true&limit=100"
        )
        artifacts = catalog.inventory(repo, revision, tree)
        if cache is not None:
            cache.parent.mkdir(parents=True, exist_ok=True)
            cache.write_text(json.dumps(artifacts), encoding="utf-8")
        return artifacts

    def _retarget_model(
        self,
        recipe: dict[str, Any],
        new_recipe: dict[str, Any],
        old: dict[str, Any],
        fresh: dict[str, Any],
        result: Assessment,
    ) -> None:
        old_ids = {f["path"]: f for f in old["files"]}
        new_ids = {f["path"]: f for f in fresh["files"]}
        by_old_id = {f["id"]: new_ids[path] for path, f in old_ids.items()}
        content = document_sha256(fresh)
        old_total = new_total = 0
        for reference in new_recipe["models"]:
            model = reference["model"]
            if model["slug"] != old["identity"]["slug"]:
                continue
            model["slug"] = fresh["identity"]["slug"]
            model["content_sha256"] = content
            for selected in reference["files"]:
                before = selected["file_id"]
                replacement = by_old_id[before]
                old_entry = next(f for f in old["files"] if f["id"] == before)
                old_total += old_entry["size_bytes"]
                new_total += replacement["size_bytes"]
                selected["file_id"] = replacement["id"]
                if selected["id"].endswith(before):
                    selected["id"] = selected["id"][: -len(before)] + replacement["id"]
        if old_total != new_total:
            resized = False
            for role in new_recipe["topology"]["roles"]:
                disk = role["resources"]["disk"]
                if disk["artifact_bytes"] == old_total:
                    disk["artifact_bytes"] = new_total
                    resized = True
            if not resized:
                result.reasons.append(
                    f"model sizes changed ({old_total} -> {new_total} bytes) and the recipe's "
                    "disk envelope is not derived from them"
                )


# ---------------------------------------------------------------------------
# Applying edits and verifying the result
# ---------------------------------------------------------------------------


def apply_edits(root: Path, edits: dict[str, bytes | None]) -> dict[str, bytes | None]:
    """Write edits; returns what is needed to undo them."""
    undo: dict[str, bytes | None] = {}
    for name, data in edits.items():
        path = root / name
        undo[name] = path.read_bytes() if path.is_file() else None
        if data is None:
            path.unlink(missing_ok=True)
        else:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_bytes(data)
    return undo


def run(
    command: list[str],
    *,
    cwd: Path,
    check: bool = True,
    env: dict[str, str] | None = None,
) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(
        command,
        cwd=cwd,
        text=True,
        capture_output=True,
        check=False,
        env={**os.environ, **(env or {})},
    )
    if check and result.returncode != 0:
        raise RuntimeError(
            f"{' '.join(command[:3])} failed ({result.returncode}): "
            f"{(result.stderr or result.stdout)[-1500:]}"
        )
    return result


def verify(root: Path, recipe_id: str) -> str | None:
    """Regenerate the README and run every check; returns a failure description."""
    steps: list[tuple[str, list[str]]] = [
        ("README overview", [sys.executable, "tools/build-readme-overview"]),
        ("model references", [sys.executable, "tools/check-recipe-model-references"]),
        ("vendored upstream files", [sys.executable, "tools/check-vendored-upstream"]),
        (
            "full test suite",
            [
                sys.executable,
                "-m",
                "pytest",
                "-q",
                "-x",
                "-m",
                "not lane",
                "-p",
                "no:cacheprovider",
            ],
        ),
    ]
    for name, command in steps:
        result = run(command, cwd=root, check=False)
        if result.returncode != 0:
            return f"{name} failed:\n{(result.stdout + result.stderr)[-2500:]}"
    return None


