@dataclass(frozen=True, slots=True)
class Comparison:
    status: str
    commits: list[dict[str, Any]]
    files: list[dict[str, Any]]
    truncated: bool
    url: str


def compare_commits(http: Http, repo: str, old: str, new: str) -> Comparison:
    commits: list[dict[str, Any]] = []
    files: list[dict[str, Any]] = []
    status = "unknown"
    url = f"https://github.com/{repo}/compare/{old[:12]}...{new[:12]}"
    truncated = False
    for page in range(1, 4):
        document = http.github(
            f"repos/{repo}/compare/{old}...{new}?per_page=100&page={page}"
        )
        status = document.get("status", status)
        commits.extend(document.get("commits", []))
        files.extend(document.get("files", []))
        url = document.get("html_url", url)
        if (
            len(document.get("commits", [])) < 100
            and len(document.get("files", [])) < 100
        ):
            break
    else:
        truncated = True
    return Comparison(status, commits, files, truncated, url)


def pin_is_current(comparison: Comparison) -> bool:
    """The pin is the newest release/head or already ahead of it (never downgrade)."""
    return comparison.status in {"behind", "identical"}


def pin_is_newer_by_date(http: Http, repo: str, pin: str, release: str) -> bool:
    """Diverged histories (a release branch against a main pin): the newer commit wins.

    Moving from a pin committed after the release commit to that release would be a
    downgrade in everything except Git ancestry.
    """
    try:
        dates = [
            http.github(f"repos/{repo}/commits/{sha}")["commit"]["committer"]["date"]
            for sha in (pin, release)
        ]
    except (RuntimeError, KeyError, TypeError, AttributeError):
        return False
    return dates[0] >= dates[1]


# Everything that makes an adapter depend on the whole upstream repository rather than on
# the individual files it vendors or fetches by URL.
WHOLE_REPO = (
    r"git\s+(clone|fetch|checkout)\b",
    r"git\+https?://",
    r"/archive/",
    r"/releases/download/",
)


def adapter_usage(
    directory: Path | None, repo: str, commit: str
) -> tuple[set[str], bool]:
    """``(paths named by URL, whole repository used)`` for one upstream repository.

    Vendored files are verified byte for byte by ``check-vendored-upstream``; this adds
    the files an adapter fetches by explicit ``raw.githubusercontent.com`` /
    ``github.com/.../blob|raw/`` URL. An adapter that clones the repository, installs an
    archive of it, or carries a file named after the pinned commit uses all of it.
    """
    if directory is None or not directory.is_dir():
        return set(), False
    escaped = re.escape(repo)
    urls = re.compile(
        rf"(?:raw\.githubusercontent\.com/{escaped}/[^/\s\"'`)]+/"
        rf"|github\.com/{escaped}/(?:blob|raw)/[^/\s\"'`)]+/)([^\s\"'`)\\?#]+)",
        re.IGNORECASE,
    )
    mentions = re.compile(rf"github\.com/{escaped}", re.IGNORECASE)
    paths: set[str] = set()
    whole = False
    for path in sorted(directory.rglob("*")):
        if not path.is_file() or path.is_symlink():
            continue
        if commit[:12] in path.name:
            whole = True
        if path.stat().st_size > 1_000_000 or path.suffix in {".gz", ".zip", ".tar"}:
            continue
        text = path.read_text(encoding="utf-8", errors="replace")
        paths.update(match for match in urls.findall(text))
        if mentions.search(text) and any(
            re.search(pattern, text) for pattern in WHOLE_REPO
        ):
            whole = True
    return paths, whole


ARCHIVE_LABEL = re.compile(r'([\w.-]*archive-sha256="?)([0-9a-f]{64})("?)')
MAX_ARCHIVE_BYTES = 400_000_000


def archive_sha256(repo: str, commit: str) -> str:
    """SHA-256 of GitHub's source archive of one commit (verified at ingress only)."""
    digest = hashlib.sha256()
    total = 0
    url = f"https://codeload.github.com/{repo}/tar.gz/{commit}"
    request = urllib.request.Request(url, headers={"User-Agent": "vonk-forge-recipes"})
    try:
        with urllib.request.urlopen(request, timeout=120) as response:
            while chunk := response.read(1 << 20):
                total += len(chunk)
                if total > MAX_ARCHIVE_BYTES:
                    raise RuntimeError(
                        f"{url} is larger than {MAX_ARCHIVE_BYTES} bytes"
                    )
                digest.update(chunk)
    except (urllib.error.HTTPError, urllib.error.URLError) as error:
        raise RuntimeError(f"cannot fetch {url}: {error}") from error
    return digest.hexdigest()


def retarget_archive_labels(dockerfile: str, item: Item) -> tuple[str, bool]:
    """Move ``*archive-sha256`` labels that digest the pinned commit's archive.

    Only a label whose value equals the archive digest of the old pin belongs to this
    repository; others (other sources, wheels) are left alone.
    """
    matches = list(ARCHIVE_LABEL.finditer(dockerfile))
    if not matches:
        return dockerfile, False
    old = archive_sha256(item.repo, item.current)
    if not any(m.group(2) == old for m in matches):
        return dockerfile, False
    new = archive_sha256(item.repo, item.target.sha)
    return (
        ARCHIVE_LABEL.sub(
            lambda m: (
                m.group(1) + new + m.group(3) if m.group(2) == old else m.group(0)
            ),
            dockerfile,
        ),
        True,
    )


def patch_targets(adapter: Path) -> set[str]:
    """Paths named by ``+++ b/<path>`` in the adapter's ``*.patch`` and ``*.diff`` files."""
    targets: set[str] = set()
    for path in sorted(adapter.rglob("*")):
        if path.suffix not in {".patch", ".diff"} or not path.is_file():
            continue
        for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
            if line.startswith("+++ ") and not line.startswith("+++ /dev/null"):
                name = line[4:].split("\t")[0].strip()
                targets.add(re.sub(r"^[ab]/", "", name))
    return targets


def classify_changes(
    comparison: Comparison,
    *,
    patched: set[str],
    vendor_problems: list[str],
    used_changes: list[str] | None = None,
    mirrored: set[str] | frozenset[str] = frozenset(),
) -> list[str]:
    """Why a GitHub pin move is not mechanical; empty means it is.

    ``mirrored`` names upstream paths whose copy ships in the adapter (a kit's patches and
    scripts); a change to one is always a reason. ``used_changes`` is ``None`` when the
    files the recipe uses could not be told (the adapter uses the whole repository, or
    the repository is the kit the adapter is built from): every changed upstream file is
    then judged.
    Otherwise it lists the used files that differ between the two commits, and nothing
    else upstream matters: unrelated changes, a truncated comparison and a diverged
    history (the caller has rejected a pin that is ahead) are not reasons.
    """
    if used_changes is not None:
        reasons = []
        if comparison.status not in {"ahead", "identical", "diverged", "behind"}:
            reasons.append(f"upstream comparison reported '{comparison.status}'")
        if used_changes:
            reasons.append(
                "files this recipe uses changed upstream: "
                + ", ".join(f"`{name}`" for name in used_changes[:20])
                + (
                    f" and {len(used_changes) - 20} more"
                    if len(used_changes) > 20
                    else ""
                )
            )
        return reasons + vendor_problems
    reasons: list[str] = []
    if comparison.status == "behind":
        reasons.append(
            "the pin is newer than the version the pinning rule selects; "
            "moving to it would be a downgrade"
        )  # unreachable through assess(): such pins are current
    elif comparison.status == "diverged":
        reasons.append("the selected version is not a descendant of the pinned commit")
    elif comparison.status not in {"ahead", "identical"}:
        reasons.append(f"upstream comparison reported '{comparison.status}'")
    if comparison.truncated:
        reasons.append("too many upstream changes to inspect (300+ files or commits)")
    changed = {f["filename"] for f in comparison.files}
    changed |= {
        f["previous_filename"] for f in comparison.files if "previous_filename" in f
    }
    blocking = sorted(name for name in changed if is_blocking(name) or name in mirrored)
    if blocking:
        reasons.append(
            "launch scripts, configuration, patches or the README changed: "
            + ", ".join(f"`{name}`" for name in blocking[:20])
            + (f" and {len(blocking) - 20} more" if len(blocking) > 20 else "")
        )
    hit = sorted(patched & changed)
    if hit:
        reasons.append(
            "a patch's target file changed upstream, so it may no longer apply: "
            + ", ".join(f"`{name}`" for name in hit)
        )
    reasons.extend(vendor_problems)
    return reasons


METADATA_ONLY = {"metadata"}
# A kit-declared model revision is followed mechanically only when it changes nothing but
# metadata: the weights, configuration and tokenizer stay the catalogued bytes.
KIT_MODEL_FILES_CHANGED = (
    "the kit declares a revision whose files differ from the catalogued ones beyond "
    "metadata (weights, configuration or tokenizer); it is a different model payload, "
    "so review it"
)


def model_shape_problems(
    old: dict[str, Any], new_files: list[dict[str, Any]]
) -> list[str]:
    """Why a Model's new snapshot does not keep the old file set's shape."""
    problems: list[str] = []
    by_path = {f["path"]: f for f in new_files}
    old_by = {f["path"]: f for f in old["files"]}
    for removed in sorted(set(old_by) - set(by_path)):
        if not set(old_by[removed]["roles"]) <= METADATA_ONLY:
            problems.append(f"file removed or renamed upstream: `{removed}`")
    for added in sorted(set(by_path) - set(old_by)):
        roles = by_path[added]["roles"]
        if roles != ["metadata"]:
            problems.append(f"new {'/'.join(roles)} file: `{added}`")
    for path in sorted(set(old_by) & set(by_path)):
        entry = old_by[path]
        if entry["sha256"] != by_path[path]["sha256"] and not set(entry["roles"]) <= {
            "weights",
            "metadata",
        }:
            problems.append(
                f"{'/'.join(entry['roles'])} file changed: `{path}` "
                "(a weights-only digest change is mechanical; this is not)"
            )
    return problems


def payload_identical(old: dict[str, Any], new_files: list[dict[str, Any]]) -> bool:
    """Whether every non-metadata file is the same bytes at the same path."""
    before = {
        f["path"]: f["sha256"] for f in old["files"] if f["roles"] != ["metadata"]
    }
    after = {f["path"]: f["sha256"] for f in new_files if f["roles"] != ["metadata"]}
    return before == after


file_id = kit_pins.file_id


def refreshed_model(
    old: dict[str, Any], new_files: list[dict[str, Any]], target: Target
) -> dict[str, Any]:
    """The old Model document moved to the new snapshot, keeping its curation."""
    return kit_pins.moved_model(old, new_files, target.sha)


def released(recipe: dict[str, Any], items: list[Item]) -> tuple[str, str]:
    """``(version, released_at)`` for a refreshed recipe (docs/recipe-authoring.md section 4)."""
    current = recipe["release"]["version"]
    published = next(
        (i for i in items if i.kind in {"source", "adapter"} and i.target.version), None
    )
    newest = max(items, key=lambda i: i.target.date)
    date = published.target.date if published else newest.target.date
    if published is not None:
        try:
            RecipeRelease.model_validate(
                {"version": published.target.version, "released_at": date}
            )
            return str(published.target.version), date
        except ValueError:
            pass
    match = OWN_VERSION.match(current)
    if match is None:
        return current, max(date, recipe["release"]["released_at"])
    major, minor, patch = (int(part) for part in match.groups())
    return f"{major}.{minor}.{patch + 1}", max(date, recipe["release"]["released_at"])


# ---------------------------------------------------------------------------
# Evidence for people (and the later AI step) reading an issue or pull request
# ---------------------------------------------------------------------------


def fence(text: str, language: str = "") -> str:
    ticks = "````"
    while ticks in text:
        ticks += "`"
    return f"{ticks}{language}\n{text.rstrip()}\n{ticks}"


def clip(text: str, limit: int) -> str:
    return text if len(text) <= limit else text[:limit] + "\n... (truncated)"


LICENCE_NAMES = ("LICENSE", "LICENCE", "COPYING", "NOTICE")


def github_evidence(item: Item, comparison: Comparison, patched: set[str]) -> str:
    lines = [
        f"### {item.label}",
        "",
        f"- pinned: `{item.current}`",
        f"- newest: `{item.target.sha}` "
        + (
            f"(release `{item.target.ref}`)"
            if item.target.ref
            else "(latest commit, no published version)"
        )
        + (f", branch `{item.target.branch}`" if item.target.branch else "")
        + f", {item.target.date} - {item.target.url}",
        (
            f"- comparison: {comparison.url} ({comparison.status}, "
            f"{len(comparison.commits)} commits, {len(comparison.files)} files)"
        ),
        "",
    ]
    licences = sorted(
        f["filename"]
        for f in comparison.files
        if f.get("status") == "removed"
        and PurePosixPath(f["filename"]).name.upper().startswith(LICENCE_NAMES)
    )
    if licences:
        lines += [
            "Licence files removed upstream (informational; licences never gate a "
            "refresh): " + ", ".join(f"`{name}`" for name in licences),
            "",
        ]
    if item.target.notes:
        lines += [
            "Release notes (upstream text, evidence only):",
            "",
            fence(clip(item.target.notes, 3000), "text"),
            "",
        ]
    if comparison.commits:
        subjects = [
            f"{c['sha'][:10]} {c['commit']['message'].splitlines()[0][:120]}"
            for c in comparison.commits[-30:]
        ]
        lines += [
            f"Commits (newest {len(subjects)}, upstream text, evidence only):",
            "",
            fence("\n".join(subjects), "text"),
            "",
        ]
    if comparison.files:
        listing = [
            f"{'!' if is_blocking(f['filename']) else ' '} {f['status']:<9} {f['filename']}"
            for f in comparison.files[:80]
        ]
        lines += [
            "Changed files (`!` marks launch/config/patch/README files):",
            "",
            fence("\n".join(listing), "text"),
            "",
        ]
    budget = 18000
    for f in comparison.files:
        if not is_blocking(f["filename"]) and f["filename"] not in patched:
            continue
        patch = f.get("patch")
        if not patch or budget <= 0:
            continue
        excerpt = clip(patch, min(3000, budget))
        budget -= len(excerpt)
        lines += [f"Diff of `{f['filename']}`:", "", fence(excerpt, "diff"), ""]
    return "\n".join(lines)


def model_evidence(
    item: Item, old: dict[str, Any], new_files: list[dict[str, Any]] | None
) -> str:
    lines = [
        f"### {item.label}",
        "",
        f"- catalogued revision: `{item.current}`",
        f"- newest revision: `{item.target.sha}` ({item.target.date}) - {item.target.url}"
        + (f" (branch `{item.target.branch}`)" if item.target.branch else ""),
        "",
    ]
    if new_files is not None:
        old_by = {f["path"]: f for f in old["files"]}
        new_by = {f["path"]: f for f in new_files}
        changes = (
            [f"removed  {p}" for p in sorted(set(old_by) - set(new_by))]
            + [
                f"added    {p} ({new_by[p]['roles'][0]})"
                for p in sorted(set(new_by) - set(old_by))
            ]
            + [
                f"changed  {p} ({old_by[p]['size_bytes']} -> {new_by[p]['installed_bytes']} bytes)"
                for p in sorted(set(old_by) & set(new_by))
                if old_by[p]["sha256"] != new_by[p]["sha256"]
            ]
        )
        gone = [
            p
            for p in sorted(set(old_by) - set(new_by))
            if set(old_by[p]["roles"]) <= METADATA_ONLY
        ]
        if gone:
            lines += [
                "Metadata files removed upstream (informational; dropped from the "
                "catalogued Model, licences never gate): "
                + ", ".join(f"`{p}`" for p in gone),
                "",
            ]
        lines += [
            "Model file changes:",
            "",
            fence("\n".join(changes[:120]) or "none", "text"),
            "",
        ]
    return "\n".join(lines)


# ---------------------------------------------------------------------------
# Assessment: decide, and prepare the edits for a mechanical refresh
# ---------------------------------------------------------------------------


class Assessor:
    def __init__(
        self,
        catalog_: Catalog,
        http: Http,
        cache_dir: Path | None,
        embedded: dict[str, Any],
    ) -> None:
        self.catalog = catalog_
        self.http = http
        self.cache_dir = cache_dir
        self.targets: dict[tuple[str, str], Target] = {}
        self.target_lock = threading.Lock()
        self.embedded_candidates: dict[str, list[dict[str, Any]]] = {}
        for record in embedded.get("recipes", []):
            if not isinstance(record, dict) or not isinstance(
                record.get("recipe_id"), str
            ):
                continue
            for item in record.get("inputs", []):
                if (
                    isinstance(item, dict)
                    and item.get("candidate_status") == "advanced"
                ):
                    self.embedded_candidates.setdefault(record["recipe_id"], []).append(
                        item
                    )

    def target(self, provider: str, repo: str) -> Target:
        key = (provider, repo.lower())
        with self.target_lock:
            found = self.targets.get(key)
        if found is None:
            found = resolve(self.http, provider, repo)
            with self.target_lock:
                self.targets[key] = found
        return found

    def assess(self, recipe_id: str) -> Assessment:
        result = collect_items(self.catalog, recipe_id, self.http, self.target)
        for item in self.embedded_candidates.get(recipe_id, []):
            repository = item.get("repository")
            pinned = item.get("revision")
            candidate = item.get("candidate_revision")
            candidate_url = item.get("candidate_url")
            result.evidence.append(
                f"### Embedded Git source candidate: {repository}\n\n"
                f"- embedded commit: `{pinned}`\n"
                f"- advertised default-branch candidate: `{candidate}` - {candidate_url}\n"
                f"- candidate observed at: {item.get('candidate_observed_at')}\n"
                "- this is review evidence, not a configured upgrade channel or compatibility recommendation; no pin was changed.\n"
            )
        if not result.drifted or result.unreachable:
            return result
        if result.reasons:
            for item in result.items:
                result.evidence.append(
                    f"### Held source candidate: {item.label}\n\n"
                    f"- current pin: `{item.current}`\n"
                    f"- proposed upstream pin: `{item.target.sha}` - {item.target.url}\n"
                    "- no automatic retarget was prepared because this recipe has another review blocker.\n"
                )
            return result
        recipe = self.catalog.recipes[recipe_id]
        edits: dict[str, bytes | None] = {}
        new_recipe = json.loads(json.dumps(recipe))
        for item in result.items:
            try:
                if item.kind == "model":
                    self._model(item, recipe, new_recipe, result, edits)
                elif item.kind == "image":
                    self._image(item, recipe, new_recipe, result, edits)
                elif item.provider == "github":
                    self._github(item, recipe, new_recipe, result, edits)
                else:
                    result.evidence.append(
                        f"### {item.label}\n\n- pinned `{item.current}`\n- newest `{item.target.sha}`"
                        f" ({item.target.date}) - {item.target.url}\n"
                    )
                    self._retarget_reference(new_recipe, item)
            except (RuntimeError, SystemExit, KeyError, ValueError, OSError) as error:
                result.reasons.append(
                    f"{item.label}: could not be assessed: {str(error)[:300]}"
                )
        result.items = [item for item in result.items if not item.noop]
        if result.mechanical:
            version, date = released(recipe, result.items)
            new_recipe["release"] = {"version": version, "released_at": date}
            result.version = (version, date)
            edits[f"recipes/{recipe_id}.json"] = canonical(new_recipe)
            result.edits = edits
        return result

    # A source_reference names "<repo>/tree/<sha>"; move only the commit.
    @staticmethod
    def _retarget_reference(new_recipe: dict[str, Any], item: Item) -> None:
        provenance = new_recipe["provenance"]
        reference = provenance.get("source_reference")
        if isinstance(reference, str) and item.current in reference:
            provenance["source_reference"] = reference.replace(
                item.current, item.target.sha
            )

    def _github(
        self,
        item: Item,
        recipe: dict[str, Any],
        new_recipe: dict[str, Any],
        result: Assessment,
        edits: dict[str, bytes | None],
    ) -> None:
        comparison = item.comparison or compare_commits(
            self.http, item.repo, item.current, item.target.sha
        )
        pin = adapter_pin(self.catalog.root, recipe)
        owns_adapter = pin is not None and pin.repo.lower() == item.repo.lower()
        patched: set[str] = set()
        problems: list[str] = []
        if owns_adapter:
            assert pin is not None
            patched = patch_targets(pin.directory)
            tree = vendored.fetch_tree(item.repo, item.target.sha)
            report = vendored.check_adapter(
                pin.directory, self.catalog.root, lambda _repo, _commit: tree
            )
            problems = [
                f"vendored file check at the new commit: {p}" for p in report.problems
            ]
        context = self.catalog.root / recipe["execution"]["build"]["context"]["path"]
        declared_kit = kit_directory(self.catalog.root, recipe)
        is_kit = (
            item.kind == "source"
            and not owns_adapter
            and (
                whole_kit(declared_kit)
                or (declared_kit is None and cites_kit(context, item.repo))
            )
        )
        mirrored: set[str] = set()
        if is_kit:
            # The adapter is built from this repository's patches and scripts, so a
            # change to what runs is a reason even though no file is named by URL.
            used_changes = None
            mirrored = adapter_files(context)
            result.evidence.append(
                f"- {item.label}: the adapter is built from this kit; every changed file "
                "is judged (docs, tests and client-side helper scripts are not runtime; "
                "patches, launch scripts, configuration and files the adapter copies are).\n"
            )
        else:
            used_changes = self._used_changes(item, recipe, pin, patched, result)
        result.reasons.extend(
            classify_changes(
                comparison,
                patched=patched,
                vendor_problems=problems,
                used_changes=used_changes,
                mirrored=mirrored,
            )
        )
        result.evidence.append(github_evidence(item, comparison, patched))
        self._retarget_reference(new_recipe, item)
        if owns_adapter:
            assert pin is not None
            self._retarget_adapter(pin, item, edits, result)
        elif is_kit:
            self._retarget_kit(context, item, edits)
        if declared_kit is not None and item.kind == "source":
            self._retarget_lock(declared_kit, item, edits)

    def _used_changes(
        self,
        item: Item,
        recipe: dict[str, Any],
        pin: AdapterPin | None,
        patched: set[str],
        result: Assessment,
    ) -> list[str] | None:
        """Used upstream files that differ between the pin and the target.

        ``None`` means the whole repository is used (or a tree is unavailable) and the
        caller falls back to judging every changed file.
        """
        context = recipe.get("execution", {}).get("build", {}).get("context", {})
        directory = (
            pin.directory
            if pin is not None
            else (self.catalog.root / context["path"] if "path" in context else None)
        )
        named, whole = adapter_usage(directory, item.repo, item.current)
        if whole:
            result.evidence.append(
                f"- {item.label}: the adapter uses the whole upstream repository "
                "(clone, archive or commit-named file); every changed file is judged.\n"
            )
            return None
        try:
            old = vendored.fetch_tree(item.repo, item.current)
            new = vendored.fetch_tree(item.repo, item.target.sha)
        except RuntimeError:
            return None
        if not (old.complete and new.complete):
            return None
        used = named | patched
        changed = sorted(p for p in used if old.blobs.get(p) != new.blobs.get(p))
        result.evidence.append(
            f"- {item.label}: {len(used)} referenced upstream file(s) checked by blob, "
            f"{len(changed)} changed; vendored files are compared byte for byte; other "
            "upstream changes are not mirrored by this recipe.\n"
        )
        return changed

    def _retarget_adapter(
        self,
        pin: AdapterPin,
        item: Item,
        edits: dict[str, bytes | None],
        result: Assessment,
    ) -> None:
        root = self.catalog.root
        for name in (vendored.MANIFEST, "Dockerfile", "NOTICE"):
            path = pin.directory / name
            if not path.is_file():
                continue
            text = path.read_text(encoding="utf-8")
            changed = item.current in text
            if changed:
                text = text.replace(item.current, item.target.sha)
            if name == "Dockerfile":
                try:
                    text, relabelled = retarget_archive_labels(text, item)
                except (RuntimeError, OSError) as error:
                    result.reasons.append(
                        f"{item.label}: could not refresh the archive digest label: "
                        f"{str(error)[:200]}"
                    )
                    continue
                changed = changed or relabelled
            if changed:
                edits[path.relative_to(root).as_posix()] = text.encode()

    def _retarget_kit(
        self, directory: Path, item: Item, edits: dict[str, bytes | None]
    ) -> None:
        """Move the kit's own commit where the adapter cites it (labels, the lock)."""
        dockerfile = directory / "Dockerfile"
        if dockerfile.is_file():
            text = dockerfile.read_text(encoding="utf-8")
            moved = kit_citation(item.repo).sub(
                lambda m: m.group(1) + item.target.sha, text
            )
            if moved != text:
                edits[dockerfile.relative_to(self.catalog.root).as_posix()] = (
                    moved.encode()
                )
        self._retarget_lock(directory, item, edits)

    def _retarget_lock(
        self, directory: Path, item: Item, edits: dict[str, bytes | None]
    ) -> None:
        """Move the kit commit the adapter's lock was derived from."""
        lock = self._lock(directory, edits)
        if lock is not None:
            lock["kit"]["commit"] = item.target.sha
            self._write_lock(directory, lock, edits)

    def _lock(self, directory: Path, edits: dict[str, bytes | None]) -> Any:
        """The adapter's kit lock with the edits already prepared for it."""
        pending = edits.get(self._lock_path(directory))
        if pending is not None:
            return json.loads(pending)
        return kit_pins.read_lock(directory)

    def _lock_path(self, directory: Path) -> str:
        return (directory / vendored.KIT_LOCK).relative_to(self.catalog.root).as_posix()

    def _write_lock(
        self, directory: Path, lock: Any, edits: dict[str, bytes | None]
    ) -> None:
        edits[self._lock_path(directory)] = kit_pins.lock_text(lock).encode()

    def _image(
        self,
        item: Item,
        recipe: dict[str, Any],
        new_recipe: dict[str, Any],
        result: Assessment,
        edits: dict[str, bytes | None],
    ) -> None:
        """Move the lock, the Dockerfile's FROM and the recorded base to the new digest."""
        pin = item.kit_pin
        directory = self.catalog.root / recipe["execution"]["build"]["context"]["path"]
        lock = self._lock(directory, edits)
        if lock is not None:
            lock["dependencies"][pin.name] = kit_pins.lock_document(
                lock["kit"]["repo"], lock["kit"]["commit"], [pin]
            )["dependencies"][pin.name]
            self._write_lock(directory, lock, edits)
        dockerfile = directory / "Dockerfile"
        if dockerfile.is_file():
            text = dockerfile.read_text(encoding="utf-8")

            def move(match: re.Match[str]) -> str:
                image = match["image"]
                if (
                    "$" in image
                    or kit_pins.split_image(image)[0].lower() != pin.repo.lower()
                ):
                    return match[0]
                return match["lead"] + kit_pins.image_reference(pin, image)

            moved = kit_pins.FROM_LINE.sub(move, text)
            if moved != text:
                edits[dockerfile.relative_to(self.catalog.root).as_posix()] = (
                    moved.encode()
                )
        base = new_recipe["execution"]["build"].get("base_image")
        if base and str(base.get("repository", "")).lower() == pin.repo.lower():
            base["digest"] = pin.immutable.removeprefix("sha256:")
        result.evidence.append(
            f"The recipe runs the kit's published image {pin.repo}; it moves to "
            f"`{pin.immutable}` (the kit's declaration), and the thin layer on top is "
            "rebuilt on it. Review the Dockerfile's header comment.\n"
        )

    def _model(
        self,
        item: Item,
        recipe: dict[str, Any],
        new_recipe: dict[str, Any],
        result: Assessment,
        edits: dict[str, bytes | None],
    ) -> None:
        old = self.catalog.models[str(item.model_slug)]
        fresh = self.catalog.catalogued(item.repo, item.target.sha)
        declared = item.kit_pin is not None
        new_files: list[dict[str, Any]] | None = None
        if fresh is None:
            new_files = self._inventory(item.repo, item.target.sha)
            problems = model_shape_problems(old, new_files)
            if declared and not problems and not payload_identical(old, new_files):
                problems = [KIT_MODEL_FILES_CHANGED]
            result.reasons.extend(f"{item.label}: {p}" for p in problems)
            result.evidence.append(model_evidence(item, old, new_files))
            if problems:
                return
            if payload_identical(old, new_files) and not declared:
                # Same bytes in every file that is not metadata (a README edit): a
                # second catalogued revision would only duplicate the payload.
                item.noop = True
                result.evidence.append(
                    "The newest revision differs only in metadata files; the catalogued "
                    "revision keeps serving identical weights, so no move is proposed.\n"
                )
                return
            fresh = refreshed_model(old, new_files, item.target)
            edits[f"models/{fresh['identity']['slug']}.json"] = canonical(fresh)
        else:
            result.evidence.append(
                model_evidence(item, old, None)
                + "\nThe newest revision is already catalogued; reusing it.\n"
            )
            problems = model_shape_problems(old, fresh["files"])
            if declared and not problems and not payload_identical(old, fresh["files"]):
                problems = [KIT_MODEL_FILES_CHANGED]
            if problems:
                result.reasons.extend(f"{item.label}: {p}" for p in problems)
                return
        self._retarget_model(recipe, new_recipe, old, fresh, result)
        if declared:
            directory = (
                self.catalog.root / recipe["execution"]["build"]["context"]["path"]
            )
            lock = self._lock(directory, edits)
            if lock is not None:
                lock["dependencies"][item.kit_pin.name] = kit_pins.lock_document(
                    lock["kit"]["repo"], lock["kit"]["commit"], [item.kit_pin]
                )["dependencies"][item.kit_pin.name]
                self._write_lock(directory, lock, edits)
        remaining = [
            rid
            for rid in self.catalog.model_references(old["identity"]["slug"])
            if rid != recipe["identity"]["slug"]
        ]
        if not remaining:
            edits[f"models/{old['identity']['slug']}.json"] = None

    def _inventory(self, repo: str, revision: str) -> list[dict[str, Any]]:
        cache = (
            None
            if self.cache_dir is None
            else self.cache_dir / "hf" / f"{repo.replace('/', '__')}@{revision}.json"
        )
        if cache is not None and cache.is_file():
            return json.loads(cache.read_text(encoding="utf-8"))
        base = f"https://huggingface.co/api/models/{quote(repo, safe='/')}"
        tree = catalog._get_tree(
            f"{base}/tree/{revision}?recursive=true&expand=true&limit=100"
        )
        artifacts = catalog.inventory(repo, revision, tree)
        if cache is not None:
            cache.parent.mkdir(parents=True, exist_ok=True)
            cache.write_text(json.dumps(artifacts), encoding="utf-8")
        return artifacts

    def _retarget_model(
        self,
        recipe: dict[str, Any],
        new_recipe: dict[str, Any],
        old: dict[str, Any],
        fresh: dict[str, Any],
        result: Assessment,
    ) -> None:
        old_ids = {f["path"]: f for f in old["files"]}
        new_ids = {f["path"]: f for f in fresh["files"]}
        by_old_id = {
            f["id"]: new_ids[path] for path, f in old_ids.items() if path in new_ids
        }
        content = document_sha256(fresh)
        old_total = new_total = 0
        for reference in new_recipe["models"]:
            model = reference["model"]
            if model["slug"] != old["identity"]["slug"]:
                continue
            model["slug"] = fresh["identity"]["slug"]
            model["content_sha256"] = content
            for selected in reference["files"]:
                before = selected["file_id"]
                if before not in by_old_id:
                    result.reasons.append(
                        f"the recipe selects a file the newest revision no longer has "
                        f"(id `{before}`)"
                    )
                    return
                replacement = by_old_id[before]
                old_entry = next(f for f in old["files"] if f["id"] == before)
                old_total += old_entry["size_bytes"]
                new_total += replacement["size_bytes"]
                selected["file_id"] = replacement["id"]
                if selected["id"].endswith(before):
                    selected["id"] = selected["id"][: -len(before)] + replacement["id"]
        if old_total != new_total:
            delta = new_total - old_total
            roles = new_recipe["topology"]["roles"]
            if any(
                abs(delta) * 100 > role["resources"]["disk"]["artifact_bytes"]
                for role in roles
            ):
                result.reasons.append(
                    f"model sizes changed ({old_total} -> {new_total} bytes) and the recipe's "
                    f"disk envelope would change by more than {MATERIAL_ENVELOPE_PERCENT}%"
                )
                return
            # The artifact envelope follows the selected files' sizes (the sum over
            # the recipe's models, or that sum plus a declared allowance), so shift
            # it by the size difference.
            for role in roles:
                role["resources"]["disk"]["artifact_bytes"] += delta


# ---------------------------------------------------------------------------
# Applying edits and verifying the result
# ---------------------------------------------------------------------------


def apply_edits(root: Path, edits: dict[str, bytes | None]) -> dict[str, bytes | None]:
    """Write edits; returns what is needed to undo them."""
    undo: dict[str, bytes | None] = {}
    for name, data in edits.items():
        path = root / name
        undo[name] = path.read_bytes() if path.is_file() else None
        if data is None:
            path.unlink(missing_ok=True)
        else:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_bytes(data)
    return undo


def run(
    command: list[str],
    *,
    cwd: Path,
    check: bool = True,
    env: dict[str, str] | None = None,
) -> subprocess.CompletedProcess[str]:
    app_env = (
        APP_AUTH.environment()
        if APP_AUTH is not None and command[0] in {"gh", "git"}
        else {}
    )
    result = subprocess.run(
        command,
        cwd=cwd,
        text=True,
        capture_output=True,
        check=False,
        env={**os.environ, **(env or {}), **app_env},
    )
    if check and result.returncode != 0:
        raise RuntimeError(
            f"{' '.join(command[:3])} failed ({result.returncode}): "
            f"{(result.stderr or result.stdout)[-1500:]}"
        )
    return result


def verify_steps() -> list[tuple[str, list[str]]]:
    """The data checks of ``validate.yml`` (tests assert none is missing here)."""
    return [
        ("README overview", [sys.executable, "tools/build-readme-overview"]),
        ("model references", [sys.executable, "tools/check-recipe-model-references"]),
        (
            "build context sources",
            [sys.executable, "tools/check-build-context-sources"],
        ),
        ("vendored upstream files", [sys.executable, "tools/check-vendored-upstream"]),
        ("kit-declared pins", [sys.executable, "tools/kit-pins", "check"]),
        (
            "full test suite",
            [
                sys.executable,
                "-m",
                "pytest",
                "-q",
                "-x",
                "-m",
                "not lane",
                "-p",
                "no:cacheprovider",
            ],
        ),
    ]


def verify(root: Path, recipe_id: str) -> str | None:
    """Regenerate the README and run every check; returns a failure description."""
    steps = verify_steps()
    for name, command in steps:
        result = run(command, cwd=root, check=False)
        if result.returncode != 0:
            return f"{name} failed:\n{(result.stdout + result.stderr)[-2500:]}"
    return None


