#!/usr/bin/env python3
"""Refresh the upstream pins of recipes: see ``recipe_tooling.refresh_upstream.cli``."""

import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path[:0] = [str(ROOT / "contracts" / "src"), str(ROOT / "src")]
from recipe_tooling.refresh_upstream.cli import main

if __name__ == "__main__":
    raise SystemExit(main())
