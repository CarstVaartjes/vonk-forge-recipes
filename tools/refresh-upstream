# HTTP with conditional requests
# ---------------------------------------------------------------------------


class NotFound(RuntimeError):
    pass


class AccessRestricted(RuntimeError):
    """An anonymous provider request requires access the catalog does not bind."""


class Http:
    """GET JSON with an ETag cache: a 304 answer costs no API quota."""

    def __init__(
        self,
        *,
        github_token: str | None,
        hf_token: str | None,
        cache_path: Path | None,
    ) -> None:
        self.tokens = {"github": github_token, "huggingface": hf_token}
        self.cache_path = cache_path
        self.lock = threading.Lock()
        self.memo: dict[str, object] = {}
        self.requests = 0
        self.not_modified = 0
        self.cache: dict[str, dict[str, Any]] = {}
        if cache_path and cache_path.is_file():
            try:
                self.cache = json.loads(cache_path.read_text(encoding="utf-8"))
            except (OSError, json.JSONDecodeError):
                self.cache = {}

    def save(self) -> None:
        if self.cache_path is None:
            return
        self.cache_path.parent.mkdir(parents=True, exist_ok=True)
        with self.lock:
            self.cache_path.write_text(json.dumps(self.cache), encoding="utf-8")

    def json(self, url: str, provider: str, *, anonymous: bool = False) -> Any:
        cache_key = f"{url}#anonymous" if anonymous else url
        with self.lock:
            if cache_key in self.memo:
                return self.memo[cache_key]
            cached = self.cache.get(cache_key)
        headers = {
            "Accept": "application/vnd.github+json"
            if provider == "github"
            else "application/json",
            "User-Agent": "vonk-forge-refresh-upstream/1",
        }
        token = None if anonymous else self.tokens.get(provider)
        if token:
            headers["Authorization"] = f"Bearer {token}"
        if cached:
            headers["If-None-Match"] = cached["etag"]
        request = urllib.request.Request(url, headers=headers)
        last: Exception | None = None
        for attempt in range(3):
            try:
                with urllib.request.urlopen(request, timeout=30) as response:
                    payload = response.read()
                    etag = response.headers.get("ETag")
                with self.lock:
                    self.requests += 1
                value = json.loads(payload)
                if etag and len(payload) < 2_000_000:
                    with self.lock:
                        self.cache[cache_key] = {"etag": etag, "body": value}
                break
            except urllib.error.HTTPError as error:
                if anonymous and error.code in {401, 403}:
                    raise AccessRestricted(
                        f"anonymous provider request returned HTTP {error.code}"
                    ) from error
                if error.code == 304 and cached:
                    with self.lock:
                        self.requests += 1
                        self.not_modified += 1
                    value = cached["body"]
                    break
                if error.code == 404:
                    raise NotFound(url) from error
                last = error
                if error.code not in {429, 500, 502, 503, 504}:
                    raise RuntimeError(f"HTTP {error.code} for {url}") from error
            except (urllib.error.URLError, TimeoutError, json.JSONDecodeError) as error:
                last = error
        else:
            raise RuntimeError(f"request failed for {url}: {last}")
        with self.lock:
            self.memo[cache_key] = value
        return value

    def github(self, path: str) -> Any:
        return self.json(f"https://api.github.com/{path}", "github")


# ---------------------------------------------------------------------------
# The pinning rule
# ---------------------------------------------------------------------------


@dataclass(frozen=True, slots=True)
class Target:
    """What the pinning rule selects for one upstream repository."""

    provider: str
    repo: str
    sha: str
    date: str
    ref: str | None  # tag for a published version, None when following the head
    version: str | None  # upstream's version spelling (no leading "v")
    url: str
    notes: str | None = None
    access_status: str | None = None


def pick_version_tag(tags: Iterable[dict[str, Any]]) -> dict[str, Any] | None:
    """The highest plain version tag (v1.2.3); pre-release spellings are not versions."""
    best: tuple[tuple[int, ...], dict[str, Any]] | None = None
    for tag in tags:
        match = VERSION_TAG.match(str(tag.get("name", "")))
        if match is None:
            continue
        key = tuple(int(part) for part in match.group(1).split("."))
        if best is None or key > best[0]:
            best = (key, tag)
    return None if best is None else best[1]


def _date(value: str | None) -> str:
    return (value or "")[:10]


def resolve_github(http: Http, repo: str) -> Target:
    tag: str | None = None
    notes: str | None = None
    released: str | None = None
    try:
        release = http.github(f"repos/{repo}/releases/latest")
        tag = release.get("tag_name")
        notes = release.get("body")
        released = release.get("published_at")
    except NotFound:
        found = pick_version_tag(http.github(f"repos/{repo}/tags?per_page=100"))
        tag = None if found is None else found["name"]
    ref = tag or "HEAD"
    commit = http.github(f"repos/{repo}/commits/{quote(ref, safe='')}")
    sha = commit["sha"]
    if not SHA.match(sha):
        raise RuntimeError(f"{repo}: provider returned a non-Git revision")
    version = tag.removeprefix("v") if tag else None
    return Target(
        provider="github",
        repo=repo,
        sha=sha,
        date=_date(released or commit["commit"]["committer"]["date"]),
        ref=tag,
        version=version,
        url=commit["html_url"],
        notes=notes,
    )


def resolve_huggingface(http: Http, repo: str) -> Target:
    document = http.json(
        f"https://huggingface.co/api/models/{quote(repo, safe='/')}",
        "huggingface",
        anonymous=True,
    )
    sha = document["sha"]
    if not SHA.match(sha):
        raise RuntimeError(f"{repo}: provider returned a non-Git revision")
    gated = document.get("gated")
    if document.get("disabled") is True:
        access_status = "disabled"
    elif document.get("private") is True:
        access_status = "private"
    elif gated not in (None, False, "false", ""):
        access_status = "gated"
    elif document.get("private") is False and gated in (None, False, "false", ""):
        access_status = "public"
    else:
        access_status = "unknown"
    return Target(
        provider="huggingface",
        repo=repo,
        sha=sha,
        date=_date(document.get("lastModified")),
        ref=None,
        version=None,
        url=f"https://huggingface.co/{repo}/tree/{sha}",
        access_status=access_status,
    )


def resolve(http: Http, provider: str, repo: str) -> Target:
    if provider == "github":
        return resolve_github(http, repo)
    return resolve_huggingface(http, repo)


