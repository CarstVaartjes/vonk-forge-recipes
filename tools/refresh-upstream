CHAIN_MAX_RUNS = 4
# A model revision that resizes the disk envelope by more than this needs a human.
MATERIAL_ENVELOPE_PERCENT = 1
MAX_BODY = 60000
VERSION_TAG = re.compile(r"^v?(\d+(?:\.\d+)*)$")
OWN_VERSION = re.compile(r"^(\d+)\.(\d+)\.(\d+)$")

# Files whose change a script cannot judge: launch scripts, images, configuration,
# dependency lists and patches. READMEs, docs and licence texts are not judged: a recipe
# carries its own launch commands. Everything else in an upstream repository is not mirrored by a
# recipe, unless an adapter vendors it (that is checked byte for byte separately).
HARMLESS_DIRS = {".github", "docs", "doc", "tests", "test", "assets", "images", "img"}
BLOCKING_SUFFIXES = {
    ".sh",
    ".bash",
    ".service",
    ".env",
    ".ini",
    ".cfg",
    ".conf",
    ".toml",
    ".yaml",
    ".yml",
    ".json",
    ".patch",
    ".diff",
    ".dockerfile",
    ".jinja",
}
BLOCKING_NAMES = re.compile(
    r"^(dockerfile.*|docker-compose.*|compose.*|makefile|"
    r"(requirements|constraints).*\.txt)$",
    re.IGNORECASE,
)
LAUNCH_SCRIPT = re.compile(
    r"^(launch|serve|server|run|start|entry|entrypoint|wrapper|deploy|vllm|sglang)"
    r"[-_a-z0-9]*\.py$",
    re.IGNORECASE,
)
LOCK_FILES = {"package-lock.json", "composer.lock", "tsconfig.json"}


def is_blocking(path: str) -> bool:
    """Whether a changed upstream path can alter what a recipe launches."""
    pure = PurePosixPath(path)
    if pure.parts and pure.parts[0].lower() in HARMLESS_DIRS:
        return False
    name = pure.name
    if name in LOCK_FILES:
        return False
    return bool(
        pure.suffix.lower() in BLOCKING_SUFFIXES
        or BLOCKING_NAMES.match(name)
        or LAUNCH_SCRIPT.match(name)
    )


# ---------------------------------------------------------------------------
# HTTP with conditional requests
# ---------------------------------------------------------------------------


class NotFound(RuntimeError):
    pass


class AccessRestricted(RuntimeError):
    """An anonymous provider request requires access the catalog does not bind."""


class Http:
    """GET JSON with an ETag cache: a 304 answer costs no API quota."""

    def __init__(
        self,
        *,
        github_token: str | None,
        hf_token: str | None,
        cache_path: Path | None,
    ) -> None:
        self.tokens = {"github": github_token, "huggingface": hf_token}
        self.cache_path = cache_path
        self.lock = threading.Lock()
        self.memo: dict[str, object] = {}
        self.requests = 0
        self.not_modified = 0
        self.cache: dict[str, dict[str, Any]] = {}
        if cache_path and cache_path.is_file():
            try:
                self.cache = json.loads(cache_path.read_text(encoding="utf-8"))
            except (OSError, json.JSONDecodeError):
                self.cache = {}

    def save(self) -> None:
        if self.cache_path is None:
            return
        self.cache_path.parent.mkdir(parents=True, exist_ok=True)
        with self.lock:
            self.cache_path.write_text(json.dumps(self.cache), encoding="utf-8")

    def json(self, url: str, provider: str, *, anonymous: bool = False) -> Any:
        cache_key = f"{url}#anonymous" if anonymous else url
        with self.lock:
            if cache_key in self.memo:
                return self.memo[cache_key]
            cached = self.cache.get(cache_key)
        headers = {
            "Accept": "application/vnd.github+json"
            if provider == "github"
            else "application/json",
            "User-Agent": "vonk-forge-refresh-upstream/1",
        }
        token = None if anonymous else self.tokens.get(provider)
        if token:
            headers["Authorization"] = f"Bearer {token}"
        if cached:
            headers["If-None-Match"] = cached["etag"]
        request = urllib.request.Request(url, headers=headers)
        last: Exception | None = None
        for attempt in range(3):
            try:
                with urllib.request.urlopen(request, timeout=30) as response:
                    payload = response.read()
                    etag = response.headers.get("ETag")
                with self.lock:
                    self.requests += 1
                value = json.loads(payload)
                if etag and len(payload) < 2_000_000:
                    with self.lock:
                        self.cache[cache_key] = {"etag": etag, "body": value}
                break
            except urllib.error.HTTPError as error:
                if anonymous and error.code in {401, 403}:
                    raise AccessRestricted(
                        f"anonymous provider request returned HTTP {error.code}"
                    ) from error
                if error.code == 304 and cached:
                    with self.lock:
                        self.requests += 1
                        self.not_modified += 1
                    value = cached["body"]
                    break
                if error.code == 404:
                    raise NotFound(url) from error
                last = error
                if error.code not in {429, 500, 502, 503, 504}:
                    raise RuntimeError(f"HTTP {error.code} for {url}") from error
            except (urllib.error.URLError, TimeoutError, json.JSONDecodeError) as error:
                last = error
        else:
            raise RuntimeError(f"request failed for {url}: {last}")
        with self.lock:
            self.memo[cache_key] = value
        return value

    def github(self, path: str) -> Any:
        return self.json(f"https://api.github.com/{path}", "github")


def kit_upstream(http: Http) -> Any:
    """Where a kit's declared dependencies are resolved: GitHub, Hugging Face, registries."""
    return kit_pins.Upstream(
        kit_pins.GitHub(http.github),
        kit_pins.HuggingFace(
            lambda path: http.json(
                f"https://huggingface.co/api/{path}", "huggingface", anonymous=True
            )
        ),
        kit_pins.Registry(kit_pins.fetch),
    )


# ---------------------------------------------------------------------------
# The pinning rule
# ---------------------------------------------------------------------------


@dataclass(frozen=True, slots=True)
class Target:
    """What the pinning rule selects for one upstream repository."""

    provider: str
    repo: str
    sha: str
    date: str
    ref: str | None  # tag for a published version, None when following the head
    version: str | None  # upstream's version spelling (no leading "v")
    url: str
    notes: str | None = None
    access_status: str | None = None
    branch: str | None = None  # non-default branch the pin follows, when it does
    committed_at: str | None = None  # the commit's own timestamp (ISO 8601), when known


def pick_version_tag(tags: Iterable[dict[str, Any]]) -> dict[str, Any] | None:
    """The highest plain version tag (v1.2.3); pre-release spellings are not versions."""
    best: tuple[tuple[int, ...], dict[str, Any]] | None = None
    for tag in tags:
        match = VERSION_TAG.match(str(tag.get("name", "")))
        if match is None:
            continue
        key = tuple(int(part) for part in match.group(1).split("."))
        if best is None or key > best[0]:
            best = (key, tag)
    return None if best is None else best[1]


def _date(value: str | None) -> str:
    return (value or "")[:10]


def resolve_github(http: Http, repo: str) -> Target:
    tag: str | None = None
    notes: str | None = None
    released: str | None = None
    try:
        release = http.github(f"repos/{repo}/releases/latest")
        tag = release.get("tag_name")
        notes = release.get("body")
        released = release.get("published_at")
    except NotFound:
        found = pick_version_tag(http.github(f"repos/{repo}/tags?per_page=100"))
        tag = None if found is None else found["name"]
    ref = tag or "HEAD"
    commit = http.github(f"repos/{repo}/commits/{quote(ref, safe='')}")
    sha = commit["sha"]
    if not SHA.match(sha):
        raise RuntimeError(f"{repo}: provider returned a non-Git revision")
    version = tag.removeprefix("v") if tag else None
    return Target(
        provider="github",
        repo=repo,
        sha=sha,
        date=_date(released or commit["commit"]["committer"]["date"]),
        ref=tag,
        version=version,
        url=commit["html_url"],
        notes=notes,
        committed_at=commit["commit"]["committer"]["date"],
    )


def resolve_huggingface(http: Http, repo: str) -> Target:
    document = http.json(
        f"https://huggingface.co/api/models/{quote(repo, safe='/')}",
        "huggingface",
        anonymous=True,
    )
    sha = document["sha"]
    if not SHA.match(sha):
        raise RuntimeError(f"{repo}: provider returned a non-Git revision")
    gated = document.get("gated")
    if document.get("disabled") is True:
        access_status = "disabled"
    elif document.get("private") is True:
        access_status = "private"
    elif gated not in (None, False, "false", ""):
        access_status = "gated"
    elif document.get("private") is False and gated in (None, False, "false", ""):
        access_status = "public"
    else:
        access_status = "unknown"
    return Target(
        provider="huggingface",
        repo=repo,
        sha=sha,
        date=_date(document.get("lastModified")),
        ref=None,
        version=None,
        url=f"https://huggingface.co/{repo}/tree/{sha}",
        access_status=access_status,
    )


# ---------------------------------------------------------------------------
# Branch-following pins
# ---------------------------------------------------------------------------
#
# A pin that sits on a non-default branch (a per-bpw branch of an EXL3 repository whose
# ``main`` holds only a README, a feature branch of a Docker recipe) follows that branch,
# not the default branch. The branch is derived from the pin itself: the branch whose head
# is the pinned commit, or whose history contains it when the pin is not the head. A pin
# the default branch's history contains follows the default branch.

# Branches probed for containing a pin (GitHub compare, Hugging Face history).
BRANCH_SEARCH_LIMIT = 30
HF_HISTORY_PAGES = 3  # 50 commits a page


def _github_compare_status(http: Http, repo: str, old: str, new: str) -> str:
    document = http.github(f"repos/{repo}/compare/{old}...{new}?per_page=1")
    return str(document.get("status", "unknown"))


def follow_github_branch(http: Http, repo: str, current: str) -> Target | None:
    """The non-default branch a GitHub pin follows, as a Target at that branch's head."""
    try:
        default = http.github(f"repos/{repo}")["default_branch"]
        default_head = http.github(f"repos/{repo}/commits/{quote(default, safe='')}")
        if _github_compare_status(http, repo, current, default_head["sha"]) in {
            "ahead",
            "identical",
        }:
            return None  # the default branch's own history
        chosen: tuple[str, str] | None = None
        heads = http.github(f"repos/{repo}/commits/{current}/branches-where-head")
        names = sorted(b["name"] for b in heads if b["name"] != default)
        if names:
            chosen = (names[0], current)
        else:
            candidates: list[tuple[int, str, str]] = []
            for branch in http.github(f"repos/{repo}/branches?per_page=100"):
                name = branch["name"]
                if name == default:
                    continue
                if len(candidates) >= BRANCH_SEARCH_LIMIT:
                    break
                head = branch["commit"]["sha"]
                document = http.github(
                    f"repos/{repo}/compare/{current}...{head}?per_page=1"
                )
                if document.get("status") == "ahead":
                    candidates.append((int(document.get("ahead_by", 0)), name, head))
            if candidates:
                _, name, head = min(candidates)
                chosen = (name, head)
        if chosen is None:
            return None
        name, head = chosen
        commit = http.github(f"repos/{repo}/commits/{head}")
        target = Target(
            provider="github",
            repo=repo,
            sha=head,
            date=_date(commit["commit"]["committer"]["date"]),
            ref=None,
            version=None,
            url=commit["html_url"],
            branch=name,
            committed_at=commit["commit"]["committer"]["date"],
        )
        return _prefer_branch_release(http, repo, target)
    except (NotFound, RuntimeError, KeyError, TypeError, AttributeError):
        return None


def _prefer_branch_release(http: Http, repo: str, target: Target) -> Target:
    """The newest published version tag inside the branch, else the branch head."""
    try:
        found = pick_version_tag(http.github(f"repos/{repo}/tags?per_page=100"))
        if found is None:
            return target
        tag_sha = found["commit"]["sha"]
        if tag_sha != target.sha and _github_compare_status(
            http, repo, tag_sha, target.sha
        ) not in {"ahead", "identical"}:
            return target  # the tag is not on this branch
        commit = http.github(f"repos/{repo}/commits/{tag_sha}")
        return Target(
            provider="github",
            repo=repo,
            sha=tag_sha,
            date=_date(commit["commit"]["committer"]["date"]),
            ref=found["name"],
            version=found["name"].removeprefix("v"),
            url=commit["html_url"],
            branch=target.branch,
            committed_at=commit["commit"]["committer"]["date"],
        )
    except (NotFound, RuntimeError, KeyError, TypeError):
        return target


def follow_huggingface_branch(
    http: Http, repo: str, current: str, default: Target
) -> Target | None:
    """The non-default branch a Hugging Face pin follows, as a Target at its head."""
    base = f"https://huggingface.co/api/models/{quote(repo, safe='/')}"

    def get(url: str) -> Any:
        return http.json(url, "huggingface", anonymous=True)

    def history(branch: str) -> list[dict[str, Any]]:
        commits: list[dict[str, Any]] = []
        for page in range(HF_HISTORY_PAGES):
            batch = get(f"{base}/commits/{quote(branch, safe='')}?p={page}")
            commits.extend(batch)
            if len(batch) < 50:
                break
        return commits

    try:
        branches = get(f"{base}/refs")["branches"]
        others = sorted(
            (b for b in branches if b["targetCommit"] != default.sha),
            key=lambda b: b["name"],
        )
        chosen: tuple[str, str, str] | None = None
        for branch in others:
            if branch["targetCommit"] == current:
                chosen = (branch["name"], current, default.date)
                break
        if chosen is None:
            main = next((b for b in branches if b["targetCommit"] == default.sha), None)
            if main is not None and any(
                c["id"] == current for c in history(main["name"])
            ):
                return None  # the default branch's own history
            found: list[tuple[str, str, str]] = []
            for branch in others[:BRANCH_SEARCH_LIMIT]:
                commits = history(branch["name"])
                if any(c["id"] == current for c in commits):
                    found.append(
                        (
                            branch["name"],
                            branch["targetCommit"],
                            _date(commits[0].get("date")),
                        )
                    )
            if len(found) != 1:
                return None  # none, or ambiguous: leave it to review
            chosen = found[0]
        name, head, date = chosen
        return Target(
            provider="huggingface",
            repo=repo,
            sha=head,
            date=date,
            ref=None,
            version=None,
            url=f"https://huggingface.co/{repo}/tree/{head}",
            access_status=default.access_status,
            branch=name,
        )
    except (NotFound, RuntimeError, KeyError, TypeError, AttributeError):
        return None


def resolve(http: Http, provider: str, repo: str) -> Target:
    if provider == "github":
        return resolve_github(http, repo)
    return resolve_huggingface(http, repo)


