#!/usr/bin/env python3
"""Fail when the catalog hierarchy in the Model displays is not one consistent tree.

The hierarchy is display only (never digested): a Model display's ``lineage``
names its Family (the product brand), Line and Model release, and
``display/families/<slug>.json`` holds each Family's title and its Lines' Model
releases, oldest first. Every lineage must resolve there and every listed release
must be named (``library_checks.validate_families``), every Model a recipe serves first
must have a lineage (helpers such as encoders and drafters have none), and no
Family or Line names a weight format: that belongs to the
Model's version and variant. The public catalog and the Controller group by
this tree, so a fragmented Family hides a brand behind near-duplicate names.
"""

from __future__ import annotations

import argparse
import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "contracts" / "src"))
from recipe_tooling.library_checks import validate_families
from recipe_tooling.qualification.documents import families, model_display, recipe
from vonk_forge_contracts.resolver import ContractResolutionError

ROOT = Path(__file__).resolve().parents[1]

# Weight formats, quantizers and packaging words that belong to a version or
# variant, never to a Family or Line.
FORMAT_TOKENS = {
    "awq",
    "bf16",
    "checkpoint",
    "checkpoints",
    "deployment",
    "deployments",
    "dflash",
    "dflash2",
    "eagle",
    "eagle3",
    "exl3",
    "fp4",
    "fp8",
    "fp16",
    "gguf",
    "gptq",
    "int4",
    "int8",
    "mlx",
    "modelopt",
    "mxfp8",
    "nvfp4",
    "quant",
    "quants",
    "quantized",
    "quantization",
    "quantizations",
    "w4a16",
}


def _tokens(value: str) -> set[str]:
    return {token for token in re.split(r"[^a-z0-9]+", value.lower()) if token}


def check(root: Path) -> list[str]:
    problems: list[str] = []
    displays = {
        path.stem: model_display(path.stem, root)
        for path in sorted((root / "display" / "models").glob("*.json"))
    }
    family_displays = families(root)
    try:
        validate_families(displays, family_displays)
    except ContractResolutionError as error:
        problems.append(str(error))
    for path in sorted((root / "recipes").glob("*.json")):
        primary = recipe(path.stem, root).models[0].model.slug
        display = displays.get(primary)
        if display is not None and display.lineage is None:
            problems.append(
                f"recipes/{path.name}: its first Model {primary} has no display "
                "lineage; a Model a recipe serves has a place in the hierarchy"
            )
    for family in family_displays.values():
        named = [("family", family.slug, family.title)] + [
            ("line", line.slug, line.title) for line in family.lines
        ]
        for level, slug, title in named:
            for field, value in (("slug", slug), ("title", title)):
                found = sorted(_tokens(value) & FORMAT_TOKENS)
                if found:
                    problems.append(
                        f"display/families/{family.slug}.json: {level} {field} "
                        f"{value!r} names a weight format or packaging "
                        f"({', '.join(found)}); that belongs to the version or variant"
                    )
    return problems


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", type=Path, default=ROOT)
    args = parser.parse_args(argv)
    problems = check(args.root)
    for problem in problems:
        print(problem, file=sys.stderr)
    if problems:
        print(f"check-model-families: {len(problems)} problem(s)", file=sys.stderr)
        return 1
    print("check-model-families: the catalog hierarchy is one consistent tree")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
