FROM nvcr.io/nvidia/cuda:13.4.1-runtime-ubuntu24.04@sha256:2eaf346843c93ae617a718818f4a804e2c46c0d97a85392212ec5b310ee57962

LABEL org.opencontainers.image.source="https://github.com/nv-tlabs/kimodo" \
      org.opencontainers.image.revision="e1c219c99b4b94ba48be1fb6a1cbc64ecee4c954" \
      org.opencontainers.image.licenses="Apache-2.0" \
      io.vonk.adapter="kimodo-soma" \
      io.vonk.agent-protocol.wheel-sha256="@protocol.sha256@"

# PYTHONPATH is a platform-owned name, so run.py puts /opt/vonk/kimodo on sys.path itself.
ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONUNBUFFERED=1

COPY requirements.lock /tmp/requirements.lock
COPY @protocol.wheel@ /tmp/@protocol.wheel@
# build-essential and python3-dev: Triton JIT needs a compiler and Python.h in every
# CUDA runtime image that pip-installs torch (tests/test_job_runtime_toolchain.py).
RUN apt-get update \
    && apt-get install --no-install-recommends --yes \
        build-essential \
        python3-dev \
        ca-certificates \
        python3 \
        python3-pip \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m pip install --break-system-packages --no-cache-dir \
        --require-hashes \
        --extra-index-url https://download.pytorch.org/whl/cu130 \
        --requirement /tmp/requirements.lock \
    && printf '%s  %s\n' @protocol.sha256@ \
        /tmp/@protocol.wheel@ | sha256sum --check --strict \
    && python3 -m pip install --break-system-packages --no-cache-dir --no-index --no-deps \
        /tmp/@protocol.wheel@ \
    && rm /tmp/requirements.lock /tmp/@protocol.wheel@

# The vendored package (the headless generation path and the SOMA skeleton assets; the
# demo, viewer and the x86-only MotionCorrection are not vendored). The weights are
# mounted by the recipe.
COPY kimodo /opt/vonk/kimodo/kimodo
COPY LICENSE NOTICE run.py /opt/vonk/source/

# Build-time import smoke (no GPU, no weights): the generation script and BVH export
# import, both SOMA skeletons load their vendored assets, the protocol model imports.
RUN PYTHONPATH=/opt/vonk/kimodo python3 -c "import kimodo.scripts.generate, bvhio, peft, SpatialTransform; from kimodo.skeleton import build_skeleton; build_skeleton(30); build_skeleton(77); from vonk_agent_protocol.job_inputs import RecipeJobInputManifest" \
    && install --directory --mode=0755 /opt/vonk/bin /inputs /outputs \
    && printf '%s\n' '#!/bin/sh' 'exec python3 /opt/vonk/source/run.py "$@"' > /opt/vonk/bin/pytorch-pipeline \
    && chmod 0755 /opt/vonk/bin/pytorch-pipeline \
    && useradd --uid 10001 --create-home --shell /usr/sbin/nologin vonk \
    && chown 10001:10001 /outputs

USER 10001:10001
ENTRYPOINT []
