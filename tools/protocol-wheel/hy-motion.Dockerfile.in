FROM nvcr.io/nvidia/cuda:13.4.1-runtime-ubuntu24.04@sha256:2eaf346843c93ae617a718818f4a804e2c46c0d97a85392212ec5b310ee57962

LABEL org.opencontainers.image.source="https://github.com/Tencent-Hunyuan/HY-Motion-1.0" \
      org.opencontainers.image.revision="c71ea6c694d8f221c742ff435d9447fa88f91707" \
      org.opencontainers.image.licenses="LicenseRef-Tencent-HY-Motion-1.0-Community" \
      io.vonk.adapter="hy-motion" \
      io.vonk.agent-protocol.wheel-sha256="@protocol.sha256@"

# PYTHONPATH is a platform-owned name, so run.py puts /opt/vonk/hy-motion on the generator's path itself.
ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONUNBUFFERED=1

COPY requirements.lock /tmp/requirements.lock
COPY @protocol.wheel@ /tmp/@protocol.wheel@
# build-essential and python3-dev: Triton JIT needs a compiler and Python.h in every
# CUDA runtime image that pip-installs torch (tests/recipes/test_job_runtime_toolchain.py).
# hostname: the creator's T2MRuntime runs `hostname -I` when it is constructed.
RUN apt-get update \
    && apt-get install --no-install-recommends --yes \
        build-essential \
        python3-dev \
        ca-certificates \
        curl \
        hostname \
        python3 \
        python3-pip \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m pip install --break-system-packages --no-cache-dir \
        --require-hashes \
        --extra-index-url https://download.pytorch.org/whl/cu130 \
        --requirement /tmp/requirements.lock \
    && printf '%s  %s\n' @protocol.sha256@ \
        /tmp/@protocol.wheel@ | sha256sum --check --strict \
    && python3 -m pip install --break-system-packages --no-cache-dir --no-index --no-deps \
        /tmp/@protocol.wheel@ \
    && rm /tmp/requirements.lock /tmp/@protocol.wheel@

# The creator's source at the pinned commit; only the hymotion package and the licence are used.
# The Git LFS data (statistics, skeleton and mesh templates) and the weights are mounted by the recipe.
RUN curl --fail --location --retry 5 \
        https://codeload.github.com/Tencent-Hunyuan/HY-Motion-1.0/tar.gz/c71ea6c694d8f221c742ff435d9447fa88f91707 \
        --output /tmp/hy-motion.tar.gz \
    && echo "0755fd5d6a3d66c87c4ec0d56cb5a9d3a6486d3bae12ccc01ee231e78e6c0dc6  /tmp/hy-motion.tar.gz" | sha256sum --check --strict \
    && mkdir /tmp/hy-motion-source \
    && tar --extract --gzip --file /tmp/hy-motion.tar.gz --strip-components=1 --directory /tmp/hy-motion-source \
    && install --directory --mode=0755 /opt/vonk/hy-motion \
    && cp -r /tmp/hy-motion-source/hymotion /tmp/hy-motion-source/License.txt /opt/vonk/hy-motion/ \
    && rm -rf /tmp/hy-motion.tar.gz /tmp/hy-motion-source

COPY run.py worker.py export_bvh.py joint_names.json /opt/vonk/source/

# Build-time import smoke (no GPU, no weights): the creator's runtime imports with the
# FBX SDK absent, the hostname binary it calls exists, the protocol model imports.
RUN PYTHONPATH=/opt/vonk/hy-motion python3 -c "import hymotion.utils.t2m_runtime; from vonk_agent_protocol.job_inputs import RecipeJobInputManifest" \
    && command -v hostname \
    && install --directory --mode=0755 /opt/vonk/bin /inputs /outputs \
    && printf '%s\n' '#!/bin/sh' 'exec python3 /opt/vonk/source/run.py "$@"' > /opt/vonk/bin/pytorch-pipeline \
    && chmod 0755 /opt/vonk/bin/pytorch-pipeline \
    && useradd --uid 10001 --create-home --shell /usr/sbin/nologin vonk \
    && chown 10001:10001 /outputs

USER 10001:10001
ENTRYPOINT []
