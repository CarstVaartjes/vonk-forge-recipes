#!/usr/bin/env -S uv run --no-project --python 3.14 --with-editable contracts python
"""Refuse a recipe the platform of a channel cannot execute.

Each channel's recipe-tools bundle carries ``platform-features.json``: the
discriminators that platform executes (serving check kinds, reasoning-effort
kinds, gateway API modes, interface adapters, Model source providers), read by
forge from the tables its Controller runs, plus its contracts major. This tool
checks every recipe in the library, with its API facts and the Models it
selects, against that one statement; there is no version table here.

Shown words (a Model's capabilities, labels) are not gated: the platform's
readers keep a word they do not know. A contracts major newer than the
platform's is refused too: a major is deployed consumer-first (see AGENTS.md).

The features file is an argument (CI extracts it from the verified bundle);
this tool runs no git and no network.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
from dataclasses import dataclass
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))

from recipe_tooling.qualification.documents import (
    has_recipe_api,
    model,
    recipe,
    recipe_api,
)
from vonk_forge_contracts import CONTRACT_MAJOR, ChatApi, RecipeApi, RecipeDefinition
from vonk_forge_contracts.api import ApiReasoningNone
from vonk_forge_contracts.model import GitHubLfsSource, GitHubReleaseSource

ROOT = Path(__file__).resolve().parents[1]

# The features-file key of each discriminator, and how a message names it.
SETS = {
    "serving_kinds": "serving kind",
    "effort_kinds": "reasoning effort",
    "api_modes": "API mode",
    "adapters": "adapter",
    "source_providers": "source provider",
}


@dataclass(frozen=True)
class PlatformFeatures:
    contract_major: int
    executed: dict[str, frozenset[str]]


def read_features(text: str) -> PlatformFeatures:
    """The platform's statement; a missing set or major fails, unknown keys are ignored."""

    document = json.loads(text)
    major = document["contract_major"]
    if not isinstance(major, int):
        raise TypeError("contract_major must be an integer")
    executed = {key: frozenset(document[key]) for key in SETS}
    return PlatformFeatures(contract_major=major, executed=executed)


def words_used(
    document: RecipeDefinition, providers: list[str], api: RecipeApi | None
) -> set[tuple[str, str]]:
    """Each executed discriminator the documents use, as ``(features key, word)``."""

    used = {
        ("serving_kinds", check.kind) for check in document.validation.serving.checks
    }
    used |= {("adapters", interface.adapter) for interface in document.interfaces}
    used |= {("source_providers", provider) for provider in providers}
    if api is not None:
        for block in [api.api, *(choice.api for choice in api.option_choices)]:
            used.add(("api_modes", block.mode))
            if isinstance(block, ChatApi) and not isinstance(
                block.reasoning, ApiReasoningNone
            ):
                effort = block.reasoning.effort
                if effort is not None:
                    used.add(("effort_kinds", effort.kind))
    return used


def source_provider(slug: str, root: Path) -> str:
    """The Model's source provider as the platform names it (no word: Hugging Face)."""

    source = model(slug, root).source
    if isinstance(source, GitHubReleaseSource | GitHubLfsSource):
        return source.provider
    return "huggingface"


def problems(root: Path, slugs: list[str], features: PlatformFeatures) -> list[str]:
    """One message per word a recipe uses that the platform does not execute."""

    found: list[str] = []
    for slug in slugs:
        document = recipe(slug, root)
        providers = [source_provider(m.model.slug, root) for m in document.models]
        api = recipe_api(slug, root) if has_recipe_api(slug, root) else None
        found += [
            f"{slug}: the platform does not execute {SETS[key]} {word}"
            for key, word in sorted(words_used(document, providers, api))
            if word not in features.executed[key]
        ]
    return found


def major_problem(contract_major: int, platform_major: int) -> str | None:
    """The error for a recipes contracts major the platform has not adopted.

    One-directional: a platform major ahead of this repo is the planned
    consumer-first window and never blocks.
    """

    if contract_major <= platform_major:
        return None
    return (
        f"contracts major {contract_major} is newer than the platform's "
        f"{platform_major}: pin this recipes commit in vonk-forge and release it first"
    )


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--platform-features",
        type=Path,
        required=True,
        help="platform-features.json from the channel's recipe-tools bundle",
    )
    parser.add_argument("--library-root", type=Path, default=ROOT)
    args = parser.parse_args(argv)
    features = read_features(args.platform_features.read_text(encoding="utf-8"))
    root = args.library_root
    slugs = sorted(p.stem for p in (root / "recipes").glob("*.json"))
    found = problems(root, slugs, features)
    found += [m for m in [major_problem(CONTRACT_MAJOR, features.contract_major)] if m]
    for item in found:
        print(f"::error::{item}" if "GITHUB_ACTIONS" in os.environ else item)
    print(
        f"Checked {len(slugs)} recipe(s) against the platform's executed features; "
        f"{len(found)} not executed."
    )
    return 1 if found else 0


if __name__ == "__main__":
    raise SystemExit(main())
