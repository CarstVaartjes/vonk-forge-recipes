      "released_at": "2026-09-05",
      "version": "1.0.0"
    },
    "runtime": {
      "arguments": [
        {
          "name": "unknown-option",
          "value": "value with spaces; $HOME/Δ and {json}"
        },
        {
          "name": "structured_option",
          "value": {
            "enabled": true,
            "items": [
              "a",
              3,
              0.25
            ]
          }
        }
      ],
      "engine": "vllm",
      "entrypoint": [
        "vllm",
        "serve",
        "/models"
      ],
      "environment": [],
      "lifecycle": {
        "stop_timeout_seconds": 30
      }
    },
    "settings": {
      "concurrency": {
        "change_effect": "restart",
        "value": 1
      },
      "context_tokens": {
        "change_effect": "restart",
        "value": 1024
      },
      "kind": "generation",
      "knobs": {}
    },
    "topology": {
      "name": "solo",
      "node_count": 1,
      "parallelism": {
        "backend": "local",
        "data": 1,
        "pipeline": 1,
        "tensor": 1
      },
      "roles": [
        {
          "count": 1,
          "endpoint_owner": true,
          "name": "entrypoint",
          "resources": {
            "disk": {
              "artifact_bytes": 1024,
              "image_bytes": 1000,
              "safety_margin_bytes": 1024,
              "working_bytes": 3072
            },
            "memory": {
              "peak_bytes": 80000000,
              "reserve_bytes": 1000000
            }
          }
        }
      ],
      "start_order": [
        "entrypoint"
      ]
    },
    "validation": {
      "serving": {
        "checks": [
          {
            "assertions": [
              "chat.nonempty",
              "chat.output-cap"
            ],
            "kind": "openai.vision",
            "name": "chat",
            "request": {
              "body": {
                "max_tokens": 16,
                "messages": [
                  {
                    "content": [
                      {
                        "text": "Describe this synthetic image.",
                        "type": "text"
                      },
                      {
                        "image_url": {
                          "url": "data:image/png;base64,iVBORw0KGgo="
                        },
                        "type": "image_url"
                      }
                    ],
                    "role": "user"
                  }
                ],
                "model": "$MODEL"
              },
              "method": "POST",
              "path": "/v1/chat/completions",
              "transport": "http"
            }
          }
        ],
        "interface": "openai"
      }
    }
