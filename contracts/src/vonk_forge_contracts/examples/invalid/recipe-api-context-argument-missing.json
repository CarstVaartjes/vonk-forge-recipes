  "recipe": {
    "execution": {
      "build": {
        "base_image": {
          "digest": "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
          "repository": "registry.example/vonk/base"
        },
        "context": {
          "path": "context.tar"
        },
        "dockerfile": "Dockerfile",
        "network": {
          "hosts": []
        },
        "patches": []
      }
    },
    "identity": {
      "publisher": "vonk-forge",
      "slug": "synthetic-tiny-build-options"
    },
    "interfaces": [
      {
        "adapter": "openai",
        "health_path": "/v1/models",
        "model_aliases": [
          "synthetic-tiny"
        ],
        "port": 8000
      }
    ],
    "kind": "recipe",
    "models": [
      {
        "files": [
          {
            "file_id": "weights",
            "id": "weights",
            "mount": {
              "target": "/models"
            },
            "roles": [
              "entrypoint"
            ]
          }
        ],
        "id": "primary",
        "model": {
          "content_sha256": "bd4f1dfa09cb263c59dc1b4d4ad6f01c9b685d9af696de5d6e4a419c35848623",
          "kind": "model",
          "publisher": "vonk-forge",
          "slug": "synthetic-tiny-fp16"
        }
      }
    ],
    "options": [
      {
        "choices": [
          {
            "args": [
              {
                "name": "language-model-only",
                "value": true
              }
            ],
            "default": true,
            "help": "The language model alone.",
            "label": "Text only",
            "value": "text-only"
          },
          {
            "args": [
              {
                "name": "language-model-only",
                "value": false
              },
              {
                "name": "limit-mm-per-prompt",
                "value": "{\"image\":4}"
              }
            ],
            "help": "Up to four images per prompt.",
            "label": "Images",
            "value": "images"
          }
        ],
        "help": "Serve text only, or accept images as well.",
        "label": "Images",
        "name": "vision"
      }
    ],
