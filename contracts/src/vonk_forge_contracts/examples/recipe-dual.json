    ]
  },
  "settings": {
    "kind": "generation",
    "context_tokens": {
      "value": 1024,
      "change_effect": "restart"
    },
    "concurrency": {
      "value": 1,
      "change_effect": "restart"
    },
    "knobs": {}
  }
