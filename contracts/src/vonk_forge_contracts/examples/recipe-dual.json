{
  "schema_version": 2,
  "kind": "recipe",
  "identity": {
    "publisher": "vonk-forge",
    "slug": "synthetic-tiny-build-dual"
  },
  "metadata": {
    "title": "Synthetic Tiny image",
    "description": "Synthetic image execution example.",
    "tags": [
      "synthetic",
      "text"
    ]
  },
  "models": [
    {
      "id": "primary",
      "model": {
        "kind": "model",
        "publisher": "vonk-forge",
        "slug": "synthetic-tiny-fp16",
        "content_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "files": [
        {
          "id": "weights",
          "file_id": "weights",
          "roles": [
            "entrypoint",
            "worker"
          ],
          "mount": {
            "target": "/models",
            "read_only": true
          }
        }
      ]
    }
  ],
  "execution": {
    "mode": "build",
    "build": {
      "base_image": {
        "repository": "registry.example/vonk/base",
        "digest": "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
        "platform": "linux/arm64"
      },
      "context": {
        "path": "context.tar"
      },
      "dockerfile": "Dockerfile",
      "patches": [],
      "target": null,
      "arguments": [],
      "network": {
        "mode": "none",
        "hosts": []
      }
    }
  },
  "runtime": {
    "engine": "vllm",
    "entrypoint": [
      "vllm",
      "serve",
      "/models"
    ],
    "arguments": [],
    "environment": [],
    "lifecycle": {
      "pre_start": [],
      "post_stop": [],
      "stop_timeout_seconds": 30
    }
  },
  "topology": {
    "name": "solo",
    "mode": "single",
    "node_count": 2,
    "roles": [
      {
        "name": "entrypoint",
        "count": 1,
        "endpoint_owner": true,
        "resources": {
          "memory": {
            "kind": "unified",
            "startup_peak_bytes": 80000000,
            "steady_state_bytes": 70000000,
            "runtime_growth_bytes": 1000000,
            "system_reserve_bytes": 1000000
          },
          "disk": {
            "image_bytes": 1000,
            "artifact_bytes": 1024,
            "staging_bytes": 2048,
            "cache_bytes": 1024,
            "rollback_bytes": 0,
            "safety_margin_bytes": 1024
          }
        }
      },
      {
        "name": "worker",
        "count": 1,
        "endpoint_owner": false,
        "resources": {
          "memory": {
            "kind": "unified",
            "startup_peak_bytes": 80000000,
            "steady_state_bytes": 70000000,
            "runtime_growth_bytes": 1000000,
            "system_reserve_bytes": 1000000
          },
          "disk": {
            "image_bytes": 1000,
            "artifact_bytes": 1024,
            "staging_bytes": 2048,
            "cache_bytes": 1024,
            "rollback_bytes": 0,
            "safety_margin_bytes": 1024
          }
        }
      }
    ],
    "parallelism": {
      "world_size": 2,
      "tensor": 2,
      "pipeline": 1,
      "data": 1,
      "backend": "nccl"
    },
    "fabric": {
      "connectivity": "connected",
      "minimum_bandwidth_mbps": 1000
    },
    "start_order": [
      "worker",
      "entrypoint"
    ],
    "stop_order": [
      "entrypoint",
      "worker"
    ]
  },
  "interfaces": [
    {
      "adapter": "openai",
      "port": 8000,
      "model_aliases": [
        "synthetic-tiny"
      ],
      "health_path": "/v1/models"
    }
  ],
  "validation": {
    "benchmarks": [],
    "serving": {
      "interface": "openai",
      "checks": [
        {
          "name": "chat",
          "kind": "openai.chat",
          "request": {
            "transport": "http",
            "method": "POST",
            "path": "/v1/chat/completions",
            "body": {
              "model": "$MODEL",
              "messages": [
                {
                  "role": "user",
                  "content": "Say hello."
                }
              ],
              "max_tokens": 16
            }
          },
          "assertions": [
            "chat.nonempty",
            "chat.output-cap"
          ]
        }
      ]
    }
