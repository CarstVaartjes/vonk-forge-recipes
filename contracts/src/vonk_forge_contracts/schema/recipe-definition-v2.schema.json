      },
      "required": [
        "mode",
        "image"
      ],
      "title": "RecipeImageExecution",
      "type": "object"
    },
    "RecipeInputSlot": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Label",
          "type": "string"
