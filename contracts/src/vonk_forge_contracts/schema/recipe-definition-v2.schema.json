      "required": [
        "rank_loss",
        "recovery"
      ],
      "title": "RecipeFailurePolicy",
      "type": "object"
    },
    "RecipeGenerationSettings": {
      "additionalProperties": false,
      "properties": {
        "knobs": {
          "maxProperties": 64,
          "patternProperties": {
            "^[a-z][a-z0-9_-]*$": {
              "$ref": "#/$defs/RecipeSetting"
