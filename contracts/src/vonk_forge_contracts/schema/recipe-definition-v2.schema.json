      "additionalProperties": false,
      "properties": {
        "base_image": {
          "$ref": "#/$defs/RecipeImage"
        },
        "context": {
          "$ref": "#/$defs/BuildContext"
        },
        "dockerfile": {
          "maxLength": 256,
          "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9._-]*|\\.[A-Za-z0-9_-][A-Za-z0-9._-]*)(?:/(?:[A-Za-z0-9_-][A-Za-z0-9._-]*|\\.[A-Za-z0-9_-][A-Za-z0-9._-]*))*$",
          "title": "Dockerfile",
          "type": "string"
        },
        "patches": {
          "items": {
            "$ref": "#/$defs/BuildPatch"
          },
          "maxItems": 64,
          "title": "Patches",
          "type": "array"
        },
        "target": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "arguments": {
          "items": {
            "$ref": "#/$defs/BuildArgument"
          },
          "maxItems": 64,
          "title": "Arguments",
          "type": "array"
        },
        "network": {
          "$ref": "#/$defs/BuildNetwork"
        }
      },
      "required": [
        "base_image",
        "context",
        "dockerfile",
        "patches",
        "arguments",
        "network"
      ],
      "title": "RecipeBuildDefinition",
      "type": "object"
    },
    "RecipeBuildExecution": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "build",
          "title": "Mode",
          "type": "string"
        },
        "build": {
          "$ref": "#/$defs/RecipeBuildDefinition"
        }
      },
      "required": [
        "mode",
        "build"
      ],
      "title": "RecipeBuildExecution",
      "type": "object"
    },
    "RecipeDiskResources": {
      "additionalProperties": false,
      "properties": {
        "image_bytes": {
          "minimum": 0,
          "title": "Image Bytes",
          "type": "integer"
        },
        "artifact_bytes": {
          "minimum": 0,
          "title": "Artifact Bytes",
          "type": "integer"
        },
        "staging_bytes": {
          "minimum": 0,
          "title": "Staging Bytes",
          "type": "integer"
        },
        "cache_bytes": {
          "minimum": 0,
          "title": "Cache Bytes",
          "type": "integer"
        },
        "rollback_bytes": {
          "minimum": 0,
          "title": "Rollback Bytes",
          "type": "integer"
        },
        "safety_margin_bytes": {
          "minimum": 0,
          "title": "Safety Margin Bytes",
          "type": "integer"
        }
      },
      "required": [
        "image_bytes",
        "artifact_bytes",
        "staging_bytes",
        "cache_bytes",
        "rollback_bytes",
        "safety_margin_bytes"
      ],
