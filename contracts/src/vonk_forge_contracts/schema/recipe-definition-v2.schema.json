        "context_tokens": {
          "$ref": "#/$defs/RecipeIntegerSetting"
        },
        "concurrency": {
          "$ref": "#/$defs/RecipeIntegerSetting"
        },
        "max_batch_tokens": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecipeIntegerSetting"
            },
            {
              "type": "null"
