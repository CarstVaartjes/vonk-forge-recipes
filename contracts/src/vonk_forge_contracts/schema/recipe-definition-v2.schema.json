          "maxItems": 16,
          "minItems": 1,
          "title": "Media Types",
          "type": "array"
        },
        "extensions": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Extensions",
          "type": "array"
        },
        "min_files": {
          "maximum": 32,
          "minimum": 0,
          "title": "Min Files",
          "type": "integer"
        },
        "max_files": {
          "maximum": 32,
          "minimum": 1,
          "title": "Max Files",
          "type": "integer"
        },
        "max_file_bytes": {
          "maximum": 536870912,
          "minimum": 1,
          "title": "Max File Bytes",
          "type": "integer"
