        "framework": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Framework",
          "type": "string"
        },
        "configuration": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Configuration",
          "type": "object"
        }
      },
      "required": [
        "name",
        "framework",
        "configuration"
