        "slug": {
          "maxLength": 64,
          "minLength": 2,
          "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
          "title": "Slug",
          "type": "string"
        },
        "content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Sha256",
          "type": "string"
