        "path": {
          "maxLength": 256,
          "pattern": "^/(?:[A-Za-z0-9_-][A-Za-z0-9._-]*|\\.[A-Za-z0-9_-][A-Za-z0-9._-]*)(?:/(?:[A-Za-z0-9_-][A-Za-z0-9._-]*|\\.[A-Za-z0-9_-][A-Za-z0-9._-]*))*$",
          "title": "Path",
          "type": "string"
        },
        "body": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "maxProperties": 32,
              "minProperties": 1,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Body"
        }
      },
      "required": [
        "transport",
        "method",
        "path"
      ],
      "title": "RecipeHttpServingRequest",
      "type": "object"
    },
    "RecipeIdentity": {
      "additionalProperties": false,
      "properties": {
        "publisher": {
          "maxLength": 64,
          "minLength": 2,
          "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
          "title": "Publisher",
          "type": "string"
        },
        "slug": {
          "maxLength": 64,
          "minLength": 2,
          "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
          "title": "Slug",
          "type": "string"
        }
      },
      "required": [
        "publisher",
        "slug"
      ],
      "title": "RecipeIdentity",
      "type": "object"
    },
    "RecipeImage": {
      "additionalProperties": false,
      "properties": {
        "repository": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._/-]*$",
          "title": "Repository",
          "type": "string"
        },
        "digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "platform": {
          "const": "linux/arm64",
          "title": "Platform",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "digest",
        "platform"
      ],
