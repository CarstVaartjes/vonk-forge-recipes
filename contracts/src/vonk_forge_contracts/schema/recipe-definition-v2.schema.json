      "type": "object"
    },
    "RecipeEmbeddingSettings": {
      "additionalProperties": false,
      "properties": {
        "knobs": {
          "maxProperties": 64,
          "patternProperties": {
            "^[a-z][a-z0-9_-]*$": {
