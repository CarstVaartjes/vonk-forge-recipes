        "hosts": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Hosts",
          "type": "array"
        }
      },
      "required": [
        "mode",
        "hosts"
      ],
      "title": "BuildNetwork",
      "type": "object"
    },
    "BuildPatch": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 256,
          "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9._-]*|\\.[A-Za-z0-9_-][A-Za-z0-9._-]*)(?:/(?:[A-Za-z0-9_-][A-Za-z0-9._-]*|\\.[A-Za-z0-9_-][A-Za-z0-9._-]*))*$",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
