            "image-job",
            "audio-job",
            "video-job",
            "mesh-job",
            "artifact-job"
          ],
          "title": "Adapter",
          "type": "string"
        },
        "path": {
          "const": "/outputs",
          "title": "Path",
          "type": "string"
        },
        "input": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecipeJobInput"
