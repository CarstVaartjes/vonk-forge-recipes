  "options": [
    {
      "choices": [
        {
          "default": true,
          "help": "Open a think block by default (TensorFold default).",
          "label": "Think first",
          "value": "thinking"
        },
        {
          "args": [
            {
              "name": "no-thinking",
              "value": true
            }
          ],
          "help": "Answer without a think block unless a request asks for one (--no-thinking).",
          "label": "Answer directly",
          "value": "direct"
        }
      ],
      "help": "Whether the chat template opens a think block by default (TensorFold's default is on). A request can still set chat_template_kwargs.enable_thinking; reasoning comes back in reasoning_content. Upstream lists --no-thinking as a serve flag.",
      "label": "Thinking",
      "name": "thinking"
    },
    {
      "choices": [
        {
          "default": true,
          "help": "TensorFold's CUDA default: at most 6 drafts a round, a chain stops under 30 percent confidence.",
          "label": "MTP, up to 6 drafts",
          "value": "mtp-6"
        },
        {
          "args": [
            {
              "name": "mtp-drafts",
              "value": 4
            }
          ],
          "help": "--mtp-drafts 4 (upstream suggests comparing it; no result published).",
          "label": "MTP, up to 4 drafts",
          "value": "mtp-4"
        },
        {
          "args": [
            {
              "name": "no-drafts",
              "value": true
            }
          ],
          "help": "Serial one-token-at-a-time reference decoding (--no-drafts); same output, slower.",
          "label": "No drafting",
          "value": "serial"
        }
      ],
      "help": "MTP drafts are verified against the model's own samples, so outputs are unchanged by drafting (upstream claim). Upstream suggests comparing --mtp-drafts 4 with the default of 6.",
      "label": "MTP drafting",
      "name": "drafting"
    },
    {
      "choices": [
        {
          "default": true,
          "help": "Tables memory-mapped and held in the page cache (taussoe default).",
          "label": "Page cache",
          "value": "page-cache"
        },
        {
          "args": [
            {
              "name": "ple-on-ssd",
              "value": true
            }
          ],
          "help": "--ple-on-ssd: tables stay on disk, about 40 GiB less peak memory, keep the model on NVMe.",
          "label": "On SSD",
          "value": "ssd"
        }
      ],
      "help": "The checkpoint carries 32 GB of hashed n-gram tables. Upstream keeps them memory-mapped in the page cache, which is tight beside 80 GB of weights on one Spark: if the kernel evicts them every token waits about 8 ms on the disk. --ple-on-ssd reads them from disk explicitly instead (MiaAI-Lab's single-Spark kit uses it; upstream reports about 40 GiB less peak for a few percent of decode speed, an upstream claim).",
      "label": "N-gram tables",
      "name": "ngram_tables"
    }
  ],
