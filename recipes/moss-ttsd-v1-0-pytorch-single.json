      "adapter": "audio-job",
      "input": {
        "max_bytes": 33640448,
        "media_types": [
          "audio/wav",
          "text/plain"
        ],
        "required": true,
        "slots": [
          {
            "description": "UTF-8 dialogue with a speaker tag before each turn, [S1] to [S5], for example \"[S1] Welcome back. [S2] Thanks for having me.\" Up to about ten minutes of audio per job.",
            "extensions": [
              ".txt"
            ],
            "id": "script",
            "label": "Dialogue script",
            "max_file_bytes": 65536,
            "max_files": 1,
            "max_total_bytes": 65536,
            "media_types": [
              "text/plain"
            ],
            "min_files": 1
          },
          {
            "description": "Optional WAV clips of the voices to clone, 3 to 10 seconds each, one per speaker. Files are taken in file-name order: the first clones [S1], the second [S2], and so on (name them 1-host.wav, 2-guest.wav). Each needs its transcript.",
            "extensions": [
              ".wav"
            ],
            "id": "reference_audio",
            "label": "Reference clips",
            "max_file_bytes": 16777216,
            "max_files": 5,
            "max_total_bytes": 33554432,
            "media_types": [
              "audio/wav"
            ],
            "min_files": 0
          },
          {
            "description": "UTF-8 transcript of each reference clip, one file per clip in the same file-name order (1-host.txt, 2-guest.txt). A missing [Sk] tag is added.",
            "extensions": [
              ".txt"
            ],
            "id": "reference_text",
            "label": "Reference transcripts",
            "max_file_bytes": 4096,
            "max_files": 5,
            "max_total_bytes": 20480,
            "media_types": [
              "text/plain"
            ],
            "min_files": 0
          }
        ]
      },
      "output": {
        "max_total_bytes": 33554432,
        "slots": [
          {
            "description": "Mono PCM16 WAV at the model's native 24 kHz.",
            "extensions": [
              ".wav"
            ],
            "id": "speech",
            "label": "Dialogue audio",
            "max_file_bytes": 33554432,
            "max_files": 1,
            "max_total_bytes": 33554432,
            "media_types": [
              "audio/wav"
            ],
            "min_files": 1
          }
        ]
      }
    }
  ],
