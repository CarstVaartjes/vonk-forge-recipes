  "options": [
    {
      "choices": [
        {
          "default": true,
          "help": "b12x nvfp4 KV everywhere at memory utilization 0.93 (upstream lane A).",
          "label": "NVFP4 (default)",
          "value": "nvfp4"
        },
        {
          "args": [
            {
              "name": "kv-cache-dtype",
              "setting": null,
              "value": "fp8_e4m3"
            },
            {
              "name": "attention-config",
              "setting": null,
              "value": "{\"indexer_kv_dtype\": \"fp8\"}"
            },
            {
              "name": "gpu-memory-utilization",
              "setting": null,
              "value": "0.9375"
            }
          ],
          "help": "b12x fp8 KV and fp8 indexer KV at memory utilization 0.9375 (upstream's fp8 EAGLE3 recipe). Set the context setting to 131072 to match it.",
          "label": "FP8",
          "value": "fp8"
        }
      ],
      "help": "Precision of the attention KV cache (target, indexer and draft). Upstream lane A uses nvfp4 (about 208K-token pool at 196K context, 36.6 tok/s JSON); its fp8 lane trades context for a simpler cache (131,072-token context, memory utilization 0.9375, indexer KV fp8).",
      "label": "KV cache precision",
      "name": "kv-cache"
    },
    {
      "choices": [
        {
          "default": true,
          "help": "Three drafted tokens per step (upstream default).",
          "label": "EAGLE-3, 3 tokens (default)",
          "value": "eagle3"
        },
        {
          "env": {
            "VONK_M3_SPEC": "off"
          },
          "help": "No speculative decoding (the drafter files are still mounted).",
          "label": "Off",
          "value": "off"
        }
      ],
      "help": "EAGLE-3 drafting with Sebesky's int4 drafter (3 draft tokens). Decode is weight-bandwidth bound, so upstream treats the drafter as the main throughput lever.",
      "label": "Speculative decoding",
      "name": "speculative"
    },
    {
      "choices": [
        {
          "default": true,
          "help": "thinking_mode adaptive (upstream default).",
          "label": "Adaptive (default)",
          "value": "adaptive"
        },
        {
          "args": [
            {
              "name": "default-chat-template-kwargs",
              "setting": null,
              "value": "{\"thinking_mode\":\"disabled\"}"
            }
          ],
          "help": "thinking_mode disabled by default; a request can still override it.",
          "label": "Disabled",
          "value": "disabled"
        }
      ],
      "help": "Server default for the chat template's thinking_mode. Upstream's recipes use adaptive; tonyd2wild measured thinking disabled as slightly faster on structured work (JSON 36.6 against 35.4 tok/s, code 31.8 against 29.2).",
      "label": "Thinking mode default",
      "name": "thinking"
    }
  ],
