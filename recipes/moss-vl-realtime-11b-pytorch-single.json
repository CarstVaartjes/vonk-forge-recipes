  "release": {
    "history": [
      {
        "changes": [
          {
            "details": "The exact BF16 weights, tokenizer, and configuration are unchanged. Upstream remote code now uses a 20 ms idle poll to keep in-process siblings responsive, drops invalid Unicode replacement characters from streamed chunks, and adds an NPU fallback while preserving the CUDA path. The adapter and source notices are bound to the verified revisions.",
            "kind": "compatibility",
            "references": [
              "https://huggingface.co/OpenMOSS-Team/MOSS-VL-Realtime/commit/25e81cb952d5f353a5690f2c1ea09a725815df80",
              "https://huggingface.co/OpenMOSS-Team/MOSS-VL-Realtime/compare/06b067617677661194cf837970fe3a10f1a0e56d...25e81cb952d5f353a5690f2c1ea09a725815df80",
              "https://github.com/OpenMOSS/MOSS-VL/compare/560f8872c362b47a52ddf20ff6a1f9c8ac10b706...288cc2dcd145e53a3baf9c11fc9be298cf1b30d7"
            ],
            "summary": "Refresh MOSS-VL-Realtime remote code to 25e81cb9."
          }
        ],
        "prior_recipe_content_sha256": "70b5a72ac7089b4e00ec6cd602532c36769d1577ea8d1b0cbd4bd1c27742537c",
        "released_at": "2026-09-05",
        "upgrade_effect": "rebuild",
        "version": "1.1.6"
      },
      {
        "changes": [
          {
            "details": null,
            "kind": "metadata",
            "references": [],
            "summary": "Bound this recipe to the evidence-backed model capability authority without changing runtime behavior."
          }
        ],
        "prior_recipe_content_sha256": null,
        "released_at": "2026-09-05",
        "upgrade_effect": "none",
        "version": "1.1.5"
      },
      {
        "changes": [
          {
            "details": "The recipe now carries every author-selectable Podman build input through the signed Controller-to-agent request, including a bounded capability list that defaults to empty. The agent drops all capabilities before adding only declared allowlisted entries inside Podman's rootless user namespace; host privilege, devices, mounts, sockets, security options, storage, cgroups, and generated image identity remain fixed platform policy.",
            "kind": "compatibility",
            "references": [],
            "summary": "Declared explicit resource limits and rootless capabilities in the portable recipe build contract."
          }
        ],
        "prior_recipe_content_sha256": "b68a4bef839f81fe69aa72f17ce8a22274ea5b93404764f4193c73b33a4ea5d2",
        "released_at": "2026-09-03",
        "upgrade_effect": "rebuild",
        "version": "1.1.4"
      },
      {
        "changes": [
          {
            "details": null,
            "kind": "metadata",
            "references": [],
            "summary": "Declared explicit recipe alignment metadata; no runtime behavior changed."
          }
        ],
        "prior_recipe_content_sha256": "bb386c79b263d9f6b95674db37e96f92434d039aa6c83f450a4ba41697b517a4",
        "released_at": "2026-09-01",
        "upgrade_effect": "none",
        "version": "1.1.3"
      },
      {
        "changes": [
          {
            "details": "Removed nvcr.io because digest-pinned base images are fetched through the separate verified base-image transfer and the build runs with pull disabled.",
            "kind": "security",
            "references": [],
            "summary": "Restricted public build egress to hosts used during Dockerfile execution."
          }
        ],
        "prior_recipe_content_sha256": "6b3f3802322e6edb47490705d96329ef0473a14d95d04e1af7d4da24d9f39bdf",
        "released_at": "2026-09-01",
        "upgrade_effect": "rebuild",
        "version": "1.1.2"
      },
      {
        "changes": [
          {
            "details": "The existing MP4 replay and JSONL transcript contract is unchanged; the catalog no longer implies that this recipe exposes the upstream WebSocket, camera, or screen-capture service.",
            "kind": "metadata",
            "references": [],
            "summary": "Clarified that this installable contract is a bounded session-replay job rather than an interactive streaming service."
          }
        ],
        "prior_recipe_content_sha256": "8e463bad03d9479b59f9d964af4692160559b29978f8dcc42cb1cfb1abed6102",
        "released_at": "2026-08-30",
        "upgrade_effect": "none",
        "version": "1.1.1"
      },
      {
        "changes": [
          {
            "details": "The adapter now discovers arbitrary controller-authenticated input names through /inputs/manifest.json, verifies every declared file and rejects unmanifested inputs. The contract reserves one bounded JSON session plus up to 31 bounded image frames within the platform's 32-file transport fence, and declares the MP4 replay and JSONL transcript as typed outputs.",
            "kind": "runtime",
            "references": [],
            "summary": "Added typed session and frame slots to the one-shot job contract."
          }
        ],
        "prior_recipe_content_sha256": "f67fcf526ca23c23fab7a74e15e92c0a841cf1065e38ac1d4c8909899583c8e5",
        "released_at": "2026-08-28",
        "upgrade_effect": "reprepare",
        "version": "1.1.0"
      },
      {
        "changes": [
          {
            "details": "The execution contract was already structurally complete; this release makes it available for explicit operator installation while physical build and Spark acceptance remain separate.",
            "kind": "metadata",
            "references": [],
            "summary": "Declared the complete recipe contract installable without changing Candidate qualification."
          }
        ],
        "prior_recipe_content_sha256": "b420166f7afc86d705b1e7f8db0495720aceeae9bfea2611c624baf1611bdc59",
        "released_at": "2026-08-26",
        "upgrade_effect": "none",
        "version": "1.0.1"
      },
      {
        "changes": [
          {
            "details": "The signed adapter replays a bounded ordered session through OpenMOSS's native create_realtime_session API, preserves timestamped frames, interrupting prompts, silence and round-control tokens, and correction-capable later chunks in an authoritative JSONL transcript, accompanied by a replay MP4. The CUDA 13 ARM64 dependency closure is hash-locked and runtime networking is disabled.",
            "kind": "initial",
            "references": [
              "https://huggingface.co/OpenMOSS-Team/MOSS-VL-Realtime/tree/06b067617677661194cf837970fe3a10f1a0e56d",
              "https://github.com/OpenMOSS/MOSS-VL/tree/560f8872c362b47a52ddf20ff6a1f9c8ac10b706/realtime_inference"
            ],
            "summary": "Added the complete Pending single-Spark MOSS-VL-Realtime native session recipe."
          }
        ],
        "prior_recipe_content_sha256": "02df574f00940aa6f24c1db2cf5260d6065aaf1c986d871b314009c43fc4eced",
        "released_at": "2026-08-24",
        "upgrade_effect": "reprepare",
