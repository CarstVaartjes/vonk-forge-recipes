  "release": {
    "history": [
      {
        "changes": [
          {
            "details": null,
            "kind": "metadata",
            "references": [],
            "summary": "Bound this recipe to the evidence-backed model capability authority without changing runtime behavior."
          }
        ],
        "prior_recipe_content_sha256": null,
        "released_at": "2026-09-05",
        "upgrade_effect": "none",
        "version": "1.0.7"
      },
      {
        "changes": [
          {
            "details": "The recipe now carries every author-selectable Podman build input through the signed Controller-to-agent request, including a bounded capability list that defaults to empty. The agent drops all capabilities before adding only declared allowlisted entries inside Podman's rootless user namespace; host privilege, devices, mounts, sockets, security options, storage, cgroups, and generated image identity remain fixed platform policy.",
            "kind": "compatibility",
            "references": [],
            "summary": "Declared explicit resource limits and rootless capabilities in the portable recipe build contract."
          }
        ],
        "prior_recipe_content_sha256": "14ebf23f2807eb098e1dfca75a904fb3f787577c6117aeb460b7f0cf07453067",
        "released_at": "2026-09-03",
        "upgrade_effect": "rebuild",
        "version": "1.0.6"
      },
      {
        "changes": [
          {
            "details": null,
            "kind": "metadata",
            "references": [],
            "summary": "Declared explicit recipe alignment metadata; no runtime behavior changed."
          }
        ],
        "prior_recipe_content_sha256": "acacd18ff6b4cd87a620e508d7fa81b975e1654b764ee46a7f5bcca6c332d7ca",
        "released_at": "2026-09-01",
        "upgrade_effect": "none",
        "version": "1.0.5"
      },
      {
        "changes": [
          {
            "details": "The exact TP8 contract is unsupported on the current one- or two-Spark configuration. Half of the immutable 592,037,337,118-byte Inkling snapshot is already 296.0 GB per rank before KV cache and runtime memory, so no safe TP2 variant can fit. Inkling Small TP2 is physically verified upstream but its current Vonk envelope is 128 GB per node, 1.1 GB above the roughly 126.9 GB inventory; the TP8 contract remains installable for future hardware.",
            "kind": "compatibility",
            "references": [
              "https://github.com/sgl-project/sglang/issues/31359",
              "https://github.com/sgl-project/sglang/blob/a74222ef6e690f851e2e4ff1c0be7dc1357be313/docs_new/src/snippets/configs/thinkingmachines/inkling-small.jsx"
            ],
            "summary": "Recorded the exact TP2 checkpoint lower bound and the smaller-model admission gate."
          }
        ],
        "prior_recipe_content_sha256": "6407a0382f89762e27c282f11826de632496ceffd9f17b54a414047fb295c0be",
        "released_at": "2026-08-30",
        "upgrade_effect": "none",
        "version": "1.0.4"
      },
      {
        "changes": [
          {
            "details": "The eight-rank contract remains an executable Candidate for future hardware, without claiming physical DGX Spark evidence. Inkling Small NVFP4 dual is the deployable fleet alternative.",
            "kind": "metadata",
            "references": [],
            "summary": "Marked TP8 unavailable on the current two-Spark fleet and named the dual alternative."
          }
        ],
        "prior_recipe_content_sha256": "aa7c429e59a296a10bb2a77f1aec2cbf5b34fea6e7b95c5e2df3406b14fd829c",
        "released_at": "2026-08-28",
