  "options": [
    {
      "choices": [
        {
          "default": true,
          "help": "bf16 KV cache (upstream default).",
          "label": "bf16",
          "value": "bf16"
        },
        {
          "args": [
            {
              "name": "kv-dtype",
              "value": "int8"
            }
          ],
          "help": "int8 KV cache, 1.68x smaller than bf16; quality unmeasured.",
          "label": "int8",
          "value": "int8"
        },
        {
          "args": [
            {
              "name": "kv-dtype",
              "value": "int4"
            }
          ],
          "help": "int4 KV cache, 2.64x smaller than bf16; quality unmeasured.",
          "label": "int4",
          "value": "int4"
        }
      ],
      "help": "Precision of the per-stream KV cache (--kv-dtype). int8 and int4 store keys and values as codes with one fp16 scale per 32 values (ExLlamaV3's -cq 8 and -cq 4 scheme); upstream says a quantized cache changes the output, so replies differ from bf16's, while drafted output still equals serial output at the same dtype. A token costs 30,784 bytes in bf16, 18,304 in int8 and 11,648 in int4 (upstream figures).",
      "label": "KV cache precision",
      "name": "kv_dtype"
    },
    {
      "choices": [
        {
          "default": true,
          "help": "Open a think block by default (upstream default: --thinking).",
          "label": "Think first",
          "value": "thinking"
        },
        {
          "args": [
            {
              "name": "thinking",
              "value": false
            },
            {
              "name": "no-thinking",
              "value": true
            }
          ],
          "help": "Answer without a think block unless a request asks for one.",
          "label": "Answer directly",
          "value": "direct"
        }
      ],
      "help": "Whether the chat template opens a think block by default. A request can still set chat_template_kwargs.enable_thinking; reasoning comes back separately from the answer.",
      "label": "Thinking",
      "name": "thinking"
    },
    {
      "choices": [
        {
          "default": true,
          "help": "At most 6 MTP drafts a round; a chain stops before a draft under 30 percent (TensorFold's CUDA default).",
          "label": "MTP, 6 drafts, confidence 0.30",
          "value": "mtp-6-030"
        },
        {
          "args": [
            {
              "name": "mtp-confidence",
              "value": 0.6
            }
          ],
          "help": "Stricter chains. MiaAI-Lab's sweep of 2026-09-29 on the MLX 4-bit checkpoint under her patched engine found 6 drafts at 0.60 about 3 to 4 percent faster than 0.30 (a claim about another checkpoint, not measured on NVFP4).",
          "label": "MTP, 6 drafts, confidence 0.60",
          "value": "mtp-6-060"
        },
        {
          "args": [
            {
              "name": "mtp-drafts",
              "value": 3
            }
          ],
          "help": "At most 3 MTP drafts a round (--mtp-drafts 3); speed unmeasured.",
          "label": "MTP, 3 drafts, confidence 0.30",
          "value": "mtp-3-030"
        },
        {
          "args": [
            {
              "name": "no-drafts",
              "value": true
            }
          ],
          "help": "Serial one-token-at-a-time reference decoding (--no-drafts); slower.",
          "label": "No drafting",
          "value": "serial"
        }
      ],
      "help": "The checkpoint's own MTP head drafts tokens and the target verifies each against its serial sample, so outputs are unchanged by drafting (upstream claim). --mtp-drafts caps the chain and --mtp-confidence stops it before a draft under that probability.",
      "label": "MTP drafting",
      "name": "drafting"
    }
  ],
