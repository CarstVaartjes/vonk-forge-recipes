  "options": [
    {
      "choices": [
        {
          "default": true,
          "help": "Upstream default: vLLM auto applies the checkpoint's FP8 kv_cache_scheme with triton_attn. Upstream log at 0.84: 2,295,133 tokens of KV (about 2.30x a 1M-token request).",
          "label": "FP8 (checkpoint scheme)",
          "value": "fp8"
        },
        {
          "args": [
            {
              "name": "kv-cache-dtype",
              "value": "bfloat16"
            }
          ],
          "help": "Upstream override: --kv-cache-dtype bfloat16 with triton_attn. Upstream log: 1,143,423 tokens of KV (about 1.14x a 1M-token request).",
          "label": "bf16",
          "value": "bf16"
        },
        {
          "args": [
            {
              "name": "kv-cache-dtype",
              "value": "bfloat16"
            },
            {
              "name": "attention-backend",
              "value": "flash_attn"
            }
          ],
          "help": "Upstream notes flash_attn can only serve a bf16 KV cache on GB10; uses the FlashAttention backend instead of triton_attn.",
          "label": "bf16 with FlashAttention",
          "value": "bf16-flash"
        }
      ],
      "help": "Which KV cache the target uses. Upstream: the checkpoint carries calibrated FP8 KV scales, so FP8 halves KV memory; bf16 is its documented override.",
      "label": "KV cache precision",
      "name": "kv-cache"
    }
