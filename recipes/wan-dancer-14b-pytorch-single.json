      {
        "changes": [
          {
            "details": "The adapter verifies the signed manifest, consumes required prompt/image/music slots, and keeps generation controls in an optional bounded JSON slot.",
            "kind": "fix",
            "references": [],
            "summary": "Added signed typed prompt, reference-image, music, controls, and MP4 result slots."
          }
        ],
        "prior_recipe_content_sha256": "c60a92b3e91c7bbe1a1dff400ba5760c85a5bd68184e0118fc0d159b9f57328b",
