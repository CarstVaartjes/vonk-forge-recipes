      },
      {
        "changes": [
          {
            "details": null,
            "kind": "metadata",
            "references": [],
            "summary": "Declared explicit recipe alignment metadata; no runtime behavior changed."
          }
        ],
        "prior_recipe_content_sha256": "b0aef0263da8e4565f550d7bd23b01c363da017b478e9bdbde1c3aa0a47697d6",
        "released_at": "2026-09-01",
        "upgrade_effect": "none",
        "version": "1.0.6"
      },
      {
        "changes": [
          {
            "details": "Portrait 720x1280 and landscape 1280x720 remain available within the existing per-dimension and multiple-of-16 contract, while larger combinations such as 1280x1280 fail closed before inference. The declared 128 GB memory envelope and blocked physical single-Spark qualification remain unchanged.",
            "kind": "fix",
            "references": [
              "https://github.com/Wan-Video/Wan-Dancer/blob/e6c87a94ec733230dac15b924c015f6e6501e618/README.md#-environment-setup"
            ],
            "summary": "Bounded every generation request to a 921,600-pixel canvas before either Wan-Dancer inference stage starts."
          },
          {
            "details": null,
            "kind": "metadata",
            "references": [],
            "summary": "Published the canvas ceiling and retained the exact pinned upstream provenance for this local safety bound."
          }
        ],
        "prior_recipe_content_sha256": "950296d999671c60362fecb5623d0bf4ad15cbf2d3b6863a9c87ef2cf9fdd940",
        "released_at": "2026-08-31",
        "upgrade_effect": "rebuild",
        "version": "1.0.5"
      },
      {
        "changes": [
          {
            "details": null,
            "kind": "fix",
            "references": [],
            "summary": "Rejected unknown signed-manifest slots and mismatched media types, extensions, and per-slot byte bounds before inference."
          },
          {
            "details": null,
            "kind": "metadata",
            "references": [],
            "summary": "Made the exact 128 GB Controller admission envelope and offline source-bundled execution status explicit."
          }
        ],
        "prior_recipe_content_sha256": "a025b2b3d701f60857370a783041e18356d639b1d61f38b8eab816c7f2d0601b",
        "released_at": "2026-08-30",
        "upgrade_effect": "rebuild",
        "version": "1.0.4"
      },
      {
        "changes": [
          {
            "details": "The adapter validates the reference image before inference, derives its even output crop and music-bound frame contract, then requires exact H.264/AAC streams, dimensions, frame rate, frame count, and synchronized durations.",
            "kind": "fix",
            "references": [],
            "summary": "Made derived Wan-Dancer MP4 acceptance fail closed."
          }
        ],
        "prior_recipe_content_sha256": "8794c9f1f71095dce7b53e41c959c8dcdd7fa45dd017d0da59f328927e65f9fb",
