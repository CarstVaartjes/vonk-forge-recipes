  "options": [
    {
      "choices": [
        {
          "default": true,
          "help": "incoai block-diffusion drafter, 7 drafted tokens per step. Upstream claims 2.2x on code (15.1 to 33.6 tok/s) and +20% on prose; acceptance is workload dependent. Drafter is CC-BY-NC-ND-4.0 (non-commercial).",
          "label": "DFlash2 K=7",
          "value": "dflash2"
        },
        {
          "args": [
            {
              "name": "speculative-config",
              "value": "{\"method\":\"mtp\",\"num_speculative_tokens\":5}"
            }
          ],
          "help": "The checkpoint's own MTP layer with 5 drafted tokens (upstream launcher default for mtp); the drafter files stay mounted but unused. Upstream used it only as a measured baseline.",
          "label": "Native MTP",
          "value": "mtp"
        }
      ],
      "help": "Draft model that proposes tokens for the target to verify. DFlash2 is the upstream primary lane; upstream measured native MTP only as a baseline.",
      "label": "Speculative decoding",
      "name": "speculation"
    },
    {
      "choices": [
        {
          "default": true,
          "help": "Skip the autotune sweep (upstream default).",
          "label": "Off",
          "value": "off"
        },
        {
          "args": [
            {
              "name": "kernel-config",
              "value": "{\"enable_flashinfer_autotune\":true}"
            }
          ],
          "help": "Run the FlashInfer autotune sweep at startup; may hang in distributed profiling.",
          "label": "On",
          "value": "on"
        }
      ],
      "help": "Startup FlashInfer autotune sweep. Upstream disables it because its distributed profiling hung once on rank 0 during spec-decode warmup; measured within noise of the autotuned baseline (upstream claim).",
      "label": "FlashInfer autotune",
      "name": "autotune"
    }
