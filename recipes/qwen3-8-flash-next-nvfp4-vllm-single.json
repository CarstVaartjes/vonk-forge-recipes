    {
      "choices": [
        {
          "default": true,
          "help": "Upstream default: 3 drafted tokens per step and disable_eagle_block_drop (vllm#53388 backport), which keeps the last prefix-cache block on multi-turn chats (upstream claims warm second turn TTFT 1.66 s to 0.81 s).",
          "label": "MTP 3 with block-drop off",
          "value": "mtp3"
        },
        {
          "args": [
            {
              "name": "speculative-config",
              "setting": null,
              "value": "{\"method\":\"mtp\",\"num_speculative_tokens\":2,\"use_local_argmax_reduction\":true,\"disable_eagle_block_drop\":true}"
            }
          ],
          "help": "2 drafted tokens per step, block-drop still disabled; upstream measured it tied with 3.",
          "label": "MTP 2",
          "value": "mtp2"
        },
        {
          "args": [
            {
              "name": "speculative-config",
              "setting": null,
              "value": "{\"method\":\"mtp\",\"num_speculative_tokens\":3,\"use_local_argmax_reduction\":true}"
            }
          ],
          "help": "3 drafted tokens, but the engine again drops and recomputes the last matched prefix-cache block on every turn (about 1,664 tokens).",
          "label": "MTP 3 with stock block drop",
          "value": "mtp3-stock-block-drop"
        }
      ],
      "help": "Depth of MTP drafting. Upstream swept K=0..3 and found K=3 best at every concurrency, K=2 tied (upstream measurement on its own Spark).",
