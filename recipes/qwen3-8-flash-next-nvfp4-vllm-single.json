      "name": "draft-vocabulary"
    },
    {
      "choices": [
        {
          "default": true,
          "help": "Upstream default: about 1M-token KV pool on one Spark.",
          "label": "FP8",
          "value": "fp8"
        },
        {
          "args": [
            {
              "name": "kv-cache-dtype",
              "setting": null,
              "value": "auto"
            }
          ],
          "help": "Unquantised KV cache (vLLM auto); smaller token pool.",
          "label": "BF16",
          "value": "bf16"
        }
      ],
      "help": "FP8 gives about 1.7x more KV tokens. Upstream measured FP8 as 2.7 to 6.1 percent slower prefill and about 4 percent slower decode than BF16, and warns to re-validate long-reasoning quality on FP8 (sparse attention picks blocks from quantised keys).",
      "label": "KV cache dtype",
      "name": "kv-cache"
    },
    {
      "choices": [
        {
          "default": true,
          "help": "Upstream default.",
          "label": "BF16",
          "value": "bf16"
        },
        {
          "args": [
            {
              "name": "mamba-ssm-cache-dtype",
              "setting": null,
              "value": "float32"
            }
          ],
          "help": "The checkpoint's own float32 state; larger cache page, slower.",
          "label": "FP32",
          "value": "fp32"
        }
      ],
      "help": "Dtype of the GDN recurrent (SSM) state. Upstream claims BF16 is +8.5 percent aggregate decode at 8 streams with unchanged acceptance and needle retrieval.",
      "label": "Recurrent state dtype",
      "name": "recurrent-state"
    },
    {
      "choices": [
        {
          "default": true,
          "help": "Upstream default.",
          "label": "2048 tokens",
          "value": "chunk-2048"
        },
        {
          "args": [
            {
              "name": "max-num-batched-tokens",
              "setting": null,
              "value": 1024
            }
          ],
          "help": "Upstream claims p95 decode gap under a 64k prefill drops from 1,111 ms to 666 ms for 5.5 percent less prefill throughput.",
          "label": "1024 tokens",
          "value": "chunk-1024"
        },
        {
          "args": [
            {
              "name": "max-num-batched-tokens",
              "setting": null,
              "value": 8192
            }
          ],
          "help": "Upstream claims about 11 percent faster prefill and 10 percent lower TTFT, paid from the KV pool (about 3 percent).",
          "label": "8192 tokens",
          "value": "chunk-8192"
        }
      ],
      "help": "Tokens per prefill chunk. Wider chunks raise prefill throughput and delay streams that are decoding at the same time.",
