    {
      "choices": [
        {
          "default": true,
          "help": "Five drafted tokens (upstream default).",
          "label": "5 (default)",
          "value": "k5"
        },
        {
          "args": [
            {
              "name": "speculative-config",
              "setting": null,
              "value": "{\"method\":\"dspark\",\"num_speculative_tokens\":3,\"draft_sample_method\":\"probabilistic\"}"
            }
          ],
          "help": "Three drafted tokens; upstream measured it slower.",
          "label": "3",
          "value": "k3"
        }
      ],
      "help": "Drafted tokens per step. The drafter emits exactly 5 per pass, so upstream allows 5 or fewer (or a multiple of 5); 7 crashes on first generation. k=5 measured about 24 percent faster than k=3 (upstream).",
      "label": "DSpark draft length",
      "name": "speculative-length"
    },
    {
      "choices": [
        {
          "default": true,
          "help": "Thinking off unless a request enables it (upstream default).",
          "label": "Off (default)",
          "value": "off"
        },
        {
          "args": [
            {
              "name": "default-chat-template-kwargs",
              "setting": null,
              "value": "{\"thinking\":true}"
            }
          ],
          "help": "Thinking on by default.",
          "label": "On",
          "value": "on"
        }
      ],
      "help": "Server default for the chat template's thinking switch; a request can still override it.",
      "label": "Thinking default",
      "name": "thinking"
    },
    {
      "choices": [
        {
          "default": true,
          "help": "Upstream's 12-slot lane (the Vision-Exp launcher default); upstream documents it as the profile class that can hit the first-request memory failure.",
          "label": "0.85 (default)",
          "value": "high"
        },
        {
          "args": [
            {
              "name": "gpu-memory-utilization",
              "setting": null,
              "value": "0.78"
            }
          ],
          "help": "Upstream's current best profile for the text checkpoint: speculative decoding allocates buffers on the first real request, and 0.80 or more can boot then die under traffic (upstream issue 8).",
          "label": "0.78",
          "value": "conservative"
        }
      ],
      "help": "Fraction of unified memory vLLM may take. Set the concurrency setting to match (upstream: 6 slots at 0.78, 12 at 0.85).",
      "label": "GPU memory utilization",
      "name": "memory"
    }
