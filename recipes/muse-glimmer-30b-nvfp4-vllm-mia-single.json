  "options": [
    {
      "choices": [
        {
          "default": true,
          "help": "Upstream default; upstream measured 2,414,048 token slots at gpu-memory-utilization 0.42 with a 256K launch.",
          "label": "FP8 E4M3 (upstream default)",
          "value": "fp8"
        },
        {
          "args": [
            {
              "name": "kv-cache-dtype",
              "value": "auto"
            }
          ],
          "help": "Upstream documents that without FP8 KV there are a factor of two fewer slots.",
          "label": "Model dtype (auto)",
          "value": "auto"
        }
      ],
      "help": "FP8 KV halves KV memory versus the model dtype at a small long-range recall cost; upstream keeps it on. Switching to auto uses the checkpoint dtype and roughly halves the token slots at the same memory fraction.",
      "label": "KV cache dtype",
      "name": "kv-cache"
    }
