  "options": [
    {
      "choices": [
        {
          "default": true,
          "help": "Upstream default: 3 drafted tokens per step.",
          "label": "DSpark, 3 tokens",
          "value": "dspark-3"
        },
        {
          "args": [
            {
              "name": "speculative-config",
              "setting": null,
              "value": "{\"method\":\"dspark\",\"num_speculative_tokens\":5}"
            }
          ],
          "help": "The checkpoint's draft block size ceiling (5); upstream measured it slower than 3 on prose.",
          "label": "DSpark, 5 tokens",
          "value": "dspark-5"
        },
        {
          "env": {
            "DSV41_SPECULATION": "off"
          },
          "help": "No speculation. Upstream: frees about 3.5 GiB per node and is faster once the batch is wide.",
          "label": "Off",
          "value": "off"
        }
      ],
      "help": "DSpark drafts tokens with the draft experts stored in the checkpoint (no separate drafter is downloaded). Upstream reports k=3 as measured faster than k=5 on prose; speed statements here are upstream claims until measured on Vonk hardware.",
      "label": "Speculative decoding",
      "name": "speculation"
    },
    {
      "choices": [
        {
          "default": true,
          "help": "Upstream default.",
          "label": "Agent (1536 tokens, 96 threads)",
          "value": "agent"
