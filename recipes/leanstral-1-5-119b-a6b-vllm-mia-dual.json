        {
          "args": [
            {
              "name": "enable-auto-tool-choice",
              "setting": null,
              "value": false
            }
          ],
          "help": "Automatic tool choice disabled.",
          "label": "Off",
          "value": "off"
        }
      ],
      "help": "Mistral tool-call parser with automatic tool choice. Upstream keeps it on and documents turning it off only to isolate chat stability problems.",
      "label": "Tool calling",
      "name": "tool-calls"
    },
    {
      "choices": [
        {
          "default": true,
          "help": "--enforce-eager, no CUDA graph capture (upstream default).",
          "label": "Eager (default)",
          "value": "eager"
        },
        {
          "args": [
            {
              "name": "enforce-eager",
              "setting": null,
              "value": false
            }
          ],
          "help": "Allow vLLM to capture CUDA graphs. Not exercised by upstream, which defaults to eager; capture adds start-up time and memory.",
          "label": "CUDA graphs",
          "value": "graphs"
        }
      ],
      "help": "Upstream runs in eager mode (ENFORCE_EAGER=1) by default; CUDA graph capture is the alternative.",
      "label": "Execution mode",
      "name": "execution"
    },
    {
      "choices": [
        {
          "default": true,
          "help": "No speculative decoding (upstream default).",
          "label": "Off (default)",
          "value": "off"
        },
        {
          "args": [
            {
              "name": "speculative-config",
              "setting": null,
              "value": "{\"model\":\"/models/eagle\",\"num_speculative_tokens\":3,\"method\":\"eagle\",\"max_model_len\":\"65536\"}"
            }
          ],
          "help": "Experimental; upstream reports instability. The draft weights are mounted either way.",
          "label": "EAGLE 3 tokens",
          "value": "eagle"
        }
      ],
      "help": "Optional EAGLE draft head (mistralai/Mistral-Small-4-119B-2603-eagle, about 392 MB, 3 speculative tokens, draft context 65536). It is a Mistral Small 4 draft, not Leanstral-specific. Upstream reports it unstable on this Leanstral setup (an execute_model timeout in shm_broadcast and chat crashes), so it is off by default.",
      "label": "Speculative decoding",
      "name": "speculative"
    }
