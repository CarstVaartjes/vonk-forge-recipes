  "options": [
    {
      "choices": [
        {
          "default": true,
          "help": "The checkpoint's 3-layer MTP head, 4 draft tokens (upstream default). Better on prose and a larger KV pool (upstream measured 2.88M tokens at memory fraction 0.963, 2.48M at 0.93); decode CUDA graphs must stay off because capture fails with multi-layer EAGLE.",
          "label": "EAGLE MTP (default)",
          "value": "eagle"
        },
        {
          "env": {
            "CUDA_GRAPH_MAX_BS_DECODE": "8",
            "MAX_TOTAL_TOKENS": "2299968",
            "SPEC_ALGO": "DFLASH",
            "SPEC_DRAFT_TOKENS": "8"
          },
          "help": "The bundled 2.9 GB Qwen3-style drafter, 8 draft tokens, decode CUDA graphs on for 8 requests and a 2,299,968-token pin (upstream: better on code, worse on prose, and its drafter keeps a second KV pool so the pool is smaller).",
          "label": "DFlash",
          "value": "dflash"
        },
        {
          "env": {
            "SPEC_ALGO": "off"
          },
          "help": "No speculative decoding, the upstream clean baseline.",
          "label": "Off",
          "value": "off"
        }
      ],
      "help": "Which drafter the checkpoint's speculative decoding uses; chosen at boot, there is no per-request switch. Upstream (sparkDash, thinking off, one stream): EAGLE MTP prose 35.0 and code 46.0 tok/s, DFlash prose 25.8 and code 69.8 tok/s.",
      "label": "Speculative decoding",
      "name": "drafter"
