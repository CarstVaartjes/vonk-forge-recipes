  "options": [
    {
      "choices": [
        {
          "default": true,
          "help": "No vision tower (upstream default: --vision is opt-in).",
          "label": "Text only",
          "value": "text-only"
        },
        {
          "args": [
            {
              "name": "vision",
              "value": true
            }
          ],
          "help": "Vision tower loaded; images sent as base64 data URLs only (--vision).",
          "label": "Images (data URLs)",
          "value": "images"
        },
        {
          "args": [
            {
              "name": "vision",
              "value": true
            },
            {
              "name": "vision-urls",
              "value": true
            }
          ],
          "help": "Also fetch public https image URLs on port 443 (--vision --vision-urls); request-time fetching by the server, not a recipe download.",
          "label": "Images (data and https URLs)",
          "value": "images-https"
        }
      ],
      "help": "Serve image_url parts with the model's own vision tower (--vision). TensorFold's vision guide calls this experimental pending its hardware matrix and makes no vision throughput claim; image requests start with a fresh KV cache (no prefix reuse). Video is not supported by this engine.",
      "label": "Image input",
      "name": "images"
    },
    {
      "choices": [
        {
          "default": true,
          "help": "Open a think block by default (upstream default: --thinking).",
          "label": "Think first",
          "value": "thinking"
        },
        {
          "args": [
            {
              "name": "thinking",
              "value": false
            },
            {
              "name": "no-thinking",
              "value": true
            }
          ],
          "help": "Answer without a think block unless a request asks for one.",
          "label": "Answer directly",
          "value": "direct"
        }
      ],
      "help": "Whether the chat template opens a think block by default. A request can still set chat_template_kwargs.enable_thinking; reasoning comes back separately from the answer.",
      "label": "Thinking",
      "name": "thinking"
    },
    {
      "choices": [
        {
          "default": true,
          "help": "Draft with z-lab/Qwen3.8-27B-DFlash2 and context copies (upstream default on CUDA).",
          "label": "DFlash2 drafting",
          "value": "dflash2"
        },
        {
          "args": [
            {
              "name": "no-drafts",
              "value": true
            }
          ],
          "help": "Serial one-token-at-a-time reference decoding (--no-drafts); the draft model stays mounted but unused. Upstream measured about 16 tok/s serial against 46 to 63 tok/s drafted on a 64 GB M5 Pro (upstream claim, other hardware).",
          "label": "No drafting",
          "value": "serial"
        }
      ],
      "help": "TensorFold's CUDA engine drafts with z-lab's DFlash2 draft model and accepts a draft only when it equals the token the same engine would sample serially, so outputs are unchanged by drafting (upstream claim).",
      "label": "Speculative drafting",
      "name": "drafting"
    }
  ],
