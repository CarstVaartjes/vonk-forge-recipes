  "options": [
    {
      "choices": [
        {
          "default": true,
          "help": "No vision tower (upstream default: --vision is opt-in).",
          "label": "Text only",
          "value": "text-only"
        },
        {
          "args": [
            {
              "name": "vision",
              "value": true
            }
          ],
          "help": "Vision tower loaded; images sent as base64 data URLs only (--vision).",
          "label": "Images (data URLs)",
          "value": "images"
        },
        {
          "args": [
            {
              "name": "vision",
              "value": true
            },
            {
              "name": "vision-urls",
              "value": true
            }
          ],
          "help": "Also fetch public https image URLs on port 443 (--vision --vision-urls); request-time fetching by the server, not a recipe download.",
          "label": "Images (data and https URLs)",
          "value": "images-https"
        }
      ],
      "help": "Serve image_url parts with the model's own bf16 vision tower (--vision) on the native CUDA engine, which counts the tower and its scratch as model memory at startup; image requests start with a fresh KV cache (no prefix reuse). JPEG, PNG and WebP images decode in the engine (JPEG through libjpeg-turbo 3.1.4.1 and WebP through libwebp 1.6.0, the exact releases TensorFold pins, built into this image). Video is not supported for this model.",
      "label": "Image input",
      "name": "images"
    },
    {
      "choices": [
        {
          "default": true,
          "help": "Draft with z-lab/Qwen3.8-27B-DFlash2 (--drafter) and context copies (upstream's documented launch).",
          "label": "DFlash2 drafting",
          "value": "dflash2"
        },
        {
          "args": [
            {
              "name": "no-drafts",
              "value": true
            }
          ],
          "help": "Plain decoding through the same engine (--no-drafts); the draft model stays mounted but unused. Upstream measured 17.3 tok/s plain against 47 to 89 tok/s with DFlash2 for the MLX 4-bit checkpoint on a 48 GB M5 Pro with TensorFold 1.2.1 (upstream claim, other hardware).",
          "label": "No drafting",
          "value": "serial"
        }
      ],
      "help": "TensorFold's native CUDA engine drafts with z-lab's DFlash2 draft model (--drafter) and accepts a draft only when it equals the token the same engine would produce with drafting off, so outputs are unchanged by drafting (upstream claim).",
      "label": "Speculative drafting",
      "name": "drafting"
    }
