  "release": {
    "history": [
      {
        "changes": [
          {
            "details": null,
            "kind": "metadata",
            "references": [],
            "summary": "Bound this recipe to the evidence-backed model capability authority without changing runtime behavior."
          }
        ],
        "prior_recipe_content_sha256": null,
        "released_at": "2026-09-05",
        "upgrade_effect": "none",
        "version": "1.1.4"
      },
      {
        "changes": [
          {
            "details": "The recipe now carries every author-selectable Podman build input through the signed Controller-to-agent request, including a bounded capability list that defaults to empty. The agent drops all capabilities before adding only declared allowlisted entries inside Podman's rootless user namespace; host privilege, devices, mounts, sockets, security options, storage, cgroups, and generated image identity remain fixed platform policy.",
            "kind": "compatibility",
            "references": [],
            "summary": "Declared explicit resource limits and rootless capabilities in the portable recipe build contract."
          }
        ],
        "prior_recipe_content_sha256": "81ff15465909ba7c4c28b3ea86b49c811366fc04309bfe02821cb6b5c79983f5",
        "released_at": "2026-09-03",
        "upgrade_effect": "rebuild",
        "version": "1.1.3"
      },
      {
        "changes": [
          {
            "details": null,
            "kind": "metadata",
            "references": [],
            "summary": "Declared explicit recipe alignment metadata; no runtime behavior changed."
          }
        ],
        "prior_recipe_content_sha256": "77fbd58a776063f9d9f9f2829d52ca0e39233bca407d54c2dc69352562b5b59e",
        "released_at": "2026-09-01",
        "upgrade_effect": "none",
        "version": "1.1.2"
      },
      {
        "changes": [
          {
            "details": "The catalog and benchmark name now make the caller-owned screenshot loop and external human approval and execution boundary explicit.",
            "kind": "metadata",
            "references": [],
            "summary": "Clarified UI-Mate as a non-actuating action-proposal endpoint."
          }
        ],
        "prior_recipe_content_sha256": "ab5eb233a4b80c775b99e542be7eb344f78732971652227f722c6041557b7182",
        "released_at": "2026-08-30",
        "upgrade_effect": "none",
        "version": "1.1.1"
      },
      {
        "changes": [
          {
            "details": "Pins the 0.28 scheduling and CUDA-graph bounds used by the other current Qwen-family recipes, while keeping the single-Spark 32K and one-sequence memory envelope.",
            "kind": "runtime",
            "references": [
              "https://github.com/vllm-project/vllm/releases/tag/v0.28.0"
            ],
            "summary": "Moved UI-Mate to the immutable vLLM 0.28.0 ARM64 release image."
          },
          {
            "details": "The entrypoint now creates its bounded cache directories on the mounted outputs volume before vLLM starts, avoiding first-launch failures caused by root-owned or missing cache paths.",
            "kind": "runtime",
            "references": [],
            "summary": "Made all runtime compilation and model caches writable for the unprivileged service user."
          },
          {
            "details": "The upstream change publishes OSWorkerBench and README links only; the three vendored serving-harness files remain byte-identical to the prior revision.",
            "kind": "metadata",
            "references": [
              "https://github.com/Tencent/UI-Mate/tree/d185dc9d74cfcab3a890d7ffb2bb011ecdd64c64"
            ],
            "summary": "Refreshed Tencent UI-Mate source provenance to d185dc9."
          }
        ],
        "prior_recipe_content_sha256": "4af963bd5be4812acac7d7233657270135cc39cfd7461ecd32aa65ec1ad91016",
        "released_at": "2026-08-29",
        "upgrade_effect": "reprepare",
        "version": "1.1.0"
      },
      {
        "changes": [
          {
            "details": "The execution contract was already structurally complete; this release makes it available for explicit operator installation while physical build and Spark acceptance remain separate.",
            "kind": "metadata",
            "references": [],
            "summary": "Declared the complete recipe contract installable without changing Candidate qualification."
          }
        ],
        "prior_recipe_content_sha256": "ac12920f785a97dc85c5248c8b95746212b9acc969c47169f668998169f6d97c",
        "released_at": "2026-08-26",
        "upgrade_effect": "none",
        "version": "1.0.1"
      },
      {
        "changes": [
          {
            "details": "Pins the exact Tencent checkpoint and source revision, directly vendors the official prompt/parser/action behavior, and adapts Tencent's TP2 vLLM launch to a bounded TP1 32K single-Spark profile pending physical acceptance.",
            "kind": "initial",
            "references": [
              "https://huggingface.co/tencent/UI-Mate-27B/tree/3ade2378fc84032d5017c1a9c93c4eaa77d65e57",
              "https://github.com/Tencent/UI-Mate/tree/d2b2e0aede83eeacfb1bc86f66503acbc4a6738a"
            ],
            "summary": "Initial UI-Mate 27B BF16 single-Spark Candidate with Tencent's official computer-use harness."
          }
        ],
        "prior_recipe_content_sha256": "b04408a1b40b827ff7eea19216559d182ec1fe9ecb08b05fdc2c4460378190a1",
