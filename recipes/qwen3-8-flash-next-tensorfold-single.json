  "options": [
    {
      "choices": [
        {
          "default": true,
          "help": "Load the 0.84 GiB vision tower; image and video requests are available.",
          "label": "Images and video",
          "value": "vision"
        },
        {
          "args": [
            {
              "name": "vision",
              "value": false
            }
          ],
          "env": {
            "TENSORFOLD_PREFILL_ROWS": "4096"
          },
          "help": "Skip the vision tower and use 4,096-row prompt chunks.",
          "label": "Text only",
          "value": "text-only"
        }
      ],
      "help": "Load Flash Next's vision tower for image_url and video_url requests, or choose text only. Text-only mode uses 4,096-row prompt chunks; vision mode preserves the standard 2,048-row chunk default.",
      "label": "Image and video input",
      "name": "images_video"
    },
    {
      "choices": [
        {
          "default": true,
          "help": "Only base64 data URLs are accepted (upstream default).",
          "label": "Data URLs only",
          "value": "data-only"
        },
        {
          "args": [
            {
              "name": "vision-urls",
              "value": true
            }
          ],
          "help": "Also fetch public https image and video URLs (--vision-urls).",
          "label": "Data and https URLs",
          "value": "https"
        }
      ],
      "help": "Whether the server may fetch public https:// image and video URLs sent in requests. Off by default, so only data URLs are accepted. This is request-time fetching by the server, not a recipe download.",
      "label": "Remote media URLs",
      "name": "vision_urls"
    },
    {
      "choices": [
        {
          "default": true,
          "help": "int8 KV with an fp16 scale per 32 values, about 23.4 GiB for the 5-stream pool (upstream default).",
          "label": "int8",
          "value": "int8"
        },
        {
          "args": [
            {
              "name": "kv-dtype",
              "value": "int4"
            }
          ],
          "help": "int4 KV: smaller cache, slightly different outputs, quality not measured.",
          "label": "int4",
          "value": "int4"
        }
      ],
      "help": "Precision of the per-stream KV cache. int8 keeps 5 x 262,144 tokens within budget; int4 needs less memory (upstream says it changes outputs slightly, quality not measured). bf16 is omitted because it only fits 3 streams at full context.",
      "label": "KV cache precision",
      "name": "kv_dtype"
    },
    {
      "choices": [
        {
          "default": true,
          "help": "At most 6 MTP drafts a round; a chain stops before a draft under 60 percent (Mia default).",
          "label": "MTP, 6 drafts, confidence 0.60",
          "value": "mtp-6-060"
        },
        {
          "args": [
            {
              "name": "mtp-confidence",
              "value": 0.3
            }
          ],
          "help": "TensorFold's stock drafting confidence.",
          "label": "MTP, 6 drafts, confidence 0.30",
          "value": "mtp-6-030"
        },
        {
          "args": [
            {
              "name": "mtp-drafts",
              "value": 4
            },
            {
              "name": "mtp-confidence",
              "value": 0.5
            }
          ],
          "help": "Matched the default on prose but not on code in upstream's sweep (upstream claim).",
          "label": "MTP, 4 drafts, confidence 0.50",
          "value": "mtp-4-050"
        },
        {
          "args": [
            {
              "name": "no-drafts",
              "value": true
            }
          ],
          "help": "Serial one-token-at-a-time reference decoding (--no-drafts); slower.",
          "label": "No drafting",
          "value": "serial"
        }
      ],
      "help": "MTP drafts are verified against the model's own samples, so outputs are unchanged by drafting (upstream claim). Mia's sweep of 2026-09-29 found 6 drafts at 0.60 confidence beat TensorFold's stock 6/0.30 by about 3 percent on prose and 4 percent on code (upstream claim). Serial decoding is TensorFold's reference path.",
      "label": "Speculative drafting",
      "name": "drafting"
    },
    {
      "choices": [
        {
          "default": true,
          "help": "Copy drafts enabled (upstream default).",
          "label": "On",
          "value": "on"
        },
        {
          "env": {
            "TENSORFOLD_MTP_COPY": "0"
          },
          "help": "TENSORFOLD_MTP_COPY=0.",
          "label": "Off",
          "value": "off"
        }
      ],
      "help": "Copy drafts from earlier text when the reply repeats the prompt. This changes only proposal coverage; the main model verifies every draft. It is effective with at least two concurrent streams.",
      "label": "Prompt-lookup drafts",
      "name": "prompt_lookup"
    },
    {
      "choices": [
        {
          "default": true,
          "env": {
            "TENSORFOLD_DRAFT_VOCAB": "default"
          },
          "help": "Use TensorFold’s default draft vocabulary; best suited to English and code.",
          "label": "Default",
          "value": "default"
        },
        {
          "env": {
            "TENSORFOLD_DRAFT_VOCAB": "zh"
          },
          "help": "Add the reviewed Chinese draft-token list. Exact verification keeps output behavior unchanged; the language-specific draft list is experimental on this hardware.",
          "label": "Chinese",
          "value": "zh"
        },
        {
          "env": {
            "TENSORFOLD_DRAFT_VOCAB": "ja"
          },
          "help": "Add the reviewed Japanese draft-token list. Exact verification keeps output behavior unchanged; the language-specific draft list is experimental on this hardware.",
          "label": "Japanese",
          "value": "ja"
        },
        {
          "env": {
            "TENSORFOLD_DRAFT_VOCAB": "zh,ja"
          },
          "help": "Add both reviewed language draft-token lists. This uses the largest MTP candidate set; speed has not been measured on this hardware.",
          "label": "Chinese and Japanese",
          "value": "zh-ja"
        }
      ],
      "help": "Choose additional tokens for MTP proposals. The model still verifies proposals against its full vocabulary; the setting affects draft coverage and memory use, not answer correctness.",
      "label": "Language draft vocabulary",
      "name": "draft_vocabulary"
