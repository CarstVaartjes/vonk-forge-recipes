  "options": [
    {
      "choices": [
        {
          "default": true,
          "help": "Upstream's DGX Spark operating point (about 4.93M-token pool, 48 concurrent requests as reported upstream).",
          "label": "0.78 (upstream default)",
          "value": "fraction-078"
        },
        {
          "args": [
            {
              "name": "mem-fraction-static",
              "setting": null,
              "value": "0.85"
            }
          ],
          "help": "Upstream's documented example for growing cache and concurrency on a memory-rich machine; leaves less headroom for the OS on a Spark.",
          "label": "0.85 (larger cache)",
          "value": "fraction-085"
        }
      ],
      "help": "SGLang --mem-fraction-static: the share of device memory reserved for weights, KV cache and CUDA-graph scratch; the main lever for KV pool size and concurrency. The 0.78 default is upstream's DGX Spark setting (128 GiB unified memory).",
      "label": "Static memory fraction",
      "name": "mem-fraction"
    },
    {
      "choices": [
        {
          "default": true,
          "help": "Upstream's DGX Spark setting.",
          "label": "4 (upstream default)",
          "value": "bs-4"
        },
        {
          "args": [
            {
              "name": "cuda-graph-max-bs-decode",
              "setting": null,
              "value": "2"
            }
          ],
          "help": "Upstream suggests 2 on smaller-memory cards to trim CUDA-graph scratch; lowers decode batch capacity.",
          "label": "2 (less scratch memory)",
          "value": "bs-2"
        }
      ],
      "help": "SGLang --cuda-graph-max-bs-decode: CUDA-graph batch-size cap for decode; lowering it saves graph scratch memory and caps decode concurrency.",
      "label": "Decode CUDA graph batch size",
      "name": "cuda-graph-decode-batch"
    }
  ],
