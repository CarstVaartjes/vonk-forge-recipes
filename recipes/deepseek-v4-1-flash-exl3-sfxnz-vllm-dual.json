  "options": [
    {
      "choices": [
        {
          "default": true,
          "help": "Upstream default (NUM_SPECULATIVE_TOKENS_PER_BATCH=1-2:5,3-4:3), graph sizes [1,4,5,6,8,10,12,15,16,20].",
          "label": "DSpark, 5 tokens at 1-2 requests, 3 at 3-4",
          "value": "tiered"
        },
        {
          "args": [
            {
              "name": "speculative-config",
              "value": "{\"method\":\"dspark\",\"num_speculative_tokens\":3,\"draft_sample_method\":\"greedy\"}"
            },
            {
              "name": "compilation-config",
              "value": "{\"cudagraph_mode\":\"FULL_AND_PIECEWISE\",\"cudagraph_capture_sizes\":[1,3,4,6,8,9,12,16],\"custom_ops\":[\"all\"]}"
            }
          ],
          "help": "Upstream NUM_SPECULATIVE_TOKENS_PER_BATCH=0 with NUM_SPECULATIVE_TOKENS=3: one width, graph sizes [1,3,4,6,8,9,12,16].",
          "label": "DSpark, 3 tokens",
          "value": "dspark-3"
        },
        {
          "args": [
            {
              "name": "compilation-config",
              "value": "{\"cudagraph_mode\":\"FULL_AND_PIECEWISE\",\"cudagraph_capture_sizes\":[1,2,3,4],\"custom_ops\":[\"all\"]}"
            }
          ],
          "env": {
            "DSV41_SPECULATION": "off"
          },
          "help": "Upstream SPEC=none: no speculative config, graph sizes [1,2,3,4].",
          "label": "Off",
          "value": "off"
        }
      ],
      "help": "DSpark drafts tokens with the draft experts stored in the pack. The default is upstream's per-batch width (5 drafted tokens at 1-2 running requests, 3 at 3-4) with adaptive verify and CUDA graph capture sizes that follow those widths.",
      "label": "Speculative decoding",
      "name": "speculation"
    },
    {
      "choices": [
        {
          "default": true,
          "help": "Upstream default: FULL_AND_PIECEWISE graphs.",
          "label": "CUDA graphs",
          "value": "graphs"
        },
        {
          "env": {
            "ENFORCE_EAGER": "1"
          },
          "help": "Upstream ENFORCE_EAGER=1: no CUDA graph capture.",
          "label": "Eager",
          "value": "eager"
        }
      ],
      "help": "Upstream ENFORCE_EAGER switch. Eager passes --enforce-eager instead of the compilation config (slower decode, faster startup, useful for diagnosis).",
      "label": "CUDA graphs",
      "name": "cuda_graphs"
    },
    {
      "choices": [
        {
          "default": true,
          "help": "Upstream default: the vision tower is loaded and images are accepted.",
          "label": "Text and images",
          "value": "on"
        },
        {
          "env": {
            "LANGUAGE_MODEL_ONLY": "1"
          },
          "help": "Upstream LANGUAGE_MODEL_ONLY=1: no vision tower; image requests are rejected.",
          "label": "Text only",
          "value": "text-only"
        }
      ],
      "help": "Upstream LANGUAGE_MODEL_ONLY switch. Text-only skips the vision tower and passes --language-model-only.",
      "label": "Image input",
      "name": "vision"
