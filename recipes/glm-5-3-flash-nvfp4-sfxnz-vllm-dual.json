  "options": [
    {
      "choices": [
        {
          "default": true,
          "help": "Upstream default: drafter linears quantized to NVFP4 W4A16 at load (GLM53_NVFP4_W4A16=draft). Upstream E2e: step -4 ms, quality at the cross-boot A/A (upstream claim).",
          "label": "NVFP4 W4A16",
          "value": "nvfp4"
        },
        {
          "env": {
            "GLM53_NVFP4_W4A16": ""
          },
          "help": "Upstream DRAFT_WEIGHTS=bf16: drafter stays BF16 (the v11-equivalent path).",
          "label": "BF16",
          "value": "bf16"
        }
      ],
      "help": "Precision of the DFlash2 drafter linears (upstream DRAFT_WEIGHTS). The target verifies every draft, so output is unchanged.",
      "label": "Drafter weights",
      "name": "drafter_weights"
    },
    {
      "choices": [
        {
          "default": true,
          "help": "Upstream default: shared experts, MLA, KDA in/out projections and lm_head in INT8. Upstream E4a: decode step -17 ms, prose +24.9%, Tier 1 863 vs 857 of 1010 (upstream claims); long prefill about 10% slower.",
          "label": "INT8 all groups",
          "value": "int8"
        },
        {
          "env": {
            "GLM53_INT8_W8A16": ""
          },
          "help": "Upstream TARGET_WEIGHT_GROUPS_INT8=none: those linears stay BF16 (about 10% faster long prefill, slower decode; more memory).",
          "label": "BF16",
          "value": "bf16"
        }
      ],
      "help": "Target non-MoE linears run as INT8 W8A16 g128 Marlin (upstream TARGET_WEIGHT_GROUPS_INT8). Trades some long-prefill speed for decode speed.",
      "label": "Target INT8 groups",
      "name": "target_int8"
    },
    {
      "choices": [
        {
          "default": true,
          "help": "Upstream default (E4b: +5.2% prose over tau 0.2, upstream claim).",
          "label": "Adaptive, tau 0.3",
          "value": "tau-0-3"
        },
        {
          "env": {
            "GLM53_ADAPTIVE_VERIFY_TAU": "0.2"
          },
          "help": "Upstream E3b setting: verifies more drafts per step than tau 0.3.",
          "label": "Adaptive, tau 0.2",
          "value": "tau-0-2"
        },
        {
          "env": {
            "GLM53_ADAPTIVE_VERIFY": "0"
          },
          "help": "Upstream ADAPTIVE_VERIFY=0: verify every drafted token every step.",
          "label": "Off",
          "value": "off"
        }
      ],
      "help": "Verify only the leading drafts whose running DFlash2 confidence stays at or above tau, at fixed shapes (upstream ADAPTIVE_VERIFY, lossless).",
      "label": "Adaptive verify",
      "name": "adaptive_verify"
    },
    {
      "choices": [
        {
          "default": true,
          "help": "Upstream default: rejected drafts no longer write committed indexer pool keys; needles pass to 128k (upstream claim).",
          "label": "On",
          "value": "on"
        },
        {
          "env": {
            "GLM53_KPOOL_TAIL_FIX": "0"
          },
          "help": "Upstream KPOOL_TAIL_FIX=0: the v11 ring.",
          "label": "Off",
          "value": "off"
        }
      ],
      "help": "Per-request DSA indexer tail ring sized for the verify window (upstream KPOOL_TAIL_FIX): a correctness fix, matters above 2048 tokens.",
      "label": "Indexer tail ring",
      "name": "kpool_tail_fix"
    },
    {
      "choices": [
        {
          "default": true,
          "help": "Upstream default: Marlin at every input size.",
          "label": "Off",
          "value": "off"
        },
        {
          "env": {
            "GLM53_WQ_DEQUANT_GROUPS": "kda_in",
            "GLM53_WQ_DEQUANT_MIN_M": "512"
          },
          "help": "Upstream PREFILL_DEQUANT_MIN_M=512: +9.5% at a 7k prompt but only +6.4% / +3.5% at 32k / 128k; upstream keeps it off because that misses its +5% rule (upstream claim).",
          "label": "From 512 rows",
          "value": "rows-512"
        }
      ],
      "help": "Dequantize the INT8 kda_in weight to BF16 and use cuBLAS for prefill inputs of at least 512 rows (upstream PREFILL_DEQUANT_MIN_M). Only matters with INT8 target groups.",
      "label": "Prefill dequant",
      "name": "prefill_dequant"
    },
    {
      "choices": [
        {
          "default": true,
          "help": "Upstream default: DFlash2 trained block of 7, two sequences, graphs 1/2/4/8/16.",
          "label": "Two sequences, 7 drafts",
          "value": "two-seq"
        },
        {
          "args": [
            {
