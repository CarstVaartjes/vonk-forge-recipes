  "options": [
    {
      "choices": [
        {
          "default": true,
          "help": "Upstream default: triton-lane FP4 KV with 16-element blocks and shared MX scaling; upstream's README reports about 1.14M KV tokens at mem fraction 0.85 (its own claim).",
          "label": "FP4 MX block16",
          "value": "fp4-mx-block16"
        },
        {
          "args": [
            {
              "name": "kv-cache-dtype",
              "value": "auto"
            }
          ],
          "help": "Lets SGLang pick the KV dtype from the checkpoint; larger KV footprint, not the configuration upstream benchmarked.",
          "label": "Model default (auto)",
          "value": "auto"
        }
      ],
      "help": "Precision of the KV cache. The FP4 recipe is the triton-lane packing upstream's champion uses.",
      "label": "KV cache dtype",
      "name": "kv-cache"
    },
    {
      "choices": [
        {
          "default": true,
          "help": "Upstream default; upstream reports about 11 points higher draft acceptance than bf16 (its own claim).",
          "label": "fp32 reduce",
          "value": "fp32"
        },
        {
          "args": [
            {
              "name": "triton-attention-reduce-in-fp32",
              "value": false
            }
          ],
          "help": "Upstream documents this as the cheaper but lower-acceptance setting.",
          "label": "bf16 reduce",
          "value": "bf16"
        }
      ],
      "help": "Accumulation precision across KV splits in the triton attention backend.",
      "label": "Attention reduce precision",
      "name": "attention-reduce"
    },
    {
      "choices": [
        {
          "default": true,
          "help": "Upstream default, measured optimum on GB10 per its README.",
          "label": "7 tokens",
          "value": "block-7"
        },
        {
          "args": [
            {
              "name": "speculative-dspark-block-size",
              "value": 15
            }
          ],
          "help": "The draft checkpoint's native block size; upstream reports it regresses throughput on GB10.",
          "label": "15 tokens",
          "value": "block-15"
        }
      ],
      "help": "How many tokens the draft proposes per step.",
      "label": "DSpark block size",
      "name": "draft-block-size"
    },
    {
      "choices": [
        {
          "default": true,
          "help": "Upstream default.",
          "label": "0.85",
          "value": "frac-085"
        },
        {
          "args": [
            {
              "name": "mem-fraction-static",
              "value": "0.75"
            }
          ],
          "help": "Upstream's suggestion when the head runs out of memory; shrinks the KV budget.",
          "label": "0.75",
          "value": "frac-075"
        }
      ],
      "help": "Share of unified memory SGLang reserves for weights and KV cache.",
      "label": "GPU memory fraction",
      "name": "memory-fraction"
    }
  ],
