  "release": {
    "history": [
      {
        "version": "1.4.8",
        "released_at": "2026-09-28",
        "upgrade_effect": "rebuild",
        "prior_recipe_content_sha256": "b3724bf2c7e4b4e7bf7592ed319d5a53343cad9823fa1e11c57c175da4ab489d",
        "changes": [
          {
            "kind": "runtime",
            "summary": "Moved the CUDA runtime base from 13.0.1 to 13.4.1 (ubuntu24.04, arm64 digest 2eaf3468).",
            "details": "The 13.4.1 runtime image keeps the brand=*,driver>=580,driver<581 requirement clause, so it stays admissible on the Spark 580-series driver. PyTorch continues to bring its own cu130 wheels.",
            "references": [
              "https://catalog.ngc.nvidia.com/orgs/nvidia/containers/cuda"
            ]
          },
          {
            "kind": "runtime",
            "summary": "Refreshed the PyTorch stack: torch 2.14.0, torchvision 0.29.0, accelerate 1.15.0, diffusers 0.35.0 -> 0.39.0.",
            "details": "diffusers 0.40.0 requires huggingface-hub>=1.23, which conflicts with the upstream-mandated Transformers v4.49.0-SigLIP-2 fork (huggingface-hub<1.0), so 0.39.0 is the newest compatible release. The diffusers APIs used (ModelMixin, ConfigMixin, schedulers, randn_tensor) import and run on CPU with the vendored fork. HunyuanVideo-Foley source (df7b005b) is still upstream head; Descript Audiotools has no newer tag than 0.7.4 (pin 348ebf20 is 2 commits past it).",
            "references": [
              "https://github.com/pytorch/pytorch/releases/tag/v2.14.0",
              "https://github.com/pytorch/vision/releases/tag/v0.29.0",
              "https://github.com/huggingface/accelerate/releases/tag/v1.15.0",
              "https://github.com/huggingface/diffusers/releases/tag/v0.39.0",
              "https://github.com/huggingface/diffusers/compare/v0.35.0...v0.39.0"
            ]
          }
        ]
      },
      {
        "changes": [
          {
            "kind": "fix",
            "summary": "Permit the official NVIDIA CUDA toolkit host.",
            "details": "The pinned PyTorch cu130 metadata requires cuda-toolkit==13.0.3.0; the official index resolves that package to a wheel hosted on pypi.nvidia.com. This exact host is now permitted for the source build; model and runtime pins are unchanged.",
            "references": [
              "https://download.pytorch.org/whl/cu130/cuda-toolkit/"
            ]
          }
        ],
