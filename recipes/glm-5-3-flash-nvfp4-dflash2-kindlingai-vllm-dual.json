  "options": [
    {
      "choices": [
        {
          "default": true,
          "help": "incoai's DFlash2 block-diffusion drafter with up to 7 drafted tokens and the creator's per-batch-size widths (7, 5, 4, 3, 2, then 7 again past 5 requests) under its adaptive-k scheduler. The drafter's licence (CC BY-NC-ND 4.0 on its original release, Apache-2.0 on its current card) is shown as information only; nothing here enforces it.",
          "label": "DFlash2 adaptive-k",
          "value": "dflash2"
        },
        {
          "args": [
            {
              "name": "speculative-config",
              "value": "{\"method\":\"mtp\",\"num_speculative_tokens\":4}"
            },
            {
              "name": "scheduler-cls",
              "value": "vllm.v1.core.sched.scheduler.Scheduler"
            }
          ],
          "help": "The checkpoint's own MTP layer with 4 drafted tokens (the creator's mtp lane) under vLLM's stock scheduler; the drafter files stay mounted but unused. The adaptive-k and draft-trunc overlay files stay in the image but are only reached through the DFlash2 speculative config.",
          "label": "Native MTP",
          "value": "mtp"
        }
      ],
      "help": "Which draft proposes tokens for the target to verify. DFlash2 with the creator's adaptive-k scheduler is its default lane; its MTP choice is the checkpoint's own head with the stock scheduler (the creator refuses adaptive-k with MTP, and a choice can only replace a value, so it writes the stock scheduler).",
      "label": "Speculative decoding",
      "name": "speculation"
    },
    {
      "choices": [
        {
          "default": true,
          "help": "vLLM's stock GLM 4.7 tool parser (the creator's default).",
          "label": "glm47",
          "value": "glm47"
        },
        {
          "args": [
            {
              "name": "tool-parser-plugin",
              "value": "/usr/local/share/glm47_failclosed.py"
            },
            {
              "name": "tool-call-parser",
              "value": "glm47_failclosed"
            }
          ],
          "help": "The creator's plugin: a malformed tool call is rejected instead of being passed on as text.",
          "label": "glm47 fail-closed",
          "value": "glm47_failclosed"
        }
      ],
      "help": "How the server parses a model-written tool call. The creator's fail-closed parser is a plugin it baked in after a stock-parser launch once ran unnoticed.",
      "label": "Tool-call parser",
      "name": "tool-parser"
    }
  ],
