  "options": [
    {
      "choices": [
        {
          "default": true,
          "help": "Upstream default: 3 drafted tokens per step.",
          "label": "MTP 3 (default)",
          "value": "mtp3"
        },
        {
          "args": [
            {
              "name": "speculative-config",
              "setting": null,
              "value": "{\"method\":\"mtp\",\"num_speculative_tokens\":4}"
            }
          ],
          "help": "4 drafted tokens per step (upstream's earlier default; costs roughly 290K tokens of KV pool on one Spark).",
          "label": "MTP 4",
          "value": "mtp4"
        },
        {
          "env": {
            "VONK_QWEN_SPEC": "off"
          },
          "help": "No speculative decoding.",
          "label": "Off",
          "value": "off"
        }
      ],
      "help": "Depth of MTP drafting with the checkpoint's own MTP head. Upstream ships 3 tokens (measured 43.9 tok/s median single stream on one Spark); 4 was the earlier default.",
      "label": "MTP speculation",
      "name": "speculation"
    },
    {
      "choices": [
        {
          "default": true,
          "help": "Upstream default (upstream claims about 25 percent faster than the full head in its own A/B).",
          "label": "Reduced 65,536 ids (default)",
          "value": "reduced"
        },
        {
          "env": {
            "QWEN4EXP_DRAFT_VOCAB": "0"
          },
          "help": "Draft over the whole vocabulary.",
          "label": "Full vocabulary",
          "value": "full"
        }
      ],
      "help": "The MTP head projects onto the 65,536 lowest token ids and the target verifies over the full vocabulary, so the emitted text is unchanged (upstream design note; the idea is FR-Spec).",
      "label": "Reduced-vocabulary draft",
      "name": "draft-vocabulary"
    },
    {
      "choices": [
        {
          "default": true,
          "help": "Upstream default (fp8_e4m3 through the baked vLLM PR #54846 overlay).",
          "label": "FP8 e4m3 (default)",
          "value": "fp8"
        },
        {
          "args": [
            {
              "name": "kv-cache-dtype",
              "setting": null,
              "value": "auto"
            }
          ],
          "help": "Stock BF16 KV; upstream measured a smaller pool at the same memory utilization.",
          "label": "BF16",
          "value": "bf16"
        }
      ],
      "help": "Precision of the main attention KV cache. FP8 is upstream's default and gives the larger pool.",
      "label": "KV cache precision",
      "name": "kv-cache"
    },
    {
      "choices": [
        {
          "default": true,
          "help": "Rows are read before the forward pass so decode replays CUDA graphs without torch.compile (upstream default, 43.9 tok/s median).",
          "label": "Staged gather, decode graphs (default)",
          "value": "staged"
        },
        {
          "args": [
            {
              "name": "compilation-config",
              "setting": null,
              "value": "{\"cudagraph_mode\":\"PIECEWISE\"}"
            }
          ],
          "env": {
            "QWEN4EXP_PLE_STAGED": "0"
          },
          "help": "Upstream's earlier stack: the gather is a graph split point with piecewise CUDA graphs and torch.compile (upstream measured 32.5 tok/s median with MTP 4, eight sequences and full-vocabulary draft; combine those options for that stack).",
          "label": "Gather as opaque op, piecewise graphs",
          "value": "mmap-piecewise"
        }
      ],
      "help": "How the disk-backed n-gram table is gathered and which CUDA graph mode goes with it.",
      "label": "Embedding table path",
      "name": "ple-table"
    }
