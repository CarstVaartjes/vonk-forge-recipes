  "options": [
    {
      "choices": [
        {
          "args": [
            {
              "name": "vision-max-images",
              "value": 50
            },
            {
              "name": "vision-max-videos",
              "value": 4
            },
            {
              "name": "vision-image-tokens",
              "value": 16384
            }
          ],
          "default": true,
          "help": "Load the 0.84 GiB vision tower; image and video requests are available (up to 50 images a request, sharing 16,384 image tokens, and up to 4 videos with a 16,384-token budget). The helper keeps 2 GiB out of the KV pool.",
          "label": "Images and video",
          "value": "vision"
        },
        {
          "args": [
            {
              "name": "vision",
              "value": false
            }
          ],
          "env": {
            "TENSORFOLD_VISION_WORKSPACE_MIB": "0"
          },
          "help": "Skip the vision tower (text only) and return the 2 GiB helper workspace to the KV pool.",
          "label": "Text only",
          "value": "text-only"
        }
      ],
      "help": "Load Flash Next's vision tower for image_url and video_url requests, or choose text only.",
      "label": "Image and video input",
      "name": "images_video"
    },
    {
      "choices": [
        {
          "default": true,
          "help": "Only base64 data URLs are accepted (upstream default).",
          "label": "Data URLs only",
          "value": "data-only"
        },
        {
          "args": [
            {
              "name": "vision-urls",
              "value": true
            }
          ],
          "help": "Also fetch public https image and video URLs (--vision-urls).",
          "label": "Data and https URLs",
          "value": "https"
        }
      ],
      "help": "Whether the server may fetch public https:// image and video URLs sent in requests. Off by default, so only data URLs are accepted. This is request-time fetching by the server, not a recipe download.",
      "label": "Remote media URLs",
      "name": "vision_urls"
    },
    {
      "choices": [
        {
          "default": true,
          "help": "MTP drafts, up to 12 a round on a lone stream while their running probability stays high and 6 when streams share a round, checked against the model's own samples (the creator's default).",
          "label": "MTP drafts",
          "value": "mtp"
        },
        {
          "args": [
            {
              "name": "no-drafts",
              "value": true
            }
          ],
          "help": "Serial one-token-at-a-time reference decoding (--no-drafts); slower.",
          "label": "No drafting",
          "value": "serial"
        }
      ],
      "help": "MTP drafts are verified against the model's own samples, so outputs are unchanged by drafting (creator claim). Serial decoding is TensorFold's reference path.",
      "label": "Speculative drafting",
      "name": "drafting"
    }
