  "release": {
    "history": [
      {
        "changes": [
          {
            "details": "The recipe now carries every author-selectable Podman build input through the signed Controller-to-agent request, including a bounded capability list that defaults to empty. The agent drops all capabilities before adding only declared allowlisted entries inside Podman's rootless user namespace; host privilege, devices, mounts, sockets, security options, storage, cgroups, and generated image identity remain fixed platform policy.",
            "kind": "compatibility",
            "references": [],
            "summary": "Declared explicit resource limits and rootless capabilities in the portable recipe build contract."
          }
        ],
        "prior_recipe_content_sha256": null,
        "released_at": "2026-09-03",
        "upgrade_effect": "rebuild",
        "version": "1.2.5"
      },
      {
        "changes": [
          {
            "details": null,
            "kind": "metadata",
            "references": [],
            "summary": "Declared explicit recipe alignment metadata; no runtime behavior changed."
          }
        ],
        "prior_recipe_content_sha256": "f90397303047422f13e26e85cebcfe755a5fa28957ff39c4169a742bbbad344f",
        "released_at": "2026-09-01",
        "upgrade_effect": "none",
        "version": "1.2.4"
      },
      {
        "changes": [
          {
            "details": "Removed nvcr.io because digest-pinned base images are fetched through the separate verified base-image transfer and the build runs with pull disabled.",
            "kind": "security",
            "references": [],
            "summary": "Restricted public build egress to hosts used during Dockerfile execution."
          }
        ],
        "prior_recipe_content_sha256": "de66ff6463978fada6d20b367acbbceee202d4628c28fd1eef7c9daaf3e4cbce",
        "released_at": "2026-09-01",
        "upgrade_effect": "rebuild",
        "version": "1.2.3"
      },
      {
        "changes": [
          {
            "details": "Replaced the synthetic snapshot pseudo-file with all 24 files in NVIDIA's exact eafac15f revision, including file sizes and SHA-256 digests, and recorded the official full-pipeline parameter count, 1,024-token prompt limit, and tested 1024px resolution. The hydrated recipe artifact, four-step launch, and runtime image are unchanged, so deployments need no rebuild or restart.",
            "kind": "metadata",
            "references": [
              "https://huggingface.co/nvidia/Qwen-Image-Flash/tree/eafac15f6140e6dd9c6031217d658ac10bfb604b"
            ],
            "summary": "Closed the immutable Qwen Image Flash source inventory."
          },
          {
            "details": "The bounded image canary now records the model card's tested 1024x1024 resolution and required four inference steps instead of relying on runtime defaults.",
            "kind": "fix",
            "references": [],
            "summary": "Made the physical canary profile explicit."
          }
        ],
        "prior_recipe_content_sha256": "84846b238017fdfcf005bff4b47c2926affb301d84bce1540a78a418c700fa93",
        "released_at": "2026-08-30",
