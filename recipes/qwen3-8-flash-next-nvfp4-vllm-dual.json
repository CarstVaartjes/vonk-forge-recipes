  "options": [
    {
      "choices": [
        {
          "default": true,
          "help": "Upstream lane default: stock QSA BF16 KV cache.",
          "label": "BF16",
          "value": "bf16"
        },
        {
          "args": [
            {
              "name": "kv-cache-dtype",
              "value": "fp8"
            }
          ],
          "help": "FP8 e4m3 KV via the baked vllm#55557 backport (upstream opt-in; delete once vLLM 0.31+). Larger KV pool, slower decode (claim).",
          "label": "FP8",
          "value": "fp8"
        }
      ],
      "help": "Precision of the main KV cache. Mia reports (claims, not measured here) about 1.34-1.52M tokens on BF16 and 2.64M on FP8 at GPU memory utilization 0.80, with FP8 about 5 percent slower in decode.",
      "label": "KV cache dtype",
      "name": "kv_cache"
    },
    {
      "choices": [
        {
          "default": true,
          "help": "Upstream lane default (VLLM_USE_BREAKABLE_CUDAGRAPH=0): steadier decode, about 2 percent variation (claim).",
          "label": "Off",
          "value": "off"
        },
        {
          "env": {
            "VLLM_USE_BREAKABLE_CUDAGRAPH": "1"
          },
          "help": "vLLM 0.30 stock behaviour (upstream V030_BREAKABLE_CUDAGRAPH=1).",
          "label": "On",
          "value": "on"
        }
      ],
      "help": "vLLM 0.30 enables breakable CUDA graphs for Qwen4Exp. Upstream turns them off on GB10 because decode varied 10-18 percent between identical runs (claim).",
      "label": "Breakable CUDA graphs",
      "name": "cuda_graphs"
    },
    {
      "choices": [
        {
          "default": true,
          "help": "Upstream default: drafts over 47k English and code token ids; about +8 percent mean decode (claim).",
          "label": "Reduced 47k",
          "value": "reduced-47k"
        },
        {
          "args": [
            {
              "name": "speculative-config",
              "value": "{\"method\":\"mtp\",\"num_speculative_tokens\":3,\"disable_eagle_block_drop\":true,\"index_share_for_mtp_iteration\":true}"
            }
          ],
          "env": {
            "VLLM_MTP_DRAFT_VOCAB": ""
          },
          "help": "Drafts over the full 248,320-token head (stock vLLM 0.30 behaviour, 5-15 percent slower decode per upstream claim).",
          "label": "Full 248k",
          "value": "full"
        },
        {
          "env": {
            "VLLM_MTP_DRAFT_VOCAB": "/opt/vonk/draft-vocab/draft_vocab_de_en_code_65k.txt"
          },
          "help": "Bundled 65,536-token German, English, and code draft vocabulary. Upstream reports higher German draft acceptance; speed depends on workload and host.",
          "label": "German, English, and code (65k)",
          "value": "de"
        },
        {
          "env": {
            "VLLM_MTP_DRAFT_VOCAB": "/opt/vonk/draft-vocab/draft_vocab_es_en_code_65k.txt"
          },
          "help": "Bundled 65,536-token Spanish, English, and code draft vocabulary. Upstream reports higher Spanish draft acceptance; speed depends on workload and host.",
          "label": "Spanish, English, and code (65k)",
          "value": "es"
        },
        {
          "env": {
            "VLLM_MTP_DRAFT_VOCAB": "/opt/vonk/draft-vocab/draft_vocab_fr_en_code_65k.txt"
          },
          "help": "Bundled 65,536-token French, English, and code draft vocabulary. Upstream reports higher French draft acceptance; speed depends on workload and host.",
          "label": "French, English, and code (65k)",
          "value": "fr"
        },
        {
          "env": {
            "VLLM_MTP_DRAFT_VOCAB": "/opt/vonk/draft-vocab/draft_vocab_ja_en_code_65k.txt"
          },
          "help": "Bundled 65,536-token Japanese, English, and code draft vocabulary. Upstream reports higher Japanese draft acceptance; speed depends on workload and host.",
          "label": "Japanese, English, and code (65k)",
          "value": "ja"
        },
        {
          "env": {
            "VLLM_MTP_DRAFT_VOCAB": "/opt/vonk/draft-vocab/draft_vocab_pt_en_code_65k.txt"
          },
          "help": "Bundled 65,536-token Portuguese, English, and code draft vocabulary. Upstream reports higher Portuguese draft acceptance; speed depends on workload and host.",
          "label": "Portuguese, English, and code (65k)",
          "value": "pt"
        },
        {
          "env": {
            "VLLM_MTP_DRAFT_VOCAB": "/opt/vonk/draft-vocab/draft_vocab_ru_en_code_65k.txt"
          },
          "help": "Bundled 65,536-token Russian, English, and code draft vocabulary. Upstream reports higher Russian draft acceptance; speed depends on workload and host.",
          "label": "Russian, English, and code (65k)",
          "value": "ru"
        },
        {
          "env": {
            "VLLM_MTP_DRAFT_VOCAB": "/opt/vonk/draft-vocab/draft_vocab_zh_en_code_65k.txt"
          },
          "help": "Bundled 65,536-token Chinese, English, and code draft vocabulary. Upstream reports higher Chinese draft acceptance; speed depends on workload and host.",
          "label": "Chinese, English, and code (65k)",
          "value": "zh"
        }
      ],
      "help": "Vocabulary the MTP drafter samples over. Output-safe: the target verifies every token; vocabulary choice affects draft acceptance and may affect speed, not emitted output.",
      "label": "MTP draft vocabulary",
      "name": "draft_vocab"
    },
    {
      "choices": [
        {
          "default": true,
          "help": "Upstream default (MAMBA_SSM_CACHE_DTYPE=bfloat16): halves state traffic; measured by Mia on the single-Spark kit (+8.5 percent at 8 streams, claim), not yet on this dual kit.",
          "label": "BF16",
          "value": "bf16"
        },
        {
          "args": [
            {
              "name": "mamba-ssm-cache-dtype",
              "value": "float32"
            }
          ],
          "help": "The checkpoint's own float32 state (upstream: leave empty).",
          "label": "Float32",
          "value": "fp32"
        }
      ],
      "help": "Precision of the Gated DeltaNet recurrent state.",
      "label": "GDN state dtype",
      "name": "ssm_state"
