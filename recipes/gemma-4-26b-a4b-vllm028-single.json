  "release": {
    "history": [
      {
        "version": "1.1.0",
        "released_at": "2026-09-28",
        "upgrade_effect": "rebuild",
        "prior_recipe_content_sha256": "5a7f2f2a0a15b7666d57d23659c50387f7a890aa0c2abbf5d26546166c599a0a",
        "changes": [
          {
            "kind": "runtime",
            "summary": "Refresh the pinned official vLLM ARM64 runtime from 0.28.0 to stable 0.30.0.",
            "details": "Moves from v0.28.0-aarch64-ubuntu2404 (41b54fb42c66) to v0.30.0-aarch64-ubuntu2404 (e06f024cf1dd), build commit ced6857a. Upstream v0.29 makes Model Runner V2 the default and deprecates V1; v0.29/v0.30 removals (PyAV video decoder, api_server module entrypoint, VLLM_PREFIX_CACHE_RETENTION_INTERVAL, VLLM_MM_HASHER_ALGORITHM, GPTQ g_idx) are not used here. Every runtime option in this recipe still exists at v0.30.0. Gemma 4 kernels are de-JITified at startup (#55768) and the Gemma 4 parser now accepts bare/malformed tool-call openers (#53444); this recipe still exposes plain image chat and reasoning only. The build-time Gemma4ForConditionalGeneration interface screen is unchanged. Needs Spark canary re-acceptance.",
            "references": [
              "https://github.com/vllm-project/vllm/releases/tag/v0.30.0",
              "https://github.com/vllm-project/vllm/releases/tag/v0.29.0",
              "https://github.com/vllm-project/vllm/compare/v0.28.0...v0.30.0",
              "https://hub.docker.com/r/vllm/vllm-openai/tags?name=v0.30.0-aarch64"
            ]
          }
        ]
      },
      {
        "changes": [
          {
            "details": "The recipe now carries every author-selectable Podman build input through the signed Controller-to-agent request, including a bounded capability list that defaults to empty. The agent drops all capabilities before adding only declared allowlisted entries inside Podman's rootless user namespace; host privilege, devices, mounts, sockets, security options, storage, cgroups, and generated image identity remain fixed platform policy.",
            "kind": "compatibility",
            "references": [],
            "summary": "Declared explicit resource limits and rootless capabilities in the portable recipe build contract."
          }
        ],
        "prior_recipe_content_sha256": null,
